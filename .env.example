# Droplet Edge Platform — Environment Variable Reference
# -------------------------------------------------------
# This file is documentation only — setup.sh generates .env directly
# via heredoc (no template dependency). Keep as a reference for developers.
#
# To provision a device: ./scripts/setup.sh
# To regenerate secrets: ./scripts/setup.sh --regenerate-env

# --- PostgreSQL ---
POSTGRES_USER=droplet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=droplet
DATABASE_URL=postgresql://droplet:change-me@db:5432/droplet

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@cache:6379

# --- MQTT ---
MQTT_USER=droplet
MQTT_PASSWORD=change-me
MQTT_BROKER=mqtt://droplet:change-me@broker:1883

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
NEXTCLOUD_URL=http://nextcloud:80

# --- AI Gateway ---
AI_GATEWAY_URL=http://ai-gateway:8000
JETSON_OLLAMA_URL=http://inference-engine.local:11434

# --- BYOK Encryption (unique per device — do not share) ---
DEVICE_SECRET=change-me
# 32-byte AES key (base64) for encrypting device client secrets at rest
DEVICE_SECRET_KEY=change-me

# --- JWT ---
JWT_SECRET=change-me

# --- Application ---
STORAGE_BACKEND=nextcloud
AUTH_ENABLED=true
FILES_ROOT=/data/files
MAX_UPLOAD_SIZE_MB=100
# --- Display (services/oled-display) ---
# Backend selection. Options:
#   auto        — try pyportal -> framebuffer -> spi -> sim (default)
#   pyportal    — USB-serial to an Adafruit PyPortal Titano
#                 running the firmware in services/oled-display/pyportal/
#   spi         — direct luma.lcd ILI9486 over /dev/spidev0.0
#   framebuffer — fbtft /dev/fb1 (requires kernel module; not on stock L4T)
#   sim         — render frames to SIM_OUTPUT PNG for dev / CI
DISPLAY_BACKEND=auto
# PyPortal backend — host-side serial device path. Titano enumerates as two
# ACM endpoints; we use the second (data) one so the REPL on ACM0 stays free.
PYPORTAL_TTY=/dev/ttyACM1
PYPORTAL_BAUD=115200
