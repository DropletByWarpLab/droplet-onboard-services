# Droplet Edge Platform — Environment Configuration
# Generated by: ./scripts/setup.sh
# WARNING: Contains device-unique secrets. Do NOT commit this file.

# --- PostgreSQL ---
POSTGRES_USER=droplet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=droplet
DATABASE_URL=postgresql://droplet:change-me@db:5432/droplet

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@cache:6379

# --- MQTT ---
MQTT_USER=droplet
MQTT_PASSWORD=change-me
MQTT_BROKER=mqtt://droplet:change-me@broker:1883

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
NEXTCLOUD_URL=http://nextcloud:80

# --- AI Gateway ---
AI_GATEWAY_URL=http://ai-gateway:8000
JETSON_OLLAMA_URL=http://inference-engine.local:11434

# --- BYOK Encryption (unique per device — do not share) ---
DEVICE_SECRET=change-me
# 32-byte AES key (base64) for encrypting device client secrets at rest
DEVICE_SECRET_KEY=change-me

# --- Application ---
STORAGE_BACKEND=nextcloud
AUTH_ENABLED=true
FILES_ROOT=/data/files
MAX_UPLOAD_SIZE_MB=100
