# Generated TLS certificates (device-specific, created by setup.sh)
docker/certs/

# Device-specific secrets materialized for Docker secret mounts (created by setup.sh)
docker/secrets/

# macOS iCloud Drive conflict copies — when the repo sits under
# ~/Documents (iCloud-synced) and git worktree operations or rapid file
# writes race with the sync daemon, iCloud appends " N" (incrementing on
# each subsequent conflict: " 2", " 3", …) to the local copy.
# These are never authoritative; delete + re-sync from git.
# Better long-term: move the repo outside ~/Documents (e.g., to ~/Projects).
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*
# device-bridge runtime env (live credentials). Only .example is tracked.
services/oled-display/device-bridge.env
/etc/droplet/device-bridge.env