node_modules/
dist/
.turbo/
*.log
.env
.env.*
!.env.example
# Per-session brainstorming companion artifacts (HTML mockups, event
# logs). Created by scripts/start-server.sh inside the active worktree
# during design phases — never meant to be tracked.
.superpowers/
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.next/
.data/
# WARP-279 — `.claude/` is ignored by default, but we make a narrow
# exception for the session-state example file. The real session-state.json
# is volatile (rewritten by the AI engineer mid-session) and must never
# land in git, but the example is the schema reference the orchestrator
# reader is documented against, so we keep it tracked.
.claude/*
!.claude/session-state.example.json
# Project subagent definitions and shared project settings are team-shared
# Claude Code config and must be tracked (settings.local.json stays ignored
# via the `.claude/*` rule above).
!.claude/agents/
!.claude/skills/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
.claude/session-state.json
*.tsbuildinfo
.DS_Store

# Generated MQTT credentials (device-specific, created by setup.sh)
docker/mosquitto_passwd_dir/mosquitto_passwd
docker/mosquitto_passwd

# Generated TLS certificates (device-specific, created by setup.sh)
docker/certs/

# Device-specific secrets materialized for Docker secret mounts (created by setup.sh)
docker/secrets/

# macOS iCloud Drive conflict copies — when the repo sits under
# ~/Documents (iCloud-synced) and git worktree operations or rapid file
# writes race with the sync daemon, iCloud appends " N" (incrementing on
# each subsequent conflict: " 2", " 3", …) to the local copy.
# These are never authoritative; delete + re-sync from git.
# Better long-term: move the repo outside ~/Documents (e.g., to ~/Projects).
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*
# device-bridge runtime env (live credentials). Only .example is tracked.
services/oled-display/device-bridge.env
/etc/droplet/device-bridge.env

# WARP-663 / ADR-020 — the appliance image-release PRIVATE signing key is
# NEVER committed (referenced only via $DROPLET_RELEASE_SIGNING_KEY). Only the
# public verify key (scripts/image/keys/droplet-release.pub) is tracked.
scripts/image/keys/*.key
# Built appliance images (large; published as GitHub release assets, not tracked).
output/
# build-iso.sh's transient working dir (upstream ISO download + extract tree).
scripts/image/.build/

# Backlog-driver loop runtime scratch (queue, run-cap counter, audit log)
.claude/loop-state/
# WARP-236 — internal CA + per-service TLS bundles (setup-generated, never tracked)
data/secrets/
# ADR-039 — `npm run finetune-export` output. Its default --out is a relative
# path, so a run from the repo root lands here; with --include-user-content
# that directory holds curated CUSTOMER CONVERSATIONS. Never tracked.
finetune-dataset/
docker/nginx-internal-scheme.conf
