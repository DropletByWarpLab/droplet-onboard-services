datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

model Device {
  id          String   @id @default(uuid())
  deviceId    String   @unique
  hostname    String
  hardwareRev String
  networkMode String   @default("dhcp")
  ip          String?
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  model     String
  provider  String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())
}

model SyncTarget {
  id          String      @id @default(uuid())
  path        String      @unique
  label       String
  intervalMin Int         @default(30)
  enabled     Boolean     @default(true)
  lastSync    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  entries     FileEntry[]
}

model FileEntry {
  id          String     @id @default(uuid())
  targetId    String
  target      SyncTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  path        String
  name        String
  isDirectory Boolean    @default(false)
  size        BigInt     @default(0)
  mimeType    String?
  hash        String?
  modifiedAt  DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([targetId, path])
}
