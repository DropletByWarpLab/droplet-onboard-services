datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

model Device {
  id          String   @id @default(uuid())
  deviceId    String   @unique
  hostname    String
  hardwareRev String
  networkMode String   @default("dhcp")
  ip          String?
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  model     String
  provider  String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())
}

// Per-user client devices (laptops, phones) paired via QR code flow.
// Distinct from the `Device` model, which tracks the Droplet hardware itself.
model DeviceClient {
  id             String   @id @default(uuid())
  userId         String                                   // Nextcloud username
  deviceName     String                                   // "Alice's MacBook"
  deviceType     String                                   // "desktop" | "mobile"
  platform       String                                   // macos|windows|linux|ios|android
  appVersion     String?
  // Encrypted Nextcloud app password (aes-256-gcm). Format: iv||tag||ciphertext
  // base64-encoded. Never exposed to clients after the initial pairing response.
  ncAppPassword  String
  lastSeen       DateTime @default(now())
  status         String   @default("active")              // "active" | "revoked"
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// Short-lived codes generated by the dashboard, consumed by a native
// client on first pairing. Each code is single-use and expires in 10 min.
model PairingCode {
  id         String    @id @default(uuid())
  code       String    @unique
  userId     String                                       // issuer
  expiresAt  DateTime
  used       Boolean   @default(false)
  claimedBy  String?                                      // DeviceClient.id
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([expiresAt])
}

model CommandAuditLog {
  id          String   @id @default(cuid())
  userId      String?
  entityId    String
  domain      String
  service     String
  data        Json?
  tier        Int
  confirmed   Boolean  @default(false)
  blocked     Boolean  @default(false)
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([userId, createdAt])
  @@index([domain, createdAt])
}

model NetworkConfigSnapshot {
  id        String   @id @default(cuid())
  userId    String?
  config    String   // "network", "wireless", "firewall", "dhcp"
  snapshot  Json     // UCI config state before change
  operation String
  createdAt DateTime @default(now())

  @@index([config, createdAt])
}

// --- Camera / Frigate NVR ---

model Camera {
  id             String                   @id @default(uuid())
  name           String                   @unique
  displayName    String
  manufacturer   String?
  model          String?
  ipAddress      String
  macAddress     String?
  enabled        Boolean                  @default(true)
  autoDiscovered Boolean                  @default(false)
  lastSeen       DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  notifications  CameraNotificationPref[]
}

model CameraNotificationPref {
  id        String  @id @default(uuid())
  userId    String
  cameraId  String
  camera    Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  onPerson  Boolean @default(true)
  onVehicle Boolean @default(true)
  onAnimal  Boolean @default(false)
  onMotion  Boolean @default(false)

  @@unique([userId, cameraId])
}

// ── Phase 4: AI file content indexing (pgvector) ──
// Stores chunked text + embeddings for semantic file search.
// Requires CREATE EXTENSION IF NOT EXISTS vector; in the db.
model FileContentChunk {
  id        BigInt   @id @default(autoincrement())
  userId    String                                     // Nextcloud username
  ncFileId  Int                                        // Nextcloud numeric file ID
  path      String                                     // Human-readable path for display
  chunkIdx  Int                                        // 0-based chunk index within the file
  text      String                                     // Raw text of this chunk
  // pgvector column — 384 dims for all-MiniLM-L6-v2.
  // Prisma doesn't support vector natively; use Unsupported + raw SQL.
  embedding Unsupported("vector(384)")
  indexedAt DateTime @default(now())

  @@unique([ncFileId, chunkIdx])
  @@index([userId])
}
