datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

model Device {
  id          String   @id @default(uuid())
  deviceId    String   @unique
  hostname    String
  hardwareRev String
  networkMode String   @default("dhcp")
  ip          String?
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// WARP-174: per-drive customer-chosen names + icons + notes.
///
/// The device-bridge inventories mounted drives by filesystem UUID; this
/// model attaches a friendly `displayName` ("Wedding Photos") so the
/// dashboard's Storage surface and the setup wizard's Storage step can
/// show the human name instead of the FS-provided label or the mount
/// path. Naming mirrors `NetworkDevice.displayName` from the ADR-002
/// Phase 1 device-intelligence pattern — same shape, different domain.
///
/// The setup wizard upserts here via PATCH /api/storage/drives/:uuid.
/// Survives reboots because the UUID is the filesystem UUID, stable as
/// long as the drive itself is.
model Drive {
  uuid        String   @id
  displayName String
  icon        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// BUG-3 / ADR-019: software-RAID (mdadm) storage pool.
///
/// Pools are OPTIONAL and owner-driven — nothing auto-creates a row here.
/// The box runs fine with zero StoragePool rows; "no pool" is the ABSENCE
/// of any row, which is distinct from a row whose `status` is `none`.
///
/// `status` / `level` are EXPLICIT enum columns, never derived from absence
/// (handbook rule 10; canonical precedent WARP-218 BrainMemoryItemStatus).
/// Live array state (active/degraded/resyncing) is read from /proc/mdstat by
/// the device-bridge; the row carries the owner's chosen name/notes + the
/// last-known status, mirroring how the `Drive` table carries owner labels
/// alongside the bridge's live inventory.
///
/// `device` is the md device the owner created (e.g. "md0") — never a
/// host-specific default (rule 12); the owner chooses members + level at
/// create time.
model StoragePool {
  /// md device name without the /dev/ prefix (e.g. "md0"). Stable id.
  device      String       @id
  displayName String
  level       ArrayLevel
  status      PoolStatus   @default(none)
  notes       String?
  members     PoolMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

/// BUG-3 / ADR-019: one disk's membership in a StoragePool.
///
/// `role` is an EXPLICIT enum (active/spare/failed/unassigned), never guessed
/// from null. A member's identity is the block device path the owner assigned
/// at create time; `uuid` (FS/array UUID) is recorded when known so the
/// dashboard can cross-reference the `Drive`/bridge inventory.
model PoolMember {
  id         String      @id @default(uuid())
  pool       StoragePool @relation(fields: [poolDevice], references: [device], onDelete: Cascade)
  poolDevice String
  /// Block device path of this member (e.g. "/dev/sda"). Owner-chosen.
  device     String
  /// FS/array UUID when known (from the bridge inventory); null until resolved.
  uuid       String?
  role       DiskRole    @default(unassigned)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([poolDevice, device])
  @@index([poolDevice])
}

/// BUG-3 / ADR-019: live pool health. EXPLICIT (rule 10), never derived from
/// absence. `none` is a first-class value for a pre-create / torn-down record;
/// "no pool at all" is the absence of any StoragePool row.
enum PoolStatus {
  active
  degraded
  resyncing
  failed
  none
}

/// BUG-3 / ADR-019: a disk's role within an array. EXPLICIT (rule 10).
enum DiskRole {
  active
  spare
  failed
  unassigned
}

/// BUG-3 / ADR-019: the RAID level of an array. Owner-chosen at create time —
/// never a host-specific default (rule 12). `jbod` = linear/concat (no RAID).
enum ArrayLevel {
  raid0
  raid1
  raid5
  raid6
  raid10
  jbod
}

/// WARP-3514 / ADR-070 — what an allocation on a bay drive holds.
///
/// One value today. It is an enum rather than a free string so a second role
/// (the dashboard's `usage.role` also knows `files`) is a reviewed schema
/// change, not a typo that quietly creates a row nothing reads.
enum StorageRole {
  RECORDINGS
}

/// WARP-3514 — how the recordings slice is sized.
///
///   AUTO_RESERVED — an ext4 PROJECT QUOTA on `<mount>/nvr`, sized from the
///                   measured per-camera bitrate and grown by the hourly
///                   allocator. `reservedBytes` is the quota hard limit.
///   FULL          — "whole drive": the quota equals the filesystem size, so
///                   Frigate may use all of it. `reservedBytes` is that size.
enum AllocationMode {
  AUTO_RESERVED
  FULL
}

/// WARP-3514 — where an allocation is in its life. EXPLICIT (handbook rule 10):
/// never derived from "no migration row" / "quota is zero" style absence.
///
///   PENDING    row exists; the host has not yet confirmed the target + quota.
///   MIGRATING  target applied; existing footage is being moved off the
///              previous source (Frigate keeps recording to it until the flip).
///   ACTIVE     Frigate records onto the slice.
///   DEGRADED   recording, but something needs the owner (read-only, SMART
///              failure, the slice cannot grow to the measured need, a failed
///              migration awaiting retry).
///   MISSING    the drive is not mounted; footage is NOT being written to the
///              system disk (the boot guard sees to that).
enum AllocationStatus {
  PENDING
  MIGRATING
  ACTIVE
  DEGRADED
  MISSING
}

/// WARP-3514 / ADR-070 — the slice of an encrypted bay drive that holds camera
/// recordings. Supersedes ADR-019 D2 ("nothing auto-assigns storage") FOR
/// CAMERA RECORDINGS ONLY: Droplet measures the cameras, sizes the slice and
/// allocates it without asking. Erasing a drive or deleting footage still needs
/// the owner's explicit confirmation.
///
/// At most one RECORDINGS row exists at a time (the allocator enforces it; the
/// DB only guarantees one row per filesystem). Switching the recordings drive
/// replaces the row — the old filesystem is no longer the recordings target.
///
/// `fsUuid` is the FILESYSTEM uuid (the same key as `Drive.uuid` and the
/// device-bridge's `uuid`), so the row survives a reboot or re-plug.
model StorageAllocation {
  id            String           @id @default(uuid())
  fsUuid        String           @unique
  role          StorageRole      @default(RECORDINGS)
  mode          AllocationMode   @default(AUTO_RESERVED)
  /// Quota hard limit in bytes (AUTO_RESERVED) or the filesystem size (FULL).
  /// BIGINT: a multi-TB drive overflows INT4.
  reservedBytes BigInt
  status        AllocationStatus @default(PENDING)
  /// Failed moves of footage onto this drive since it was last confirmed. Drives
  /// the auto-retry schedule (1 h, 6 h, 24 h, then the row stays PENDING and the
  /// owner is told); reset to 0 by a success or by the owner's explicit retry.
  migrationFailures Int          @default(0)
  /// When the most recent failed move ended: the retry clock. Null until one failed.
  lastFailureAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([role, status])
}

/// WARP-3514 — one hourly reading of a camera's recording rate, the input to
/// the allocator's sizing (p95 over the last 72 h). Rows older than 14 days
/// are pruned by the sampler itself.
///
/// `camera` is Frigate's camera name as a plain string, not a relation: a
/// sample must outlive a camera that is deleted mid-window, and the sizer
/// simply ignores names that are no longer configured.
model CameraBitrateSample {
  id        String   @id @default(uuid())
  camera    String
  sampledAt DateTime @default(now())
  /// Frigate's measured rate in MiB/hour. Frigate reports MiB (not MB); the
  /// column keeps the unit it was measured in so nothing downstream has to
  /// remember a conversion.
  mbPerHour Float

  @@index([camera, sampledAt])
  @@index([sampledAt])
}

/// WARP-3514 — the closed set of conditions the hourly recordings-health check
/// can raise. Mirrors the API's `warnings[].code` (lower-case there).
enum RecordingsAlertCode {
  DRIVE_MISSING
  READ_ONLY
  ON_SYSTEM_DISK
  NEAR_FULL
  CANNOT_GROW
  SMART_FAILED
  NOT_ENCRYPTED
}

/// WARP-3514 — per-condition outage state, so the owner hears about an outage
/// ONCE, not once per hourly tick.
///
/// Persisted (not in-process like camera-storage's near-full edge) because the
/// conditions here — a missing drive, recordings on the OS disk — last for days
/// and an orchestrator restart must not re-page the owner for each of them.
/// `active` + `since` are explicit columns; "was it announced" is `notifiedAt`,
/// never inferred from the absence of a NotificationLog row.
model RecordingsAlertState {
  code       RecordingsAlertCode @id
  /// True while the condition currently holds.
  active     Boolean             @default(false)
  /// When the CURRENT outage began; null while healthy.
  since      DateTime?
  /// When owner/admin were told about the CURRENT outage; null = not yet.
  notifiedAt DateTime?
  updatedAt  DateTime            @updatedAt
}

/// WARP-304: per-user persistent chat sessions for the /chat page.
/// `userId` is the Nextcloud username from the auth middleware. The dashboard
/// only ever lists / reads sessions for the requesting user — owner/admin do
/// not get visibility into other users' chats (privacy boundary).
///
/// The pre-WARP-104 `model`/`provider` columns are kept (nullable now) for
/// backwards compatibility with any existing rows; the new rows record them
/// from the first turn's chat request.
/// WARP-845 — per-user chat projects: folders in the history sidebar
/// plus a default persona (systemPrompt) applied to new chats started
/// inside the project. Strictly per-user (product call): no sharing,
/// owner/admin get no visibility into other users' projects.
model ChatProject {
  id           String        @id @default(uuid())
  userId       String
  name         String
  systemPrompt String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  sessions     ChatSession[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ChatSession {
  id              String            @id @default(uuid())
  userId          String
  title           String?
  model           String?
  provider        String?
  /// WARP-845 — optional project membership. SetNull on project delete:
  /// the chats survive, falling back to the ungrouped date list.
  projectId       String?
  project         ChatProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// WARP-844 — the caller-supplied system prompt this conversation is
  /// held under. Persisted from the request's system message on every
  /// turn (latest wins) and returned on GET so the dashboard restores
  /// the textarea when the thread is reloaded. NULL = no custom prompt.
  systemPrompt    String?
  /// WARP-1917 — sidebar pin. `pinned` is the EXPLICIT state column (per
  /// CLAUDE.md "no guessing": never derived from pinnedAt IS NULL);
  /// `pinnedAt` only orders the Pinned section (most recent pin first).
  /// Both written together by setConversationPinned via raw SQL so the
  /// @updatedAt column is NOT bumped — unpinning must return the chat to
  /// its original chronological spot, not to "Today".
  pinned          Boolean           @default(false)
  pinnedAt        DateTime?
  /// WARP-2991 — may this conversation's on-box answers be replayed to a
  /// cloud model? Explicit enum, never inferred from the timestamp. The
  /// server replays assistant history to a cloud provider ONLY when this is
  /// `granted` AND `cloudHistoryConsentAt` is later than every on-box answer
  /// in the thread; anything else replays the user's own messages only.
  /// A CHECK ties the state to its actor pair (not_asked ⇔ both NULL).
  cloudHistoryConsent   CloudHistoryConsent @default(not_asked)
  cloudHistoryConsentAt DateTime?
  /// Username of the person who decided (ChatSession.userId is a username too).
  cloudHistoryConsentBy String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  messages        ChatMessage[]
  pins            ContextPin[]
  /// WARP-1118 — back-relation for BusinessProfile.interviewChat. Prisma
  /// requires the opposite side of the relation to be declared; it is the
  /// onboarding-interview session a business profile was built from (at
  /// most one profile points here). SetNull on delete so deleting the
  /// interview session doesn't cascade the singleton profile away.
  businessProfile BusinessProfile?
  /// WARP-1683 — back-relation for TeamChatMessage.sharedChatSession (an
  /// AI-chat transcript forwarded into a team-chat thread). SetNull on
  /// delete: the forward keeps serving from its immutable
  /// `sharedChatSnapshot` after the source conversation is deleted.
  teamChatShares  TeamChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  /// WARP-845 — Postgres doesn't auto-index FK columns; per-project
  /// counts and the SET NULL cascade on project delete scan on this.
  @@index([projectId])
}

/// WARP-460 — Context pins per chat session. The dashboard's right-side
/// "Context · N sources" panel (FEATURES.md §2.2.7) lists these; the
/// agent loop reads them on every turn and prepends pin descriptions to
/// the system prompt so retrieval/tool calls are scoped accordingly.
///
/// `kind` is an explicit enum (no string-soup per CLAUDE.md "no guessing").
/// `ref` is kind-specific (path / id / external ref). `meta` carries
/// kind-specific extras (e.g. `{from, to}` for camera_window).
model ContextPin {
  id        String         @id @default(uuid())
  sessionId String
  session   ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      ContextPinKind
  ref       String
  meta      Json?
  addedAt   DateTime       @default(now())

  /// WARP-2582 — one pin per record per thread. The record-drawer "Ask AI
  /// about this customer" action makes a duplicate ONE CLICK, and a duplicate
  /// is not cosmetic: it spends the pin block's char budget twice on every
  /// turn thereafter. All three columns are NOT NULL, which is what makes this
  /// safe as a P2002 target — a compound unique containing a NULLABLE column
  /// never matches in Postgres (NULL = NULL is false) and an upsert against it
  /// silently inserts forever. `meta` is excluded for that reason as much as
  /// any other.
  @@unique([sessionId, kind, ref])
  @@index([sessionId, addedAt])
}

/// WARP-460 — kinds of context the user can pin to a chat thread.
/// Maps 1:1 to the dashboard's side-panel pill types.
///
/// NOTE (WARP-2582): the "`context_pins` request shape in FEATURES.md §4.1"
/// this comment used to cite was never implemented — no chat request field of
/// that name exists in the orchestrator or the dashboard. Removed rather than
/// left pointing at nothing. The consequence is real and load-bearing: a pin
/// cannot exist before the first turn mints a session, so the dashboard's
/// record hand-off seeds the composer for turn 1 and pins from turn 2.
///
/// WARP-2582 — the four BUSINESS kinds. Their `ref` is a record id, not a
/// path, so unlike the first five they must be RESOLVED to a name before they
/// can be rendered into the prompt (services/context-pin-targets.service.ts).
/// They carry no foreign key deliberately: `ref` is polymorphic across all
/// nine kinds, and giving four of them real FK columns would need four
/// nullable columns plus an exactly-one-of CHECK Prisma cannot express — a lot
/// of schema to buy a cascade whose absence is already handled. A dangling pin
/// resolves to the explicit `missing` state, which is more useful than
/// vanishing: the user gets a row they can remove.
enum ContextPinKind {
  folder
  file
  email_thread
  camera
  camera_window
  customer
  deal
  project
  work_item
}

/// WARP-461 — Durable per-workspace memory facts the model can recall
/// (FEATURES.md §5). Distinct from `BrainMemoryItem`, which is the
/// chat-attachment file-bytes table — keep concerns separate per the
/// WARP-461 architecture note.
///
/// `addedBy` is a free-form identifier (username today; will become a
/// User.id UUID after the chat-user-id backfill lands). `evidenceChatId`
/// optionally points at the conversation where the fact was extracted.
/// `active` is a soft-disable flag so users can pause a fact without
/// deleting the row (preserving evidence chain).
model MemoryFact {
  id             String             @id @default(uuid())
  category       MemoryFactCategory
  fact           String
  addedBy        String
  evidenceChatId String?
  active         Boolean            @default(true)
  /// WARP-845 — role audience (minimum-role ladder owner > admin >
  /// family > guest). A fact is visible to callers whose role rank is
  /// AT OR ABOVE the audience's rank: audience=guest distributes to the
  /// whole household incl. guests; audience=owner keeps it owner-only.
  /// Default family = every member, no guests. Explicit column, never
  /// derived (no-guessing rule).
  audience       MemoryFactAudience @default(family)
  addedAt        DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@index([category, active])
  @@index([active, addedAt(sort: Desc)])
  @@index([active, audience])
}

/// WARP-845 — who a memory fact is distributed to (minimum role).
enum MemoryFactAudience {
  owner
  admin
  family
  guest
}

/// WARP-461 — per FEATURES.md §5 fact taxonomy. Explicit enum, never
/// derived (CLAUDE.md no-guessing rule). `Other` is the catch-all so the
/// agent has somewhere to put a fact that doesn't fit the four named
/// categories.
enum MemoryFactCategory {
  Tone
  Workflow
  Scope
  Schedule
  Other
  /// WARP-1118 (D-9) — business-knowledge facts extracted by the
  /// onboarding interview. Added in its own migration
  /// (20260708000000_warp_1118_memory_fact_business); a new Postgres enum
  /// value cannot be USED in the same transaction that adds it, so nothing
  /// references `Business` inside that migration. The five-value vocabulary
  /// is hardcoded across ≥6 sites (extract/recall handlers, routes/memory.ts
  /// zod, dashboard) and is threaded through them in Phase 2, not here.
  Business
}

/// WARP-1118 — AI Personality & Business Onboarding (§11).
///
/// PRIVACY CONTRACT: like `Workspace.industry/size`, `AssistantPersona`,
/// `BusinessProfile`, and interview transcripts are LOCAL box state —
/// NEVER sent off the box. Personality is prompt + data only; it never
/// changes which `LLM_MODEL` runs (One-Model Rule, §5-1).

/// The four canonical personality presets. Prompt fragments live in code
/// (`persona-presets.ts`), versioned with the app — the DB only stores
/// which one is selected. Copy owned by the design brief §9.
enum PersonaPreset {
  warm_friendly // default
  professional_precise
  founder
  direct_technical
}

/// Reply + recap length. One trait deliberately covers both — there is no
/// separate recap-length field (§7.1).
enum PersonaVerbosity {
  concise
  balanced // default
  detailed
}

/// Workspace-level personality singleton (D-2). Injected as a
/// char-budgeted block into the base system prompt right after identity
/// (§7.2). Read fresh from Prisma each request — no cache to invalidate.
model AssistantPersona {
  id                 String           @id @default("singleton")
  preset             PersonaPreset    @default(warm_friendly)
  verbosity          PersonaVerbosity @default(balanced)
  useFirstNames      Boolean          @default(true)
  /// The one sanctioned free-text instruction channel (§7.1). Owner/admin
  /// authored only. Cap enforced BOTH in the zod schema and as a real DB
  /// constraint so an out-of-band writer can't exceed the prompt budget.
  customInstructions String           @default("") @db.VarChar(1200)
  updatedBy          String? // userId
  updatedAt          DateTime         @updatedAt
}

/// Onboarding-interview state (§9.2). Explicit enum — state is NEVER
/// derived from row-absence or a null timestamp (§5-2, WARP-218 precedent).
enum BusinessOnboardingState {
  not_started
  in_progress
  completed
  skipped
  re_running // re-run in flight; skip or interview-chat deletion restores completed
}

/// Provenance for the Settings meta line — which surface last wrote the
/// profile. Explicit column, never inferred (§5-2).
enum BusinessProfileSource {
  onboarding
  settings
}

/// Periodic refresh-nudge state (Phase 4). Explicit column — dismissal is
/// a real write, never "we nulled the timestamp" (§5-2).
enum ReviewNudgeState {
  none
  due
  dismissed
}

/// Structured business-knowledge singleton (D-2, §8/§11). Created in
/// Phase 0 so the schema is stable; only `AssistantPersona` is wired into
/// the prompt this phase — the role-filtered business block is Phase 2.
///
/// Field set matches the design brief's six row labels 1:1 (no `hours`
/// column — operating hours belong in `typicalDay` or a `Schedule` fact).
/// `Workspace.industry/size` stay wizard-owned; this model never writes
/// them.
model BusinessProfile {
  id                String                  @id @default("singleton")
  onboardingState   BusinessOnboardingState @default(not_started)
  /// The persisted onboarding-interview session this profile was built
  /// from (D-4/§9.2). SetNull on delete: deleting the interview session
  /// must not cascade the singleton profile away — the delete-hook
  /// transitions state instead (Phase 3).
  interviewChat     ChatSession?            @relation(fields: [interviewChatId], references: [id], onDelete: SetNull)
  interviewChatId   String?                 @unique
  summary           String                  @default("") @db.VarChar(1500) // prompt-injected (business block, Phase 2)
  whatWeDo          String                  @default("") @db.VarChar(600)
  customers         String                  @default("") @db.VarChar(600)
  teamShape         String                  @default("") @db.VarChar(600)
  toolsUsed         String                  @default("") @db.VarChar(600)
  typicalDay        String                  @default("") @db.VarChar(600)
  goals             String                  @default("") @db.VarChar(600)
  lastSource        BusinessProfileSource? // provenance for the Settings meta line
  reviewNudgeState  ReviewNudgeState        @default(none) // explicit, never derived
  reviewDueAt       DateTime? // schedule timestamp only
  reviewDismissedAt DateTime?
  updatedBy         String?
  updatedAt         DateTime                @updatedAt
}

/// WARP-2748 (ADR-051) — the DERIVED half of the company's self-knowledge.
///
/// `BusinessProfile` above is what a human TYPED about the business: 1,500
/// characters, written once by an onboarding interview, never refreshed from
/// the company's own data. `BrainDigest` is what the box WORKED OUT by reading
/// that data, one bounded pass at a time, and it accumulates.
///
/// WHY A TABLE AND NOT A BIGGER PROMPT. The shipped window is 16,384 tokens
/// (`config.ts` OLLAMA_CONTEXT_LENGTH); a turn spends ~2,950 on fixed blocks
/// plus ~3,426 on tool schemas, every tool result is capped at 8,000 chars by
/// a Zod `.max(8000)` an operator cannot raise, and the in-loop guard
/// force-finalizes past 13,824 tokens. That is ~40-45 KB of readable text per
/// turn against a corpus five orders of magnitude larger. A question therefore
/// CANNOT scan the company; it reads rows a scheduled run wrote earlier. The
/// scan is offline and incremental, the read is cheap and always in budget.
///
/// WORKSPACE-WIDE, NO `workspaceId`. `Workspace` is a singleton (`id = 1`, and
/// its own docstring calls it "the company brain"), so these rows follow the
/// `MemoryFact` precedent and carry no workspace column. Visibility is `scope`
/// plus the reader's role, not a tenancy key.
///
/// PROVENANCE IS NOT OPTIONAL. `sources` is a non-empty JSON array enforced by
/// a CHECK in the migration, not by application code. A digest nobody can
/// trace back to a document is a hallucination that has been given a row id,
/// which is strictly worse than having no row: it reads as fact, it survives
/// restarts, and it gets prompt-injected. The constraint is the feature.
model BrainDigest {
  id String @id @default(uuid())

  kind BrainDigestKind

  /// Short human-readable claim. `body` is length-capped so N rows fit the
  /// fixed prompt block without the assembler truncating mid-row — the
  /// `MemoryFact` MEMORY_FACTS_CHAR_BUDGET posture, applied at write time
  /// instead of at splice time.
  title String @db.VarChar(200)
  body  String @db.VarChar(1200)

  /// A LOOSE pointer, deliberately without a foreign key — the posture
  /// `EntityLink` takes toward `File`, for the same reason plus one more.
  ///
  /// (1) Not every subject has a local row. An obligation found in a lease, a
  /// theme across twenty documents, a project that exists only as a folder
  /// nobody turned into a `PmProject` — these are exactly the things this
  /// table exists to surface, and an FK would reject all of them.
  /// (2) Evidence outlives its subject. A deleted deal's digest is still a
  /// true statement about what happened; cascading it away destroys the record
  /// of why a finding was ever raised.
  ///
  /// So a subject pointer CAN dangle, and the UI shows that. No column
  /// pretends to track liveness: a `subjectState` nothing maintains is a
  /// column that always lies (the `EntityLink.fileState` ruling).
  subjectType BrainSubjectType?
  subjectId   String?

  /// Non-empty JSON array of `{sourceKind, sourceId, quote}`. See the CHECK
  /// `BrainDigest_sources_not_empty` in the migration — the emptiness rule is
  /// a database constraint on purpose, so a detector with a bug cannot write
  /// an unfalsifiable row.
  sources Json

  /// Integer 0-100, NOT a 0..1 float — matching `EntityLink.confidence` and
  /// `CrmPipelineStage.probability`. Two confidence scales in one schema is
  /// how a 0.85 gets rendered as "85%" beside an 85 rendered as "8500%".
  confidence Int?

  /// Which corpus scope this was derived FROM, and therefore the widest
  /// audience it may be shown TO. A `company` digest must never surface to a
  /// `family` or `guest` reader: the enforcement point is this column, because
  /// the corpus that produced the row is the only thing that knows.
  scope BrainScope @default(personal)


  /// WARP-2752 — WHOSE personal row this is. Required exactly when `scope` is
  /// `personal`, and forbidden otherwise (`*_personal_scope_needs_owner`).
  ///
  /// Without it `personal` was UNENFORCEABLE: neither table had an owner
  /// column, so `visibleScopeFilter` OR'd in `{ scope: "personal" }` for every
  /// caller and every user saw every other user's personal rows — the exact
  /// opposite of what the `BrainScope` docstring promises. An enum value
  /// nothing can enforce is the same defect as a column nothing maintains, and
  /// this is the second time that rule bit this schema.
  ///
  /// LOCAL `User.id` UUID, never a Nextcloud username — the IDOR ruling
  /// `FileComment` paid for. Cascade: it is an ACCESS-CONTROL key, and an
  /// access key that dangles is a leak.
  owner   User?   @relation("BrainDigestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?

  /// WHICH department, when `scope` is `department`. Required exactly then
  /// (`BrainDigest_department_scope_needs_id`), because a department-scoped row
  /// with no department is unenforceable: the reader check is "is this person a
  /// member of THAT groupfolder", and there is nothing to ask about. An enum
  /// value nothing can enforce is the same defect as a column nothing maintains.
  ///
  /// Cascade, unlike the loose subject pointer above. This one is an
  /// ACCESS-CONTROL key, and an access key that dangles is a leak: a digest
  /// naming a deleted department would fall through the membership test.
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String?

  /// Accumulation and decay. A re-run over unchanged input advances
  /// `lastConfirmedAt` and writes nothing else; a superseding row points back
  /// here rather than deleting, so the reason a claim changed stays readable.
  firstSeenAt     DateTime @default(now())
  lastConfirmedAt DateTime @default(now())
  supersededById  String?

  /// The detector or pass that produced this. Lets one noisy producer be
  /// switched off without touching the others.
  detectorKey String

  /// The idempotency key, computed and stored by the service — NOT a compound
  /// `@@unique` over the nullable subject columns.
  ///
  /// READ THIS BEFORE "SIMPLIFYING" IT AWAY. `subjectType` and `subjectId` are
  /// null on every theme-shaped row, and Postgres never treats two rows as
  /// duplicates when an indexed column is NULL — so `@@unique([kind,
  /// subjectType, subjectId, detectorKey])` would reject nothing and P2002
  /// would never fire. `EntityLink` hit exactly this and paid for it with five
  /// partial unique indexes that `prisma.upsert` cannot address, forcing an
  /// updateMany-then-create retry at every call site. A single NOT NULL
  /// derived column makes the uniqueness real AND keeps `upsert` usable, which
  /// is precisely what an idempotent nightly loop needs.
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dedupeKey])
  @@index([kind, scope])
  @@index([subjectType, subjectId])
  @@index([scope, lastConfirmedAt(sort: Desc)])
  @@index([ownerId, scope])
  @@index([departmentId, scope])
  @@index([detectorKey])
}

/// WARP-2748 (ADR-051) — what the box thinks you should DO about what it read.
///
/// A digest is a claim; a finding is a claim with a consequence and a status a
/// human moves. They are separate tables because their lifecycles differ: a
/// digest is superseded silently as understanding improves, a finding is
/// acknowledged, actioned or dismissed BY SOMEBODY and that decision must
/// stick.
///
/// IDEMPOTENCY IS THE WHOLE DESIGN. `dedupeKey` (detector + subject) is what
/// makes the same overdue invoice on Tuesday UPDATE Monday's row instead of
/// creating a second one. Without it a nightly loop produces a growing pile of
/// near-duplicates, the operator mutes the feature inside a week, and a muted
/// feature is a deleted feature. This is the most likely way the brain fails in
/// production, and it is a schema problem rather than a prompt problem.
model BrainFinding {
  id String @id @default(uuid())

  kind BrainFindingKind

  title     String @db.VarChar(200)
  rationale String @db.VarChar(2000)

  /// Minor units plus currency, the `CrmDeal.amountMinor` shape, and NULLABLE
  /// on purpose. A finding without a number is still a finding ("this contract
  /// auto-renews in 9 days and nobody has looked at it"); a finding carrying a
  /// number the box invented is worse than one carrying none, so a detector
  /// that cannot compute an impact must leave it null rather than guess. The
  /// migration's `BrainFinding_impact_needs_currency` CHECK is the same
  /// all-or-nothing pairing as `CrmDeal_amount_needs_currency`.
  impactMinor BigInt?
  currency    String?

  /// Non-empty JSON `{digestIds, sources}`. Same rule and same reason as
  /// `BrainDigest.sources`, enforced by CHECK: a finding whose evidence array
  /// is empty must fail at the database, not merely look weak in review.
  evidence Json

  confidence Int?

  /// EXPLICIT status column, never derived from a timestamp being null — the
  /// no-guessing rule, canonical precedent WARP-218 `BrainMemoryItemStatus`.
  status BrainFindingStatus @default(new)

  /// Required when `status` is `dismissed` (`BrainFinding_dismissed_needs_reason`).
  /// A dismissal with no reason is indistinguishable from a bug in the
  /// detector, and the reason is the only thing that stops the same finding
  /// being raised again next week.
  dismissedReason String? @db.VarChar(500)

  /// LOCAL `User.id` UUID, never a Nextcloud username — the IDOR ruling
  /// `FileComment` paid for and `EntityLink.createdById` restates. SetNull:
  /// removing a person must not delete the business's findings.
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  detectorKey String

  /// See `BrainDigest.dedupeKey` — same reasoning, same NULL trap avoided.
  dedupeKey String

  scope BrainScope @default(personal)

  /// See `BrainDigest.ownerId` — same rule, same CHECK, same Cascade.
  owner   User?   @relation("BrainFindingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?

  /// See `BrainDigest.departmentId` — same rule, same CHECK, same Cascade.
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String?

  firstSeenAt     DateTime @default(now())
  lastConfirmedAt DateTime @default(now())

  /// WARP-2752 — when this finding was last TOLD to somebody.
  ///
  /// Without it an hourly pass re-notifies the same overdue invoice every hour
  /// forever, which is precisely how a nightly feature earns a mute. Null means
  /// "nobody has been told yet", and it is the queue the digest drains.
  /// Deliberately NOT derived from `status`: a finding can be acknowledged in
  /// the UI without ever having been pushed, and re-notifying it then would be
  /// telling someone what they just read.
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dedupeKey])
  /// Personal reads lead with the owner — "my open findings".
  @@index([ownerId, status])
  /// The notification queue: unnotified findings, newest first.
  @@index([notifiedAt, status])
  @@index([departmentId, status])
  @@index([status, kind])
  @@index([detectorKey, status])
  @@index([status, impactMinor(sort: Desc)])
  @@index([assigneeId, status])
  @@index([scope, status])
}

/// What a digest is ABOUT, structurally. `metric` and `theme` rows normally
/// carry no subject at all.
enum BrainDigestKind {
  entity
  project
  obligation
  theme
  metric
  relationship
}

/// Mirrors `EntityLinkSubject` and extends it with the two things a digest can
/// describe that a file-link cannot: a document and a bare file.
enum BrainSubjectType {
  COMPANY
  CONTACT
  DEAL
  PROJECT
  WORK_ITEM
  DOCUMENT
  FILE
}

/// The corpus a row was derived from, which bounds who may read it.
/// `personal` = one user's own space; `department` = a groupfolder its members
/// share; `company` = the household / whole-business corpus, owner+admin only.
enum BrainScope {
  personal
  department
  company
}

enum BrainFindingKind {
  loss
  risk
  inefficiency
  opportunity
  inconsistency
}

enum BrainFindingStatus {
  new
  acknowledged
  actioned
  dismissed
  stale
}

/// WARP-2749 (ADR-051) — the durable position of a brain pass.
///
/// ONE ROW PER PASS, and the row IS the cursor. A pass re-reads its own row on
/// every tick, works from `cursor` forward, and writes the new position back in
/// the SAME transaction as the rows it produced. That is what makes a crash
/// mid-pass re-digest at most one unit instead of skipping one: there is no
/// window in which the cursor has moved but the output has not landed.
///
/// NOT AN `AgentRun`, and not a second scheduler. `AgentRun` is a durable LLM
/// conversation with a lease, a heartbeat and an iteration budget; this is a
/// bookmark. The deterministic detector pass needs no model call at all (see
/// `detectors/`), so giving it an AgentRun would buy a lease it does not need
/// and an inference slot it must not hold. The corpus pass, which DOES call the
/// model, still records its position here and runs under the one sanctioned
/// clock (`cronRuntime.scheduleInterval` with an advisory lock), because the
/// repo has exactly one scheduler and a guard test pins that.
///
/// COUNTERS ARE ON THE SURFACE ON PURPOSE. An operator who believes the brain
/// read everything on night one stops trusting it the first time it misses
/// something. `unitsSeen` / `unitsDigested` / `lastError` are what `/brief`
/// renders as coverage, so "three weeks to first-pass a 5,000-document corpus"
/// is a visible fact rather than a footnote in a brief nobody opened.
model BrainPass {
  /// Stable identifier for the pass, e.g. "detectors" or "corpus.documents".
  /// Primary key: exactly one row per pass, upserted at boot, so a pass can
  /// never accidentally run two positions in parallel.
  passKey String @id

  /// Opaque, pass-defined. The corpus pass stores an "updatedAt|id" watermark
  /// (a bare timestamp loses rows that share a millisecond — the WARP-2743
  /// pagination bug, avoided here rather than relearned). The detector pass
  /// stores nothing: it is a set of deterministic queries over landed rows and
  /// re-running it is the point, so it has no position to keep.
  cursor String?

  /// Explicit enable switch, never derived from absence. A pass that is off
  /// must look different from a pass that has never run — the no-guessing
  /// rule, canonical precedent WARP-218 `BrainMemoryItemStatus`.
  enabled Boolean @default(true)

  lastRunAt      DateTime?
  lastSucceededAt DateTime?
  /// Cleared on every success. A stale error string on a healthy pass is the
  /// same lie as a status column nothing resets.
  lastError      String?  @db.VarChar(1000)

  /// Cumulative coverage counters, for the /brief coverage line.
  unitsSeen     Int @default(0)
  unitsDigested Int @default(0)
  rowsWritten   Int @default(0)

  /// WARP-2837 — the LEASE, and the reason it exists.
  ///
  /// The corpus pass was registered with cron-runtime's `lockKey`, which runs
  /// the handler inside `prisma.$transaction(..., { timeout: 60_000 })`. That
  /// handler makes up to ten sequential model calls on a box with one
  /// inference slot and no turn-level timeout. Ten CPU inferences do not fit
  /// in sixty seconds, and when the transaction expired the advisory lock was
  /// released MID-RUN while the pass kept going — its writes use the outer
  /// client, so they had already committed out of band.
  ///
  /// `agent-run-worker.service.ts` reached this conclusion first and states
  /// it: the transaction-scoped lock is "exactly right for a tick and exactly
  /// wrong for a forty-minute run". So exclusion moves off the lock and onto
  /// these columns: a conditional `updateMany` wins the row or does not, and
  /// the pass then executes OUTSIDE any transaction.
  ///
  /// An explicit enum, never a `claimedAt IS NULL` — the repo's standing rule,
  /// and the one that keeps "idle" distinguishable from "claimed by a process
  /// that has since died".
  runState BrainPassRunState @default(idle)

  /// Which process holds the lease, and the FENCE the lease's own writes ride:
  /// `beatPass` and `releasePass` both condition on this still being their own
  /// worker id, so a process whose claim was reclaimed learns it at its next
  /// beat instead of releasing the SUCCESSOR's claim on the way out.
  ///
  /// SCOPE, stated so nobody reads more into the column than it does: the
  /// fence covers the LEASE. It does not yet cover the cursor and counter
  /// writes `runCorpusPass` makes DURING a run — those key on `passKey`
  /// alone (brain-corpus.service.ts), so a worker stalled past the lease
  /// window can still write over its successor. Fencing those means the pass
  /// has to STOP when it finds its claim gone mid-run, which is a behaviour
  /// change to the pass rather than a column, and is tracked as its own change.
  claimedBy   String?
  /// When the current run started. Rendered as "running since" rather than
  /// inferred from `lastRunAt`, which means "last STARTED" and keeps moving.
  claimedAt   DateTime?
  /// Beaten while the pass runs. A claim is stale — and reclaimable — once
  /// this is older than the lease window. Without it a process killed
  /// mid-corpus would wedge the pass forever, and `/coverage` reports
  /// `lastRunAt`, which is liveness-blind.
  heartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  /// The stale-lease predicate the claim rides.
  @@index([runState, heartbeatAt])
}

/// WARP-2837 — whether a pass is executing right now. Explicit, not derived
/// from a nullable timestamp: `claimedAt IS NOT NULL` cannot tell a live run
/// from a crashed one, and that distinction is the whole point of the lease.
enum BrainPassRunState {
  idle
  running
}

/// WARP-2838 (ADR-051 §9) — the owner's consent to the brain, as a row.
///
/// The corpus pass reads the business's own documents THROUGH THE MODEL, so
/// switching the brain on is a consent decision, not a tunable. Until this
/// table the only switch was `BRAIN_ENABLED` in the environment: read in one
/// place, written nowhere, absent from every deployment file — behind a
/// `/brief` empty state that told the owner to "turn the brain on" while
/// nothing in the product could. Same shape as WARP-2733, which fixed it for
/// auto-filing by giving the off state its own door.
///
/// SINGLETON by primary key, the `AutoFilingSetting` shape. A MISSING row means
/// nobody has consented and the resolver answers off. The row is never created
/// by a read: a consent record that exists because something looked at it is
/// not consent.
///
/// AN OPERATOR-SET `BRAIN_ENABLED` STILL WINS, in both directions, and this
/// table does not try to represent that — the environment is not state the box
/// owns. `brain-switch.service.ts` resolves the two, and refuses the write
/// rather than storing a value that would not be read.
model BrainSetting {
  id String @id @default("singleton")

  enabled Boolean @default(false)

  /// Who turned it on, server-stamped from the session — never from the body.
  /// Plain String and no FK, matching `AutoFilingSetting.enabledById`: the
  /// record of who consented has to outlive the account that gave it, and an
  /// FK with `SetNull` under the biconditional CHECK below would make deleting
  /// that user fail inside a statement naming a table nobody touched.
  enabledById String?
  enabledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// WARP-470 — 24 h WAN throughput time-series for §2.6 Network page.
///
/// A 60 s apscheduler tick in `services/routing/scheduler.py` polls
/// the WAN device counters via ubus, diffs against the previous
/// sample to compute bps, and POSTs the derived row into the
/// orchestrator via /api/network/throughput-sample.
///
/// `wanDownBps` / `wanUpBps` are BigInt because gigabit links can
/// briefly burst > 2³¹. Retention: a nightly cron prunes rows
/// older than 30 days alongside the existing daily-purge.
model NetworkThroughputSample {
  ts         DateTime @id @default(now())
  wanDownBps BigInt
  wanUpBps   BigInt

  @@index([ts(sort: Desc)])
}

/// WARP-468 — per-tick deltas of DNS queries blocked by the OpenWrt
/// adblock / blocklist layer, sampled by the routing service.
///
/// A 60 s apscheduler tick in `services/routing/dns_block_meter.py`
/// reads the cumulative blocked-query counter via ubus, diffs against
/// the previous reading to derive a per-tick delta, and POSTs the
/// delta into the orchestrator via /api/network/dns-block-sample. The
/// Network page §2.6 KPI strip sums these rows day-to-date for the
/// "DNS blocked today" chip.
///
/// `blockedCount` is Int (not BigInt like throughput's bps): a single
/// 60 s window cannot accumulate > 2³¹ blocked queries, so a count
/// delta fits comfortably in Int. Retention: a nightly cron prunes
/// rows older than 30 days alongside the existing daily-purge.
model DnsBlockSample {
  ts           DateTime @id @default(now())
  blockedCount Int

  @@index([ts(sort: Desc)])
}

/// WARP-304 / WARP-329: persisted message in a `ChatSession`. Stored in
/// order of `createdAt`; for the same millisecond the `id` (uuid) breaks
/// the tie.
///
/// `toolCalls` captures the assistant's tool-call requests on a turn so a
/// rehydrated thread can render the same chips the user saw live;
/// `toolCallId` ties a role=tool message back to the call it answered.
/// `turnId` is a client-supplied UUID that lets us drop duplicate writes
/// when a network retry resubmits the same turn. WARP-3193 PERF-9: enforced
/// by the partial unique index `ChatMessage_sessionId_turnId_role_key`
/// (`("sessionId","turnId","role") WHERE "turnId" IS NOT NULL`), SQL-only
/// because Prisma cannot express a partial index — see that migration.
///
/// WARP-329: `status` + `completedAt` enable save-on-send. A user message
/// is created with `status=completed` immediately on receipt; the matching
/// assistant message is created with `status=streaming` BEFORE the LLM
/// runs, then transitions to `completed` / `failed` / `aborted` when the
/// agent loop ends. A mid-turn refresh sees the user message + the
/// streaming-placeholder assistant row, and the WARP-329 MQTT signal
/// fires when an in-flight turn finishes so other tabs / future mobile
/// clients can update.
///
/// WARP-458: `reasoning` captures the per-turn deep-reasoning trace (the
/// model's internal "thinking" wrapped in `<reasoning>…</reasoning>` in
/// streamed output, or the native reasoning field on providers that
/// surface it separately). Only present on `role=assistant` rows. Always
/// persisted when the model emits one, regardless of the per-request
/// `captureReasoning` flag — that flag gates EMISSION on the wire, not
/// PERSISTENCE, so the dashboard can lazy-load reasoning on demand
/// without re-running the turn. Nullable because the vast majority of
/// turns do not carry reasoning content (small models, tool-only turns,
/// system messages).
model ChatMessage {
  id          String               @id @default(uuid())
  sessionId   String
  session     ChatSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  toolCalls   Json?
  toolCallId  String?
  turnId      String?
  status      ChatMessageStatus    @default(completed)
  completedAt DateTime?
  reasoning   String?
  /// WARP-904 — the model/provider actually used for THIS turn, distinct
  /// from `ChatSession.model`/`provider` (the conversation's original
  /// selection). A mid-conversation quick-switch changes these per turn
  /// going forward without touching earlier rows, giving each message its
  /// own audit trail. NULL on rows persisted before this column existed.
  model       String?
  provider    String?
  /// WARP-844 — user rating on an assistant turn (explicit column per the
  /// no-guessing rule). NULL = unrated. Feeds the admin RAG-eval loop.
  feedback    ChatMessageFeedback?
  /// WARP-3300 — what this row is. `message` is every ordinary turn;
  /// `agent_run_result` is a background run reporting back into the chat
  /// that started it (`meta` then holds {runId, status, title, summary,
  /// artifacts}). An explicit column, never inferred from `meta`.
  kind        ChatMessageKind      @default(message)
  meta        Json?
  createdAt   DateTime             @default(now())

  @@index([sessionId, createdAt])
  @@index([sessionId, turnId])
  @@index([sessionId, status])
}

/// WARP-2991 — the owner's answer to "send this conversation's earlier
/// on-box answers to the cloud model?". `not_asked` and `declined` both
/// replay the user's own messages only; the difference is audit, not effect.
enum CloudHistoryConsent {
  not_asked
  granted
  declined
}

/// WARP-3300 — see ChatMessage.kind.
enum ChatMessageKind {
  message
  agent_run_result
}

/// WARP-844 — thumbs rating on an assistant message.
enum ChatMessageFeedback {
  up
  down
}

/// WARP-329: lifecycle of a single ChatMessage row.
///   - `pending`   — user message that hasn't been dispatched yet (reserved
///                   for a future client-driven optimistic path; not used
///                   by the orchestrator route today).
///   - `streaming` — assistant message in-flight; `content` is being
///                   appended as SSE deltas arrive.
///   - `completed` — terminal: turn finished cleanly. `completedAt` set.
///   - `failed`    — terminal: agent loop errored. `completedAt` set.
///   - `aborted`   — terminal: client cancelled mid-stream. `completedAt`
///                   set; partial content preserved.
enum ChatMessageStatus {
  pending
  streaming
  completed
  failed
  aborted
}

/// What minted a DeviceClient row. EXPLICIT, never inferred from `deviceName`,
/// `deviceType` or the absence of pairing columns (CLAUDE.md no-guessing).
///   - app_pairing    — a native desktop/mobile app, via /api/devices/pair(/claim).
///   - personal_drive — a Finder / File Explorer WebDAV login, via
///                      POST /api/storage/network-drive/personal (WARP-3318).
/// Turning personal drives off revokes every active `personal_drive` row and
/// touches no `app_pairing` row.
enum DeviceClientKind {
  app_pairing
  personal_drive
}

// Per-user client devices (laptops, phones) paired via QR code flow.
// Distinct from the `Device` model, which tracks the Droplet hardware itself.
model DeviceClient {
  id            String   @id @default(uuid())
  userId        String // Nextcloud username
  deviceName    String // "Alice's MacBook"
  deviceType    String // "desktop" | "mobile"
  platform      String // macos|windows|linux|ios|android
  appVersion    String?
  // Who minted this row — see DeviceClientKind. Rows that predate the column
  // default to app_pairing (see the migration for why they are not backfilled).
  kind          DeviceClientKind @default(app_pairing)
  // Encrypted Nextcloud app password (aes-256-gcm). Format: iv||tag||ciphertext
  // base64-encoded. Never exposed to clients after the initial pairing response.
  ncAppPassword String
  lastSeen      DateTime @default(now())
  status        String   @default("active") // "active" | "revoked"
  createdAt     DateTime @default(now())

  // ── WARP-1298: client-dispatched-actions metadata (ADR-014 §37–39, §③) ──
  // Foundation columns for the desktop tool-host (WARP-350 epic). Additive
  // and default-safe; the WS bridge, signature-verify, and tool catalog that
  // consume them land in WARP-353/354. Romain chose this shape (Option B on
  // WARP-352) on 2026-07-12 — the original WARP-352 model had no column for
  // the client public key, which was the concrete blocker on WARP-353.

  // WS-liveness heartbeat, distinct from the coarse `lastSeen` above. WARP-354
  // catalog membership requires this to be within 90s (ADR-014 §37). Null until
  // the client first connects to the WS bridge.
  lastSeenWsAt     DateTime?
  // Per-tool consent map ({ [tool]: "allow" | "confirm" | "block" }). DEFAULT-
  // DENY (ADR-014 §③): empty map = nothing reachable until the user opts in per
  // tool from the menu-bar AI-permissions surface. Pairing grants presence, not
  // capability.
  toolConsent      Json      @default("{}")
  // Client family advertised at pair time: desktop_macos | desktop_windows |
  // ios | android | web. Distinct from the existing deviceType/platform axes.
  // Null until a pairing flow populates it (WARP-353+).
  clientKind       String?
  // Capability list the client declares at pair time. Default empty array.
  toolCapabilities Json      @default("[]")
  // The paired client's ed25519 public key (base64/hex wire form, stored as
  // text). WARP-353 verifies `tool_response` signatures against it. @unique
  // follows the VpnPeer.publicKey precedent: the key is the client identity,
  // so a revoked client must not be able to re-pair its old key.
  clientPublicKey  String?   @unique

  @@index([userId])
  @@index([status])
  // WARP-354 catalog query: this user's rows with a recent WS heartbeat.
  @@index([userId, lastSeenWsAt])
}

// ── WARP-217: Token-based user invitations ──
// Admin-issued, single-use, time-limited tokens that let an invitee set
// their own password through `/invite/<token>` instead of having the admin
// type a password and hand it off out-of-band. The state machine is:
//   Pending  →  Accepted   (POST /api/auth/invites/accept/:token w/ password)
//   Pending  →  Expired    (now() > expiresAt)
//   Pending  →  Revoked    (admin DELETE /api/auth/invites/:token)
// Once a token transitions out of Pending it is dead — no re-use, no resurrect.
// Tokens are URL-safe base64 (`base64url` of 32 random bytes), compared in
// constant time. See PairingCode for the closest precedent.
model UserInvite {
  id           String    @id @default(cuid())
  token        String    @unique
  username     String
  displayName  String?
  email        String?
  // WARP-171: persistent role state lives in an explicit enum column
  // (CLAUDE.md no-guessing rule). The enum is the single source of truth
  // shared with the TS `Role` union in src/services/jwt.service.ts;
  // any drift between them is a schema bug. The invite-accept route
  // (auth.ts) maps `admin` invitee → `owner` session role and
  // `family` invitee → `family` session role for backwards-compat with
  // the pre-WARP-171 two-value contract; widening that mapping is a
  // separate ticket.
  role         Role      @default(family)
  createdBy    String // username of issuing admin
  // WARP-3263: the issuing admin's User.id, copied to User.invitedById at
  // accept. No FK: an audit pointer that must not block invite creation;
  // accept checks the row still exists before copying it. Null on invites
  // issued before this column existed.
  createdById  String?
  expiresAt    DateTime
  // WARP-3193 QUAL-3: the lifecycle is this column, not the absence of the
  // timestamps below (CLAUDE.md no-guessing rule; WARP-218
  // BrainMemoryItemStatus is the precedent). Each writer sets it in the same
  // statement that stamps acceptedAt / revokedAt. See enum InviteStatus.
  status       InviteStatus @default(pending)
  acceptedAt   DateTime?
  acceptedFrom String? // ip address (optional, audit)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  // BUG-11 — invite-email delivery state. Issuing an invite WRITES the row;
  // delivering the accept-link email is a separate, fallible step over the
  // operator's SMTP relay (EmailChannelSetting). Per the no-guessing rule
  // (CLAUDE.md): delivery is an explicit enum column, NOT derived from a
  // nullable timestamp — `sendStatus = 'failed'` is a first-class, queryable,
  // retryable state. A send that fails NEVER rolls back the invite (the row is
  // still valid and the link still works if delivered out-of-band); the
  // dashboard surfaces `failed` with a Retry affordance.
  sendStatus   InviteSendStatus @default(pending)
  sentAt       DateTime?
  sendError    String? // last SMTP error (operator-facing; never the token)
  sendAttempts Int              @default(0)

  // WARP-1255: department rights granted by this invite (user will have these
  // rights in each listed department once the invite is accepted).
  departmentGrants UserInviteDepartment[]

  // ADR-032 / WARP-1525 (RBAC v2): custom access role granted by this invite.
  // Null = plain tier invite (today's world). The accept path assigns it in
  // the same mint transaction (T9, the WARP-1051 pattern). onDelete Restrict:
  // deleting a role blocks on ANY invite row that references it — pending,
  // accepted, revoked, or expired alike (invite rows are retained state via
  // acceptedAt/revokedAt, never deleted) — so an invitee's intended access
  // can never silently degrade to the bare tier and role deletion stays an
  // explicit service-layer flow ("reassign first", T3).
  accessRoleId String?
  accessRole   AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)

  @@index([token])
  @@index([expiresAt])
  @@index([sendStatus])
  @@index([status])
}

/// WARP-3193 QUAL-3 — invite lifecycle, replacing the derivation over
/// acceptedAt / revokedAt / expiresAt that every reader used to repeat.
///   - pending  — issued, acceptable. `expiresAt` stays authoritative for the
///                deadline: readers reject an overdue pending row in real
///                time; the daily 03:00 sweep writes pending→expired
///                (PairingCodeStatus precedent).
///   - accepted — consumed by the accept route (acceptedAt stamped with it).
///   - revoked  — revoked by an admin or the owner-invite boot sweep
///                (revokedAt stamped with it).
///   - expired  — past `expiresAt`, stamped by the daily sweep.
enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

/// BUG-11 — invite-email delivery lifecycle. Mirrors the EmailDraftStatus
/// pattern (draft → queued → sent → failed) but for the outbound INVITE
/// channel. Explicit enum so "this invite's email bounced" is a queryable
/// state the dashboard can filter + retry, never inferred from a null
/// `sentAt`. Values:
///   - pending — row created, email not yet attempted (or SMTP unconfigured).
///   - sent    — SMTP relay accepted the message for delivery.
///   - failed  — the relay rejected it / transport errored; retryable.
enum InviteSendStatus {
  pending
  sent
  failed
}

/// WARP-171: canonical role enum for the orchestrator. Mirrors the
/// `Role` TS union in `src/services/jwt.service.ts` one-to-one so a
/// session role can be persisted without coercion. Replaces the legacy
/// free-form `String @default("user")` column on `UserInvite` (the
/// only persistent role column in the schema today — users themselves
/// live in Nextcloud and are surfaced via OCS, not in a local table).
///
/// Values:
///   - owner   — install-time first admin; full control including
///               service-restart endpoints.
///   - admin   — household admin; auth/user mgmt, network, VPN, DDNS.
///   - family  — regular household member; cameras, matter, files.
///   - guest   — read-only family-tier; can only act on their own LLM
///               sessions.
///   - service — internal service principal (voice-io, mcp-server);
///               read-only on every guarded write route (see
///               docs/ADR-004 §3 matrix).
enum Role {
  owner
  admin
  family
  guest
  service
}

/// WARP (SCIM directory sync) — soft-deactivation lifecycle for a directory
/// user. An explicit enum column (NOT derived from a NULL / row-delete) so
/// "this account is disabled" is a first-class, queryable state and the
/// login path can fail closed on it. SCIM `active:false` (PATCH/PUT) and
/// DELETE map to DEACTIVATED; SCIM `active:true` re-activates. We never hard
/// delete a SCIM-provisioned user — Okta owns the lifecycle and may
/// re-activate the same person later (re-link must preserve User.id).
///   - ACTIVE      — normal; can sign in, counts against the directory.
///   - DEACTIVATED — disabled by the directory; denied at /auth/login and
///                   SSO callback, retained for audit + possible re-activate.
enum DirectoryUserStatus {
  ACTIVE
  DEACTIVATED
}

// WARP-3113 — see User.deletionStatus. WARP-3169: HANDING_OVER is a
// hand-over's claim while its file transfer runs.
enum UserDeletionStatus {
  NONE
  PENDING
  PURGING
  HANDING_OVER
}

// WARP-2858 — how a User row came to exist. LOCAL: /auth/setup, admin
// create, invite accept (the box owns the credential). SSO: just-in-time
// created by an OIDC sign-in (sso.ts). SCIM: pushed by the IdP's directory
// sync (scim.service.ts provisionUser).
enum UserProvisionSource {
  LOCAL
  SSO
  SCIM
}

/// WARP-1202: explicit pairing-code lifecycle. Persistent state lives in this
/// enum column, never inferred from a `used` boolean + `expiresAt` comparison
/// + `claimedBy` nullability (CLAUDE.md "no guessing"; WARP-218
/// BrainMemoryItemStatus is the precedent).
///   - active  — issued, claimable. `expiresAt` stays authoritative for the
///               deadline: readers reject an overdue active row in real time;
///               the daily 03:00 sweep writes the active→expired transition.
///   - claimed — consumed by /pair/claim; `claimedBy` = DeviceClient.id.
///   - expired — past `expiresAt`, stamped by the daily sweep.
///   - revoked — reserved for operator invalidation (no writer yet).
/// Terminal rows (claimed/expired/revoked) are purged by the daily 03:00
/// cron after a retention window (WARP-1203), keyed on this status.
enum PairingCodeStatus {
  active
  claimed
  expired
  revoked
}

// Short-lived codes generated by the dashboard, consumed by a native
// client on first pairing. Each code is single-use and expires in 10 min.
model PairingCode {
  id        String            @id @default(uuid())
  code      String            @unique
  userId    String // issuer
  expiresAt DateTime
  status    PairingCodeStatus @default(active)
  claimedBy String? // DeviceClient.id
  createdAt DateTime          @default(now())

  @@index([code])
  @@index([expiresAt])
  // WARP-1203: purge-sweep selection key (terminal status + retention age).
  @@index([status, createdAt])
}

model CommandAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  entityId  String
  domain    String
  service   String
  data      Json?
  tier      Int
  confirmed Boolean  @default(false)
  blocked   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([userId, createdAt])
  @@index([domain, createdAt])
}

model NetworkConfigSnapshot {
  id        String   @id @default(cuid())
  userId    String?
  config    String // "network", "wireless", "firewall", "dhcp"
  snapshot  Json // UCI config state before change
  operation String
  createdAt DateTime @default(now())

  @@index([config, createdAt])
}

/// WARP-825: lifecycle of a factory-reset job (Settings Danger Zone).
///
/// Status is an EXPLICIT enum, never inferred from the absence of a column
/// (handbook rule 10 / project CLAUDE.md "no guessing"; precedent WARP-218
/// BrainMemoryItemStatus, BUG-3 PoolStatus). A reset is high-blast-radius:
/// it wipes every data volume + secrets and bounces the orchestrator
/// container itself, so the orchestrator can NEVER report "succeeded" — the
/// process is gone before the wipe finishes. Honest states are therefore:
///   requested  — owner confirmed; audit row written; about to dispatch.
///   dispatched — handed to the device-bridge host executor; the wipe is
///                running detached from the orchestrator (which will die).
///   failed     — the dispatch itself failed (bridge unreachable / refused)
///                BEFORE anything was wiped. The box is untouched and usable.
/// There is deliberately no `succeeded`: a completed reset returns the box to
/// first-run, where this table no longer exists (the db volume is wiped). The
/// dashboard treats `dispatched` as terminal-success for its progress view.
enum ResetJobStatus {
  requested
  dispatched
  failed
}

/// WARP-825: one factory-reset attempt. At most ONE row may be in a
/// non-terminal (`requested` or `dispatched`) state at a time — the
/// double-fire guard (a second confirmed reset while one is in flight is
/// refused). `confirmToken` is the device name the owner typed to clear the
/// type-to-confirm friction step; it is validated SERVER-side before a row is
/// ever created, and stored only for the audit trail. No host-specific
/// default for the target name (handbook rule 12) — it is read from device
/// identity at request time.
model ResetJob {
  id            String         @id @default(cuid())
  status        ResetJobStatus @default(requested)
  /// User.id (UUID) of the owner who confirmed. Never null in practice — the
  /// route is requireRole("owner") — but nullable so an orphaned audit write
  /// never blocks on a missing session id.
  requestedBy   String?
  /// The device/host name the reset targets + that the owner had to type to
  /// confirm. Recorded for the audit trail.
  targetName    String
  /// Set when status transitions to `failed`; the human-readable dispatch
  /// failure (bridge unreachable / refused). Null while requested/dispatched.
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
}

// --- Camera / Frigate NVR ---

model Camera {
  id             String   @id @default(uuid())
  /// The camera's FRIGATE KEY, not a label (WARP-3506): always the output of
  /// `toFrigateKey()` (apps/orchestrator/src/services/camera-key.ts) — lower
  /// case, [a-z0-9_] only. It names the recording directory, keys Frigate's
  /// events and roots the MQTT topic tree, so DB↔Frigate joins are plain
  /// string equality. What the operator typed lives in `displayName`.
  name           String   @unique
  displayName    String
  manufacturer   String?
  model          String?
  ipAddress      String
  macAddress     String?
  /// Operator toggle (detection on/off). Says NOTHING about adoption — that
  /// is `adoption` below (WARP-3510).
  enabled        Boolean  @default(true)
  autoDiscovered Boolean  @default(false)
  /// WARP-3510 — is this row a real camera, or a discovery candidate?
  /// An explicit state, never inferred from `enabled` (an operator-disabled
  /// live camera is `enabled = false` and still ADOPTED). Discovery merges
  /// rank ADOPTED rows first and only ever delete or rename CANDIDATE rows;
  /// a Frigate key owned by an ADOPTED row is never pruned.
  adoption       CameraAdoption @default(CANDIDATE)
  lastSeen       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // WARP-1851 — storage allocation.
  //
  // `retentionMode` is an EXPLICIT enum rather than "budget is null =
  // manual", per CLAUDE.md's no-guessing-from-absence rule. The two are
  // not redundant: an operator can clear a budget while the column keeps
  // the last value, and MANUAL must win unambiguously in that case.
  //
  // MANUAL — retention days are whatever the operator set on the camera
  //          settings page. Nothing derives them.
  // BUDGET — `storageBudgetBytes` is authoritative; the reconciler derives
  //          retention days from it and the camera's measured bitrate, and
  //          writes those days into Frigate's config.
  retentionMode      CameraRetentionMode @default(MANUAL)
  /// Target bytes of recordings for this camera. Only meaningful when
  /// retentionMode = BUDGET. BigInt because a multi-TB budget overflows Int.
  storageBudgetBytes BigInt?
  /// The operator's PREFERRED retention windows — the ceiling the budget
  /// controller scales down from and grows back toward:
  ///   { continuous, motion, alerts, detections }  (days)
  ///
  /// Needed because enforcement is a feedback loop, not a formula. Without a
  /// remembered ceiling the controller cannot tell "I reduced this to fit the
  /// budget" from "the operator wants it low", so it could never restore
  /// retention after the camera's usage drops.
  ///
  /// A window recorded as 0 stays 0 forever: scaling never ENABLES a window
  /// the operator has switched off. That is what made the first cut of this
  /// feature turn 24/7 recording on when asked to cap storage.
  ///
  /// Null while retentionMode = MANUAL, and captured from the camera's live
  /// Frigate config the moment a budget is set.
  retentionCeiling   Json?

  notifications CameraNotificationPref[]
  groupMembers  CameraGroupMember[]
  accessGrants  CameraAccessGrant[]
}

/// WARP-1962 — who may see THIS camera.
///
/// Role tiers (WARP-1961) answer "may this person watch recordings at all".
/// They cannot answer "may this person watch THE BEDROOM", which is the
/// actual household question: a `family` member who should see the front
/// door and the driveway otherwise sees every camera in the house.
///
/// Deliberately a GRANT table, not a deny-list, and access is an explicit
/// ROW rather than something inferred from a null — same rule that made
/// `Camera.retentionMode` an enum instead of "budget is null = manual".
///
/// The default for a camera with no grants is therefore: owner/admin always
/// (they administer the appliance), everyone else DENIED until granted. So
/// adding a camera never silently exposes it to the whole household — the
/// safe direction to be wrong in.
model CameraAccessGrant {
  id        String   @id @default(uuid())
  userId    String
  cameraId  String
  createdAt DateTime @default(now())
  /// User id of whoever granted it, for the audit trail. Nullable so a
  /// seed or migration-created grant doesn't have to invent an actor.
  grantedBy String?

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([userId, cameraId])
  @@index([userId])
  @@index([cameraId])
}

/// WARP-3510 — whether a Camera row is a camera the operator (or discovery's
/// verified auto-add) put into Frigate, or a device discovery merely found.
enum CameraAdoption {
  /// Found on the network, not yet in Frigate. A placeholder: discovery may
  /// rename, merge or delete it.
  CANDIDATE
  /// In Frigate and owned by the operator. Never renamed, merged away or
  /// pruned by discovery.
  ADOPTED
}

/// WARP-1851 — how a camera's retention window is decided.
enum CameraRetentionMode {
  /// Operator sets retention days directly.
  MANUAL
  /// Retention days are derived from a byte budget + measured bitrate.
  BUDGET
}

model CameraNotificationPref {
  id        String  @id @default(uuid())
  userId    String
  cameraId  String
  camera    Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  onPerson  Boolean @default(true)
  onVehicle Boolean @default(true)
  onAnimal  Boolean @default(false)
  onMotion  Boolean @default(false)

  @@unique([userId, cameraId])
}

// ── Camera groups ──
//
// Operator-defined logical groupings rendered as a navigation rail above
// the cameras grid (e.g. "Front of house", "Backyard", "Inside"). A camera
// can belong to multiple groups; a group can contain zero cameras (so a
// freshly-created group survives until the operator populates it).
//
// Membership is its own row rather than a ManyMany list so we can carry
// per-group sortOrder and so deletion of either side cascades cleanly.
model CameraGroup {
  id        String              @id @default(uuid())
  name      String              @unique
  // Optional emoji or short string the dashboard renders in the rail
  // tile. Kept as plain text so the operator can use any character set
  // their keyboard supports — no fixed icon-set lock-in.
  icon      String?
  // Display order across the rail, lower = earlier. Mutable via PATCH.
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  members   CameraGroupMember[]
}

model CameraGroupMember {
  id        String      @id @default(uuid())
  groupId   String
  cameraId  String
  // Display order within the group, lower = earlier.
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  group     CameraGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  camera    Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([groupId, cameraId])
  @@index([groupId])
  @@index([cameraId])
}

// ── Camera pins ──
//
// Per-user "pinned to top" preferences for the cameras grid. Operators
// pin the cameras they actually watch (porch, baby monitor) so they
// always sit at the top of the grid even after dozens of cameras are
// added. Pins are pure preference data — we key them by Frigate camera
// NAME (not a Camera FK) to avoid the upsert dance for a feature that
// doesn't need referential integrity. If a camera is removed, the pin
// becomes a tombstone that the read-side filters out.
model CameraPin {
  id         String   @id @default(uuid())
  userId     String
  cameraName String
  // Order within this user's pin list, lower = earlier.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([userId, cameraName])
  @@index([userId])
}

// ── Web Push subscriptions ──
//
// One row per browser/PWA install that's subscribed to push. The
// dashboard's service worker calls `pushManager.subscribe()` and POSTs
// the resulting endpoint + keys here. Push dispatch reads from this
// table and fans out via the web-push library.
//
// Endpoint is unique because the same browser can only be subscribed
// once per VAPID public key. If a subscription returns 410 Gone on a
// dispatch, we delete it (the browser is uninstalled or the user
// revoked permission).
model PushSubscription {
  id             String    @id @default(uuid())
  /// Nextcloud username (`User.username`), never `User.id` (WARP-2911).
  username       String
  endpoint       String    @unique
  // Push payload encryption keys, base64url. Required by Web Push protocol.
  p256dhKey      String
  authKey        String
  // Optional FK to a paired DeviceClient — lets the operator see
  // which paired device a subscription belongs to. Nullable because
  // dashboard browsers subscribe without going through the pairing
  // flow.
  deviceClientId String?
  createdAt      DateTime  @default(now())
  // Updated on every successful push so we can age out stale entries.
  lastFiredAt    DateTime?

  @@index([username])
  @@index([deviceClientId])
}

// ── Phase 4: AI file content indexing (pgvector) ──
// Stores chunked text + embeddings for semantic file search.
// Requires CREATE EXTENSION IF NOT EXISTS vector; in the db.
//
// WARP-203 additions:
//   - `source` distinguishes Nextcloud-watcher chunks from chat-attached
//     "brain memory" chunks. Cosine search runs across both by default;
//     callers can filter to one source via `search_content`'s arg.
//   - `brainItemId` is set when source=brain so we can cascade-delete a
//     BrainMemoryItem and have its chunks go with it.
//   - `pageNumber` carries through PDF/DOCX page breaks so retrieval can
//     cite the exact page.
//   - `warnings` is the per-chunk extractor warnings list (e.g.
//     "low_confidence_ocr_page_3") — surfaced in citations so the UI
//     can de-prioritize / explain low-confidence hits.
model FileContentChunk {
  id          BigInt                     @id @default(autoincrement())
  userId      String // Nextcloud username
  ncFileId    Int // Nextcloud numeric file ID (0 when source=brain)
  path        String // Human-readable path for display
  chunkIdx    Int // 0-based chunk index within the file
  text        String // Raw text of this chunk
  // pgvector column — 384 dims for bge-small-en-v1.5 (WARP-2196; the
  // pre-WARP-2196 all-MiniLM-L6-v2 was also 384, which is why the swap
  // needed a re-embed rather than a column change — see
  // docs/RAG_RE_EMBED_RUNBOOK.md).
  // Prisma doesn't support vector natively; use Unsupported + raw SQL.
  //
  // WARP-2193 — the ANN index on this column is RAW SQL ONLY:
  // "FileContentChunk_embedding_hnsw_idx", USING hnsw (embedding
  // vector_cosine_ops), created in
  // 20260826120000_warp_2193_hnsw_vector_index. It cannot be declared below
  // with @@index, because Prisma has no way to express an index on an
  // Unsupported() column.
  //
  // Which means: `prisma migrate dev` reads it as DRIFT and will emit a
  // `DROP INDEX "FileContentChunk_embedding_hnsw_idx";` at the top of the
  // next generated migration, whatever that migration is about. DELETE THAT
  // LINE. This exact drift already ate the index once —
  // 20260425220000_add_camera_audit_snapshot_tables opens with a generated
  // drop of the IVFFlat index this replaced, nothing recreated it, and the
  // vector arm ran on sequential scans for four months without a single
  // failing test. src/__tests__/vector-index-migration.guard.test.ts replays
  // the migration chain so it cannot happen silently a third time.
  embedding   Unsupported("vector(384)")
  indexedAt   DateTime                   @default(now())
  source      FileContentSource          @default(nextcloud)
  brainItemId String?
  pageNumber  Int?
  warnings    String[]                   @default([])
  // WARP-214: free-form per-chunk metadata. Today carries:
  //   - chain[]            { filename, mime, parentItemId? }[] for email/archive recursion
  //   - subtitle_source    "asr_transcript" | "embedded" | "frame_ocr"
  // The orchestrator surfaces this verbatim on the /api/files/knowledge
  // routes; the dashboard renders breadcrumbs + source-channel badge from it.
  // Keep loose-typed Json so future extractors can add fields without
  // requiring a migration (e.g. WARP-208 frame OCR, WARP-207 diarization).
  metadata    Json?
  // WARP-286: generated tsvector column for lexical (BM25-style) search.
  // Read-only from the app side; computed by Postgres on insert/update.
  // Declared as Unsupported() because Prisma has no first-class tsvector type.
  // WARP-242: the generated expression NULLs the tsvector when
  // sensitivity=sensitive — a tsvector over dcv1 ciphertext would index
  // base64 garbage, and a plaintext-derived one would leak a stemmed
  // positional bag-of-words into every pg_dump, gutting crypto-shred.
  text_tsv    Unsupported("tsvector")?
  /// WARP-233 @encrypted(aes-256-gcm, dek=brain:<brainItemId>) when
  /// sensitivity=sensitive: `text` holds a dcv1: blob; excluded from the
  /// lexical (text_tsv) search arm; snippets are computed app-side post-decrypt.
  sensitivity ChunkSensitivity           @default(standard)

  @@unique([ncFileId, chunkIdx])
  @@index([userId])
  @@index([userId, source, indexedAt]) // recency dashboard query
  @@index([brainItemId])
  @@index([userId, sensitivity]) // WARP-233: lexical-arm sensitivity filter
}

enum FileContentSource {
  nextcloud
  brain
}

/// WARP-1139/WARP-1140 — explicit per-file indexing status for the
/// file-indexer's Nextcloud watcher corpus. Per the CLAUDE.md "no guessing"
/// rule (the WARP-218 convention): search surfaces must distinguish "not
/// indexed yet / skipped / failed" from "no match", which is impossible when
/// indexing state is derived from FileContentChunk row ABSENCE. Written by
/// services/file-indexer at each pipeline stage (indexing → ready | skipped |
/// failed); read by GET /api/files/search/status so the dashboard can render
/// an honest "still indexing" empty state.
///
/// `userId` follows the FileContentChunk convention: the Nextcloud username,
/// or the `__household__` sentinel for files in the shared groupfolder space.
/// `path` is the home-relative display path (e.g. "/Docs/report.pdf" or
/// "/Household/Trips/notes.txt") — same shape as FileContentChunk.path.
/// `reason` is non-null only when status is `failed` or `skipped` (mirrors
/// BrainMemoryItem.failureReason).
model FileIndexStatus {
  userId    String
  path      String
  ncFileId  Int?
  status    FileIndexState
  reason    String?
  updatedAt DateTime       @default(now())

  /// WARP-2056: which generation of the extractors produced this row
  /// (`extractors/registry.py EXTRACTOR_CAPABILITY`). A `skipped` verdict is
  /// only valid for the extractors that made it, so the reconcile retries
  /// rows stamped with an older generation instead of treating every skip as
  /// permanent. NULL = written before the column existed (treated as gen 1).
  extractorCapability String?

  /// ADR-048 (WARP-2729) — the filing ledger. These five columns make this row
  /// the queue: the durable row that already says "new content exists" carries
  /// its own claim, exactly as WARP-2587 put `notifyStatus` on the activity
  /// tables instead of adding an event table.
  ///
  /// 🔴 EVERY COLUMN HERE IS NULLABLE OR CARRIES A POSTGRES DEFAULT, and that is
  /// load-bearing rather than incidental. `services/file-indexer/db.py`
  /// `set_index_status` INSERTs this row naming its columns explicitly, so a
  /// column it never writes is filled by Postgres — no Python change, and no
  /// coupling between a Prisma migration and a file-indexer image release (an
  /// unknown column there kills ALL indexing, not just filing). Prisma's
  /// CLIENT-side defaults (`@default(uuid())`, `@updatedAt`) emit no DB default
  /// at all, so a NOT NULL column of that shape would break the Python INSERT —
  /// silently, because `watcher.py _set_status` swallows every DB exception at
  /// `logger.debug`.
  extractStatus    ExtractStatus  @default(pending)
  extractClaimedAt DateTime?
  extractAttempts  Int            @default(0)
  extractReason    ExtractReason?

  /// Terminal marker. A CHECK ties this to a terminal `extractStatus`, so a row
  /// can never sit forever-pending with a terminal status or vice versa.
  extractedAt DateTime?

  /// 🔴 The watermark the last extraction CONSUMED — not when it ran.
  ///
  /// `updatedAt` above is bumped by `set_index_status` on EVERY upsert, so
  /// `extractedFromUpdatedAt < updatedAt` is the re-index signal, computed
  /// entirely orchestrator-side. It is a separate column from `extractedAt`
  /// deliberately: writing `now()` there would overtake a bump that landed
  /// WHILE the worker held the claim, and that file could then never re-arm.
  /// The worker snapshots `updatedAt` at claim time and writes THAT value here.
  extractedFromUpdatedAt DateTime?

  /// Cheap content fingerprint (chunk count + hash of the first and last chunk
  /// text), compared before any model call. `updatedAt` is bumped by a TOUCH,
  /// not a change — `on_modified` fires on metadata-only events and the ON
  /// CONFLICT arm has no `WHERE`/`IS DISTINCT FROM` — so a `chown -R`, a restic
  /// restore, a desktop resync or an `occ files:scan` would otherwise re-extract
  /// the whole corpus. Unchanged fingerprint ⇒ `done/unchanged`, no LLM call.
  extractFingerprint String?

  @@id([userId, path])
  @@index([userId, status])
  @@index([extractStatus, updatedAt])
  // WARP-3193 PERF-15: the filing orphan sweep (filing/maintenance.ts) looks
  // rows up by ncFileId alone, which led no index.
  @@index([ncFileId])
}

/// ADR-048 — the filing claim state machine. Explicit enum, never derived from
/// a NULL (CLAUDE.md), and `not_needed` is a real terminal so a row is never
/// silently skipped into a forever-pending state — the `TeamChatMeetingReminder
/// Status { pending | sent | not_needed }` shape WARP-2587 proved.
enum ExtractStatus {
  pending
  running
  done
  skipped
  failed
  not_needed
}

/// Why a source reached a terminal state. An enum, never free text: a failure
/// class must be groupable and renderable, and free text is where filenames
/// (which are PHI, WARP-1983) leak into a column nobody screens.
enum ExtractReason {
  /// The classifier returned verdict RECORD. Terminal before any extraction.
  phi_record
  /// The path or filename tripped the deterministic denylist. The LLM was
  /// never called at all.
  phi_path
  not_business
  too_large
  bad_json
  model_unreachable
  /// The active model resolved to a non-local provider. Unattended work over
  /// stored documents is local, full stop — there is no owner opt-in.
  cloud_model_refused
  owner_unavailable
  out_of_scope
  ignored_by_you
  stale_claim
  /// Pre-dates the owner enabling filing. Set by the slice-1 backfill so first
  /// boot does not extract a three-year history overnight. NOT sticky.
  backlog
  /// The content fingerprint was unchanged since the last extraction.
  unchanged
  /// WARP-2730 — indexed, but with no readable body: the extractor chain
  /// produced nothing, or every chunk was header. Nothing to retry.
  no_text
  /// WARP-2730 — at least one chunk is WARP-233 `sensitive` and holds a `dcv1:`
  /// blob rather than text. Extracting from ciphertext would produce confident
  /// nonsense.
  encrypted_content
}

enum FileIndexState {
  indexing
  ready
  skipped
  failed
}

/// WARP-233 — explicit sensitivity tag (no guessing / no prefix-sniffing for
/// policy; the dcv1: prefix is a FORMAT marker, this column is the POLICY).
enum ChunkSensitivity {
  standard
  sensitive
}

/// WARP-233 — wrapped per-document data-encryption keys (deviation D1: app-layer
/// AES-256-GCM instead of pg_tde). `keyId` scope: `brain:<brainItemId>` (one DEK
/// per chat-attached document). User.email deliberately does NOT get a stored
/// DEK — a whole-column logical key has no per-user crypto-shred story, so it
/// is HKDF-derived instead (column-crypto.service.ts deriveEmailColumnKey).
/// `wrappedDek` = base64(iv‖ct‖tag) of the raw 32-byte DEK sealed under the
/// device doc-KEK with AAD = keyId.
///
/// WARP-242 — keyed by (keyId, version) per the rotation design: a scheduled
/// rotation mints version N+1 and re-encrypts the document's chunks in the
/// background before deleting version N (rotation itself is a follow-up
/// slice; today every row is version 1 and readers take the latest version).
/// The doc-KEK is HKDF of the dedicated keyfile data/secrets/doc-kek.key —
/// NOT DEVICE_SECRET_KEY, which travels inside every restic snapshot via .env
/// and would make snapshots self-decrypting. The keyfile is excluded from the
/// backup set (droplet-backup.sh), so crypto-shred — DELETE all versions for
/// a keyId — holds even against restored backups: snapshots carry ciphertext
/// chunks + wrapped DEKs but no KEK. TPM-sealing the KEK is WARP-1033.
model DocumentEncryptionKey {
  keyId      String
  version    Int      @default(1)
  wrappedDek String
  createdAt  DateTime @default(now())

  @@id([keyId, version])
}

// ── WARP-203: Per-user brain memory ──
// Files dropped into a chat conversation land here, on a per-user volume
// outside Nextcloud. Each row has a per-item directory at
// /data/brain-memory/<userId>/<id>/ holding `original.<ext>`,
// `extracted.txt` (cached extraction), and `manifest.json` (mirror of this
// row). The file-indexer picks up the upload via MQTT and embeds chunks
// into FileContentChunk with source=brain + brainItemId=this id.
model BrainMemoryItem {
  id                String            @id @default(cuid())
  userId            String // owner — per-user isolation
  filename          String // original filename, displayed in UI
  mimeType          String? // detected at upload
  bytes             BigInt // original byte count
  storagePath       String // /data/brain-memory/<userId>/<id>/<filename>
  source            BrainMemorySource // chat_attachment | other (extensible enum)
  originatingChatId String? // ai-gateway session id, when applicable
  uploadedAt        DateTime          @default(now())
  indexedAt         DateTime? // null until extractor finishes
  extractorWarnings String[]          @default([]) // e.g. ["low_confidence_ocr_page_3"]
  hasOriginalBytes  Boolean           @default(true) // toggled false if user opts into bytes-purge
  // Image-vision: the indexer wrote a normalized vision.jpg render next to the
  // original (downscaled, web/cloud-safe JPEG). Explicit column (no guessing) —
  // the chat route reads it to decide whether an image can be sent to a vision
  // model. False for non-images, pre-feature uploads, or a failed render.
  hasVisionRender   Boolean           @default(false)

  // WARP-218: explicit status (no guessing per CLAUDE.md). The worker
  // updates this; readers query directly. `failureReason` is non-null
  // only when status='failed'. Retry-window fields enforce the
  // max-3-per-rolling-hour cap (see worker's claim_attempt).
  status                       BrainMemoryItemStatus @default(indexing)
  failureReason                String?
  lastAttemptedAt              DateTime?
  recentAttemptCount           Int                   @default(0)
  recentAttemptWindowStartedAt DateTime?

  // WARP-864: content hash of the original bytes (hex). Re-uploading
  // identical bytes reuses the existing row instead of ingesting a
  // duplicate. Unique per user (Postgres treats NULLs as distinct, so
  // pre-WARP-864 rows — which stay NULL until backfilled — are exempt).
  sha256 String?

  // WARP-905: explicit ingest policy (no guessing per CLAUDE.md). Distinct
  // from `status` (the pipeline lifecycle: indexing → ready | failed): this
  // column is the POLICY gate the file-indexer consults before embedding.
  //   - auto_embed     → default; the upload is embedded immediately (the
  //                      historical behaviour — every pre-WARP-905 row is
  //                      auto_embed via the column default).
  //   - await_approval → the upload is HELD (not embedded) until a human
  //                      releases it via POST /files/brain/:id/approve. This
  //                      is the "pending decision" state surfaced in the
  //                      files/brain UI alongside `status`.
  // Indexed so "list the items awaiting my approval" is a direct query, not
  // a derivation over status + an absence predicate.
  ingestPolicy BrainIngestPolicy @default(auto_embed)

  @@unique([userId, sha256])
  @@index([userId, uploadedAt])
  @@index([userId, originatingChatId])
  @@index([userId, status])
  @@index([status])
  @@index([userId, ingestPolicy])
}

enum BrainMemorySource {
  chat_attachment
}

enum BrainMemoryItemStatus {
  queued_for_transcription
  indexing
  ready
  failed
}

/// WARP-905 — per-item ingest policy. Orthogonal to BrainMemoryItemStatus
/// (which tracks the embedding pipeline lifecycle): this enum is the gate the
/// file-indexer consults before it embeds a chat-attached upload.
///   - auto_embed     → embed on upload (the default; historical behaviour).
///   - await_approval → hold the upload until a human approves it. The
///                      "pending decision" state the files/brain UI renders.
enum BrainIngestPolicy {
  auto_embed
  await_approval
}

// ── WARP-613: phone-home egress policy ──
// Explicit applied-state for the egress reconciler (handbook "state is
// explicit, never derive from absence"). Distinct from the schedule ticker's
// boolean full-block state on `lastAppliedBlocked`.
//   - open               → no phone-home rule on the router
//   - phone_home_blocked → WAN egress denied except NTP + local DNS
//   - full_blocked       → all WAN denied (owned by the schedule ticker; the
//                          egress reconciler never sets this, only yields to it)
enum DeviceEgressState {
  open
  phone_home_blocked
  full_blocked
}

// ── WARP-80: Device intelligence ──
// Per-client-device registry (laptops, phones, smart bulbs, printers on the LAN).
// Populated by the reconciler (WARP-81) from routing-service leases/ARP snapshots.
// Primary key is the MAC address in canonical form (see src/lib/mac.ts).
model NetworkDevice {
  mac                String              @id
  displayName        String?
  icon               String?
  notes              String?
  vendor             String?
  hostname           String?
  lastIp             String?
  firstSeen          DateTime            @default(now())
  lastSeen           DateTime            @default(now())
  // WARP-106: block state has exactly two authored fields + one computed
  // projection. There is a single source of truth — the schedule ticker.
  //
  //   manualBlock        — USER INTENT. Set by the /manualBlock endpoint;
  //                        an INPUT to the schedule ticker, never the
  //                        firewall's effective state on its own.
  //   lastAppliedBlocked — TICKER-AUTHORED effective firewall state and the
  //                        SOURCE OF TRUTH for display. Only the schedule
  //                        ticker writes it (atomically, with the
  //                        ScheduleEvent). Nullable — null means "ticker has
  //                        never touched this device" so the next tick
  //                        dispatches regardless of desired state (bootstrap);
  //                        on orchestrator restart it reconstitutes the
  //                        ticker's state so we don't re-dispatch every device.
  //
  // The old reconciler-authored `isBlocked` column is GONE (WARP-106): the
  // reconciler is now a pure drift DETECTOR — it logs when the live firewall
  // disagrees with lastAppliedBlocked but never writes block state, so it can
  // never clobber ticker intent. The API boundary exposes a COMPUTED, always-
  // boolean `isBlocked = (lastAppliedBlocked ?? manualBlock)` for display.
  manualBlock        Boolean             @default(false)
  lastAppliedBlocked Boolean?
  // WARP-613: last egress policy the egress-reconciler pushed to the router.
  // Maintained independently of lastAppliedBlocked (which the schedule ticker
  // owns). See enum DeviceEgressState above.
  lastAppliedEgress  DeviceEgressState   @default(open)
  groups             DeviceGroup[]       @relation("DeviceGroups")
  presenceDays       DevicePresenceDay[]
  schedules          Schedule[]          @relation("DeviceSchedules")
  overrides          ScheduleOverride[]  @relation("DeviceOverrides")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([lastSeen])
  @@index([vendor])
}

// User-curated grouping (rooms, categories, etc.). Many-to-many with
// NetworkDevice — a device can be in multiple groups (e.g. "Living Room"
// and "Media"). Seeded with 5 default rooms by the migration.
model DeviceGroup {
  id             String             @id @default(cuid())
  name           String             @unique
  color          String?
  icon           String?
  // WARP-613: when true AND the master toggle
  // (WorkspaceSetting `network.block_phone_home_enabled`) is on, every device
  // in this group gets a phone-home WAN-egress block (NTP + local DNS still
  // allowed). Enforced by the egress reconciler.
  blockPhoneHome Boolean            @default(false)
  devices        NetworkDevice[]    @relation("DeviceGroups")
  schedules      Schedule[]         @relation("GroupSchedules")
  overrides      ScheduleOverride[] @relation("GroupOverrides")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// Daily presence roll-up — one row per (device, calendar day) with the
// number of minutes the device was seen. Powers the "who's home" and
// presence-timeline dashboards without scanning per-minute lease data.
model DevicePresenceDay {
  mac         String
  date        DateTime      @db.Date
  seenMinutes Int           @default(0)
  device      NetworkDevice @relation(fields: [mac], references: [mac], onDelete: Cascade)

  @@id([mac, date])
  @@index([date])
}

// ── WARP-92: Phase 2 scheduling (parental controls / time-of-day) ──
// Schedule = a named rule that blocks a subject (device OR group) during
// one or more recurring weekly windows. Windows live in ScheduleWindow
// rows keyed by day-of-week bitmask + minutes-of-day range.
model Schedule {
  id          String           @id @default(cuid())
  name        String
  enabled     Boolean          @default(true)
  subjectType String // "device" | "group"
  deviceMac   String?
  groupId     String?
  windows     ScheduleWindow[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  device NetworkDevice? @relation("DeviceSchedules", fields: [deviceMac], references: [mac], onDelete: Cascade)
  group  DeviceGroup?   @relation("GroupSchedules", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([deviceMac])
  @@index([groupId])
}

// Recurring weekly window inside a Schedule. daysOfWeek is a 7-bit mask
// (Sun=1..Sat=64). startMin/endMin are minutes since local midnight.
// endMin <= startMin means the window wraps past midnight.
model ScheduleWindow {
  id         String   @id @default(cuid())
  scheduleId String
  daysOfWeek Int
  startMin   Int
  endMin     Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, daysOfWeek, startMin, endMin]) // WARP-112: no duplicate windows per schedule
  @@index([scheduleId])
}

// Ad-hoc one-shot override of schedule state for a subject over a window
// of wall-clock time. "allow" unblocks during the range; "block" blocks
// during the range. Expires naturally once endAt passes.
model ScheduleOverride {
  id          String   @id @default(cuid())
  subjectType String
  deviceMac   String?
  groupId     String?
  action      String // "allow" | "block"
  startAt     DateTime
  endAt       DateTime
  note        String?
  createdAt   DateTime @default(now())

  device NetworkDevice? @relation("DeviceOverrides", fields: [deviceMac], references: [mac], onDelete: Cascade)
  group  DeviceGroup?   @relation("GroupOverrides", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([endAt])
  @@index([deviceMac])
  @@index([groupId])
}

// Append-only audit log of every block/unblock transition the ticker
// causes. Powers the "why is this blocked?" UI and historical reports.
//
// WARP-113: append-only immutability is enforced at the DB level — Prisma
// can't model triggers, so this is "managed at DB level only" (do not rely
// on the ORM). Migration 20260711000001 installs a BEFORE INSERT OR UPDATE
// trigger that (1) blocks every UPDATE and (2) rejects future-dated inserts
// (occurredAt > now() + 5min skew grace). DELETE is intentionally allowed —
// schedule-purge.ts prunes old rows for retention.
model ScheduleEvent {
  id          String   @id @default(cuid())
  scheduleId  String?
  overrideId  String?
  subjectType String
  deviceMac   String?
  groupId     String?
  transition  String // "blocked" | "unblocked"
  reason      String
  occurredAt  DateTime @default(now())

  @@index([occurredAt])
}

// ── Notes ──
//
// The Home "Notes" tile used to keep a single string in the browser's
// localStorage: per-browser, unsynced, and wiped by "New note". Notes now live
// on the box like every other piece of customer data — many per user, each
// pinnable, so the pinned ones can surface on Home from any device.
//
// `pinned` is an explicit column, not derived from ordering or a magic
// position (CLAUDE.md — no guessing from absence).

model Note {
  id        String   @id @default(uuid())
  userId    String // Nextcloud username — the note's owner
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// WARP-2117 — CRM timeline entries that POINT AT this note. The CRM never
  /// copies the body; deleting the note nulls the reference and leaves the
  /// fact that the interaction happened intact.
  crmActivities CrmActivity[]

  // Home reads "this user's pinned notes, newest first"; the notes surface
  // reads "this user's notes, pinned first, newest first". One index serves
  // both.
  @@index([userId, pinned, updatedAt])
}

// ── Calendar / Reminders / Notifications (PR #2) ──
//
// One canonical calendar per user lives in CalendarEvent. External calendars
// (iCloud, Fastmail, any CalDAV/ICS feed) are pulled in via CalendarSource +
// the periodic ingest job — those events have `source = "external"` and
// `externalUid` set so re-sync is idempotent. The user's own events have
// `source = "local"` and are publishable via the /api/calendar/publish/... ICS
// feed, so phones can subscribe without needing OAuth.

/// WARP-2767: lifecycle of a calendar feed link. Persistent state lives in
/// this enum, never inferred from a nullable timestamp (PairingCodeStatus is
/// the precedent).
///   - active  — the feed answers. `expiresAt` stays authoritative in real
///               time: the feed refuses an overdue active row and stamps it
///               `expired` on the spot.
///   - rotated — replaced by a newer link via POST /calendar/publish/rotate.
///   - revoked — turned off via POST /calendar/publish/revoke.
///   - expired — past `expiresAt`.
enum CalendarFeedTokenState {
  active
  rotated
  revoked
  expired
}

/// WARP-3533: which feed a link reads. One credential mechanism, three feeds.
///   - calendar   — the person's own events, /api/calendar/publish/:user.ics.
///                  Every link minted before PM feeds is this, by the column
///                  default, so the existing links keep their meaning.
///   - pm_my_work — the items assigned to the person that have a due date,
///                  /api/calendar/publish/:user/my-work.ics.
///   - pm_project — one project's items that have a due date,
///                  /api/calendar/publish/:user/projects/:projectId.ics.
/// A link reads ONLY its own feed: a leaked project link exposes that one
/// project's due dates and not the person's calendar or anything else.
enum CalendarFeedTokenScope {
  calendar
  pm_my_work
  pm_project
}

/// WARP-2767: a bearer credential for the pre-auth ICS feed at
/// /api/calendar/publish/:user.ics. The URL token is `<id>.<secret>`; only
/// sha256(secret) is stored, so a database read never yields a working link.
/// Bound to exactly one account by FK — the feed also requires the URL's
/// username to be that account's current username.
///
/// WARP-3533: `scope` (+ `projectId` for a project feed) says which feed the
/// link reads; rotating or revoking one feed's link leaves the others alone.
/// INVARIANT NOT EXPRESSIBLE HERE: CalendarFeedToken_project_scope_coherent —
/// CHECK (("scope" = 'pm_project') = ("projectId" IS NOT NULL)) lives in
/// migration SQL and is proven in pm-api-token.pg.test.ts.
model CalendarFeedToken {
  id         String                 @id @default(uuid())
  userId     String
  secretHash String
  state      CalendarFeedTokenState @default(active)
  scope      CalendarFeedTokenScope @default(calendar)
  /// Set exactly when `scope` is `pm_project`. Cascade: a link to a project
  /// that no longer exists has nothing to read.
  projectId  String?
  createdAt  DateTime               @default(now())
  expiresAt  DateTime
  /// Set when the row leaves `active` (rotated / revoked / expired).
  endedAt    DateTime?
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    PmProject?             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  /// WARP-845: the ON DELETE CASCADE scan index.
  @@index([projectId])
}

/// WARP-3452: lifecycle of a coding-tool token. Explicit, never derived from
/// `revokedAt` / `expiresAt`. `expired` is written when introspection or a
/// listing finds `expiresAt` passed; renewal takes it back to `active`.
/// `revoked` is terminal.
enum ModelAccessTokenStatus {
  active
  revoked
  expired
}

/// WARP-3452: why a token was revoked. `manual` = its holder or an
/// owner/admin (see `revokedById`); the other two are the lifecycle hooks in
/// role-mutation-guard.service.ts.
enum ModelAccessTokenRevokeReason {
  manual
  user_deactivated
  role_guest
}

/// WARP-3452: a per-person bearer credential (`dlk_…`) that lets a coding tool
/// on the LAN use the box's model runtime through ai-gateway's `/llm/` router.
/// Only sha256(full token) is stored; `prefix` (8 chars after `dlk_`) is for
/// display. ai-gateway checks every request against this row through
/// POST /api/llm-access/_introspect, so a revoke is effective immediately.
model ModelAccessToken {
  id               String                        @id @default(uuid())
  userId           String
  label            String                        @db.VarChar(64)
  prefix           String
  secretHash       String                        @unique
  status           ModelAccessTokenStatus        @default(active)
  createdAt        DateTime                      @default(now())
  /// createdAt (or the last renewal) + 364 days.
  expiresAt        DateTime
  /// Written at most once a minute per token.
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokedReason    ModelAccessTokenRevokeReason?
  /// Who revoked it by hand; null for the lifecycle hooks.
  revokedById      String?
  /// Last time a refused (revoked/expired) use wrote an ActivityRow — at most
  /// one per token per hour.
  refusalAuditedAt DateTime?
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage            ModelAccessTokenUsage[]

  @@index([userId, status])
}

/// WARP-3452: per-token, per-day (UTC) usage counters. Never any prompt or
/// completion content — counts only. One row per token per day instead of an
/// ActivityRow per request (an agent session makes hundreds).
model ModelAccessTokenUsage {
  tokenId          String
  day              DateTime         @db.Date
  requests         Int              @default(0)
  promptTokens     Int              @default(0)
  completionTokens Int              @default(0)
  errors           Int              @default(0)
  token            ModelAccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, day])
}

/// WARP-3533: lifecycle of a personal API token. Explicit, never derived from
/// `revokedAt` / `expiresAt`. `expired` is stamped when a use or a listing
/// finds `expiresAt` passed; `revoked` is terminal.
enum PmApiTokenStatus {
  active
  revoked
  expired
}

/// WARP-3533: why a token was revoked. `manual` = its holder or an owner/admin
/// (see `revokedById`); the other two are the lifecycle hooks in
/// role-mutation-guard.service.ts, and the same two are re-checked at every use.
enum PmApiTokenRevokeReason {
  manual
  user_deactivated
  role_changed
}

/// WARP-3533: a personal API token (`dpm_…`) that lets a script call
/// `/api/pm/*` and `/api/support/*` as the person who created it. Only
/// sha256(full token) is stored (unique), so a database read or a backup never
/// yields a working token; `prefix` (the 8 characters after `dpm_`) is for
/// display. The token authenticates as its holder through authMiddleware, so
/// every role, module and feature gate runs unchanged; `scopes` only narrow it.
///
/// `issuedRole` is the holder's role when the token was minted. The token
/// works only while the holder still has that role, so a promotion or a
/// demotion ends it even when the revoke hook did not land.
///
/// INVARIANTS NOT EXPRESSIBLE HERE (migration SQL, proven in
/// pm-api-token.pg.test.ts):
///   PmApiToken_scopes_valid     — scopes is non-empty and a subset of
///                                 pm:read | pm:write | support:read | support:write
///   PmApiToken_role_may_hold    — issuedRole is owner | admin | family; an
///                                 external guest or a service principal never
///                                 holds a token
///   PmApiToken_revoked_coherent — status = revoked exactly when revokedAt and
///                                 revokedReason are both set
model PmApiToken {
  id               String                  @id @default(uuid())
  userId           String
  name             String                  @db.VarChar(64)
  prefix           String
  hash             String                  @unique
  scopes           String[]
  issuedRole       Role
  status           PmApiTokenStatus        @default(active)
  createdAt        DateTime                @default(now())
  /// Null = the holder chose no expiry.
  expiresAt        DateTime?
  /// Written at most once a minute per token.
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokedReason    PmApiTokenRevokeReason?
  /// Who revoked it by hand; null for the lifecycle hooks.
  revokedById      String?
  /// Last time a refused (revoked/expired) use wrote an ActivityRow — at most
  /// one per token per hour.
  refusalAuditedAt DateTime?
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CalendarEvent {
  id           String   @id @default(uuid())
  userId       String // Nextcloud username
  title        String
  description  String?
  location     String?
  /// WARP-1874 — an https-only video-call link (Zoom / Teams / Meet / Webex
  /// or any other https URL), EXPLICIT rather than sniffed out of
  /// `location`. Deriving "is this location string actually a link" from
  /// the text would be exactly the guessing CLAUDE.md rule 10 forbids, and
  /// it is what made the field unusable for remote attendees.
  ///
  /// Nullable and additive: rows written before this column keep working,
  /// including the ones whose `location` already holds a pasted URL —
  /// those still render as the plain text they always were.
  ///
  /// Admission is `https:` ONLY, enforced on every write path by
  /// `parseMeetingLink` in @droplet/shared-types. The stored value is that
  /// parser's normalized href, so what was validated is what becomes an
  /// anchor on another household member's screen.
  meetingUrl   String?
  startsAt     DateTime
  endsAt       DateTime
  allDay       Boolean  @default(false)
  // "local" — created in the Droplet UI/LLM. Mutable.
  // "external" — ingested from a CalendarSource. Read-only locally; updates
  //   come from the next sync. Deleting a local copy doesn't remove the
  //   upstream event (only un-ingest does).
  source       String   @default("local")
  sourceId     String? // FK to CalendarSource.id (when source="external")
  externalUid  String? // iCalendar UID — used as idempotency key on re-sync
  externalEtag String? // CalDAV ETag for change detection
  /// WARP-3266 — explicit, never derived from externalUid's shape:
  /// "none" — a one-off event (every local row);
  /// "occurrence" — one instance of a subscribed recurring series, expanded
  ///   at sync time (externalUid = "<UID>::<original start ISO>");
  /// "unexpanded" — a recurring series whose RRULE is outside the supported
  ///   subset, stored as its first instance only. Clients can say "repeats".
  recurrence   String   @default("none")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// WARP-2117 — CRM timeline entries that POINT AT this event (a meeting on
  /// a deal). The CRM stores a caption, never a copy.
  crmActivities CrmActivity[]

  @@unique([sourceId, externalUid]) // a given upstream event appears at most once locally
  @@index([userId, startsAt])
  @@index([userId, source])
}

// External CalDAV / ICS feeds the user has subscribed to. The ingest job
// fetches each one on its own interval and upserts events into CalendarEvent
// keyed by externalUid.
model CalendarSource {
  id               String    @id @default(uuid())
  userId           String
  name             String // "Personal iCloud"
  url              String // CalDAV calendar URL OR public ICS URL
  // basic|none. CalDAV usually basic. ICS feeds usually none.
  authMode         String    @default("basic")
  username         String?
  // Encrypted with the same aes-256-gcm key as DeviceClient.ncAppPassword.
  // Format: iv||tag||ciphertext, base64-encoded. Never returned to clients.
  passwordEnc      String?
  syncIntervalSec  Int       @default(900) // 15 minutes default
  // WARP-2022 — owner/admin opt-in to a CalDAV server inside the boundary
  // (a self-hosted Nextcloud/Radicale on the box's own LAN is a first-class
  // use case on this appliance). An EXPLICIT column, never an exemption
  // inferred from the URL, and never settable by a lower role. Skips the
  // private-address rules ONLY: the scheme and userinfo rules still apply.
  allowPrivateHost Boolean   @default(false)
  lastSyncAt       DateTime?
  lastSyncError    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model Reminder {
  id              String    @id @default(uuid())
  userId          String
  title           String
  body            String?
  dueAt           DateTime
  // WARP-3193 QUAL-3: the lifecycle is this column, not the absence of
  // completedAt / notifiedAt. Each writer sets it in the same statement that
  // stamps the timestamp. See enum ReminderStatus.
  status          ReminderStatus @default(scheduled)
  // When the reminder was completed (set with status = completed).
  completedAt     DateTime?
  // Optional link to the event this reminder is for.
  calendarEventId String?
  // When the dispatcher fired the due-time notification (set with
  // status = notified). Kept after completion, so un-completing knows
  // whether the reminder had already fired.
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, dueAt])
  // WARP-3193 PERF-14: the poller's `status = 'scheduled' AND dueAt <= now
  // ORDER BY dueAt LIMIT 100`.
  @@index([status, dueAt])
}

/// WARP-3193 QUAL-3 — reminder lifecycle.
///   - scheduled — waiting for dueAt; the poller's only input.
///   - notified  — the poller fired the due-time notification.
///   - completed — the person marked it done.
/// Re-arming (a new dueAt) returns a scheduled/notified reminder to
/// scheduled; un-completing returns to notified if it had already fired,
/// else scheduled.
enum ReminderStatus {
  scheduled
  notified
  completed
}

// ── Remote Access (WireGuard VPN) ──
//
// One row per device a user has provisioned to dial in over WireGuard.
// `userId` is the Nextcloud username (same convention as DeviceClient,
// CalendarEvent, FileContentChunk, etc. — we never duplicate the user
// table; Nextcloud is the source of truth).
//
// We store the peer's PUBLIC key (server-side identifier) and the
// allocated tunnel IP. We DO NOT store the peer's private key — it's
// shown to the user once at creation time (rendered into a QR / .conf)
// and discarded. If they lose it they revoke and re-mint.
//
// Status drives the IP allocator: `active` rows reserve an IP from the
// VPN subnet; `revoked` rows are tombstones (kept for audit + so the
// dashboard can show a recently-removed device for a brief grace
// period). Re-using a recently-revoked IP is fine — the orchestrator's
// allocator just picks the next free one in numerical order.
model VpnPeer {
  id            String    @id @default(uuid())
  userId        String // Nextcloud username
  deviceLabel   String // "Alice's iPhone"
  // Peer's WireGuard public key (X25519, base64). Unique across all
  // peers (active + revoked) — pubkey is effectively the peer identity
  // and reusing one would let a revoked device reauthenticate.
  publicKey     String    @unique
  // Tunnel IP assigned from the VPN subnet (e.g. "10.13.13.5"). Unique
  // across ACTIVE rows; a revoked row's IP can be reissued. Stored
  // without CIDR mask (mask is implied by the subnet).
  assignedIp    String
  status        String    @default("active") // "active" | "revoked"
  // How this peer reaches the box (hybrid remote-access P1). EXPLICIT enum-
  // checked value, never inferred from another field's absence (rule 10):
  //   "away" (default) — dials the box from OUTSIDE the home LAN via the public
  //           FQDN / relay endpoint. The pre-hybrid behavior; every existing row
  //           is "away", so the default keeps them correct without a backfill.
  //   "home" — dials the box DIRECTLY at its home-facing LAN IP (split-tunnel to
  //           the box, no public inbound). The .conf's Endpoint is the LAN IP.
  // A CHECK constraint pins it to exactly these two values (see the migration).
  mode          String    @default("away")
  // WARP-1385: how this peer was provisioned. EXPLICIT enum-checked value, never
  // inferred from absence (rule 10):
  //   "static"  (default) — a persistent peer minted by the owner via
  //             POST /api/vpn/peers (the QR/.conf flow). Every pre-1385 row is
  //             "static" via the column default — no backfill needed.
  //   "overlay" — a direct-punch overlay peer (ADR-030) installed/refreshed by
  //             the overlay connect agent on each HQ session. `lastSessionAt`
  //             tracks the last refresh so idle overlay peers can be expired.
  // A CHECK constraint pins it to exactly these two values (see the migration).
  kind          String    @default("static")
  // Last time the overlay connect agent refreshed this peer's endpoint from an
  // HQ session offer. NULL for "static" peers (they never carry a session); the
  // idle-expiry sweep filters on `kind = 'overlay' AND lastSessionAt < cutoff`,
  // so the NULL is never used to DERIVE state (rule 10).
  lastSessionAt DateTime?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  // WARP-3172: the peer was revoked locally (router + row) but HQ could not be
  // reached, so HQ may still broker sessions for it. The connect tick refuses
  // the device and retries the HQ revoke, clearing this on success.
  hqRevokePending Boolean @default(false)

  // WARP-1474: provenance for a peer enrolled via the dashboard-QR link flow
  // (ADR-030). Nullable — a peer minted via POST /api/vpn/peers (kind='static')
  // or an overlay peer created before this flow existed carries none of these.
  // When an owner APPROVES a PendingOverlayEnrollment these are stamped onto the
  // resulting overlay peer row so the audit trail shows who linked which QR:
  //   linkTokenEnrolledBy — the approving owner's user id (createdBy).
  //   linkTokenId         — the OverlayLinkToken this device redeemed.
  //   linkTokenLabel      — the human label from the redeem body.
  //   enrolledAt          — when the owner approved the enrollment.
  linkTokenEnrolledBy String?
  linkTokenId         String?
  linkTokenLabel      String?
  enrolledAt          DateTime?

  @@index([userId])
  @@index([status])
  // WARP-1385: the overlay idle-expiry sweep scans (kind, status, lastSessionAt).
  @@index([kind])
  // WARP-565: a PARTIAL unique index enforces "at most one ACTIVE peer per
  // assignedIp" at the DB layer (revoked rows' IPs are reusable). Prisma can't
  // express partial-unique declaratively, so it lives as raw SQL in migration
  // 20260614000000_vpn_peer_unique_active_ip. This @@index stays for the
  // non-unique read path the allocator uses.
  @@index([assignedIp])
}

// ── WARP-1474: Dashboard-QR overlay device linking (ADR-030) ──
//
// The owner mints a short-lived QR on the dashboard; a phone scans it and
// redeems the token (NO bearer) to STAGE an enrollment the owner then approves.
// Only on approval does the box vouch the device to HQ (reusing the WARP-1385
// enrollOverlayDevice broker) — the redeem itself performs NO HQ call and
// installs NO wg0 peer.
//
// `state` on both models is an EXPLICIT enum-checked TEXT column (rule 10 — no
// state derived from a NULL), pinned by a raw-SQL CHECK constraint in the
// migration, mirroring the sibling VpnPeer.status / .mode / .kind idiom.

// One row per minted QR link token. The plaintext token is returned to the
// owner ONCE and NEVER persisted or logged — only its sha256 hex hash lives
// here, so a DB read can neither replay nor reconstruct a token.
model OverlayLinkToken {
  id          String    @id @default(uuid())
  // sha256(token) hex. Unique — the redeem path looks a token up by its hash.
  tokenHash   String    @unique
  // 'available' — freshly minted, unredeemed, unexpired.
  // 'consumed'  — redeemed once; boundSignFp records the first redeemer's key.
  // 'expired'   — past TTL, or superseded by a newer mint from the same owner
  //               (single-active-per-owner). CHECK-pinned in the migration.
  state       String    @default("available")
  expiresAt   DateTime
  consumedAt  DateTime?
  // The owner (req.user.id) who minted the token. Drives single-active-per-owner
  // supersession + the mint audit's actor.
  createdBy   String
  // Optional owner-supplied label shown on the pending-enrollments list.
  label       String?
  // sha256(sign_public_key_pem) hex of the FIRST device to redeem this token.
  // A later redeem with a DIFFERENT fingerprint is a token_conflict (409); the
  // same fingerprint re-redeeming is idempotent.
  boundSignFp String?
  createdAt   DateTime  @default(now())

  @@index([createdBy, state])
  @@index([state, expiresAt])
}

// One row per staged (redeemed-but-not-yet-approved) device enrollment.
// Created by the by-token redeem; transitions to approved/denied by the owner,
// or expired by the natural token TTL. The owner approves against the short
// fingerprint; the client polls its coarse state via a PoP-guarded endpoint.
model PendingOverlayEnrollment {
  id                 String    @id @default(uuid())
  // The OverlayLinkToken.id redeemed to create this row.
  linkTokenId        String
  // sha256(sign_public_key_pem) hex — full fingerprint; the list surfaces its
  // first 8 chars.
  signKeyFingerprint String
  // Exact validated PEM bytes, un-trimmed, so sha256(pem) stays byte-identical
  // to the box vouch + HQ recompute. Also the key the status-PoP verifies against.
  signPublicKeyPem   String
  wgPublicKey        String
  label              String
  presentedAt        DateTime  @default(now())
  // 'pending' | 'approving' | 'approved' | 'denied' | 'expired'. CHECK-pinned in
  // the migration. 'approving' is the WARP-1474 SEND-BACK #2 atomic-approve
  // claim: the approve route flips pending→approving BEFORE the box→HQ vouch so
  // exactly one approver vouches (the losing concurrent approve matches 0 rows
  // on the conditional flip). approving→approved on vouch success; compensated
  // back to pending on vouch failure so the owner can retry.
  state              String    @default("pending")
  // True once a DIFFERENT-fingerprint device tried to redeem the same token —
  // surfaced to the owner so a hijack attempt is visible, not silent.
  conflict           Boolean   @default(false)
  // Set on approval: the approving owner, the enroll timestamp, and HQ's
  // returned device reference (the response `device_id`).
  approvedBy         String?
  enrolledAt         DateTime?
  hqDeviceRef        String?
  // WARP-3152: username of the account that asked, for a sign-in enrollment
  // staged for owner review. Becomes the peer's owner at approval. NULL for a
  // QR-linked device and for rows staged before the column existed (admin-only).
  requestedBy        String?

  @@index([state])
  @@index([linkTokenId])
  @@index([wgPublicKey])
}

/// WARP-2587 — the notification vocabulary, as an enum rather than a comment.
///
/// These four labels were already the whole vocabulary: notifications.service
/// declared them as a TS union, routes/notifications.ts as a zod enum, and
/// tools-core's send-notification handler hardcodes 'ai'. The COLUMN was a
/// free String with the list in a `//` comment above it — exactly the
/// string-soup ContextPin's docstring cites CLAUDE.md's no-guessing rule
/// against, and one raw insert away from a fifth label nothing renders.
///
/// Lowercase labels on purpose: they are the WIRE contract. The MQTT toast
/// payload, the dashboard's NotificationToaster union and the POST
/// /notifications/send body all carry these strings, so renaming a label is a
/// dashboard change and a mobile change, not a migration.
///
/// Adding a label later is NOT free: `ALTER TYPE ... ADD VALUE` cannot be used
/// in the same transaction that adds it, so it needs its own migration ahead
/// of any migration that writes it (see baseline entry 1 in
/// schema-drift-baseline.sql for the ToolRunStatus instance of exactly this).
enum NotificationKind {
  reminder
  event
  system
  ai
}

// Append-only log of every notification dispatched. Powers the in-app
// "recent notifications" panel and helps debug missing pushes.
model NotificationLog {
  id          String           @id @default(cuid())
  /// Nextcloud username (`User.username`), never `User.id` (WARP-2911).
  username    String
  kind        NotificationKind
  title       String
  body        String?
  // WARP-2909 — deep link: a same-origin dashboard path (validated by
  // assertNotificationLink) and small flat PHI-free client context.
  url         String?
  data        Json?
  // Comma-separated channels actually attempted: "toast,push"
  channels    String
  deliveredAt DateTime?
  error       String?
  /// WARP-2904 — what the web-push leg did, explicitly. NULL only on rows
  /// written before this column existed and on `recordNotification` rows
  /// (queued, no transport yet); never inferred from `channels`/`error`.
  pushOutcome PushOutcome?
  createdAt   DateTime         @default(now())
  /// WARP-2804 — whether the recipient has seen it. Explicit, never inferred
  /// from ackedAt. Rows written before WARP-2804 are `untracked` (backfilled
  /// by the migration); every new row starts `unacked`.
  ackState     NotificationAckState   @default(unacked)
  ackedAt      DateTime?
  ackMethod    NotificationAckMethod?
  /// The sign-in's id (JWT `sid`) from the signed token that acked it: it
  /// names the right sign-in, but its live-session check can be skipped when
  /// the session store is unreachable — `ackSessionChecked` says whether it
  /// ran. NULL when that token carried no sid (grace/legacy tokens).
  ackSessionId String?                @db.VarChar(64)
  /// What the acking client SAID it was (X-Droplet-Client, else a coarse
  /// User-Agent label). Reported, never proof. NULL when it said nothing
  /// usable.
  ackClient    String?                @db.VarChar(120)
  /// Whether the session store CONFIRMED that sign-in was live when it acked
  /// (authMiddleware `req.sessionChecked`). False when the check was skipped
  /// (store unreachable, no sid) and on every row not acked. DB CHECK
  /// `NotificationLog_ack_session_checked`: true only on an acked row with a
  /// sid.
  ackSessionChecked Boolean             @default(false)

  @@index([username, createdAt])
  // WARP-2804 — the unread count and the `state=unacked` list.
  @@index([username, ackState, createdAt])
}

/// WARP-2804 — whether the RECIPIENT has seen a notification. Set only by the
/// recipient (never by someone else's act). Explicit — never inferred from
/// ackedAt. The DB CHECK `NotificationLog_ack_shape` pins the columns to it.
enum NotificationAckState {
  /// Not seen yet. The only state counted as unread.
  unacked
  acked
  /// Written before WARP-2804: nobody can say. Never counted as unread; can
  /// still be acked.
  untracked
}

/// WARP-2804 — the path that acknowledged a notification.
enum NotificationAckMethod {
  /// POST /notifications/:id/ack (the default)
  inbox
  /// POST /notifications/:id/ack {via:'opened'} — the client REPORTS the
  /// person opened its link
  opened
  /// POST /notifications/ack-all
  all
  /// The recipient acknowledged the incident this notification was about.
  /// Never set by a notification route.
  incident
}

/// WARP-2904 — the web-push leg of one sendNotification call.
///   sent           at least one subscription accepted the push
///   no_subscribers the user has no (valid) PushSubscription row
///   refused_gate   the `web_push` off-LAN channel is off (or unreadable)
///   failed         subscribers existed and nothing was accepted, or the
///                  push leg threw
enum PushOutcome {
  sent
  no_subscribers
  refused_gate
  failed
}

// ── WARP-446: Coverage extender APs (auto-onboarded OpenWrt APs) ──
//
// Per ADR-005 (docs/ADR-005-ap-auto-onboarding.md). Each row tracks one
// extender AP the household has installed (or that's announced itself
// on `_droplet-ap._tcp` mDNS but hasn't been approved yet). The main
// router (192.168.50.1) is NOT in this table — it's the single source
// of routing truth, not an extender.
//
// `mac` is the canonical primary key (uppercase, colon-separated; see
// `normalizeMac()` in src/lib/mac.ts). Same convention as
// `NetworkDevice.mac` from WARP-80. Every boundary normalizes before
// querying so the dashboard's URL params and the mDNS poller's
// observed values can't drift.
//
// `status` is an explicit enum (ApDeviceStatus). The CLAUDE.md
// no-guessing rule forbids deriving state from `approvedAt IS NULL`
// or similar nullable-absence patterns. WARP-218's
// `BrainMemoryItemStatus` is the canonical precedent.
//
// `lastIp` carries the discovered DHCP lease for the AP so the
// orchestrator can address its rpcd over the LAN without re-resolving
// mDNS on every push.
//
// `failureReason` is non-null only when `status = FAILED`. Same shape
// the WARP-218 brain-memory pattern uses for transient failures.
model ApDevice {
  mac              String           @id
  // Operator-friendly label set at approval time. Defaults to the
  // model name + last-3-octets of the MAC if the operator doesn't
  // override it (e.g. "AP (12:34:56)"). Editable from the
  // dashboard later (PATCH /api/aps/:mac).
  displayName      String?
  // mDNS-reported product info — useful for the dashboard's "what is
  // this" rendering and for the audit log on approval.
  model            String?
  serial           String?
  // Overlay version reported by the AP at announce time. Diverging
  // versions across APs is a yellow flag the dashboard surfaces; the
  // orchestrator does NOT auto-upgrade.
  version          String?
  // Last IPv4 observed for this AP (from the mDNS announce or the
  // DHCP lease the discovery poller cross-references). The
  // orchestrator addresses the AP at this IP over rpcd.
  lastIp           String?
  // Last DHCP-reported hostname.
  hostname         String?
  status           ApDeviceStatus   @default(DISCOVERED)
  // ADR-024: which onboarding backend owns this row's discovery +
  // provisioning. Explicit enum column (NOT derived from absence —
  // CLAUDE.md no-guessing rule, same discipline as `status`). Every
  // row created today is DROPLET_IMAGE (ADR-005's mDNS + uci path);
  // EASYMESH / UNIFI land in later ADR-024 phases. The default keeps
  // every existing row — and every reconcile that predates a backend
  // being passed — pinned to the only discovery source that exists now.
  backend          ApOnboardBackend @default(DROPLET_IMAGE)
  // Backend-scoped opaque id: UniFi device_id, 1905.1 AL-MAC, etc.
  // Null for DROPLET_IMAGE rows (the MAC is the only handle ADR-005
  // needs).
  backendRef       String?
  // Human-readable vendor label surfaced in the dashboard + LLM
  // ("TP-Link", "Ubiquiti"). Null for the Droplet-image extender.
  vendor           String?
  // Non-null only when status = FAILED. Free text, surfaced verbatim
  // in the dashboard's "what went wrong" tile.
  failureReason    String?
  // SSID + iface section the orchestrator pushed (or will push) when
  // the AP transitions to PROVISIONING. Stored so re-provisioning +
  // decommission have everything they need without re-querying the
  // main router.
  approvedSsid     String?
  // First time the orchestrator saw this MAC announce on mDNS.
  firstSeen        DateTime         @default(now())
  // Updated on every fresh announce — drives the "stale extender"
  // dashboard warning.
  lastSeen         DateTime         @default(now())
  // Timestamp the operator hit Approve. Null until the row leaves
  // AWAITING_APPROVAL.
  approvedAt       DateTime?
  // Operator (Nextcloud username) who approved this AP. Audit trail.
  approvedBy       String?
  // Timestamp the AP transitioned to DECOMMISSIONED. Null otherwise.
  decommissionedAt DateTime?
  // Last Operation-Id the orchestrator received from the routing
  // service for a write touching this AP — lets the dashboard
  // resume polling after a refresh.
  lastOperationId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([lastSeen])
}

/// WARP-446: lifecycle of an extender AP (per ADR-005 §"State machine").
///   - `DISCOVERED`         — mDNS poller has seen this MAC announce; the
///                            operator has not yet been shown the card.
///                            Today this state is short-lived (the
///                            poller flips to AWAITING_APPROVAL on the
///                            same tick) but it exists so re-runs that
///                            haven't fired yet are distinguishable
///                            from approved-and-online.
///   - `AWAITING_APPROVAL`  — rendered in the Add Extender wizard.
///   - `PROVISIONING`       — orchestrator is mid-push to the AP's
///                            rpcd. Set right before the routing
///                            service call; cleared by the result.
///   - `ONLINE`             — terminal-active; AP is serving the
///                            household SSID and answering the post-
///                            apply health probe.
///   - `FAILED`             — the apply failed (router unreachable,
///                            ubus refused, post-apply probe timed
///                            out). `failureReason` is populated.
///                            Operator can retry by re-approving.
///   - `DECOMMISSIONED`     — terminal-removed; the operator hit
///                            "Remove" and the orchestrator deleted
///                            the wireless config off the AP. Row
///                            kept for audit.
enum ApDeviceStatus {
  DISCOVERED
  AWAITING_APPROVAL
  PROVISIONING
  ONLINE
  FAILED
  DECOMMISSIONED
}

/// ADR-024: the onboarding backend that owns a given ApDevice row's
/// discovery + provisioning. A discriminator so one canonical entity,
/// one state machine, and one LLM/dashboard surface can serve multiple
/// vendor ecosystems instead of three forked features.
///   - `DROPLET_IMAGE` — ADR-005: mDNS `_droplet-ap._tcp` discovery +
///                       uci `wifi-iface` push. The only backend that
///                       does anything today; the schema default.
///   - `EASYMESH`      — IEEE 1905.1 discovery + prplMesh-controller
///                       M1/M2 onboarding (ADR-024 §2). Phase 4.
///   - `UNIFI`         — UBNT UDP 10001 discovery + UniFi Network API
///                       adoption (ADR-024 §3). Phase 3.
enum ApOnboardBackend {
  DROPLET_IMAGE
  EASYMESH
  UNIFI
}

/// WARP-1732 (ADR-035 §2/§5/§6) — persisted inventory of every device
/// announcing on the fabric: the edge router, the switch, each AP, and
/// whatever role ships next.
///
/// **Observations only.** This table is a ledger of what the routing
/// service's `GET /fabric/members` reported, nothing more. It owns no
/// lifecycle state machine and drives no device writes — `ApDevice` keeps
/// owning AP lifecycle (ADR-005), and this row existing for an AP MAC says
/// only "something answered mDNS with that anchor MAC", never "approved".
/// Deliberately no `status` column: there is no state to machine here, and
/// inventing one would be exactly the derived-state drift ADR-035 argues
/// against.
///
/// `anchorMac` is the primary key per ADR-035 §2 — the wired management
/// interface's MAC is the one identifier every observer (mDNS TXT, DHCP,
/// both FDBs, ARP, the beacon) agrees on. Every write path canonicalizes
/// it through the existing `src/lib/mac.ts` `normalizeMac`, so the stored
/// form is always `AA:BB:CC:DD:EE:FF` and a member cannot land twice under
/// two spellings of the same address.
///
/// `role` is a bare String, NOT an enum: ADR-035 §5 explicitly plans for
/// roles to grow (router | switch | ap today; box and beyond later), and a
/// role the routing service starts announcing must be storable without a
/// migration. That is the one place this schema prefers openness — every
/// other state column in this file stays an explicit enum.
///
/// Staleness is a READ, never a delete (ADR-035 §6 — "stale edges dim,
/// never silently vanish"). A member that stops announcing keeps its row
/// with `lastSeen` frozen at the last real observation; the reconciler has
/// no delete path at all. That is what makes "the switch dropped off the
/// fabric at 10:05" answerable instead of indistinguishable from "the
/// switch was never here".
model FabricMember {
  /// Wired management-interface MAC, canonical `AA:BB:CC:DD:EE:FF`.
  anchorMac String   @id
  /// `router` | `switch` | `ap` | … — free-form by design (see above).
  role      String
  /// Product string as announced (`Zyxel GS1900-10HP`, `Raspberry Pi 5
  /// Model B`, …). Null until a member announces one.
  model     String?
  /// Firmware/overlay version as announced. Diverging versions across the
  /// fabric are a dashboard yellow flag; nothing here auto-upgrades.
  version   String?
  /// Last IPv4 the member was observed at. A property of the observation,
  /// not an identity — ADR-035 §2 forbids keying on it.
  lastIp    String?
  /// Last hostname the member announced.
  hostname  String?
  /// Switch-only PoE facts, parsed from the `poe_ports` / `poe_budget`
  /// TXT keys the GS1900 already advertises (and which, before ADR-035,
  /// were consumed by nothing). Null on every non-PoE member — null means
  /// "not advertised", never "zero ports".
  poePorts  Int?
  poeBudget Int?
  /// First time the orchestrator ever saw this anchor MAC. Write-once.
  firstSeen DateTime @default(now())
  /// Last time this member was present in a poll. The staleness signal.
  lastSeen  DateTime @default(now())

  @@index([role])
  @@index([lastSeen])
}

/// WARP-1761 (ADR-035 §1/§7) — the INTENDED state of a fabric-owned config
/// domain. One row per domain key; `wifi.primary` is the first and, today,
/// the only one.
///
/// ADR-035 §1 draws a hard line this model sits on one side of:
///   * **observed** state — "what IS the AP broadcasting" — is read LIVE off
///     the device on every request and is never cached here; and
///   * **intended** state — "what SHOULD it broadcast" — lives here.
/// The two are rendered side by side plus the delta. This table must NEVER
/// be read by a display path: the moment intent answers "what is my Wi-Fi
/// called", drift stops being visible and starts being hidden, which is the
/// exact failure ADR-035 exists to kill. `getApWifi()` keeps dialing the AP.
///
/// Why it exists: before this table a Wi-Fi write was a synchronous RPC at
/// one device. An unreachable AP (the lab unit was, for ~20 minutes, during
/// a firmware experiment) meant the call failed and the operator's intent
/// was DISCARDED with nothing left to retry. Now the write records intent
/// and still pushes; if the push fails the intent remains and the converger
/// applies it when the device comes back.
///
/// `value` is Json so a domain can carry a shape without a migration per
/// domain — but it is a small, closed, documented shape per key, never a
/// junk drawer. For `wifi.primary` it is exactly `{ "ssid": string }`.
///
/// **No secret ever lands in `value`.** The Wi-Fi passphrase is deliberately
/// NOT stored: the orchestrator has never persisted one (the audit writer
/// redacts it via `redactSecretParams`, the Tier-2 pending record that
/// carries it is in-memory with a 60 s TTL, and `ApDevice` stores only the
/// approval-time `approvedSsid`), and this ticket is not the place to open a
/// durable Wi-Fi-secret surface. Passphrase convergence waits for the
/// per-device escrow rows of ADR-035 §3. Passphrase WRITES are unchanged:
/// they still push directly, exactly as before.
///
/// `generation` is monotonic and bumped atomically (`{ increment: 1 }`) on
/// every write, so the converger can distinguish "this device already
/// applied the current intent" from "this device is behind". Rows are never
/// deleted (ADR-035 §6) — a domain that stops being written keeps its last
/// intent rather than silently reverting to "no opinion".
model NetworkIntent {
  /// Domain key, dot-namespaced: `wifi.primary` today. A bare String, not
  /// an enum, for the same reason `FabricMember.role` is — ADR-035 §7 lists
  /// six more domains (VLANs, DHCP, band steering, …) and a new one must be
  /// storable without a migration.
  key        String   @id
  /// The intended fact. Closed shape per key; `{ "ssid": string }` for
  /// `wifi.primary`. Never holds a secret (see above).
  value      Json
  /// Monotonic, incremented on every write. Never reset, never decremented.
  generation Int      @default(0)
  /// `User.id` of the last writer, or null for a write with no authenticated
  /// principal. Audit only — nothing branches on it.
  writtenBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// WARP-1761 (ADR-035 §7) — per-device convergence bookkeeping: how far a
/// single fabric member has got with a single intent key.
///
/// Keyed on `(anchorMac, key)` — the same anchor MAC that is `FabricMember`'s
/// primary key (ADR-035 §2), canonicalized through `src/lib/mac.ts`
/// `normalizeMac`. No FK: `FabricMember` is an observation ledger whose rows
/// may lag or lead this one, and a convergence record must not be deletable
/// as a side effect of inventory churn.
///
/// All three data columns are OBSERVATION TIMESTAMPS / values, not a state
/// machine — there is deliberately no derived-state column, and nothing
/// infers status from a NULL. Read them as facts:
///   * `appliedGeneration` — the `NetworkIntent.generation` this device was
///     last VERIFIED to be running. Null = never yet verified.
///   * `lastVerifiedAt`    — when that verification happened.
///   * `driftDetectedAt`   — the last time the device was found disagreeing
///     with intent. It is NEVER cleared: ADR-035 §6's "stale observations
///     dim, they do not vanish" applied to drift. A dashboard shows drift as
///     current by comparing it against `lastVerifiedAt`, and "this AP was
///     edited in LuCI at 14:02 and repaired at 14:03" stays answerable
///     instead of collapsing into "nothing ever happened".
///
/// Rows are never deleted, consistent with `FabricMember`.
model DeviceIntentState {
  /// Wired management-interface MAC, canonical `AA:BB:CC:DD:EE:FF`.
  anchorMac         String
  /// The `NetworkIntent.key` this row tracks.
  key               String
  /// Last generation VERIFIED on the device. Null = never verified.
  appliedGeneration Int?
  /// When the device was last read and found to match intent.
  lastVerifiedAt    DateTime?
  /// When the device was last found NOT to match. Never cleared.
  driftDetectedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@id([anchorMac, key])
  @@index([key])
}

// ── WARP-455: A1 Local user directory + scope bindings + guest time-box ──
//
// `User` is the local household-directory record. ADDITIVE on top of the
// Nextcloud-OCS auth fallback in middleware/auth.ts — it does not replace
// OCS-validated sessions. A row here represents a person the household
// has deliberately registered through the dashboard's People surface;
// the Nextcloud fallback continues to populate `req.user` for legacy
// sessions that haven't yet been mirrored locally.
//
// `role` references the WARP-171 `Role` enum (mirrors the TS `Role`
// union in src/services/jwt.service.ts). No new role enum — that was
// the contract from ADR-004 §1.
//
// `isLocal=true` marks records minted in this table. Nextcloud-mirrored
// rows (future ticket) would set `isLocal=false` and the delete handler
// refuses to mutate the OCS-owned identity. Today every row is local;
// keeping the column lets the dashboard render the "Local" vs "OCS"
// affordance without a schema migration when mirroring lands.
model User {
  id                 String              @id @default(uuid())
  // Login handle. Unique across the directory. For Nextcloud-mirror
  // rows this matches the OCS user id so `req.user.username` from the
  // auth middleware resolves directly to this row.
  username           String              @unique
  displayName        String
  // ADR-013: email is the stable directory login key — the Aurora login
  // (PR #370) sends "Work email" as the identifier and POST /auth/login
  // resolves the row by email before the argon2id verify. Unique so two
  // rows can't both claim one login identity (an auth ambiguity).
  // Still nullable: service-only principals and locally-minted rows that
  // predate ADR-013 may have no email; the login route fails closed when
  // email or passwordHash is null.
  /// WARP-233 @encrypted(aes-256-gcm, key=hkdf:user-email-column): `email` stores a dcv1:
  /// blob (write path: column-crypto.service.ts encryptColumn; read path:
  /// decryptColumn). Equality lookups go through emailLookupHash — a
  /// deterministic HMAC-SHA256 blind index over trim+lowercase(email); the
  /// plaintext-uniqueness guarantee moves there because GCM ciphertext is
  /// non-deterministic. `@unique` dropped from email for that reason.
  email              String?
  /// WARP-233 — HMAC-SHA256 blind index over trim+lowercase(email). Carries
  /// the plaintext-uniqueness guarantee that email's @unique used to hold.
  /// Nullable: service-only principals without an email stay null (Postgres
  /// treats NULLs as distinct, matching the old email @unique semantics).
  emailLookupHash    String?             @unique
  // ADR-013: argon2id PHC hash — the built-in directory is the auth
  // source of truth (Nextcloud is demoted to downstream WebDAV
  // provisioning). Written at account-creation (/auth/setup, invite
  // accept) and verified at /auth/login via password.service. NEVER
  // contains plaintext; NEVER logged. Nullable because service-only
  // principals and pre-first-login invitees may not have one yet — the
  // login route fails closed (no enumeration leak) when it's null.
  passwordHash       String?
  // WARP-485: stable mapping key from the Nextcloud OCS user id
  // (`ocs.data.id`, e.g. `stefan-cruceru`) to this row's UUID. The auth
  // middleware looks up `User` by `nextcloudUsername` on the OCS
  // fallback path so `req.user.id` is always a local User.id UUID,
  // regardless of whether the session originated from a JWT or an OCS
  // token. Nullable because locally-minted rows that never authenticate
  // via Nextcloud (service-only users, fresh invitees pre-first-login)
  // don't have one. Unique because two local Users mapping to the same
  // OCS identity would create an authentication ambiguity. Distinct
  // from `username` to keep the local display handle decoupled from the
  // OCS-mapping key — they often match today but the dashboard may
  // edit `username` in the future without breaking OCS resolution.
  nextcloudUsername  String?             @unique
  role               Role                @default(family)
  // Locally provisioned vs. mirrored from Nextcloud. Today every row
  // is local — the dashboard's People surface is the only writer. The
  // delete handler refuses when isLocal=false to keep OCS-owned
  // identities off-limits.
  isLocal            Boolean             @default(true)
  // WARP (SCIM directory sync): soft-deactivation status. Defaults ACTIVE
  // so every existing + password/SSO-created row is unaffected. SCIM sets
  // DEACTIVATED on `active:false` / DELETE (soft — never a row delete) and
  // back to ACTIVE on re-activate. The login route + SSO callback fail
  // closed when this is DEACTIVATED. Explicit enum, never IS-NULL-derived.
  directoryStatus    DirectoryUserStatus @default(ACTIVE)
  // WARP-2858: where this account was CREATED — written once, by the path
  // that minted the row, never inferred from a null `passwordHash` or
  // `nextcloudUsername`. SSO / SCIM rows authenticate through the IdP only:
  // the box refuses to set, change or verify a local password on them,
  // because a local password is a login the IdP's disable/deprovision cannot
  // reach. A LOCAL row that later links an SSO identity stays LOCAL.
  provisionSource    UserProvisionSource @default(LOCAL)
  // WARP-3113 — leaver deletion. Delete never purges a person's files on the
  // spot: it parks the row (already DEACTIVATED) on PENDING with a due date,
  // and the nightly leaver-deletion job completes the removal after the
  // retention window. PURGING is the job's claim, so an admin's cancel can
  // never land between the Nextcloud delete and the row delete. Explicit
  // enum, never derived from a null `deletionDueAt`. WARP-3169: HANDING_OVER
  // holds the row while a hand-over's file transfer runs; the previous value
  // is restored if the transfer fails.
  deletionStatus      UserDeletionStatus @default(NONE)
  deletionDueAt       DateTime?
  deletionRequestedBy String?
  // WARP-3176 — when the current HANDING_OVER or PURGING claim was taken
  // (null on NONE / PENDING). It is the claim's token: every later write by
  // the request that took it is pinned to it, and the stale-claim sweep and
  // the nightly retry age it (never inferred from updatedAt).
  // `handoverPriorStatus` is the NONE|PENDING value a HANDING_OVER claim
  // replaced, so a released claim never silently cancels a scheduled
  // retention delete; `handoverRecipientId` names who was receiving.
  deletionClaimedAt   DateTime?
  handoverPriorStatus UserDeletionStatus?
  handoverRecipientId String?
  // WARP-824: admin-created users get a temporary password and must change
  // it on first login. This is the EXPLICIT persistent signal for that gate
  // — never derived from password age, a null/sentinel hash, or "row was
  // created by an admin" inference (project no-guessing rule; same posture
  // as `directoryStatus` above and `TotpCredential.confirmedAt`). Set true
  // by POST /auth/users when the operator leaves "require change on first
  // login" on (the default); cleared to false by POST /auth/change-password
  // once the user picks their own password. The post-auth gate
  // (`requirePasswordChangeGate`) reads this FRESH from the row on every
  // request, so it can't be bypassed by a stale/forged JWT. Defaults false so
  // every existing row + self-service signup (/auth/setup, invite-accept) is
  // unaffected.
  mustChangePassword Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Many-to-many to Group via GroupMembership (explicit join model
  // so future per-membership metadata — joinedAt, addedBy — has a
  // place to land).
  memberships         GroupMembership[]
  // Per-user scope bindings — controls which scopes this user can
  // act inside via requireScope() (see src/middleware/scope.ts).
  scopeBindings       ScopeBinding[]
  // Optional guest time-box. Non-null when this user was minted as a
  // guest with an expiry; the nightly `guest-expiry-sweep` cron walks
  // GuestExpiry rows directly (no IS-NULL guessing — status is an
  // explicit enum on GuestExpiry).
  guestExpiry         GuestExpiry?
  // ADR-013 (SSO OIDC): external-IdP identities (Google / Entra / Okta)
  // linked to this local user. A user may have several (e.g. both Google
  // and Entra resolve to the same work email → both link to one local row).
  // The link preserves this row's UUID — SSO never mints a second local
  // User for an email that already has one.
  ssoIdentities       SsoIdentity[]
  // PR #377 (WARP-___): FIDO2/WebAuthn passkeys registered to this user.
  // A user may enrol several (a platform authenticator on the laptop, a
  // roaming security key, the phone's passkey). Each row carries its own
  // signature counter for clone detection. Deleting the user cascades the
  // credentials (see WebAuthnCredential.user onDelete: Cascade).
  webauthnCredentials WebAuthnCredential[]
  // PR #377: outstanding WebAuthn challenges minted FOR this user (the
  // registration ceremony, and any authenticate ceremony where the email
  // was supplied up front). Anonymous passwordless-authenticate challenges
  // have a null userId, so they are NOT in this relation.
  webauthnChallenges  WebAuthnChallenge[]
  // WARP-2767: calendar ICS feed links ("subscribe on my phone"). Deleting
  // the user cascades them, so a reused username can never inherit an old
  // link (see CalendarFeedToken).
  calendarFeedTokens  CalendarFeedToken[]
  // WARP-3452: coding-tool tokens for the local model API (`/llm/`). Deleting
  // the user cascades them; deactivation revokes them (see ModelAccessToken).
  modelAccessTokens   ModelAccessToken[]
  // WARP-3533: personal API tokens for /api/pm and /api/support (`dpm_…`).
  // Deleting the user cascades them; deactivation and a role change revoke
  // them (see PmApiToken).
  pmApiTokens         PmApiToken[]

  // PR #375 — TOTP second factor (ADR-013 directory). One credential row
  // per user (the secret is encrypted at rest). `confirmedAt` is the
  // explicit "TOTP enabled" signal — the login gate reads it directly
  // rather than inferring enablement from row presence.
  totpCredential TotpCredential?
  // One-time recovery codes (argon2id-hashed). Consumed rows keep an
  // explicit `usedAt` so a replay matches nothing.
  recoveryCodes  RecoveryCode[]

  // WARP-1255: department membership (per-user rights per department).
  departmentMemberships DepartmentMembership[]
  // WARP-1255: per-user storage/usage policy (quota, upload cap, LLM cap).
  usagePolicy           UserUsagePolicy?
  // WARP-2981 (DS-003): the department this person's shell is arranged
  // around. Absent = Whole business, the default for everyone (DS-014).
  activeDepartmentChoice ActiveDepartmentChoice?

  // ADR-032 / WARP-1525 (RBAC v2): optional custom access role. Null = plain
  // built-in tier — today's world, fully backward compatible. Assigning a
  // role sets `role = accessRole.startingPoint` in the same transaction (T3)
  // so the ADR-004 enum floor stays authoritative. onDelete Restrict (not
  // SetNull/Cascade): deleting an in-use role is blocked server-side
  // ("reassign first") and the DB backs that up — a role delete must never
  // silently strip or downgrade a person's assignment.
  accessRoleId     String?
  accessRole       AccessRole?           @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)
  // WARP-3263: the person who brought this account onto the box: the invite's
  // issuer (stamped at invite accept) or the admin who created it directly
  // (POST /auth/users). An explicit id, never inferred from usernames or
  // timestamps. Null when nobody did (setup owner, SSO/SCIM) or when that
  // person was later deleted (SetNull), so a new hire reusing the old
  // username is never mistaken for the inviter. An external guest's Messages
  // roster shows this person.
  invitedById      String?
  invitedBy        User?                 @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees         User[]                @relation("UserInvitedBy")
  // ADR-032 / WARP-1525: per-person feature-axis exceptions (design D-A, v1).
  accessExceptions UserAccessException[]
  // WARP-2748 (ADR-051): findings assigned to this person. SetNull on the
  // owning side — removing a person must not delete the business's findings.
  // WARP-2748: findings ASSIGNED to this person (SetNull — removing someone
  // must not delete the business's findings).
  brainFindings      BrainFinding[]
  // WARP-2752: personal-scope rows this person OWNS. Distinct relations, and
  // distinct delete behaviour: an owned row is Cascade because `ownerId` is an
  // access-control key, where an assignment is mere provenance.
  brainFindingsOwned BrainFinding[] @relation("BrainFindingOwner")
  brainDigestsOwned  BrainDigest[]  @relation("BrainDigestOwner")
  // WARP-2251: the user's own morning briefings, one per box-local day.
  morningBriefings   MorningBriefing[]

  @@index([role])
  @@index([accessRoleId])
}

/// ADR-013 (SSO OIDC) — maps an external IdP identity to a LOCAL User.
///
/// `subject` is the IdP's stable `sub` claim (NOT the email — emails can
/// be reassigned at the IdP, `sub` cannot). `(provider, subject)` is
/// unique so one IdP identity resolves to exactly one local user; a
/// second local row claiming the same identity would be an auth
/// ambiguity. `userId` FKs to `User` so the link is referential and the
/// existing `User.id` UUID is preserved (consistent with WARP-485 —
/// JWT.sub / Redis keys stay on the UUID).
///
/// Account-linking policy (route): on callback we resolve the validated
/// `sub` here first; on a hit we sign in that user. On a miss we look up
/// the local User by NORMALIZED email (#374 trim+lowercase) — if one
/// exists we LINK (create this row pointing at it), else we CREATE the
/// local User per the directory model and link. We never create a
/// login-unable row.
model SsoIdentity {
  id        String   @id @default(uuid())
  userId    String
  provider  String // "google" | "entra" | "okta"
  subject   String // IdP 'sub' claim (OIDC SSO) or SCIM resource id (directory provisioning)
  // Email seen at link time (already normalized). Audit/debug only — the
  // login key on User.email remains authoritative; this is not a second
  // source of truth.
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// ADR-013 (SSO OIDC) — server-side, single-use, time-bound login state.
///
/// The OIDC `state` (CSRF) + `nonce` (ID-token replay) + PKCE
/// `codeVerifier` are minted at /sso/oidc/authorize and persisted HERE,
/// not in the redirect or a client-readable cookie. The browser only
/// carries the opaque `state` (in the authorize redirect and matched back
/// at /callback), so a tampered or replayed callback can't smuggle its
/// own nonce/verifier.
///
/// Single-use: `consumedAt` is stamped the moment the callback claims the
/// row (same idiom as UserInvite.acceptedAt — the established single-use
/// pattern in this codebase). A second callback with the same `state`
/// finds `consumedAt` already set and is rejected. Time-bound:
/// `expiresAt` (short, ~10 min) bounds the authorize→callback window so
/// an abandoned flow can't be resumed later. A periodic sweep can delete
/// expired rows; correctness does not depend on the sweep (the callback
/// re-checks `expiresAt`).
model SsoLoginState {
  id           String    @id @default(uuid())
  state        String    @unique
  nonce        String
  codeVerifier String
  provider     String // "google" | "entra" | "okta"
  // Where to send the browser after a successful sign-in (defaults to
  // "/"). Validated to a same-origin relative path at issue time so it
  // can't become an open redirect.
  returnTo     String    @default("/")
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  // ── Native handoff (RFC 8252) — the native Windows client's SSO leg ──
  // The IdP still redirects to the box callback (ADR-016); a NATIVE row then
  // hands the result to the app's own redirect instead of setting cookies.
  // Which leg the callback takes is this explicit column, never derived from
  // `nativeRedirectUri` being null. A migration CHECK pins that a NATIVE row
  // always has its redirect + challenge.
  flowKind            SsoFlowKind @default(BROWSER)
  // http://127.0.0.1:<port>/<path>, http://[::1]:<port>/<path> or
  // droplet://sso/callback — validated at /sso/oidc/native/begin.
  nativeRedirectUri   String?
  // The app's PKCE S256 challenge for the handoff (43-char base64url). Not
  // the IdP-side verifier above, which never leaves the box.
  nativeCodeChallenge String?
  // sha256 (hex) of the single-use consent value the callback embedded in the
  // consent page (ADR-063 S5). Set by the callback, cleared when Continue
  // claims it; the page lives as long as `expiresAt` (10 minutes). Plaintext
  // is never stored.
  nativeConsentHash   String?     @unique
  // sha256 (hex) of the one-time handoff code; the plaintext is never stored.
  handoffCodeHash     String?     @unique
  // Local User.id the callback resolved (parked with the consent value, before
  // any code exists); re-read at redemption.
  handoffUserId       String?
  // 60 s after Continue minted the code (ADR-063 S5), not after the callback.
  handoffExpiresAt    DateTime?
  // Single-use stamp for the redemption (same idiom as `consumedAt`).
  handoffConsumedAt   DateTime?

  @@index([expiresAt])
}

/// Which leg an SSO login state finishes on. BROWSER: the dashboard flow
/// (state cookie + session cookies). NATIVE: the RFC 8252 handoff to a
/// native app's loopback / droplet:// redirect, redeemed with PKCE at
/// POST /api/sso/oidc/native/token.
enum SsoFlowKind {
  BROWSER
  NATIVE
}

// PR #375 — TOTP (RFC 6238) enrollment for the built-in directory's
// second factor. One row per user; created on enroll, marked enabled on
// the first successful verify.
model TotpCredential {
  id          String    @id @default(uuid())
  // FK to the owning directory user. Unique → at most one TOTP secret
  // per account. Cascade-delete so removing a user clears their factor.
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The Base32 TOTP secret, encrypted at rest with the aes-256-gcm
  // encryption.service (DEVICE_SECRET_KEY). NEVER plaintext; NEVER logged.
  secretEnc   String
  // Explicit enablement signal (no IS-NULL inference for state — project
  // rule). Null while enrollment is pending; set to the verify timestamp
  // on the first successful code. The login gate requires TOTP only when
  // this is non-null.
  confirmedAt DateTime?
  // WARP-3193 SEC-AUTH-10 — the RFC 6238 time step (unix seconds / 30) of
  // the last code accepted. A code is accepted only through a conditional
  // update `lastAcceptedStep < step`, so each code works at most once.
  // 0 = no code accepted yet (step 0 is 1970; no live code can match it).
  lastAcceptedStep Int     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// PR #375 — one-time backup codes for the TOTP factor. Each row stores an
// argon2id hash (reusing password.service); the plaintext is shown to the
// user exactly once at generation. Single-use: `usedAt` is stamped on
// consumption so a replay of the same code matches no unused row.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // argon2id PHC hash of the code. NEVER plaintext; NEVER logged.
  codeHash  String
  // Explicit consumption marker (no IS-NULL state inference). Null = the
  // code is still spendable; non-null = already used at that timestamp.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // The login/recovery path scans a user's UNUSED codes — index the
  // hot lookup key.
  @@index([userId])
}

/// WARP (SCIM directory sync) — a group Okta pushed to the box via
/// `/scim/v2/Groups`. We persist the group so role mapping is idempotent
/// across Okta's retries and survives restarts (the mapping is not derived
/// on the fly from a request body that may arrive in any order).
///
/// `externalId` is Okta's stable group id (the SCIM `id` we mint is this
/// row's `id`; `externalId` is the IdP-side id when supplied). `displayName`
/// is the human group name ("Droplet Admins"). `mappedRole` is the LOCAL
/// Role this group grants — resolved from the group's display name via the
/// explicit policy in scim-role-mapping.service.ts (default least-privilege
/// `family`). A user's effective role is the HIGHEST-privilege mapped role
/// across the groups they belong to (computed at provisioning time, written
/// to User.role), so a member of both "Admins" and "Everyone" lands on
/// owner, not family.
model ScimGroup {
  id          String   @id @default(uuid())
  // Okta-side stable id (SCIM `externalId`). Unique so retries upsert the
  // same row instead of forking duplicates. Nullable because a minimal SCIM
  // client may omit it; when absent we key on displayName.
  externalId  String?  @unique
  displayName String   @unique
  // The local Role this group grants. Explicit column (not recomputed from
  // displayName on every read) so an operator override survives re-sync.
  mappedRole  Role     @default(family)
  // WARP-3631: local User.ids in the group as of the last push, so a person
  // dropped from a push can be demoted (the group's grant is recomputed from
  // the groups they remain in).
  memberUserIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mappedRole])
}

// User-curated grouping (households, family branches, work cohorts).
// Many-to-many to User via GroupMembership.
/// @deprecated dead code — dropped post-GA (WARP-1273)
model Group {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupMembership[]
}

/// @deprecated dead code — dropped post-GA (WARP-1273)
/// Explicit join table — `(userId, groupId)` unique so a user can't be
/// listed twice in the same group. `joinedAt` lets the dashboard show
/// "added X days ago" without a separate audit query.
model GroupMembership {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

// ── WARP-455: Scope axis (second RBAC axis on top of WARP-171's Role) ──
//
// `Scope` is a pgEnum (not a separate Scope table) by design. The set is
// small and fully known up front; the requireScope() middleware switches
// on these values directly. Adding a new scope is a schema migration —
// that's the desired velocity. A table would invert the cost: trivial to
// add a row, expensive to keep code and data in sync.
//
// Values:
//   - team        — household-wide default (every resource lands here
//                   absent an explicit binding). Most files, devices,
//                   chats sit at this scope.
//   - exec_only   — leadership-tier (founders + COO peers). Private
//                   docs, finance summaries, board prep.
//   - finance     — bookkeeping, invoices, payroll.
//   - engineering — code + technical-ops docs (mirror of the GH org).
//   - ops         — runbooks, vendor records, day-to-day operations.
//   - private     — user-owned, never shared. The dashboard hides
//                   resources at this scope from anyone other than
//                   the owner; service principals never see them.
enum Scope {
  team
  exec_only
  finance
  engineering
  ops
  private
}

/// WARP-1255: per-department member access rights. One level: a user has one
/// right level per department, and that right determines what operations they
/// can perform on the department's files and shared resources.
enum DepartmentRight {
  reader // list/download/search/read metadata
  contributor // + upload/mkdir/rename/move/copy/delete/trash/versions/favorite
  manager // + create shares on dept content, manage dept membership (absorbs WARP-1245)
}

/// WARP-2976 (ADR-059 P1): which arrangement a department's profile starts
/// from. A template is DATA — default nav destinations and home widgets the
/// dashboard seeds a profile with; the owner or the department's manager edits
/// both afterwards. It grants nothing: what a person may reach is still ADR-032
/// + CameraAccessGrant. `custom` is an explicit choice, not a fallback.
enum DepartmentTemplate {
  sales
  finance
  operations
  front_desk
  it
  custom
}

/// WARP-1255: department hierarchy kind. Departments are top-level; teams nest
/// one level deep inside them. Household is the legacy WS-5 system department.
enum DepartmentKind {
  HOUSEHOLD // the seeded WS-5 system department — legacy NC group adopted verbatim (zero NC mutation)
  DEPARTMENT
  TEAM // 2026-07-11 amendment: nested one level under a DEPARTMENT parent
}

/// WARP-1255: department provisioning lifecycle. Departments move through this
/// state machine from creation (pending) → syncing (provisioning) → active (or failed).
///
/// WARP-1257: `failed` is the PROVISION-intent failure state; `archive_failed`
/// is the ARCHIVE-intent failure state. The reconciler routes a failed row's
/// retry on which of the two it is, so a transient NC error mid-archive is
/// retried down the archive path (never silently re-provisioned back to active).
/// Explicit-state-per-intent, not a guess derived from an overloaded `failed`.
enum ProvisionState {
  pending
  provisioning
  active
  failed
  archiving
  archived
  archive_failed
}

/// WARP-1255: Nextcloud sync state for memberships and usage policies. Tracks
/// whether the local Prisma row has been synced to NC (groups, permissions, quotas).
///
/// WARP-1257: `failed` is the SYNC-intent failure state; `remove_failed` is the
/// REMOVAL-intent failure state. A membership removal that fails partway retries
/// down the removal path (never silently re-synced, which would re-grant revoked
/// access). Explicit-state-per-intent, not a guess derived from an overloaded `failed`.
enum NcSyncState {
  pending
  synced
  failed
  removing
  remove_failed
}

/// ADR-032 / WARP-1525 (RBAC v2): action level carried by an AccessRole
/// feature grant (axis a+b) or an allow-exception. The catalog tiers
/// (ADR-032 §9): view (read surfaces) → act (day-to-day operations) →
/// manage (admin operations). The service layer (T3) clamps a grant's level
/// to the catalog ceiling of the role's `startingPoint` — the ADR-004 floor.
enum FeatureAccessLevel {
  view
  act
  manage
}

/// ADR-032 / WARP-1525 (RBAC v2): per-tool-domain level for an AccessRole
/// tool grant (axis d, on-box). Absence of a grant row = domain OFF for the
/// role — never inferred, the resolver (T5) treats no-row as no-access.
///   - view — the domain's read-only tools.
///   - use  — the domain's full tool set (write tools remain subject to the
///            tier write-filter and handler-side confirmations).
enum ToolAccessLevel {
  view
  use
}

/// ADR-032 / WARP-1525 (RBAC v2): per-connector level for an AccessRole
/// connector grant (axis d, off-box). Absence of a grant row = none.
/// `read_write` is only selectable on Admin-based roles (decision O-2) and
/// always sits UNDER IntegrationConnection.writeEnabled + the staged-outbox
/// human confirm — role grants only ever narrow, never widen.
enum ConnectorAccessLevel {
  read
  read_write
}

/// ADR-032 / WARP-1525 (RBAC v2): effect of a per-person feature exception
/// (design D-A — feature axis only in v1). `allow` grants a module on top of
/// the person's role (with a required `level`, service-enforced); `deny`
/// removes one the role grants. Exceptions can never escape the ADR-004
/// floor — the T3 resolver clamps them like role grants.
enum AccessExceptionEffect {
  allow
  deny
}

// User ↔ Scope many-to-many. A user can be bound to any subset of the
// six scopes; the unique constraint stops the same scope from being
// added twice for the same user.
//
// Owner / admin roles always pass requireScope() regardless of bindings
// (they hold every scope by definition — see ADR-004 §3 for the
// admin-tier-passes-every-write contract). Family / guest must have an
// explicit binding for the resource's scope; family at `team` is the
// default seed for new household members.
model ScopeBinding {
  id        String   @id @default(uuid())
  userId    String
  scope     Scope
  // Who granted this binding. Audit-only; the dashboard renders
  // "granted by Alice 3 days ago" from this pair.
  grantedBy String?
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@index([userId])
  @@index([scope])
}

// ── WARP-455: Guest time-box ──
//
// Guests are time-boxed: every guest User has at most one GuestExpiry
// row carrying `expiresAt` and an explicit `status` enum. The nightly
// cron (cron-runtime `guest-expiry-sweep`) walks rows where
// `status = ACTIVE AND expiresAt < now()`, denylists their JWT via
// jwt.service, flips them to EXPIRED, and emits an ActivityRow.
//
// Per the no-guessing rule (CLAUDE.md): `status` is an explicit Prisma
// enum. Deriving "is this guest expired" from `expiresAt < now()` at
// read time would (a) duplicate the derivation rule across every
// reader and (b) leak the cron's tick cadence into UX (a guest is
// only "expired" once the cron has actually denylisted their session).
// WARP-218's BrainMemoryItemStatus is the canonical precedent.
model GuestExpiry {
  id        String            @id @default(uuid())
  userId    String            @unique
  // When the guest's session should be revoked. The cron sweep
  // compares this against `now()` and flips status when it's past.
  expiresAt DateTime
  status    GuestExpiryStatus @default(ACTIVE)
  // When the cron actually flipped the row to EXPIRED. Non-null
  // only when status = EXPIRED. Useful for the dashboard's
  // "expired N hours ago" copy without re-querying ActivityRow.
  expiredAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([status, expiresAt])
}

/// WARP-455: lifecycle of a guest's time-box.
///   - ACTIVE   — session is live; the cron has not flipped this row yet.
///   - EXPIRED  — terminal. The cron ran AFTER expiresAt, denylisted the
///                guest's JWT, and emitted an `auth`-kind ActivityRow.
enum GuestExpiryStatus {
  ACTIVE
  EXPIRED
}

/// PR #377 (WARP-___): a registered FIDO2/WebAuthn credential (passkey or
/// roaming security key) bound to a directory User (ADR-013).
///
/// Phishing-resistant, passwordless sign-in alternative to the argon2id
/// login (PR #374). The orchestrator never sees a private key — only the
/// public key the authenticator emits at registration, plus the rolling
/// `counter` used for clone detection.
///
/// Stored fields map 1:1 onto `@simplewebauthn/server`'s `WebAuthnCredential`
/// shape: `credentialId` (its `id`), `publicKey`, `counter`, `transports`.
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  // The authenticator's credential id, base64url-encoded. Globally unique
  // — the same physical authenticator must not be registered twice, and
  // the authenticate ceremony looks the credential up by this value.
  credentialId String    @unique
  // COSE public key bytes emitted at registration. NOT a secret (it's the
  // public half), but treated as opaque and never logged.
  publicKey    Bytes
  // Signature counter. Monotonic clone-detection signal: the authenticator
  // increments it on every assertion. A verify whose `newCounter` is not
  // strictly greater than the stored value (when the stored value is > 0)
  // means a cloned authenticator — the assertion is rejected and this row
  // is left untouched. `@simplewebauthn/server` enforces the comparison;
  // we persist the returned `newCounter` on every successful assertion.
  counter      Int       @default(0)
  // CSV of AuthenticatorTransportFuture values ("usb,nfc,ble,internal,
  // hybrid"). Optional — older authenticators omit it. Used only as a UX
  // hint to the browser on the next authenticate ceremony.
  transports   String?
  // WARP-1157: owner-chosen label shown in Settings. NULL until renamed.
  name         String?
  // WARP-1157: the RP ID (host) this passkey was created on — passkeys only
  // work on that address. NULL only for rows enrolled before it was recorded.
  rpId         String?
  createdAt    DateTime  @default(now())
  // Bumped on every successful assertion so the dashboard can show
  // "last used 3 days ago" without a separate audit query.
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// PR #377 (WARP-___): a single-use, time-bound WebAuthn ceremony challenge.
///
/// Replay defence for both the registration and authentication ceremonies.
/// The server mints a random challenge, persists it here with an `expiresAt`,
/// and hands the base64url challenge to the browser. On verify the row is
/// looked up by `challenge`, checked for expiry, and DELETED — so a captured
/// challenge can never be replayed (single-use = consume-by-delete;
/// time-bound = expiresAt). A short background sweep prunes abandoned rows.
///
/// `userId` is non-null for the registration ceremony (you register a passkey
/// for the signed-in user) and null for the passwordless authenticate
/// ceremony (no user is known until the assertion resolves the credential).
model WebAuthnChallenge {
  id        String                @id @default(uuid())
  // The base64url challenge handed to the browser. Unique so a verify can
  // resolve exactly one row, and so two ceremonies can't collide.
  challenge String                @unique
  // Which ceremony this challenge belongs to. Explicit enum (no guessing
  // from the presence/absence of userId) so verify can refuse a challenge
  // minted for the wrong ceremony — a registration challenge must not be
  // accepted by the authenticate verify and vice-versa.
  type      WebAuthnChallengeType
  // Non-null for registration (bound to the signed-in user). Null for the
  // passwordless authenticate ceremony.
  userId    String?
  // Hard expiry. Verify rejects (and deletes) any row past this instant.
  expiresAt DateTime
  createdAt DateTime              @default(now())
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

/// PR #377: which WebAuthn ceremony a challenge was minted for. Keeps the
/// registration and authentication challenge pools from cross-contaminating
/// (a register challenge must never satisfy an authenticate verify).
enum WebAuthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

// ── WARP-455: File scope registry ──
//
// The orchestrator does not own file bytes — Nextcloud does. This `File`
// model is a thin scope-bearing registry keyed by Nextcloud's stable
// `ncFileId`, the same identifier `FileContentChunk.ncFileId` already
// uses. It exists so the dashboard's scope-filtered file surfaces can
// JOIN one row per logical file instead of scanning per-chunk rows for
// distinct ncFileIds.
//
// `scope` is an explicit Scope enum column, defaulting to `team` so a
// new file (e.g. a Nextcloud upload caught by the file-indexer) lands
// at the household-wide default without an explicit POST from the
// dashboard. Operators tighten the scope from there via PATCH (in a
// follow-up ticket — this ticket only ships the model + backfill).
//
// `ownerUserId` carries the file's owner (Nextcloud username; matches
// the convention everywhere else — FileContentChunk.userId,
// BrainMemoryItem.userId). The dashboard's per-user file lists join on
// this column; the scope-filter pass narrows the join result by the
// caller's ScopeBinding set.
model File {
  id           String   @id @default(uuid())
  ncFileId     Int      @unique
  ownerUserId  String
  departmentId String? // WARP-1255: department this file belongs to (null = personal/household)
  scope        Scope    @default(team)
  // Cached path for display, as of the upload that wrote the row. Nothing
  // refreshes it on a rename or move (WARP-2096 Leg 5), so treat it as a hint
  // and confirm it against Nextcloud before relying on it.
  path         String?
  // WARP-2096: SHA-256 (hex) of the bytes, computed while the upload streams
  // through, and their length. Null for rows written before it or outside
  // POST /files/upload. The (owner, sha256) index is deliberately NOT unique:
  // a second copy of the same bytes is a legitimate file, so duplicates are
  // reported to the uploader, never refused by the database.
  sha256       String?
  sizeBytes    BigInt?
  // WARP-3425: whether Nextcloud still has this file. Rows are written on
  // upload, and a delete by any path (Files, Nextcloud, a sync client, a trash
  // purge, a wiped folder) used to leave them claiming the file existed.
  // `reconcileFileRegistry` (file-registry.service.ts) sets `missing` only
  // after a SUCCESSFUL read of Nextcloud's file cache did not contain
  // `ncFileId`, and sets `live` again if the id comes back (a Nextcloud
  // restore); an upload always writes `live`. A file in the trash bin is still
  // `live`: it keeps its id and can be restored.
  //
  // Kept, never deleted: `departmentId` is what the metadata gates
  // (`resolveFileDepartment`, `filterVisibleLinks`) fail closed on, and a
  // missing row would read as personal-space semantics there.
  status       FileRegistryStatus @default(live)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerUserId])
  @@index([scope])
  @@index([departmentId])
  @@index([ownerUserId, sha256])
}

/// WARP-3425 — see `File.status`. Explicit (CLAUDE.md "no guessing"): a row's
/// existence in Nextcloud is never inferred from a NULL or from the row's absence.
enum FileRegistryStatus {
  live
  missing
}

// ── WARP-456: signed append-only activity log ──
//
// Canonical audit trail of every observable event on the device — chat
// turns, MCP tool calls, file indexing, camera writes, network ops,
// smart-home commands, email sends, auth events, scheduled tool runs,
// system events. Replaces the per-domain `CommandAuditLog` (which is
// now a read view; new writes go through `activity.service.record`).
//
// Tamper-evidence: every row carries an HMAC-SHA256 `signature` computed
// over the canonical JSON of its own content (`at`, `kind`, `severity`,
// `sourceIcon`, `what`, `sub`, `refs`) plus the `prevSignatureHash` of
// the row immediately before it. This is a strict hash-chain — mutating
// or removing any historical row breaks the chain at that point, so the
// `POST /api/activity/export` sealed bundle is verifiable offline by
// anyone holding the public key (today: the HMAC key bytes; tomorrow:
// a TPM-attested key per the spec's note about pluggable signing).
//
// `kind` and `severity` are explicit enums (no IS-NULL state per
// CLAUDE.md — mirrors WARP-218's BrainMemoryItemStatus pattern).
//
// `refs` is opaque JSON of foreign keys / external identifiers (e.g.
// `{conversationId, messageId}` for chat, `{nodeId, command}` for
// Matter writes, `{toolName, callId}` for MCP tool calls). The
// exporter preserves it verbatim; the signature covers it.
model ActivityRow {
  id                BigInt           @id @default(autoincrement())
  at                DateTime         @default(now())
  severity          ActivitySeverity
  // Lucide-icon name (or other agreed token). String so the dashboard
  // can render without joining another table; not enforced beyond
  // what the recorder validates because emitters are trusted in-
  // process code.
  sourceIcon        String
  what              String
  sub               String?
  kind              ActivityKind
  // Optional structured references. Today: small object literals
  // from the emitter call site. Kept Json so future emitters can
  // grow new fields without a migration. Covered by the signature.
  refs              Json?
  // Canonical-JSON HMAC-SHA256 over the row content + prevSignatureHash.
  // Base64-url (no padding) so the value is URL-safe in audit-trail
  // exports and dashboard URLs.
  signature         String
  // Hash of the signature of the immediately-preceding row, base64-
  // url (no padding). Empty string for the genesis row (the very
  // first entry per device). The chain semantics live in
  // `activity.service.record`.
  prevSignatureHash String

  // ── WARP-181: first-class actor attribution ──
  // Who performed the action. Nullable ONLY for pre-upgrade v1 rows —
  // a CHECK constraint in the migration enforces
  // `schemaVersion = 1 OR actorType IS NOT NULL` (explicit-era rule).
  actorType     ActivityActorType?
  // Canonical user UUID when known (`type: user` rows always carry it;
  // `ai` rows carry the on-behalf-of UUID when it was already plumbed
  // through, else NULL). Never a username — display names stay in refs.
  actorId       String?
  // Canonical-content version this row was signed under. Existing rows
  // are backfilled to 1 by the migration; the recorder always writes 2
  // explicitly (no DB default — the migration drops it after backfill).
  // `canonicalizeRowContent` dispatches on this value so v1 rows keep
  // verifying byte-identically.
  schemaVersion Int

  // Composite index for the GET /api/activity range/filter query
  // (sorted by `at` descending within an optional `kind` filter), and
  // a separate `at` index for unfiltered time-range queries.
  @@index([at, kind])
  @@index([at])
  // WARP-181: "what did this user do" queries (actorId filter + at sort).
  @@index([actorId, at])
  // WARP-3193 PERF-7: GET /api/activity pages `ORDER BY id DESC LIMIT n`.
  // (kind, id DESC) serves the ?kind= filter; the trigram GIN indexes serve
  // the ?q= ILIKE '%…%' on what/sub (pg_trgm, enabled by the migration).
  @@index([kind, id(sort: Desc)])
  @@index([what(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sub(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ── WARP-237: device-key-signed daily roots over the activity chain ──
// One row per UTC day, signed by the device identity key (TPM-backed via
// device-identity-svc). Anchors the symmetric HMAC chain to a
// non-extractable asymmetric key at day granularity: an attacker who
// obtains /data/secrets/audit.key and rewrites ActivityRow still cannot
// re-produce these ECDSA signatures. Spans are id-anchored (contiguous,
// firstRowId = previous root's lastRowId + 1) for the same clock-skew
// reason WARP-586's purge anchors on id, and roots are NEVER purged
// (~300 bytes/day). rowCount = 0 (firstRowId > lastRowId) attests a
// quiescent day, so a silently deleted day is detectable.
model ActivityDailyRoot {
  id                BigInt   @id @default(autoincrement())
  // UTC calendar day covered, "YYYY-MM-DD".
  date              String   @unique
  firstRowId        BigInt
  lastRowId         BigInt
  rowCount          Int
  // hashSignature(signature of row `lastRowId`) — ties the root to the
  // chain tail. Repeats the previous root's value on an empty day.
  tailSignatureHash String
  // rootHash of the previous root ("" for the first) — roots chain too.
  prevRootHash      String
  // base64url SHA-256 of canonicalizeDailyRoot(content).
  rootHash          String
  // base64 DER ECDSA signature over the canonical content bytes,
  // produced by device-identity-svc Sign().
  signature         String
  algorithm         String
  createdAt         DateTime @default(now())
}

/// WARP-263 — per-device hardware inventory baseline (NIST SSDF
/// supply-chain transparency). Singleton row (single-appliance
/// assumption, same `id = "singleton"` pattern as `ApplianceSetup`)
/// holding the last-known-good hardware component list (SoM/baseboard,
/// RAM SKU, disk model+serial, USB/PCI peripherals — see
/// `hardware-inventory.collector.ts`) as compared by
/// `hardware-bom.service.ts`. `components` is the canonical snapshot;
/// `componentsHash` is `hashComponents(canonicalizeComponents(components))`
/// for a cheap equality check without re-parsing JSON on every boot.
/// `signature`/`algorithm` are `signWithDeviceKey(canonical)` over the
/// same canonical bytes — the WARP-230 device-identity TPM key, so this
/// row can't be silently rewritten without invalidating the signature.
/// On divergence the service overwrites this row with the new snapshot
/// AND emits a `hardware_changed` ActivityRow (kind `system`) — this
/// table always holds "current committed baseline"; the change history
/// lives in the signed activity chain, not here.
model HardwareBaseline {
  // Fixed singleton key — one appliance, one hardware baseline.
  id             String   @id @default("singleton")
  components     Json
  componentsHash String
  signature      String
  algorithm      String
  capturedAt     DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

/// WARP-181: who performed the action behind an ActivityRow. `user` =
/// an authenticated household member (actorId REQUIRED — recorder
/// enforces it); `ai` = the agent loop / tool dispatch (actorId is the
/// on-behalf-of user when already available); `system` = the box
/// itself (boot, tickers, sweeps, purges); `anonymous` = pre-auth
/// surfaces (failed/throttled sign-ins).
enum ActivityActorType {
  user
  ai
  system
  anonymous
}

/// WARP-456: domain bucket for ActivityRow. Adding a new value here
/// is a schema change — keep the set stable. The recorder is the
/// single place that validates incoming `kind`.
enum ActivityKind {
  chat
  tool_call
  file
  camera
  network
  smart_home
  email
  auth
  tool_run
  system
  /// WARP-1058: voice events (wake detections, missed wakes, DSP
  /// wedge/recovery, calibration applied, processor restarts) — the
  /// /voice page's "Recent voice activity" feed filters on this.
  voice
}

/// WARP-456: severity of an ActivityRow. Display-only; the dashboard
/// renders the colour from this enum directly. `info` is neutral
/// "happened" — no good/bad connotation — used by passive observations
/// (file indexed, device joined). `ok` is "succeeded" — used for write
/// operations that completed cleanly. `warn` and `err` follow standard
/// logging semantics.
enum ActivitySeverity {
  ok
  warn
  err
  info
}

// ── WARP-457: workspace settings registry ──
//
// Persistent CRUD layer for the dashboard's Settings surface. Replaces
// the .env-only knobs in apps/orchestrator/src/config.ts for surfaces
// the household is expected to tune from the UI (workspace name,
// memory/privacy defaults, off-LAN posture, hardware feature flags,
// appearance theme). `.env` continues to own infra-level knobs
// (DATABASE_URL, JWT_SECRET, OLLAMA_URL etc) — settings here are
// additive, not a replacement.
//
// Per the no-guessing rule (CLAUDE.md):
//   - `section` is the explicit `SettingSection` enum — never derived
//     from a key prefix or path-style string.
//   - `type` is the explicit `SettingType` enum — the route layer
//     validates `valueJson` against this enum before write (string
//     length, number range, enum membership, duration parsing, etc).
//
// `valueJson` is Json so the same column carries every type-erased
// value; adding a new `SettingType` doesn't need a column migration.
// The seeder in workspace-settings.service.ts populates rows from
// existing .env-derived defaults on first run (insert-or-skip; never
// overwrite user values).
//
// `@@index([section])` keeps GET /api/settings's grouped query plan
// stable as the row count grows.
model WorkspaceSetting {
  id        String         @id @default(uuid())
  key       String         @unique
  section   SettingSection
  type      SettingType
  valueJson Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([section])
}

/// WARP-457: top-level grouping for the dashboard's Settings surface.
/// Adding a new value here is a schema change — keep the set stable.
/// The route layer (GET /api/settings/:section) trusts this enum for
/// path-param validation.
///   - `workspace`       — display name, locale, default scope, etc.
///   - `memory_privacy`  — brain memory defaults, retention, scope.
///   - `off_lan`         — VPN / remote-access posture (DDNS, peers).
///   - `hardware`        — feature flags for cameras, switch, display.
///   - `appearance`      — theme, density, dashboard layout.
///   - `ai`              — active local model choice (WARP-1112). Managed
///                         from the /models surface, NOT the generic
///                         Settings page — deliberately kept out of the
///                         settings route's SECTION_VALUES so the only
///                         writer is PATCH /api/models/active (which
///                         validates the model is actually installed).
enum SettingSection {
  workspace
  memory_privacy
  off_lan
  hardware
  appearance
  ai
}

/// WARP-457: type tag for `WorkspaceSetting.valueJson`. The route
/// layer's PATCH handler dispatches per-type validation off this
/// enum (string length, number range, enum membership, duration
/// parsing, json validity). Adding a new type requires extending the
/// validator switch in routes/settings.ts.
///   - `string`            — UTF-8 text, length-bounded by the route.
///   - `number`            — JSON number (integer or float).
///   - `bool`              — true/false.
///   - `duration_seconds`  — non-negative integer seconds.
///   - `enum`              — value must be one of an allowed set; the
///                           allowed set lives in the route definition,
///                           not in the schema (so per-key allowed
///                           values don't need a schema migration).
///   - `json`              — opaque JSON blob; validated for parse-
///                           ability and a depth cap, not shape.
enum SettingType {
  string
  number
  bool
  duration_seconds
  enum
  json
}

/// WARP-465 — Phase D1. Operator-owned email account the email-indexer
/// service connects to via IMAP IDLE. Credentials encrypted at rest
/// with Fernet (key under /data/secrets/email.key, generated by
/// setup.sh, mode 0600). The orchestrator never sees the plaintext
/// password — it stores only the Fernet ciphertext and hands it to
/// the email-indexer service which holds the key.
///
/// `imapStatus` is an explicit enum (`idle | reconnecting | error |
/// paused`); the dashboard renders the badge from this directly. Per
/// CLAUDE.md no-derived-state rule: connectivity state is a column,
/// not an IS NULL.
model EmailAccount {
  id          String          @id @default(uuid())
  userId      String?
  displayName String
  address     String          @unique
  imapHost    String
  imapPort    Int             @default(993)
  imapTls     Boolean         @default(true)
  smtpHost    String
  smtpPort    Int             @default(465)
  smtpTls     Boolean         @default(true)
  username    String
  passwordEnc String
  imapStatus  EmailImapStatus @default(paused)
  lastIdleAt  DateTime?
  lastErrorAt DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  threads     EmailThread[]
  messages    EmailMessage[]
  drafts      EmailDraft[]
  /// WARP-3529 — the service desk this mailbox is the front door of, if any.
  supportChannel PmSupportChannel?

  @@index([userId, address])
}

/// WARP-465 — RFC 5322 thread grouping. `threadKey` is derived from
/// the root Message-ID (or Subject + first-seen hash when a thread
/// arrives without References). The dashboard groups by this and
/// renders one row per thread in the §2.4 inbox list.
///
/// `triageStatus` is the §2.4 surface state — explicit enum so the
/// dashboard can render the right tab badge without joining the
/// messages.
model EmailThread {
  id               String            @id @default(uuid())
  accountId        String
  account          EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadKey        String
  subject          String
  lastSender       String?
  snippet          String?
  messageCount     Int               @default(0)
  triageStatus     EmailTriageStatus @default(inbox)
  draftedByDroplet Boolean           @default(false)
  lastMessageAt    DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         EmailMessage[]
  drafts           EmailDraft[]
  /// WARP-3529 — the tickets this conversation belongs to. More than one when a
  /// reply to a final ticket opened a follow-up: the newest link is the thread's
  /// current ticket.
  ticketLinks      PmTicketEmailLink[]

  @@unique([accountId, threadKey])
  @@index([accountId, triageStatus, lastMessageAt(sort: Desc)])
  @@index([accountId, lastMessageAt(sort: Desc)])
}

/// WARP-465 — one persisted MIME message. `messageId` is the RFC 5322
/// Message-ID header (unique per account; not globally — different
/// mailboxes can replay the same forwarded ID). `bodyText` is the
/// canonical text/plain body; `bodyHtml` is the rendered HTML when
/// present. Both are nullable — multipart messages may carry one or
/// the other.
model EmailMessage {
  id         String       @id @default(uuid())
  accountId  String
  account    EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId   String
  thread     EmailThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId  String
  inReplyTo  String?
  fromAddr   String
  fromName   String?
  toAddrs    Json
  ccAddrs    Json?
  subject    String
  bodyText   String?
  bodyHtml   String?
  receivedAt DateTime
  createdAt  DateTime     @default(now())

  /// WARP-2117 — CRM timeline entries that POINT AT this message. The CRM
  /// stores the subject line as a caption and never a copy of the body, so
  /// mail retention stays governed by the mail surface alone.
  crmActivities CrmActivity[]

  /// ADR-048 — filing proposals derived from this message. `onDelete: SetNull`
  /// on the far side, and deliberately not covered by any CHECK there: this
  /// model's own `accountId` is `onDelete: Cascade`, so a CHECK requiring the
  /// pointer would make deleting an email account impossible once one proposal
  /// existed.
  ingestProposals IngestProposal[]

  /// ADR-048 (WARP-2729) — the same filing ledger as `FileIndexStatus`.
  ///
  /// NO route change is needed: `prisma.emailMessage.create` on the 201 branch
  /// of `POST /api/email/:accountId/messages-ingest` takes the default, and the
  /// P2002 branch returns `duplicate: true` before any create, so a redelivery
  /// never re-arms.
  ///
  /// There is deliberately no `extractedFromUpdatedAt` or fingerprint here:
  /// this model has no `updatedAt` and is immutable after create, so there is
  /// no email re-arm. An extractor-version bump is a bounded, explicit owner
  /// action, not an automatic one.
  extractStatus    ExtractStatus  @default(pending)
  extractClaimedAt DateTime?
  extractAttempts  Int            @default(0)
  extractedAt      DateTime?
  extractReason    ExtractReason?

  /// WARP-3267 — the files this message carried.
  attachments EmailAttachment[]

  /// WARP-3529 (ADR-069 §4) — what the sender's headers said about how the
  /// message was sent: `{ references, autoSubmitted, precedence, xAutoreply,
  /// xAutorespond, returnPath, reportType }`, validated at the ingest boundary
  /// (routes/email.ts) and recorded as written. NULL only on a message stored
  /// before this column existed or by an indexer that predates it — which the
  /// desk reads as "could not be checked", never as "automatic mail is absent".
  headers Json?

  /// WARP-3529 — the service desk's ledger, the same shape as the filing arm's
  /// `extract*` columns above and for the same reason: the durable row that
  /// already says "new mail exists" carries its own claim, so the ingest route
  /// needs NO change and cannot fail because a desk did. Every message starts
  /// PENDING; only a mailbox bound to a desk channel is ever swept, and only
  /// mail received after the channel was switched on (`PmSupportChannel.enabledAt`).
  /// IGNORED and FAILED always carry a reason (a CHECK); nothing is skipped
  /// without saying why.
  deskIntakeStatus   PmEmailIntakeStatus  @default(PENDING)
  deskIntakeReason   PmEmailIntakeReason?
  deskIntakeAttempts Int                  @default(0)
  /// When the message reached a terminal status. NULL exactly while PENDING.
  deskIntakeAt       DateTime?

  /// The ticket this message is part of, once the desk has taken it in.
  ticketLink PmTicketEmailLink?

  @@unique([accountId, messageId])
  @@index([threadId, receivedAt(sort: Desc)])
  @@index([extractStatus, receivedAt])
  /// The desk sweep's claim: one mailbox's pending mail, oldest first.
  @@index([accountId, deskIntakeStatus, createdAt])
  /// The per-sender rate window: one mailbox's recent mail.
  @@index([accountId, createdAt])
}

/// WARP-3267 — one MIME part of an inbound message that is not its body.
///
/// Ruling: the bytes live in box storage (this table), not in the mailbox
/// owner's Nextcloud home. A mailbox an admin connects for the company has no
/// owner (`EmailAccount.userId` is null) and so no home to write to; anything
/// in a Nextcloud home is picked up by the preview generator and the file
/// indexer, which would render and parse a stranger's file the moment it
/// arrived; and here the bytes go with the message, so disconnecting a mailbox
/// (which cascades) leaves nothing behind. Saving an attachment into Files is
/// the person's own act, from a client.
///
/// Never rendered by the box. Served only as a download
/// (`GET /api/email/:accountId/messages/:messageId/attachments/:attachmentId`).
/// `status` says whether the bytes were kept: a part over the size limits is
/// listed, so the reader knows it existed, but not stored.
model EmailAttachment {
  id             String                @id @default(uuid())
  emailMessageId String
  emailMessage   EmailMessage          @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  /// Copied from the message so a forward can check, in one query, that the
  /// attachment belongs to the mailbox the draft is sent from.
  accountId      String
  /// Position among the message's attachments (0-based). Unique per message.
  partIndex      Int
  /// As the sender named it, decoded. Sanitised when served, never trusted.
  filename       String
  /// As the sender declared it. Recorded, never used to decide how to open it.
  contentType    String
  size           Int
  sha256         String
  /// `Content-ID` of an inline part (a `cid:` image), without the brackets.
  contentId      String?
  status         EmailAttachmentStatus
  /// Null unless `status` is `stored`.
  data           Bytes?
  createdAt      DateTime              @default(now())

  @@unique([emailMessageId, partIndex])
  @@index([accountId])
}

/// WARP-3267 — whether an attachment's bytes were kept.
/// `too_large`: the part, or the message's running total, was over the limit.
/// `over_limit`: the message carried more attachments than the box keeps.
enum EmailAttachmentStatus {
  stored
  too_large
  over_limit
}

/// WARP-465 — operator- or Droplet-authored draft. `draftedByDroplet`
/// is a first-class boolean (NOT IS-NULL) so the §2.4 surface can
/// render the "drafted by Droplet" pill without inferring from `body`
/// being non-empty.
///
/// `status` is the send lifecycle: `draft | queued | sent | failed`.
/// `sentAt` is set on `sent`, `error` on `failed`.
model EmailDraft {
  id               String           @id @default(uuid())
  accountId        String
  account          EmailAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId         String?
  thread           EmailThread?     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  toAddrs          Json
  ccAddrs          Json?
  bccAddrs         Json?
  subject          String
  body             String           @default("")
  draftedByDroplet Boolean          @default(false)
  status           EmailDraftStatus @default(draft)
  sentAt           DateTime?
  /// WARP-890 — wall-clock the draft was claimed into `sending` (queued→sending).
  /// Tamper-proof reconcile clock: the stale-sending sweep keys off THIS column,
  /// not `updatedAt`, because `@updatedAt` resets on ANY row write (a concurrent
  /// edit to an unrelated field would silently reset the grace window and strand
  /// a draft forever). Nullable + additive (no-incidental-state rule): NULL for
  /// every draft that has never been claimed.
  claimedAt        DateTime?
  error            String?
  /// WARP-3267 — stored `EmailAttachment` ids a forward carries. Checked on
  /// write to belong to this draft's mailbox; the indexer attaches them at send.
  attachmentIds    String[]         @default([])
  /// WARP-3529 — the RFC 5322 Message-ID (no brackets) of the email this draft
  /// becomes, chosen by the service desk when it queues the draft and sent by the
  /// indexer exactly as stored, so the desk knows the id a customer's reply will
  /// carry before anything is sent. NULL for a draft nothing chose one for (every
  /// draft the mail screen and the assistant create); the indexer makes its own.
  messageId        String?          @unique
  /// WARP-3529 — an automatic acknowledgement rather than a person's reply: sent
  /// as `Auto-Submitted: auto-replied` (RFC 3834).
  autoSubmitted    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// The service desk comment this draft is the delivery of, if it is one.
  ticketLink PmTicketEmailLink?

  @@index([accountId, status, updatedAt(sort: Desc)])
}

/// WARP-465 — IMAP connection state. `paused` is the initial state
/// (no IDLE attempted yet); `idle` is healthy; `reconnecting` is
/// the exponential-backoff window after a drop; `error` is the
/// terminal state when reconnect attempts exhausted.
enum EmailImapStatus {
  idle
  reconnecting
  error
  paused
}

/// WARP-465 — §2.4 inbox state machine. Adding a tab is a schema
/// change so the dashboard's tab set can't drift from the data.
enum EmailTriageStatus {
  inbox
  triaged
  archived
}

/// WARP-465 — draft lifecycle. `queued` is the transient state after
/// POST /drafts/:id/send while the SMTP request is in-flight; `sent`
/// is terminal-success, `failed` is terminal-error.
enum EmailDraftStatus {
  draft
  queued
  sending
  sent
  failed
}

/// BUG-11 — operator-supplied OUTBOUND SMTP relay config (the appliance is a
/// self-hosted box; the owner brings their own mail provider's SMTP — Gmail
/// app-password, Fastmail, a corporate relay, etc. — we never run an MTA).
/// Single-row table (id is pinned to a constant by the service) so the
/// dashboard edits one channel; `@@unique` is unnecessary for a singleton but
/// the service enforces the constant id on every upsert.
///
/// SECRET HANDLING (CLAUDE.md rule 19): `passwordEnc` is the SMTP password
/// encrypted at rest with aes-256-gcm via encryption.service (the same
/// DEVICE_SECRET_KEY-backed primitive that protects per-device Nextcloud app
/// passwords). The plaintext password is NEVER stored, NEVER returned by the
/// settings API (GET redacts to a `hasPassword` boolean), and NEVER logged.
/// Nothing secret lives in a tracked file — only the operator-entered,
/// at-rest-encrypted blob in this DB row.
model EmailChannelSetting {
  id           String               @id
  enabled      Boolean              @default(false)
  host         String               @default("")
  port         Int                  @default(587)
  username     String               @default("")
  // aes-256-gcm blob (encryption.service). Empty string = no password set.
  passwordEnc  String               @default("")
  fromAddress  String               @default("")
  fromName     String               @default("Droplet")
  security     EmailChannelSecurity @default(starttls)
  // Last verify/send outcome for the dashboard banner (operator-facing only).
  lastError    String?
  lastTestedAt DateTime?
  updatedAt    DateTime             @updatedAt
  updatedBy    String?
}

/// BUG-11 — SMTP transport security mode. `starttls` (default, port 587) opens
/// plaintext then upgrades; `tls` (port 465) is implicit TLS from connect;
/// `none` is plaintext (a LAN relay only — discouraged, but some self-hosted
/// Postfix relays expect it). Explicit enum so the transport builder can't
/// drift from a free-form string.
enum EmailChannelSecurity {
  starttls
  tls
  none
}

/// WARP-462 — Phase C1. Productized workflow spec ("call carrier-delay
/// recap every weekday morning"). Distinct from `packages/tools-core`
/// (the capability registry) — a ToolSpec composes capabilities into
/// an operator-shareable, scheduled, versioned routine.
///
/// `status` is an explicit enum (`live | draft | suggested`); the
/// dashboard renders three tabs against it. `suggested` rows are
/// written by the WARP-464 pattern-miner; `draft` is operator-authored
/// and not yet executed; `live` is publishable + schedulable.
///
/// `safety` is the maximum safety tier across the spec's steps —
/// computed at publish time so a "tier 3" spec never silently sneaks
/// into the live tab. `writes` mirrors the step-aggregated
/// requiresWrite. `reversible` is operator-declared: true if every
/// action in the spec can be undone (e.g. flip a switch back); false
/// otherwise. Together (writes && !reversible) gates a confirm_action
/// card before run-now (handled in route layer + C2 scheduler).
///
/// WARP-3354 — `visibility` is an explicit enum, never derived from `ownerId`
/// or `share`: `PRIVATE` routines are seen and run only by their creator
/// (`ownerId`) and by an owner or admin; `WORKSPACE` routines are seen by
/// every member. No column default on purpose — every creator must say which
/// it is. `share` (free text, never read) is superseded by this column.
model ToolSpec {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  category    String?
  description String?
  version     Int            @default(1)
  status      ToolSpecStatus @default(draft)
  ownerId     String?
  share       String?
  visibility  ToolSpecVisibility
  safety      Int            @default(1)
  writes      Boolean        @default(false)
  reversible  Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       ToolStep[]
  runs        ToolRun[]
  schedules   ToolSchedule[]

  @@index([status, updatedAt(sort: Desc)])
}

/// WARP-462 — one ordered step inside a ToolSpec. `kind` is the
/// dispatch class ("call" for an MCP tool call; future kinds may
/// include "branch", "wait"). `args` carries the per-kind payload —
/// for `kind=call` it is `{ tool: "tool_name", args: { ... } }`.
///
/// idx is the explicit ordering column; the imperative walker
/// (services/tool-spec-runner.service.ts) walks ascending.
model ToolStep {
  id     String   @id @default(uuid())
  specId String
  spec   ToolSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  idx    Int
  kind   String   @default("call")
  args   Json

  @@index([specId, idx])
}

/// WARP-462 — one execution record of a ToolSpec.
///
/// `status` is explicit (`pending | running | ok | failed | cancelled`);
/// the dashboard renders per-run chips against the enum. `pending` is
/// the non-terminal initial state for pre-created rows (scheduler or
/// any future op that materializes a row before dispatch). `running`
/// is in-flight. `error` carries the last-step failure message for
/// `failed` runs; null otherwise. `trace` captures per-step results so
/// the dashboard's run-detail drawer can show "step 2 of 5 failed: ...".
model ToolRun {
  id          String        @id @default(uuid())
  specId      String
  spec        ToolSpec      @relation(fields: [specId], references: [id], onDelete: Cascade)
  triggeredBy String?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  status      ToolRunStatus @default(pending)
  error       String?
  trace       Json?

  @@index([specId, startedAt(sort: Desc)])
}

/// WARP-462 — RRULE-driven schedule for a ToolSpec. `nextFireAt` is
/// advanced by the WARP-463 tool-schedule-ticker after each
/// successful (or failed) run. Multiple schedules per spec allowed —
/// the §7 example carrier-delay spec has both a 09:00 weekday cron
/// and an ad-hoc "high-priority client" trigger.
model ToolSchedule {
  id         String   @id @default(uuid())
  specId     String
  spec       ToolSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  rrule      String
  /// WARP-2665 — IANA timezone the rrule's wall-clock time is interpreted in,
  /// matching SceneSchedule.timezone (KAN-6). Without it a routine scheduled
  /// for "07:00" fires at 07:00 UTC and drifts an hour at every DST boundary.
  /// Added with the write path (WARP-2665) rather than after it, so no row
  /// ever gets created under the UTC-only reading. Defaults to "UTC", which
  /// keeps nextFireFromRrule's UTC fast-path unchanged.
  timezone   String   @default("UTC")
  nextFireAt DateTime
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([nextFireAt])
  @@index([specId])
}

/// WARP-462 — ToolSpec lifecycle. `suggested` rows are written by the
/// pattern miner (WARP-464); `draft` is operator-authored and not yet
/// runnable; `live` is publishable + schedulable. Adding a new state
/// is a schema change so the dashboard's three-tab UX can't drift.
enum ToolSpecStatus {
  live
  draft
  suggested
}

/// WARP-3354 — who may see and run a routine. `PRIVATE`: its creator, owners
/// and admins. `WORKSPACE`: every member (external guests never see routines).
enum ToolSpecVisibility {
  PRIVATE
  WORKSPACE
}

/// WARP-462 — ToolRun outcome. Non-terminal: `pending` (pre-created
/// but not dispatched), `running` (in flight). Terminal: `ok`,
/// `failed`, `cancelled`. Per CLAUDE.md "no guessing" rule (mirrors
/// WARP-218's BrainMemoryItemStatus), the default is the non-terminal
/// `pending` — a row that wasn't explicitly transitioned to a terminal
/// state must NOT appear as a successful run.
enum ToolRunStatus {
  pending
  running
  ok
  failed
  cancelled
}

/// WARP-2177 — a durable, background agent run (epic WARP-2176).
///
/// Everything a chat turn does inside one HTTP request, moved into a row that
/// outlives the request, the browser tab and the container. The agent loop
/// (`llm-agent.service.ts`) is not rewritten: `agent-run-worker.service.ts`
/// claims a row, resumes the loop from the checkpoint below, and writes the
/// outcome back. Design: `docs/agent-runs-design.md`.
///
/// `status` is an explicit enum, never derived from `endedAt IS NULL` — the
/// CLAUDE.md "no guessing state" rule, same as `ToolRun`.
///
/// CHECKPOINT. `iteration` is the next loop iteration to execute and
/// `messages` is the complete conversation at the top of that iteration. That
/// is the loop's natural boundary: at the top of an iteration the array is a
/// valid conversation (every `tool_calls` has its `role: "tool"` replies), so
/// it can be handed back to `runAgent()` verbatim.
///
/// REPLAY GUARD. `trace` records every dispatched tool call — written BEFORE
/// dispatch (`tool_call_id`, tool, args, iteration) and completed with the
/// wire result after. A run resumed mid-iteration feeds a completed call's
/// stored result back to the model instead of re-dispatching it, so a
/// redeploy can never re-send a notification the run already sent.
///
/// LEASE. `claimedBy` / `claimedAt` / `heartbeatAt`. A `running` row whose
/// heartbeat is older than `AGENT_RUN_RECLAIM_AFTER_MS` is re-queued with
/// `attempts + 1`; past `AGENT_RUN_MAX_ATTEMPTS` it is failed with an error
/// naming the count, so a crashing worker cannot wedge a run into infinite
/// retry. Every executor write is fenced on `claimedBy`, so the zombie of a
/// reclaimed run cannot clobber its successor.
///
/// `deadlineAt` is the wall-clock ceiling, stamped at first claim. A column
/// rather than `startedAt + constant` so a config change cannot move the
/// goalposts of a run already in flight. `maxIter` alone does not bound a run
/// whose model calls are slow.
model AgentRun {
  id                 String                   @id @default(uuid())
  /// Attributed principal (`User.id`). Tool reach is re-resolved from it at
  /// EVERY claim (the WARP-1580 ticker rule), never cached at creation, so a
  /// run cannot outlive a role change with stale reach.
  userId             String
  /// The chat conversation that started the run, when one did. WARP-3299:
  /// set by the server from the chat turn (never from model arguments),
  /// together with the two ids below, when `origin = chat`.
  sessionId          String?
  /// WARP-3299 — who started the run. Explicit, never inferred from which
  /// ids are NULL (a schedule run also has no session).
  origin             AgentRunOrigin
  /// WARP-3299 — the assistant message whose tool call started the run, and
  /// that call's id. Lets the chat card find its run.
  originMessageId    String?
  originToolCallId   String?
  /// WARP-3299 — the short label the card shows, and what "done" means.
  /// Backfilled from the goal's first line for runs that predate them.
  title              String                   @default("")
  deliverable        String                   @default("")
  /// WARP-3299 — the bounded result written back to the chat (the full final
  /// text stays in `result`). Written by the result-message work, WARP-3300.
  summary            String?                  @db.VarChar(2000)
  /// WARP-3299 — `[{kind, ref, title}]`: what the run created.
  artifacts          Json                     @default("[]")
  /// WARP-3299 — whether the result message reached the conversation.
  /// `not_applicable` for runs no chat started.
  resultDelivery     AgentRunResultDelivery   @default(not_applicable)
  /// WARP-3300 — posts of the result message tried so far. The worker stops
  /// retrying a `failed` delivery at 5 (RESULT_DELIVERY_MAX_ATTEMPTS).
  resultDeliveryAttempts Int                  @default(0)
  /// WARP-3301 — why a `queued` run is not being worked on: `queue` (behind
  /// other runs, or not due yet) or `chat` (it yielded the one inference slot
  /// to interactive chat on a gateway 429). Written at every transition back
  /// to `queued`; meaningless in any other status, where the API reports
  /// `waitingFor: "none"`.
  queueWait          AgentRunQueueWait        @default(queue)
  goal               String
  model              String
  status             AgentRunStatus           @default(queued)
  /// Not before. Delay and backoff without a second queue.
  runAfter           DateTime                 @default(now())
  claimedBy          String?
  claimedAt          DateTime?
  heartbeatAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  deadlineAt         DateTime?
  attempts           Int                      @default(0)
  maxIter            Int
  iteration          Int                      @default(0)
  messages           Json?
  trace              Json?
  /// The final assistant answer on `succeeded`.
  result             String?
  /// The loop's own `stop_reason` for the terminal segment.
  stopReason         String?
  error              String?
  /// WARP-2179 — the parked Tier-2 call, while `status = awaiting_confirmation`.
  /// Explicit columns, not a blob: the call is bound the way the interceptor
  /// binds its token — tool name + `confirmationBindingHash(tool, args)` — so
  /// what the human approves is exactly what will be redeemed, and nothing
  /// else can be smuggled through the park. No token is stored: the
  /// interceptor's own token is minted at resume, seconds after the human
  /// decided, and redeemed in the same breath. `parkedAt` is what the
  /// deadline is extended by on resume, so a day parked is not a day spent.
  pendingTool        String?
  pendingBindingHash String?
  pendingArgs        Json?
  pendingToolCallId  String?
  parkedAt           DateTime?
  pendingDecision    AgentRunPendingDecision?
  pendingDecidedAt   DateTime?
  pendingDecidedBy   String?
  /// WARP-2877 — the schedule that fired this run, when one did. NULL is the
  /// ordinary case (a run started from chat), not a missing value: it is the
  /// FK that is absent, never a status. The ticker's overlap guard reads it —
  /// a schedule whose previous fire is still active does not fire a second
  /// one — and `onDelete: SetNull` keeps the history of a deleted schedule's
  /// runs rather than deleting the runs with it.
  scheduleId         String?
  schedule           AgentRunSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// WARP-2896 (ADR-056 slice G) — the workspace a WORKSHOP run works in.
  /// NULL for every ordinary run. Set once at enqueue and never changed: the
  /// `/api/workspace/:id/*` routes check that the run named in the request
  /// carries THIS id ("run owns workspace"), so a run cannot reach any
  /// workspace but its own. `onDelete: SetNull` — deleting a workspace keeps
  /// the runs that worked in it, as the schedule FK above does.
  ///
  /// ONE LIVE RUN PER WORKSPACE is a partial unique index —
  /// `AgentRun_workspaceId_active_key`, `UNIQUE ("workspaceId") WHERE
  /// "workspaceId" IS NOT NULL AND "status" IN (queued, running,
  /// awaiting_confirmation)` — in the warp_2896_workspace migration's raw SQL,
  /// because Prisma cannot express a WHERE-filtered unique index (the
  /// `PmCycle_projectId_active_key` pattern). `POST /api/agent-runs` still
  /// counts first for the friendlier 409, and maps the index's P2002 onto the
  /// same 409 when two starts race past the count.
  workspaceId        String?
  workspace          WorkshopWorkspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  /// WARP-2997 — the per-person cloud gate's verdict at the LATEST claim.
  /// Explicit, like `status`: `unchecked` until the worker first claims the
  /// row, never inferred from `offLanProvider` being NULL.
  cloudGate          AgentRunCloudGate        @default(unchecked)
  /// WARP-2997 — the non-local provider the run's model resolved to at the
  /// latest claim; NULL when it stays on the box (`cloudGate` says which).
  offLanProvider     String?
  /// WARP-2997 — the stored-content tools withheld from the run's pool at
  /// the latest claim (`withholdStoredContentTools`). Empty on a local run.
  offLanWithheldTools String[]                @default([])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Claim scan: `status = queued AND runAfter <= now()`.
  @@index([status, runAfter])
  // WARP-2877 — the ticker's overlap probe: has this schedule an active run?
  @@index([scheduleId, status])
  // WARP-2896 — a workspace's runs, for the workshop's extension page.
  @@index([workspaceId, createdAt(sort: Desc)])
  // Reclaim scan: `status = running AND heartbeatAt < now() - threshold`.
  @@index([status, heartbeatAt])
  // "My runs", newest first — the list route in WARP-2180.
  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId])
}

/// WARP-2177 — AgentRun lifecycle. Non-terminal: `queued` (claimable),
/// `running` (leased by a worker), `awaiting_confirmation` (parked on a
/// Tier-2 call — WARP-2179; unused until it lands). Terminal: `succeeded`,
/// `failed`, `cancelled`. Explicit, like `ToolRunStatus`: a row that was not
/// transitioned to a terminal state must never read as a finished run.
enum AgentRunStatus {
  queued
  running
  awaiting_confirmation
  succeeded
  failed
  cancelled
}

/// WARP-2896 (ADR-056 §6.2) — a workshop workspace: one bare git repository
/// on the sandbox's `workspace-git` volume plus its working checkout, in
/// which a workshop run reads, writes, commits, runs the allow-listed
/// commands and finally PROPOSES. The row is the orchestrator's index of
/// what the sandbox holds — the repository itself never lives in Postgres.
///
/// Named for the surface (the singleton `Workspace` below is the box itself —
/// the org, its name, its slug; a WorkshopWorkspace is one extension's
/// repository). `id` doubles as the repository name (`<id>.git`) and the sandbox's
/// workspace id, so it is constrained to the sandbox's id grammar
/// (`^[a-z0-9][a-z0-9-]{0,63}$`) at the route, not a uuid.
///
/// `status` is explicit: `active` (a run may work in it), `proposed` (a
/// proposal tag exists; the review surface — slice I — reads it), `archived`
/// (kept for history, no run may be started in it). Never inferred from the
/// presence of a tag.
model WorkshopWorkspace {
  id          String          @id
  /// The owning person (`User.id`). Runs in this workspace are attributed to
  /// them; the dashboard shows an owner their own, an admin everyone's.
  userId      String
  name        String
  /// The `templates.git` directory it was created from, when one was.
  template    String?
  status      WorkshopWorkspaceStatus @default(active)
  /// The `proposal/<version>` tag the last `workspace_propose` wrote.
  proposedTag String?
  proposedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AgentRun[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

enum WorkshopWorkspaceStatus {
  active
  proposed
  archived
}

/// WARP-2900 (ADR-056 slice H2) — a promoted extension: one per workshop
/// workspace, keyed by its SLUG (deriveExtensionSlug(workspaceId), <= 27
/// chars, so "ext-" + slug fits the multiplexer's 32-char server id).
///
/// `status` is explicit (CLAUDE.md "No guessing"): never inferred from a
/// NULL token or a missing process.
///   signed       — promoted and box-signed, not installed yet
///   installed    — the sandbox is running its host shim
///   live         — installed AND attached through the multiplexer (H3)
///   disabled     — stopped by the owner; the signed versions stay
///   failed       — the last install/verify failed (failureReason says why)
///   uninstalled  — removed from the sandbox; the signed history stays
///
/// `serviceTokenHash` is the sha256 of the extension's call-back bearer
/// (`dxt_...`), rotated on every start and cleared when it stops. The
/// plaintext only ever exists in the sandbox child's environment.
model Extension {
  id                String             @id
  workspaceId       String             @unique
  name              String
  /// The owner who promoted it: the person the extension acts for (H3).
  installedByUserId String
  status            ExtensionStatus    @default(signed)
  /// The tool domain chosen at promote (domainSource "operator", H3).
  operatorDomain    String?
  currentVersionId  String?            @unique
  currentVersion    ExtensionVersion?  @relation("ExtensionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  serviceTokenHash  String?            @unique
  failureReason     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  versions          ExtensionVersion[] @relation("ExtensionVersions")

  @@index([status])
}

/// One signed version of an extension: the statement the box (or Warp Lab's
/// release key) signed, exactly as signed, and the manifest bytes it names.
/// Every install re-verifies these bytes (update-agent/extension-verify.ts)
/// with `signer` + `keyFingerprint` as the recorded expectation, so a
/// rebuilt boot disk (a new box extension key) is extension_key_changed and
/// needs a re-promote, never a silent re-sign.
model ExtensionVersion {
  id               String          @id @default(uuid())
  extensionId      String
  extension        Extension       @relation("ExtensionVersions", fields: [extensionId], references: [id], onDelete: Cascade)
  currentOf        Extension?      @relation("ExtensionCurrentVersion")
  version          String
  /// The proposal/<version> tag the owner promoted.
  tag              String
  commit           String
  tree             String
  manifestBytes    Bytes
  manifestSha256   String
  statementBytes   Bytes
  /// Base64 DER ECDSA-P256-SHA256 (the cosign sig-file format, both signers).
  signature        String
  signer           ExtensionSigner
  /// "sha256:<hex>" of the signing key's SPKI.
  keyFingerprint   String
  promotedByUserId String
  createdAt        DateTime        @default(now())

  @@unique([extensionId, version])
  @@index([extensionId, createdAt(sort: Desc)])
}

enum ExtensionStatus {
  signed
  installed
  live
  disabled
  failed
  uninstalled
}

enum ExtensionSigner {
  box
  release
}

/// WARP-3299 — who started a run.
enum AgentRunOrigin {
  workshop
  schedule
  chat
}

/// WARP-3299 — whether a chat-started run's result message reached its
/// conversation. `not_applicable` for every run no chat started.
enum AgentRunResultDelivery {
  not_applicable
  pending
  delivered
  failed
  /// WARP-3300 — the conversation was deleted before the result could be
  /// posted. Terminal, like `delivered`: there is nowhere left to post it.
  conversation_gone
}

/// WARP-3301 — why a queued run waits. See `AgentRun.queueWait`.
enum AgentRunQueueWait {
  queue
  chat
}

/// WARP-2997 — where a run's model runs, and whether its owner may use it.
/// `unchecked` (never claimed yet), `local` (on the box; nothing withheld),
/// `cloud_allowed` (cloud model, person permitted; stored-content tools
/// withheld), `cloud_refused` (451: the person may not use cloud models),
/// `cloud_unverified` (503: the gate could not be read; fail-closed).
enum AgentRunCloudGate {
  unchecked
  local
  cloud_allowed
  cloud_refused
  cloud_unverified
}

/// WARP-2180 — a recurring background run: the same RRULE vocabulary as
/// `ToolSchedule` / `SceneSchedule`, fired by the agent-run-schedule ticker
/// on the ONE sanctioned clock (`cronRuntime.scheduleInterval`, its own lock
/// key). Each fire enqueues an `AgentRun` attributed to `userId`, whose reach
/// is re-resolved at claim — a schedule cannot outlive its creator's role.
/// `timezone` is the IANA zone the rrule's wall clock is read in (KAN-6).
model AgentRunSchedule {
  id          String    @id @default(uuid())
  userId      String
  goal        String
  model       String
  /// WARP-3047 — true when the schedule was created WITHOUT a model: each
  /// fire runs on the box's active model, resolved by the ticker at that
  /// moment, so a switch reaches it. `model` then holds the model that was
  /// active at creation — the fallback when nothing resolves at fire. False
  /// (every schedule before this column) = pinned to `model`.
  followsActiveModel Boolean @default(false)
  maxIter     Int
  rrule       String
  timezone    String    @default("UTC")
  nextFireAt  DateTime
  enabled     Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// WARP-2877 — the runs this schedule fired. Back-relation only; the guard
  /// queries `AgentRun` directly.
  runs        AgentRun[]

  // The ticker's scan: `enabled AND nextFireAt <= now()`.
  @@index([enabled, nextFireAt])
  @@index([userId, createdAt(sort: Desc)])
}

/// WARP-2179 — the human's decision on a parked Tier-2 call. Absent while
/// parked; set by the confirm/deny route, consumed by the worker on resume.
/// `approved` redeems the call once; `denied` is fed back to the model as a
/// tool result so it can adapt or finish.
enum AgentRunPendingDecision {
  approved
  denied
}

/// WARP-474 — Phase G2. Smart-home scene definition.
///
/// One row per operator-created scene ("Movie night", "Goodnight").
/// Pressing a scene from §2.7 is a write op that emits a
/// `confirm_action` card before applying — the dashboard surfaces
/// every action that will fire. Per ADR-005 these are owner+admin
/// write surfaces; family can read but not author.
///
/// `actions` is the ordered list of Matter commands the run-handler
/// dispatches via `sendMatterCommand`. Failures are tolerated
/// per-action (the run-handler captures and surfaces them) so a
/// dead bulb mid-scene doesn't abort the lights that work.
model Scene {
  id        String          @id @default(uuid())
  name      String
  icon      String?
  createdBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  actions   SceneAction[]
  schedules SceneSchedule[]

  @@index([createdAt])
}

/// feat/scene-schedules — recurring cadence for a saved Scene (routine).
///
/// Lets an owner/admin schedule a routine to run on an RRULE cadence
/// (e.g. `FREQ=DAILY;BYHOUR=7` → every day 07:00 UTC). The
/// scene-schedule-ticker (60s interval, pg advisory lock) scans rows
/// whose `enabled = true AND nextFireAt <= now()`, executes the parent
/// Scene via the shared `executeScene` path with `triggeredBy="scheduler"`,
/// then advances `nextFireAt` from the RRULE. This is the EXACT clone of
/// the WARP-463 ToolSchedule pattern — one sanctioned scheduler, no
/// hand-rolled timers.
///
/// State is the explicit `enabled` column + `nextFireAt` — NEVER derived
/// from a NULL. A malformed RRULE or a deleted parent Scene flips
/// `enabled = false` (+ an audit row) so a typo can't pin the ticker.
/// `lastFiredAt` records the most recent successful tick fire (NULL =
/// never fired yet — that is provenance, not state).
///
/// SAFETY: an unattended scheduled fire bypasses the per-run scene
/// confirm-token (see scenes.ts run-handler). That is the deliberate
/// owner/admin opt-in — *creating the schedule IS the confirmation* —
/// and every fire is audited. Same justification as ToolSchedule.
model SceneSchedule {
  id          String    @id @default(uuid())
  sceneId     String
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  rrule       String
  /// KAN-6 — IANA timezone the rrule's wall-clock time is interpreted in
  /// (e.g. "America/Los_Angeles"). The ticker recomputes nextFireAt against
  /// this zone each fire so a "07:00 local" routine keeps firing at 07:00
  /// LOCAL across a daylight-saving change instead of drifting an hour.
  /// Defaults to "UTC" — every pre-KAN-6 row back-fills to UTC and so fires
  /// at exactly the same instant it did before.
  timezone    String    @default("UTC")
  nextFireAt  DateTime
  enabled     Boolean   @default(true)
  createdBy   String?
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([nextFireAt])
  @@index([sceneId])
}

/// WARP-474 — one Matter command in a Scene. `idx` is the explicit
/// ordering column (0-based); the run-handler walks them in
/// ascending order. `args` is opaque JSON forwarded to
/// `sendMatterCommand` — see matter.service.ts for the per-command
/// shape (e.g. on/off has no args, levelControl wants `level`).
model SceneAction {
  id           String @id @default(uuid())
  sceneId      String
  scene        Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  idx          Int
  deviceNodeId String
  command      String
  args         Json?

  @@index([sceneId, idx])
}

/// WARP-467 — Phase E1. Five off-LAN egress channels the operator can
/// enable/disable. Lives in its own table (not WorkspaceSetting) so
/// `requiresAdmin`, `lastChangedBy`, `lastChangedAt`, and `reason` can
/// be modelled as first-class columns instead of opaque JSON. Defaults
/// are seeded by `services/workspace-settings.service.ts` per
/// FEATURES.md §8:
///   - software_updates    enabled  (operator opts in by leasing a Droplet)
///   - cloud_model_escape  disabled (sovereignty default — must opt-in)
///   - outbound_email      enabled  (notifications + invites)
///   - telemetry           enabled  (Warp Lab fleet ops; can be revoked)
///   - web_fetch           disabled (must opt-in; LLM tool blocked by default)
///
/// `reason` is required on every PATCH so the audit feed answers
/// "who turned cloud escape back on, and why" without a Slack archaeology
/// expedition. Per ADR-005, off-LAN channels are sovereignty surface —
/// changes are owner+admin only.
model OffLanAllowlistChannel {
  key           OffLanChannelKey @id
  enabled       Boolean
  requiresAdmin Boolean          @default(true)
  lastChangedBy String?
  lastChangedAt DateTime         @default(now())
  reason        String?
}

/// WARP-467 — closed set of off-LAN egress channels. Extending the
/// vocabulary is a schema change so the dashboard and the egress
/// metering pipeline (WARP-468 / E2) can't drift apart silently.
enum OffLanChannelKey {
  software_updates
  cloud_model_escape
  outbound_email
  telemetry
  web_fetch
  /// WARP-1436 — "Weather & currency data (Open-Meteo, European Central
  /// Bank)": the /api/web/weather + /api/web/rates routes' egress gate,
  /// fronting the services/web-fetch allowlisted fetcher.
  ambient_data
  /// WARP-2904 — Web Push delivery: the dial to whichever push service
  /// (Google / Apple / Mozilla) a PushSubscription row names. Read by
  /// `webPushGate` in dispatchToUser, the one dial site, on every call.
  web_push
  /// WARP-3264 — "Look up places online": the calendar place field's
  /// OpenStreetMap (Nominatim) lookup. Owner-only switch, default off;
  /// read fail-closed by `placeLookupGate` in GET /api/calendar/places.
  place_lookup
  /// WARP-3532 (ADR-069 §9) — "may work data leave this box": the one switch
  /// for webhooks and Slack / Teams / Discord / Google Chat notifications, and
  /// for WS-18's GitHub / GitLab poll. Owner-only, default off; read
  /// fail-closed by `workIntegrationsGate` before every off-LAN delivery. LAN
  /// destinations never need it (they still pass the SSRF guard). One key, not
  /// one per integration: an owner decides this once.
  work_integrations
}

/// WARP-473 — Phase G1. File ↔ ChatMessage citations.
///
/// One row every time the agent loop emits a `tool_result` whose card
/// kind is `file_results` or `code_block` and that result references
/// one or more files. The §2.3 file-detail drawer reads this table
/// to populate its "Related chats" section.
///
/// Inserts are FIRE-AND-FORGET from the agent loop (setImmediate) so
/// a slow DB write can never stall a turn. Duplicate inserts on the
/// same (filePath, messageId) are tolerated — the dashboard de-dupes
/// in render. We don't add a unique index here because the same file
/// can legitimately be cited multiple times within one message (and
/// the cost of an extra row is one ChatSession lookup).
///
/// `userId` is the privacy boundary — without it, the related-chats
/// query leaks other users' chat session titles for any commonly-cited
/// file path. Indexed `(filePath, userId, citedAt DESC)` for the IDOR-
/// safe range-scan that powers the dashboard's "Related chats" panel.
model FileCitation {
  id        String   @id @default(uuid())
  filePath  String
  userId    String
  threadId  String
  messageId String
  citedAt   DateTime @default(now())

  @@index([filePath, userId, citedAt(sort: Desc)])
}

/// WARP-881 / WS-3 (ADR-027) — native file comments. Nextcloud stays dumb
/// storage (ADR-013); Droplet owns this metadata, exactly like FileCitation
/// and ActivityRow. Keyed on `ncFileId` (oc:fileid, resolved via
/// `ncGetFileId`) — the SAME identifier `File.ncFileId` /
/// `FileContentChunk.ncFileId` use — so a comment SURVIVES a rename/move.
/// (Deliberately NOT path-keyed like FileCitation, whose rows go stale on
/// rename.)
///
/// IDOR: `authorUserId` is the LOCAL `User.id` UUID (`req.user.id`), NOT the
/// Nextcloud username (`getUser(req)`). The read filter scopes a non-
/// privileged user to `{ ncFileId, authorUserId: req.user.id }`; storing the
/// username while filtering by the UUID would make a `family` user see zero
/// of their own comments. Owner/admin see every household comment.
model FileComment {
  id           String   @id @default(uuid())
  ncFileId     Int // oc:fileid; resolve via ncGetFileId — survives rename/move
  authorUserId String // req.user.id (local User UUID), NOT getUser(req)/username
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ncFileId, createdAt(sort: Desc)])
  @@index([authorUserId])
}

/// WARP-881 / WS-3 (ADR-027) — native file tags. File-scoped, NOT user-
/// scoped: every reader sees every tag on a file (a household-shared
/// taxonomy). `addedByUserId` records provenance only — it does NOT gate
/// reads. Unique on `(ncFileId, label)` so a re-add is an idempotent upsert
/// (the original `addedByUserId`/`createdAt` are preserved).
model FileTag {
  id            String   @id @default(uuid())
  ncFileId      Int
  label         String
  addedByUserId String // req.user.id (local User UUID)
  createdAt     DateTime @default(now())

  @@unique([ncFileId, label])
  @@index([ncFileId])
  @@index([addedByUserId])
}

/// Finder-tag-style palette for a folder's colour in the Files UI. "No colour"
/// is not a member: clearing a colour deletes the `FileFolderColor` row (the
/// row's existence IS the "this folder is coloured" fact, and `color` is its
/// only state — there is no second column to disagree with it).
enum FolderColor {
  red
  orange
  yellow
  green
  blue
  purple
  gray
}

/// Per-user folder colour. Personal organisation, NOT shared metadata: user A
/// colouring a folder is invisible to user B, so it is keyed on
/// `(userId, ncFileId)`. `ncFileId` (oc:fileid) survives rename/move — the
/// same identity FileTag / FileComment use — so no path bookkeeping happens on
/// rename. `userId` is the LOCAL `User.id` UUID (`req.user.id`), never the
/// Nextcloud username. Like FileTag, no FK to User: a file-metadata table
/// keyed on Nextcloud identities, mirroring the shipped precedent.
model FileFolderColor {
  id        String      @id @default(uuid())
  userId    String
  ncFileId  Int
  color     FolderColor
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, ncFileId])
  @@index([userId])
}

/// WARP-468 — Phase E2. 60 s egress byte counter per off-LAN channel.
///
/// One row per (ts, channel). A 60 s apscheduler tick in
/// `services/routing/egress_meter.py` reads OpenWrt nftables byte
/// counters (chain per channel under the `droplet_offlan_*` prefix),
/// diffs against the previous sample, and POSTs the derived delta
/// into the orchestrator via /api/network/off-lan-sample-batch.
///
/// `bytes` is BigInt because cumulative monthly totals on a busy
/// channel can exceed 2³¹ comfortably. The chart on the Network
/// page sums these rows for the §2.6 "Off-LAN this month" chip;
/// the Models page sums them filtered to `cloud_model_escape` for
/// the "Cloud spend" chip.
///
/// Retention: a nightly cron prunes rows older than 90 days. Longer
/// than throughput samples (30 d) because off-LAN totals roll up
/// to monthly billing windows; 90 d covers a quarter-on-quarter
/// review without bloating the table.
model OffLanEgressSample {
  ts      DateTime         @default(now())
  channel OffLanChannelKey
  bytes   BigInt

  @@id([ts, channel])
  @@index([channel, ts(sort: Desc)])
}

/// ADR-007 + ADR-009: workspace type for this Droplet. Business is the
/// multi-role IA (Roles matrix, Groups, Sessions, full People,
/// Plan/Billing).
///
/// Singleton row pinned to `id = 1`. The dashboard's WorkspaceProvider
/// hydrates from `/api/settings/workspace`; only the setup wizard and
/// owner-only POST to `/api/settings/workspace` can flip it.
///
/// WARP-1341: this build ships business-only — BUSINESS is the default
/// and the only reachable value (the wizard and the owner POST both
/// refuse "home"). HOME stays in the enum solely so pre-migration rows
/// deserialize; the 20260717 migration flips them to BUSINESS.
enum WorkspaceType {
  HOME
  BUSINESS
}

model Workspace {
  // Singleton — exactly one row per Droplet. id = 1 lets every CRUD
  // path use a fixed primary key + prisma upsert without inventing one.
  id                Int           @id @default(1)
  type              WorkspaceType @default(BUSINESS)
  /// Optional human-readable name ("Stefan's Home" / "Acme HQ").
  /// Surfaced in the chrome workspace pill + setup wizard.
  displayName       String?
  /// PR #380 (WARP onb org) — the onboarding ORG step fields. The org step
  /// names this single workspace (the "company brain") and reserves its
  /// `droplet.local/<slug>` host. Everyone the owner invites joins this ONE
  /// workspace, so the org data lives on the SAME singleton row rather than a
  /// second workspace table.
  ///
  /// `slug` is UNIQUE and validated `[a-z0-9-]` (setup-org.service.ts); it
  /// reserves `droplet.local/<slug>`. Nullable because the pre-#380 Home/
  /// Business path (and a box that hasn't run the org step yet) has no slug.
  ///
  /// `industry` / `size` are LOCAL smart-default hints ONLY — folder
  /// structure, example tools, camera policy. NEVER sent off the box
  /// (FEATURES.md §10). `logoPath` is the on-NVMe path of the optional logo.
  slug              String?       @unique
  tz                String?
  industry          String?
  size              String?
  logoPath          String?
  /// Module-toggles feature — BOUNDED module-preset selector. Distinct from the
  /// free-form `industry` hint above: module enablement keys off THIS enum so the
  /// preset a customer picks maps to a deterministic module set (CLAUDE.md
  /// no-guessing / explicit-enum rule — a free-form string can't back a reliable
  /// preset map). The setup wizard MAY derive it from `industry`. Null until a
  /// preset is applied, in which case the registry's per-module `defaultEnabled`
  /// applies. See docs/superpowers/specs/2026-07-07-module-toggles-design.md.
  businessType      BusinessType?
  businessTypeSetBy String?
  businessTypeSetAt DateTime?
  /// PR #380 — EXPLICIT completion flag for the org step. The wizard / state
  /// machine reads THIS, never `slug IS NULL` (CLAUDE.md no-guessing rule;
  /// WARP-218 / ClaimCodeState precedent). False until the org step persists;
  /// the org step is NOT skippable.
  orgConfigured     Boolean       @default(false)
  /// Owner setting, OFF by default: may owner/admin/family map their own
  /// drive in Finder / File Explorer (POST /api/storage/network-drive/personal
  /// mints a per-user Nextcloud app password)? EXPLICIT boolean, never derived
  /// from the presence of DeviceClient rows or a role (CLAUDE.md no-guessing
  /// rule; same discipline as `orgConfigured` above). Written only by the
  /// owner-only PUT /api/settings/workspace/personal-drive; readable by any
  /// signed-in user through GET /api/settings/workspace so the dialog can say
  /// why the drive is unavailable. WARP-3318; see docs/network-drive.md.
  personalDriveEnabled Boolean       @default(false)
  /// Whoever last flipped the type (Nextcloud username from the auth
  /// middleware). Nullable: setup wizard runs before any user exists.
  setBy             String?
  setAt             DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/// Module-toggles feature — the bounded set of vertical presets. Each maps (in
/// code, src/modules/module-registry.ts BUSINESS_TYPE_PRESETS) to a default set
/// of enabled modules. `custom` = no preset (leave current toggles as-is).
/// Adding a value here is a schema change — keep the set stable and update the
/// preset map + the design spec together.
enum BusinessType {
  home
  professional_office
  retail
  clinic
  hospitality
  custom
}

/// Module-toggles feature — the canonical id of every user-facing capability
/// module. The catalog (label, category, route prefixes, tool domains,
/// availability signal, defaults) lives in code (src/modules/module-registry.ts,
/// the one-registry discipline mirroring packages/tools-core); THIS enum is the
/// shared id vocabulary between the registry, the ModuleSetting rows, and the
/// dashboard. Admin-only surfaces (activity, rag-eval) stay on the existing
/// GET /api/admin/capabilities probe and are intentionally NOT here.
enum ModuleId {
  chat
  knowledge
  files
  docs
  email
  calendar
  projects
  voice
  cameras
  smart_home
  network
  managed_switch
  /// WARP-1683 — Team chat (member-to-member Messages surface).
  team_chat
  /// WARP-2018 — Contacts (the one address book, CardDAV/Graph-fed or local).
  contacts
  /// WARP-2117 — CRM (companies, deals, pipeline, timeline), nested inside
  /// the Projects surface.
  crm
  /// WARP-2581 — invoices and bills landed from a cloud ledger. Its own
  /// module because a box that keeps its books elsewhere should have no
  /// /money surface at all, rather than an empty one.
  money
  /// WARP-3528 (ADR-069) — the service desk: tickets, requesters, public
  /// replies and internal notes, at /support. Its own module because a front
  /// desk that answers customers needs no project tracker, and the surface has
  /// its own API prefix (/api/support).
  support
}

/// Module-toggles feature — per-install runtime enablement of a module. ONE row
/// per module, keyed by the ModuleId enum. `enabled` is an EXPLICIT boolean,
/// never derived from absence (CLAUDE.md no-guessing rule; same discipline as
/// UserInvite.role / BrainMemoryItemStatus / Workspace.orgConfigured). A MISSING
/// row means "the operator hasn't decided" → the registry's versioned
/// `defaultEnabled` applies; it is NOT an inferred runtime state. Applying a
/// business type materializes a row for every non-core module, so post-onboard
/// the table is fully explicit. Effective = available (deploy-time, from config)
/// AND enabled (this row). See the design spec for the two-axis model.
model ModuleSetting {
  moduleId ModuleId @id
  enabled  Boolean
  setBy    String?
  setAt    DateTime @default(now()) @updatedAt
}

/// PR #372 — first-run setup is RESUMABLE and EXPLICIT.
///
/// Before this model, setup was stateless: the dashboard derived a
/// boolean `setupRequired` from Nextcloud's `installed` flag
/// (`GET /api/auth/setup`), so a refresh mid-wizard lost the customer's
/// place and there was no `unclaimed → ready` lifecycle. `ApplianceSetup`
/// makes the state a first-class, persisted, explicit column.
///
/// `setupStep` is the resumability anchor — the orchestrator persists it
/// as the customer advances the wizard, so a refresh routes them back to
/// the exact same step (the headline AC). It is the `SetupStep` enum, not
/// a free-form string, per CLAUDE.md's no-guessing rule (canonical
/// precedent: WARP-218 `BrainMemoryItemStatus`).
///
/// `state` is the appliance lifecycle: "unclaimed" (first-run not
/// finished) vs "ready" (wizard complete). DELIBERATELY a column the
/// finish-handler flips, NEVER derived from `setupStep == done` or from
/// Nextcloud's `installed` flag — the same no-derived-state rule. Kept as
/// a 2-value String (not an enum) to match the spec's data-model block in
/// docs/ONBOARDING_STATE_MACHINE.md verbatim; the service is the single
/// writer and validates the two legal values.
///
/// `userTourCompleted` gates the post-claim product tour: a ready
/// appliance whose owner hasn't seen the tour routes to the tour, not the
/// dashboard. Independent of `state` (claiming the box and finishing the
/// tour are distinct events).
///
/// Singleton — exactly one row per appliance, pinned to a fixed `id` the
/// same way `Workspace` pins `id = 1`, so every read/write is an upsert
/// against a known primary key with no "which row?" ambiguity. Persisted
/// on the encrypted NVMe (FEATURES.md §10) alongside the rest of the
/// orchestrator's Postgres state.
model ApplianceSetup {
  // Fixed singleton key — there is only ever one appliance-setup row.
  // Not a generated uuid: a uuid default would mint a new row on every
  // upsert-create and break the singleton invariant.
  id                String    @id @default("singleton")
  // "unclaimed" | "ready". Explicit lifecycle column — never derived.
  state             String    @default("unclaimed")
  setupStep         SetupStep @default(welcome)
  userTourCompleted Boolean   @default(false)
  // WARP-1039 — the owner-chosen box name (validated slug), written by
  // POST /setup/box-name on the ok path alongside the host-.env write-back.
  // The .env write only becomes visible to the orchestrator on the NEXT boot
  // (config is a boot-time snapshot), so this column is what lets
  // GET /setup/box-name surface the saved name back to the wizard in-session
  // (AddressStep rehydration + VpnStep's honest blocked view). NULLABLE and
  // additive so the raw-INSERT singleton seed migration (explicit column
  // list, 20260531150000) stays valid. Null = no name chosen yet — allowed
  // here because the name genuinely may not exist; the lifecycle columns
  // above remain the explicit non-derived state.
  boxName           String?
  // M6 (PR #372 re-review): `@default(now())` emits a DB-level
  // DEFAULT CURRENT_TIMESTAMP so a raw INSERT omitting `updatedAt` (the
  // singleton migration seed) can't violate NOT NULL; `@updatedAt` still
  // bumps it on every Prisma write.
  updatedAt         DateTime  @default(now()) @updatedAt
  createdAt         DateTime  @default(now())
}

/// PR #372 — ordered first-run wizard steps. The set mirrors the
/// dashboard wizard's `STEPS` array in
/// `apps/web-dashboard/src/app/setup/page.tsx` 1:1, so the persisted
/// resume-point can never reference a step the wizard can't render.
///
/// GATE (PR #372): listed only the 9 SHIPPED steps and documented that the
/// claim / org / team steps EXTEND this enum — and the wizard array, and the
/// route validation — in one coherent change when they ship.
///
/// PR #373 (this change) — `claim` ships. It slots FIRST (after the welcome
/// splash, before account): the customer binds the appliance to their
/// workspace before any account exists, per #371 handoff §1
/// (`welcome → claim → account → …`). The value is appended at the END of the
/// enum DECLARATION (not inserted between `welcome` and `account`) because
/// Postgres enums are ordered by their physical declaration order and
/// `ALTER TYPE … ADD VALUE` can only append cheaply; the WIZARD ORDER lives in
/// `SETUP_STEPS` (setup.service.ts) and the dashboard `STEPS` array, which both
/// place `claim` second. The enum is an unordered membership set here — nothing
/// reads its declaration order — so appending is safe and keeps the additive
/// migration trivial.
///
/// PR #380 (WARP onb org) — `org` ships. It slots AFTER account
/// (`welcome → claim → account → org → internet → …`): the customer names the
/// single workspace and reserves its `droplet.local/<slug>` once the owner
/// account exists. Appended at the END of the declaration for the same
/// append-only `ALTER TYPE … ADD VALUE` reason as `claim`; the wizard order
/// lives in `SETUP_STEPS` / the dashboard `STEPS` array.
///
/// PR #381 (WARP onb team) — `team` ships, the LAST onboarding step to wire.
/// It slots near the END of the WIZARD, after `ai` and before `done`
/// (`… → ai → team → done`): once the box is set up, the owner brings people
/// in — invite by email + role, or note directory-sync over SSO. The step IS
/// skippable ("I'll invite people later"; a solo owner is a valid end state),
/// so the value is reachable but not gating. Appended at the END of the
/// declaration for the same append-only `ALTER TYPE … ADD VALUE` reason as
/// `claim` / `org` — declaration order is membership-only; the wizard ORDER
/// (team before done) lives in `SETUP_STEPS` + the dashboard `STEPS` array.
enum SetupStep {
  welcome
  account
  internet
  storage
  discovery
  cameras
  vpn
  ai
  done
  claim
  org
  team
}

/// PR #373 — claim-code lifecycle. EXPLICIT, never derived from absence.
///
/// `available` — the code can still bind the appliance.
/// `consumed`  — the code has bound the appliance (single-use; terminal).
///
/// The "is this code still claimable?" decision reads this column, NOT
/// `usedAt IS NULL` (CLAUDE.md no-guessing rule; canonical precedent WARP-218
/// `BrainMemoryItemStatus`). `usedAt` exists for AUDIT only — when the bind
/// happened — and is written in the same atomic transaction that flips the
/// state, so the two can never disagree. Mirrors the `state`-column discipline
/// `ApplianceSetup` uses for the appliance lifecycle.
enum ClaimCodeState {
  available
  consumed
}

/// PR #373 — a single-use code that binds a fresh appliance to its workspace
/// (the onboarding Claim step). The customer reads the code off the PyPortal
/// lid display and confirms it; `POST /api/setup/claim` verifies it and flips
/// the appliance to "ready".
///
/// SECURITY POSTURE (per docs/ONBOARDING_CLAIM.md + #371 handoff §2):
///   - `codeHash` stores a one-way hash, NEVER the plaintext code, so a DB
///     read (backup, breach, hand-edit) can't recover a live claim code.
///     Verification re-hashes the candidate and compares in constant time
///     (timingSafeEqual) — no plaintext at rest, no early-exit byte compare.
///   - `state` (ClaimCodeState) is the explicit single-use guard. The atomic
///     consume is a conditional `updateMany WHERE state = 'available'` inside a
///     `$transaction` (the WARP-564 pairing-claim pattern): the Postgres row
///     lock serializes concurrent claimers, the loser flips zero rows and is
///     rejected, so a code can bind the box exactly once even under a race.
///   - `attempts` counts wrong-code guesses against this code for lockout /
///     observability; the live rate-limit BUDGET is enforced in the route via
///     the shared cache-counter helper (no busy-loop), and a wrong guess
///     decrements that budget without revealing the real code.
///
/// MINTING / ROTATION IS OUT OF SCOPE for this PR (it belongs to the PyPortal
/// display-service — a separate PR). Here a code is seeded via env/fixture
/// (`CLAIM_CODE` / a test fixture) and only VERIFIED. `expiresAt` is carried so
/// the rotation owner can expire codes later; the consume already treats expiry
/// as authoritative (`expiresAt > now` in the conditional update).
model ClaimCode {
  id        String         @id @default(uuid())
  // One-way hash of the claim code. Never the plaintext.
  codeHash  String         @unique
  // Explicit single-use lifecycle — never inferred from `usedAt`.
  state     ClaimCodeState @default(available)
  // When the code expires. The rotation owner (PyPortal service, future PR)
  // sets this; the consume treats it as authoritative.
  expiresAt DateTime
  // Audit-only: when the successful bind happened. Written in the same
  // transaction that flips `state` → consumed. Null while available.
  usedAt    DateTime?
  // Wrong-guess counter for this code (lockout / observability).
  attempts  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// ADR-023 (C2): the lifecycle state of the per-device TLS serving cert.
/// EXPLICIT (architecture-guard rule 10 + ADR-023 §C2): the tls-issuance cron
/// reads this enum to decide issue-vs-renew-vs-noop — it NEVER infers the state
/// from a null/expired cert file.
///   BOOTSTRAP_SELF_SIGNED — the secrets.sh self-signed bootstrap cert is
///                           installed; HQ issuance has not yet succeeded.
///   LE_ISSUED             — a publicly-trusted Let's Encrypt fullchain is
///                           installed and current.
///   LE_RENEWING           — a renewal/issuance order is in flight.
///   LE_RENEW_FAILED       — HQ was unreachable or the order didn't go active;
///                           the box keeps serving its current cert and retries
///                           on the next daily tick.
enum TlsCertState {
  BOOTSTRAP_SELF_SIGNED
  LE_ISSUED
  LE_RENEWING
  LE_RENEW_FAILED
}

/// ADR-023 (C2): one row per opaque per-device FQDN tracking the installed TLS
/// cert's state + expiry. Keyed by `fqdn` (`d-<hmac>.devices.warp-lab.ai`) so a
/// box that ever learns a new FQDN gets a fresh row rather than overwriting the
/// old one. `notAfter` mirrors the installed leaf's expiry and drives the
/// 30-day renewal threshold; null until the first LE cert is installed.
model TlsCert {
  fqdn      String       @id
  state     TlsCertState @default(BOOTSTRAP_SELF_SIGNED)
  notAfter  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// WARP-882 / WS-4 — one row per OPEN in-browser editing/co-authoring session,
/// keyed on the Nextcloud numeric fileId. Co-authoring is a single shared
/// document session: many editors collaborate on one `ncFileId`, so the fileId
/// is the natural key (the engine's `documentKey` namespaces that session).
/// Re-opening a file while a session is active upserts this row rather than
/// creating a duplicate.
///
/// `status` is an EXPLICIT enum column, never derived from absence (handbook
/// "state is explicit"; canonical precedent WARP-218 `BrainMemoryItemStatus`).
/// `closing` is the non-terminal transition the engine's save-callback drives
/// before the row settles to `closed`; `closed` rows are retained for audit.
model FileEditSession {
  /// Nextcloud numeric fileId — the co-authoring session key.
  ncFileId     Int                   @id
  /// Last user observed to open/touch the session (NC username). Audit only.
  ncUser       String
  /// Path at session open, for human-readable audit/logs (may go stale on move).
  filePath     String
  /// Engine-decided mode the session was opened in.
  mode         FileEditSessionMode
  /// EXPLICIT lifecycle state — never inferred from a null column.
  status       FileEditSessionStatus @default(open)
  /// Opaque co-authoring document key handed to the engine.
  documentKey  String
  openedAt     DateTime              @default(now())
  /// Bumped on every editor-session mint / heartbeat for the same fileId.
  lastActiveAt DateTime              @default(now())
  /// Set when the engine's save-callback reports the session fully closed.
  closedAt     DateTime?

  @@index([status])
  @@index([ncUser, status])
}

enum FileEditSessionMode {
  edit
  view
}

enum FileEditSessionStatus {
  open
  closing
  closed
}

// ─────────────────────────────────────────────────────────────────────────────
// Native Project Management (ADR-026 — supersedes ADR-010 embedded Plane)
//
// First-class, Droplet-owned PM. Replaces the embedded Plane stack: all state
// lives here (Plane held none — greenfield), the dashboard renders it natively
// in the bento design system, and the 9 `pm_*` MCP tools read/write it through
// the orchestrator. RBAC reuses the existing Role enum + requireRole guards.
//
// Naming: every model is `Pm`-prefixed to stay clear of the existing dashboard
// `Workspace`/`WorkspaceType` (ADR-007 dual-workspace) and `ActivityRow`. The
// PM "workspace" is the Plane-style container the tool contract still keys on
// via `workspace_slug`; a single `home` workspace is seeded on first boot.
// User references (leadId/createdById/authorId/actorId/assignee userId) are
// plain `User.id` strings — same convention as ChatProject.userId /
// CalendarEvent.userId — not FK relations, to avoid widening the User model.
// ─────────────────────────────────────────────────────────────────────────────

/// Top-level PM container. One per home (seeded `home`); the model is kept so
/// the LLM tool contract's `workspace_slug` stays meaningful and multi-home is
/// possible later without a schema break.
model PmWorkspace {
  id        String      @id @default(uuid())
  slug      String      @unique
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  projects  PmProject[]
  /// WARP-3522 — saved views, project-scoped and cross-project.
  savedViews PmSavedView[]
  /// WARP-3532 — the workspace's webhook destinations.
  webhooks  PmWebhook[]
}

/// A project (Plane "project"). `identifier` is the short key prefix (e.g.
/// "INBOX") combined with a per-project work-item number to form INBOX-42.
/// `seqCounter` is the monotonic source for that number — bumped via an
/// atomic `UPDATE ... SET "seqCounter" = "seqCounter" + 1 RETURNING` inside
/// the same interactive transaction as work-item creation (pm.service.ts
/// `createWorkItem`): Postgres takes the row lock at that UPDATE and holds it
/// for the rest of the transaction, so a concurrent create blocks until the
/// first commits and never observes/reuses the same number (WARP-885 —
/// documents the existing enforcement; no schema change needed for this one).
model PmProject {
  id           String      @id @default(uuid())
  workspaceId  String
  workspace    PmWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  identifier   String
  description  String?
  icon         String?
  color        String?
  leadId       String?
  /// WARP-3528 (ADR-069 §1) — which surface owns this container. An explicit
  /// enum, never inferred from the presence of a `PmTicket` row. `/api/pm/*`
  /// and the dashboard's /projects read PROJECT only; `/api/support/*` reads
  /// SERVICE_DESK only. A service-desk work item fetched through a PM route is
  /// a 404, so the `projects` grant is never a back door into customer
  /// conversations. Set once at creation and never changed.
  kind         PmProjectKind @default(PROJECT)
  /// ADR-045 §5.3 — the department that owns this project's work. NULLABLE and
  /// SetNull: `Department` is a Nextcloud groupfolder (ADR-029), so deleting
  /// one must never delete work, and a project with no department reads as
  /// unassigned rather than as an error. A work item may override this per item
  /// (`PmWorkItem.departmentId`). This is a DIMENSION, not a boundary — PM is
  /// household-shared and every role still reads every project.
  departmentId String?
  department   Department? @relation("PmProjectDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  seqCounter   Int         @default(0)
  sortOrder    Int         @default(0)
  /// Canonical "is archived" signal (WARP-884) — explicit column, not
  /// derived from `archivedAt IS NOT NULL`. `archivedAt` remains the audit
  /// timestamp of when it was archived (null when un-archived, mirroring the
  /// prior derivation's semantics).
  isArchived   Boolean     @default(false)
  archivedAt   DateTime?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  states     PmState[]
  labels     PmLabel[]
  workItems  PmWorkItem[]
  cycles     PmCycle[]
  modules    PmModule[]
  properties PmCustomProperty[]
  /// WARP-3522 — views saved against this project (cross-project views have no project).
  savedViews PmSavedView[]
  /// WARP-3529 — the channels a SERVICE_DESK takes requests through. Always
  /// empty for a PROJECT (a trigger holds that).
  supportChannels PmSupportChannel[]
  /// WARP-3532 — webhooks scoped to this project (cascade with it).
  webhooks   PmWebhook[]

  /// WARP-2117 — the deals this project delivers. A won deal becomes a job;
  /// the link is on the deal so deleting the project leaves the commercial
  /// record intact (SetNull, not Cascade).
  crmDeals CrmDeal[]

  /// WARP-2562 (ADR-044) — the customer this project is FOR.
  ///
  /// WARP-2117 gave the DEAL a project ("a won deal becomes the job that
  /// delivers it"). This is the other direction, and it is not the same edge:
  /// plenty of work for a customer never came through a deal at all — a
  /// warranty callout, a second phase, anything begun before the CRM was
  /// switched on. Reading the customer off `crmDeals` would leave those
  /// projects unattributed.
  ///
  /// NULL is the common case and is not a gap: internal projects have no
  /// customer, and on a home box that is most of them.
  ///
  /// SetNull, not Cascade — deleting a customer must not delete the work
  /// delivered for them. The job happened.
  companyId String?
  company   CrmCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// WARP-2585 — files related to this job. Cascade, unlike `crmDeals`: a link
  /// is a pointer with no independent meaning, where a deal is a commercial
  /// record that outlives the project.
  fileLinks EntityLink[]

  /// WARP-3533 — ICS feed links for this project (see CalendarFeedToken).
  /// Cascade: a feed of a deleted project reads nothing.
  feedTokens CalendarFeedToken[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId, sortOrder])
  /// WARP-845: an unindexed ON DELETE SET NULL FK makes the parent delete a
  /// sequential scan of this table. Five such columns already shipped
  /// unindexed on the CRM side; not repeating it here.
  @@index([departmentId])
  /// "This customer's projects" is the customer record's own query.
  @@index([companyId, isArchived])
}

/// Workflow state group — the kanban-column semantics. Explicit enum (no
/// string-soup per CLAUDE.md "no guessing"); the dashboard groups columns and
/// the LLM transition tool validates against it.
enum PmStateGroup {
  backlog
  unstarted
  started
  completed
  cancelled
}

/// Per-project workflow state (kanban column). Default seed set: Backlog /
/// Todo / In Progress / Done / Cancelled. `isDefault` marks the landing state
/// for newly created work items.
///
/// INVARIANT: at most ONE default state per project. Enforced by a partial
/// unique index — `UNIQUE ("projectId") WHERE "isDefault" = true` — that lives
/// in raw migration SQL because Prisma's schema language cannot express a
/// WHERE-filtered (partial) unique index. See the
/// `PmState_projectId_isDefault_key` index in the native_pm_foundation
/// migration. State names are also unique per project (`@@unique` below).
model PmState {
  id        String       @id @default(uuid())
  projectId String
  project   PmProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  group     PmStateGroup @default(backlog)
  color     String?
  sortOrder Int          @default(0)
  isDefault Boolean      @default(false)
  /// WARP-3528 (ADR-069 §5) — what being in this state does to a ticket's SLA
  /// clock. A column, not a rule derived from the group or the name, so a desk
  /// can rename "Pending" without breaking its SLAs. Meaningful on service-desk
  /// states only; every project state carries the default and nothing reads it.
  slaClock  PmSlaClock   @default(RUNNING)
  /// WARP-3529 (ADR-069 §4) — what a customer's email does to a ticket that sits
  /// in this state: nothing, return it to work, or (the ticket being final) open
  /// a follow-up. An explicit column for the same reason as `slaClock`: Solved and
  /// Closed are both a completed state that stops the clock, and which of them
  /// takes a reply back is the desk's rule, not something to read off a name a
  /// desk may rename. Meaningful on service-desk states only; every project
  /// state carries the default and nothing reads it.
  onCustomerReply PmCustomerReplyEffect @default(NONE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  workItems PmWorkItem[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

/// Per-project label/tag.
model PmLabel {
  id        String            @id @default(uuid())
  projectId String
  project   PmProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  items     PmWorkItemLabel[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Work-item priority. Matches the strings the LLM tool contract and dashboard
/// expect verbatim.
enum PmPriority {
  urgent
  high
  medium
  low
  none
}

/// The work item (Plane "issue"). `sequenceId` + project.identifier forms the
/// human key (INBOX-42). `sortOrder` is a float so a kanban drag can insert
/// between two cards without renumbering the column. Sub-issues via the
/// self-relation; `state`/`cycle`/`parent` are SetNull so deleting one of those
/// never cascades away the work itself.
///
/// `parentId ON DELETE SET NULL` (WARP-885): when a parent is deleted,
/// pm.service.ts `deleteWorkItem` explicitly re-parents (`parentId = null`)
/// and emits one `parent_removed` PmActivity row per orphaned child BEFORE
/// the delete, in the same transaction — so the DB-level SET NULL is a
/// defense-in-depth backstop, never the only record of the promotion.
///
/// `stateId ON DELETE SET NULL` (WARP-885): `deleteState` refuses to delete
/// the last state or the project's sole default (STATE_IS_LAST /
/// STATE_IS_DEFAULT), and — for any other state — reassigns its work items to
/// the project's default state (with a completion-signal re-sync) before the
/// delete, so a deleted state never strands items in an unbucketed
/// NULL-state limbo.
model PmWorkItem {
  id              String       @id @default(uuid())
  projectId       String
  project         PmProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequenceId      Int
  name            String
  descriptionHtml String?
  /// WARP-3522 — the plain-text projection of `descriptionHtml`: tags stripped,
  /// entities decoded, whitespace collapsed. NEVER written by application code:
  /// the `pmworkitem_description_text` trigger (migration 20261004060000)
  /// recomputes it on every INSERT and on every UPDATE that sets
  /// `descriptionHtml`, so every write path — this service's, another slice's,
  /// a raw import — keeps it true. It exists so the filter DSL's `text`
  /// condition searches what a person typed, not the markup around it (an
  /// ILIKE over the raw HTML matches "class", "strong" and every href), and so
  /// that search can use a trigram index. Null when there is no description.
  descriptionText String?
  stateId         String?
  state           PmState?     @relation(fields: [stateId], references: [id], onDelete: SetNull)
  priority        PmPriority   @default(none)
  parentId        String?
  parent          PmWorkItem?  @relation("PmSubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children        PmWorkItem[] @relation("PmSubIssues")
  /// WARP-3521 — the cycle (sprint) this item is planned into, at most one.
  /// SetNull so deleting a cycle never deletes work; `deleteCycle` audits that
  /// SET NULL with one `cycle_removed` row per item before it runs. The cycle
  /// MUST belong to the item's own project: the service refuses a cross-project
  /// cycle (`invalid_cycle`) and the `pmworkitem_cycle_same_project` trigger in
  /// the warp_3521_pm_cycles_modules migration backstops it (a CHECK cannot — it
  /// may not contain a subquery; same reasoning as `pmworkitem_parent_same_project`).
  cycleId         String?
  cycle           PmCycle?     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  /// ADR-045 §5.3 — the department that owns THIS item, OVERRIDING its
  /// project's when set. Null means "inherit the project's", which is also
  /// null-tolerant, so "nobody owns this" stays representable at both levels.
  /// SetNull for the same reason as the project's: deleting a department must
  /// never delete work, and must never be the reason work goes invisible.
  departmentId    String?
  department      Department?  @relation("PmWorkItemDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  createdById     String?
  startDate       DateTime?
  dueDate         DateTime?
  /// Size of the item, in points (WARP-3520 owns the field and its API; WARP-3521
  /// reads it for cycle / module progress and the burndown). Declared in both
  /// slices' migrations as `ADD COLUMN IF NOT EXISTS` so either lands first.
  estimate        Float?
  sortOrder       Float        @default(0)
  /// Canonical "is done" signal (WARP-884) — explicit column, not derived
  /// from `completedAt IS NOT NULL`. Kept in sync with the state's group by
  /// every write path that can change it: createWorkItem, updateWorkItem,
  /// updateState's group-change cascade, and deleteState's reassignment.
  isCompleted     Boolean      @default(false)
  completedAt     DateTime?
  /// Canonical "is archived" signal (WARP-884) — mirrors PmProject.isArchived.
  isArchived      Boolean      @default(false)
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  assignees      PmWorkItemAssignee[]
  labels         PmWorkItemLabel[]
  comments       PmComment[]
  attachments    PmAttachment[]
  activity       PmActivity[]
  modules        PmModuleWorkItem[]
  propertyValues PmWorkItemPropertyValue[]

  /// WARP-2117 — CRM timeline entries that POINT AT this work item (the task
  /// raised off a customer conversation).
  crmActivities CrmActivity[]

  /// WARP-2586 (ADR-045 slice G) — the cross-project edge, from both sides.
  /// TWO back-relations for ONE table because Prisma cannot disambiguate two
  /// edges from the same model to the same model without named relations.
  /// `relationsFrom` and `relationsTo` are a STORAGE view, not a semantic one:
  /// for the symmetric kinds (RELATES, DUPLICATES) the row is stored once in
  /// canonical id order and neither end leads, so read them through
  /// pm-relations.service's `listRelationsFor`, which matches on either end
  /// and reports an explicit `direction`. Reading only `relationsFrom` shows
  /// half the graph.
  relationsFrom PmWorkItemRelation[] @relation("PmRelationFrom")
  relationsTo   PmWorkItemRelation[] @relation("PmRelationTo")

  /// WARP-2585 — files in /files RELATED to this work item. Not the same thing
  /// as `attachments` above and not a replacement for it: a `PmAttachment` is a
  /// COPY of the bytes on the orchestrator's own volume, an `EntityLink` is a
  /// pointer at a file that lives in /files and stays there.
  fileLinks EntityLink[]

  /// WARP-3526 (ADR-069 WS-10) — time logged against this item, and the timers
  /// currently running on it (at most one per person). Both cascade on delete.
  worklogs PmWorklog[]
  timers   PmTimer[]
  /// WARP-3528 (ADR-069 §1) — the desk-only columns of a ticket. Present
  /// exactly when the item lives in a SERVICE_DESK project (a trigger holds
  /// that); a project work item never has one.
  ticket PmTicket?

  @@unique([projectId, sequenceId])
  @@index([projectId, stateId, sortOrder])
  @@index([projectId, updatedAt(sort: Desc)])
  @@index([parentId])
  @@index([cycleId])
  @@index([stateId])
  /// WARP-845 — the ON DELETE SET NULL scan index.
  @@index([departmentId])
  /// ADR-045 §5.3 — the board's department filter is "this project's items,
  /// owned by department X". Neither `[departmentId]` above nor
  /// `[projectId, stateId, sortOrder]` can serve it, so the filter gets its own
  /// composite. Two columns only: the unfiltered board still orders off the
  /// state index.
  @@index([projectId, departmentId])
  /// WARP-3522 — the filter DSL's `text` condition is `name ILIKE '%q%' OR
  /// "descriptionText" ILIKE '%q%'`. A btree cannot serve a leading-wildcard
  /// pattern at all; a trigram GIN index lets the planner answer each arm with
  /// a bitmap scan. (A query shorter than three characters has no trigram and
  /// falls back to a scan, which is correct and, at this table's size, cheap.)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([descriptionText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Work-item ↔ assignee join. `userId` is a User.id.
/// Edge kind between two work items (WARP-2586, ADR-045 slice G).
///
/// UPPERCASE, matching CrmStageKind / CrmActivityKind rather than the
/// lowercase Pm* enums. Deliberate, and flagged so it reads as a decision:
/// these three values are quoted verbatim inside a raw-SQL CHECK constraint
/// (`PmWorkItemRelation_symmetric_canonical_order`) and in the service's
/// symmetric-kind set, and SCREAMING_CASE reads unambiguously as a wire enum
/// in both places.
///
/// BLOCKS is DIRECTIONAL — "A blocks B" and "B blocks A" are different claims,
/// and together a deadlock the service refuses on write.
/// RELATES and DUPLICATES are SYMMETRIC — one fact, therefore one row.
enum PmRelationKind {
  BLOCKS
  RELATES
  DUPLICATES
}

/// A link between two work items, which — unlike every other PM grouping — may
/// SPAN PROJECTS (WARP-2586, ADR-045 slice G).
///
/// PmModule and PmCycle both carry a projectId, so an epic and a sprint stop at
/// the project boundary. PmWorkItem.parentId can physically cross one but is
/// not allowed to: parenting is CONTAINMENT, and as of the WARP-2586 migration
/// a database trigger (`pmworkitem_parent_same_project`) holds it inside one
/// project — the application layer has enforced the same rule on every write
/// path since ADR-026 P2, and the dashboard's `useSubIssues` fetches children
/// through a project-scoped list, so an off-project child would never render.
/// This table is the other half of that decision: containment stays local,
/// REFERENCE crosses freely.
///
/// INVARIANTS THE SCHEMA LANGUAGE CANNOT EXPRESS — both live in raw migration
/// SQL (see 20260904140100_warp_2586_pm_work_item_relation) and are proven
/// against a real Postgres in `pm-work-item-relation.pg.test.ts`:
///
///   * `PmWorkItemRelation_no_self_edge` — CHECK ("fromId" <> "toId").
///   * `PmWorkItemRelation_symmetric_canonical_order` —
///     CHECK ("kind" = 'BLOCKS' OR "fromId" COLLATE "C" < "toId" COLLATE "C").
///     A symmetric relation is stored ONCE, smaller id first. Two rows for one
///     symmetric fact is how an edge becomes un-deletable: the drawer removes
///     the row it rendered, the mirror survives, and the relation is back on
///     refresh. The COLLATE "C" makes Postgres text `<` agree with the
///     service's JavaScript `<` on a cluster with any collation.
///
/// Both ends Cascade rather than SetNull: an edge with one end missing is not
/// a weaker edge, it is not an edge. `pm.service.deleteWorkItem` writes a
/// `relation_removed` activity row on the SURVIVING end before the delete, so
/// the cascade is always preceded by an explainable entry in that item's own
/// history — the discipline WARP-885 established for parentId's SET NULL.
model PmWorkItemRelation {
  id          String         @id @default(uuid())
  fromId      String
  from        PmWorkItem     @relation("PmRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          PmWorkItem     @relation("PmRelationTo", fields: [toId], references: [id], onDelete: Cascade)
  kind        PmRelationKind
  /// A User.id string, not an FK — the same convention every other PM
  /// attribution column follows (see the note at the head of this section).
  createdById String?
  createdAt   DateTime       @default(now())

  @@unique([fromId, toId, kind])
  /// BOTH directions are indexed, with `kind` second on each. The forward
  /// index serves the bounded BLOCKS cycle walk (one query per level,
  /// `kind = 'BLOCKS' AND fromId IN (...)`); the reverse index serves the
  /// incoming half of the work-item read. Postgres does not auto-index a
  /// foreign key column, and an unindexed FK is the WARP-845 hazard.
  @@index([fromId, kind])
  @@index([toId, kind])
}

model PmWorkItemAssignee {
  id         String     @id @default(uuid())
  workItemId String
  workItem   PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime   @default(now())

  @@unique([workItemId, userId])
  @@index([userId])
}

/// Work-item ↔ label join.
model PmWorkItemLabel {
  id         String     @id @default(uuid())
  workItemId String
  workItem   PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  labelId    String
  label      PmLabel    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([workItemId, labelId])
  @@index([labelId])
}

/// A comment on a work item. `authorId` null = system / LLM-authored.
///
/// WARP-3528 (ADR-069 §3) — one comment stream carries both halves of a ticket's
/// conversation. `visibility` says who may see it: INTERNAL (the default, so
/// every existing comment stays internal) is for the team; PUBLIC is the reply
/// the requester receives. Only a PUBLIC comment on a ticket is ever delivered
/// to the requester, and a project work item never has one — a trigger
/// (`pmcomment_public_only_on_tickets`) holds that, because the service is not
/// the only writer a future automation or importer will bring.
/// `authorKind` says what kind of party wrote it; `contactId` names the
/// requester when that party is a CONTACT.
model PmComment {
  id          String              @id @default(uuid())
  workItemId  String
  workItem    PmWorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId    String?
  commentHtml String
  visibility  PmCommentVisibility @default(INTERNAL)
  authorKind  PmAuthorKind        @default(USER)
  /// A plain `Contact.id`, like every other PM reference to a person (`authorId`
  /// is a plain `User.id`): a comment outlives the address-book row it names.
  /// Contact rows are owner-scoped and disappear by cascade when an address-book
  /// source is removed or a connector is purged, and none of those paths may be
  /// blocked by — or silently eat — a customer's conversation.
  contactId   String?
  /// WARP-3529 (ADR-069 §4) — whether the email of a PUBLIC reply reached the
  /// mail server: NONE for a comment that is not an outgoing email (a note, a
  /// customer's message, a reply recorded on a desk with no channel), PENDING
  /// from the moment it is queued, SENT or FAILED once the mail service says so.
  /// Explicit, never read off the draft's status at display time, and pinned by
  /// a CHECK: only a PUBLIC comment from staff or the system ever leaves NONE,
  /// and a failure always says why.
  deliveryStatus  PmDeliveryStatus   @default(NONE)
  deliveryFailure PmDeliveryFailure?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  /// The emails this comment is — the one it arrived as, or each attempt to send it.
  emailLinks PmTicketEmailLink[]

  @@index([workItemId, createdAt])
  /// The delivery sweep's read: the comments still waiting on the mail service.
  @@index([deliveryStatus, createdAt])
}

/// Cycle / sprint — a time-boxed set of work items.
enum PmCycleStatus {
  draft
  active
  completed
}

/// A cycle (sprint) — a time-boxed set of work items. Written by
/// `pm-cycles.service.ts` (WARP-3521): create / edit / start / complete /
/// delete, `completeCycle` being the one that moves work.
///
/// `startDate` / `endDate` are CALENDAR DATES, stored as midnight UTC like
/// `PmWorkItem.dueDate` and read back as `YYYY-MM-DD`. `completedAt` is the
/// instant `completeCycle` ran and `carriedOverCount` the number of unfinished
/// items it moved out — both explicit columns written once, in the completion
/// transaction, so a completed cycle can still say how much of its scope it
/// finished (its attached items are all done by construction) and the burndown
/// knows where to stop.
///
/// INVARIANTS THE SCHEMA LANGUAGE CANNOT EXPRESS — all in raw migration SQL and
/// proven against a real Postgres in `pm-cycles-modules.pg.test.ts`:
///
///   * At most ONE active cycle per project — a partial unique index,
///     `UNIQUE ("projectId") WHERE "status" = 'active'`
///     (`PmCycle_projectId_active_key`; Prisma cannot express a WHERE-filtered
///     unique index, mirroring `PmState_projectId_isDefault_key`). Created in
///     warp_884_885_pm_schema_hardening and re-asserted idempotently in
///     warp_3521_pm_cycles_modules. `startCycle` maps its P2002 onto
///     `cycle_already_active`.
///   * `PmCycle_dates_ordered` — CHECK: `endDate` is never before `startDate`.
///   * `pmworkitem_cycle_same_project` — trigger on PmWorkItem: an item's cycle
///     belongs to the item's project.
model PmCycle {
  id               String        @id @default(uuid())
  projectId        String
  project          PmProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  status           PmCycleStatus @default(draft)
  completedAt      DateTime?
  carriedOverCount Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  workItems        PmWorkItem[]

  @@index([projectId])
}

/// Module — a grouping/epic of work items (many work items per module, and a
/// work item may belong to several modules → join table).
enum PmModuleStatus {
  backlog
  planned
  in_progress
  paused
  completed
  cancelled
}

/// Written by `pm-modules.service.ts` (WARP-3521). `startDate` / `targetDate`
/// are calendar dates (midnight UTC), `PmModule_dates_ordered` CHECKs that the
/// target is never before the start, and `pmmoduleworkitem_same_project` (a
/// trigger on the join table) keeps a module's items inside its own project —
/// both in raw migration SQL, proven in `pm-cycles-modules.pg.test.ts`.
model PmModule {
  id          String             @id @default(uuid())
  projectId   String
  project     PmProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  leadId      String?
  status      PmModuleStatus     @default(backlog)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  workItems   PmModuleWorkItem[]

  @@index([projectId])
}

model PmModuleWorkItem {
  id         String     @id @default(uuid())
  moduleId   String
  module     PmModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  workItemId String
  workItem   PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([moduleId, workItemId])
  @@index([workItemId])
}

/// Custom field definition on a project. `options` holds the choice list for
/// select / multi_select types (array of {id,name,color}); null for scalars.
enum PmPropertyType {
  text
  number
  date
  boolean
  select
  multi_select
  member
}

model PmCustomProperty {
  id        String                    @id @default(uuid())
  projectId String
  project   PmProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      PmPropertyType
  options   Json?
  sortOrder Int                       @default(0)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @default(now()) @updatedAt
  values    PmWorkItemPropertyValue[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

/// A custom-field value on a work item. `value` is type-tagged JSON, e.g.
/// {"text":"…"} | {"number":3} | {"optionIds":[…]} | {"userIds":[…]}.
model PmWorkItemPropertyValue {
  id         String           @id @default(uuid())
  workItemId String
  workItem   PmWorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  propertyId String
  property   PmCustomProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  value      Json
  /// WARP-885: was the only PM model missing this — first-set time was lost
  /// on overwrite (only `updatedAt` existed). Backfilled from `updatedAt` at
  /// migration time since that's the best available approximation for rows
  /// that predate this column.
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  @@unique([workItemId, propertyId])
  @@index([propertyId])
}

/// File attached to a work item. Bytes live on the orchestrator-managed
/// `pm-attachments` volume keyed by the opaque `storageKey` (never a public
/// path); served only via the authenticated GET /api/pm/attachments/:id route.
model PmAttachment {
  id           String     @id @default(uuid())
  workItemId   String
  workItem     PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    BigInt
  storageKey   String     @unique
  uploadedById String?
  createdAt    DateTime   @default(now())

  @@index([workItemId])
}

/// WARP-3526 (ADR-069 WS-10) — one logged span of work on a work item.
///
/// `userId` is the person who SPENT the time (a `User.id` string, like every
/// other PM attribution column), which is not always the person who typed the
/// entry: an owner or admin may log or correct time for someone else, and the
/// `time_logged` activity row records who actually did it.
///
/// `startedAt` is when the work began. A timesheet or report attributes the
/// whole entry to the calendar day (in the reader's zone) that `startedAt` falls
/// on — an entry is never split across midnight.
///
/// INVARIANT THE SCHEMA LANGUAGE CANNOT EXPRESS, in raw migration SQL and proven
/// against a real Postgres in pm-time.pg.test.ts:
///   * `PmWorklog_minutes_range` — CHECK ("minutes" BETWEEN 1 AND 1440). One
///     entry is at least a minute and at most a day; longer work is several
///     entries. The service and the route validate the same bounds, so this is
///     the backstop for any writer that bypasses them.
///
/// Cascade, not SetNull: an entry with no work item has nothing to be reported
/// against. `deleteWorkItem` runs SERIALIZABLE and needs no extra audit here —
/// the item's own activity feed goes with it.
model PmWorklog {
  id         String     @id @default(uuid())
  workItemId String
  workItem   PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId     String
  startedAt  DateTime
  minutes    Int
  /// Empty string means "no note" — not NULL, so there is exactly one way to
  /// say it and clearing a note is an ordinary write.
  note       String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  /// The drawer's entries, newest first.
  @@index([workItemId, startedAt])
  /// A person's week.
  @@index([userId, startedAt])
  /// A report over a window, any project, any person.
  @@index([startedAt])
}

/// WARP-3526 — the one timer a person may have running.
///
/// The primary key IS the rule: `userId` is the whole key, so a second row for
/// the same person is a unique violation no matter which writer attempts it.
/// "Starting a second timer stops the first" is the service's job
/// (pm-time.service.ts `startTimer`, serialised per person by an advisory lock);
/// this table is what makes "one running timer per user" true even if it did
/// not run. State is the presence of the row — there is no `status` to drift
/// out of step with it. Stopping a timer deletes the row and writes a
/// `PmWorklog` in the same transaction.
///
/// Cascade: a timer on a deleted work item (or on any item of a deleted
/// project) disappears with it instead of pointing at nothing.
model PmTimer {
  userId     String     @id
  workItemId String
  workItem   PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  startedAt  DateTime   @default(now())

  /// WARP-845 — the ON DELETE CASCADE scan index.
  @@index([workItemId])
}

enum PmActivityVerb {
  created
  updated
  state_changed
  commented
  assigned
  unassigned
  priority_changed
  due_date_changed
  title_changed
  description_changed
  label_added
  label_removed
  archived
  restored
  cycle_added
  cycle_removed
  /// WARP-885: emitted on the orphaned child when a deleted work item takes
  /// its sub-issues' parentId to null (the app-level companion to the DB's
  /// `parentId ON DELETE SET NULL`) — see deleteWorkItem.
  parent_removed
  /// WARP-885: forward-declared for the PmModuleWorkItem write path (not yet
  /// shipped — same precedent as the unused cycle_added/cycle_removed above)
  /// so module assignments are audited from day one once that path lands.
  module_added
  module_removed
  /// WARP-2586: emitted on BOTH ends when a PmWorkItemRelation is created or
  /// removed — each item's own timeline has to explain what happened to it,
  /// and for a symmetric relation there is only ONE row, so a single activity
  /// entry would leave the other end's history silent. Also emitted on the
  /// SURVIVING end by deleteWorkItem before the DB cascade takes the edge,
  /// mirroring what parent_removed does for orphaned sub-issues.
  relation_added
  relation_removed
  /// WARP-3526 (ADR-069 WS-10): a worklog was written — by hand, or by stopping
  /// a timer. `newValue` is the minutes. A timer START writes no row: a running
  /// timer is one person's transient state, not a change to the item.
  ///
  /// The three time verbs share one `field` encoding: `worklog` when a person
  /// acts on their own entry, `worklog:<userId>` when an owner or admin acts on
  /// SOMEBODY ELSE'S (the entry's owner after the colon; `actorId` stays who did
  /// it). That is what tells "Sam removed 90m" from "Sam removed Mia's 90m".
  time_logged
  /// WARP-3526: a worklog's minutes, start or note changed. `oldValue` /
  /// `newValue` are the minutes before and after.
  time_log_updated
  /// WARP-3526: a worklog was deleted. `oldValue` is the minutes it held.
  time_log_removed
}

/// WARP-2587 (ADR-045 slice I) — the notification claim on an activity row.
///
/// An EXPLICIT enum, not a nullable `notifiedAt` claimed on IS NULL. A
/// two-state timestamp cannot express "considered and correctly declined", so
/// every row the sweep legitimately passes over — an `updated` verb, a CRM
/// NOTE, an assignment whose only recipient is the person who made it — would
/// sit at NULL forever and be rescanned every 60s for the life of the row.
/// `not_needed` makes "skipped" a decision somebody wrote down. Copies
/// TeamChatMeetingReminderStatus, which solved the same problem for the
/// meeting sweep.
enum NotifyStatus {
  pending
  sent
  not_needed
}

/// Append-only activity/history feed for a work item. `actorId` null = system /
/// LLM. `verb` is a machine token; for field updates `field`/`oldValue`/
/// `newValue` capture the diff.
///
/// WARP-2587: this table is ALSO the notification queue. There is no separate
/// event table because there does not need to be one — these rows are already
/// written inside the same transaction as the mutation they describe, and
/// already carry the actor and the diff. `notifyStatus` is the claim;
/// `notifiedAt` is an audit timestamp pinned to it by
/// `PmActivity_notifiedAt_matches_status`, a CHECK in the migration (Prisma
/// cannot express it — the CrmActivity_subject_exactly_one precedent).
model PmActivity {
  id           String         @id @default(uuid())
  workItemId   String
  workItem     PmWorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId      String?
  verb         PmActivityVerb
  field        String?
  oldValue     String?
  newValue     String?
  notifyStatus NotifyStatus   @default(pending)
  notifiedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([workItemId, createdAt])
  @@index([notifyStatus, createdAt])
  /// WARP-3532 (ADR-069 §7) — the outbox cursor's read: "rows after
  /// (createdAt, id), oldest first, LIMIT n". Without it every consumer sweep
  /// is a sequential scan plus a sort of the whole feed, several times a
  /// minute, for the life of the box. The pair matches the ORDER BY exactly, so
  /// the planner walks the index and stops at the limit.
  @@index([createdAt, id])
}

// ── WARP-3532 (ADR-069 §9): work webhooks and chat-app notifications ─────────
//
// Work events leave the box through one gate: the owner's `work_integrations`
// off-LAN switch (a destination on the box's own LAN needs no switch but always
// passes the SSRF guard). The PmActivity outbox (ADR-069 §7) feeds the fan-out;
// `PmWebhookDelivery` IS the queue — there is no job table beside it.

/// What a `PmWebhook` sends. `JSON` is the documented v1 payload
/// (docs/work-webhooks.md); the others are the same event rendered as the
/// incoming-webhook body that chat app expects.
enum PmWebhookFormat {
  JSON
  SLACK
  TEAMS
  DISCORD
  GOOGLE_CHAT
}

/// Why a webhook is or is not delivering. Paired with `PmWebhook.enabled` by
/// the `PmWebhook_enabled_matches_status` CHECK, so the boolean a query can
/// index on and the reason a person reads can never disagree:
/// `enabled` ⇔ `status = ACTIVE`.
///   ACTIVE           delivering.
///   PAUSED           an owner or admin turned it off.
///   DISABLED_FAILING the box turned it off after 20 consecutive failed
///                    attempts, and told the owners and admins.
enum PmWebhookStatus {
  ACTIVE
  PAUSED
  DISABLED_FAILING
}

/// One delivery's place in the retry ladder. Explicit, never inferred from
/// `attempts` or `deliveredAt` (CLAUDE.md "no guessing").
///   PENDING    never attempted — or held back because the destination is off
///              the LAN and the `work_integrations` switch is off.
///   FAILED     attempted at least once and failed; `nextAttemptAt` is the retry.
///   DELIVERED  a 2xx. `deliveredAt` is set exactly when this is.
///   GIVEN_UP   out of retries, expired, or its webhook was turned off.
enum PmWebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  GIVEN_UP
}

/// A destination for work events. `urlEnc` is bearer-like for chat apps (a
/// Slack incoming-webhook URL IS the credential), so the full URL is sealed at
/// rest and never returned, logged, audited or sent in a notification. `urlEnc`
/// and `secretEnc` use separate AAD labels under the SaaS credential key, so
/// neither blob can be opened as the other. The URL's host is shown; its path
/// remains write-only. The HMAC signing secret is shown once on create/rotate.
model PmWebhook {
  id                  String          @id @default(uuid())
  workspaceId         String
  workspace           PmWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Null = every project in the workspace. Cascade, not SetNull: a
  /// project-scoped hook that survived its project as a workspace-wide one
  /// would widen what it sends.
  projectId           String?
  project             PmProject?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  urlEnc              String
  format              PmWebhookFormat @default(JSON)
  secretEnc           String
  /// Event names from `WORK_EVENT_NAMES` (services/pm/webhook-events.ts) — a
  /// text array, not a Postgres enum, because the vocabulary grows with the
  /// slices (`ticket.*` joins with the service desk) and a value must never
  /// need a migration to be subscribable. Validated on write; never empty.
  events              String[]
  enabled             Boolean         @default(true)
  status              PmWebhookStatus @default(ACTIVE)
  /// Consecutive failed ATTEMPTS (not events); any success resets it. At 20 the
  /// box disables the webhook.
  consecutiveFailures Int             @default(0)
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt

  deliveries PmWebhookDelivery[]

  /// The fan-out's lookup: "enabled webhooks for this workspace".
  @@index([workspaceId, enabled])
  /// WARP-845: an unindexed ON DELETE CASCADE FK makes the parent delete a
  /// sequential scan of this table.
  @@index([projectId])
}

/// One event, for one webhook — and the queue the delivery worker drains. The
/// worker's claim is `FOR UPDATE SKIP LOCKED` over the partial index
/// `PmWebhookDelivery_due_idx` (raw migration SQL — Prisma cannot express a
/// WHERE-filtered index), which moves `nextAttemptAt` forward as a lease, so a
/// worker that dies mid-send is retried rather than stuck.
model PmWebhookDelivery {
  id             String                  @id @default(uuid())
  webhookId      String
  webhook        PmWebhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  /// What this delivery came from, for idempotence: `activity:<PmActivity.id>`
  /// for the outbox fan-out, a caller-chosen key for a direct enqueue (the SLA
  /// events WS-14 emits); null for a test ping and a re-delivery. NOT a foreign
  /// key: the delivery log outlives the activity (deleting a work item cascades
  /// its activity away). `(webhookId, sourceKey)` is unique, which is what makes
  /// the fan-out idempotent — a replayed outbox row creates nothing the second
  /// time. NULLs are distinct in a unique index, which is exactly what a ping
  /// and a re-delivery need.
  sourceKey      String?
  /// The v1 event payload, as built at fan-out — the body is rendered from it
  /// at send time.
  payload        Json
  status         PmWebhookDeliveryStatus @default(PENDING)
  attempts       Int                     @default(0)
  nextAttemptAt  DateTime                @default(now())
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime                @default(now())
  deliveredAt    DateTime?

  @@unique([webhookId, sourceKey])
  /// The delivery log: newest first, per webhook.
  @@index([webhookId, createdAt(sort: Desc)])
}

/// WARP-3522 — who may see a saved view. PERSONAL is the owner's alone — no role,
/// not even owner/admin, lists another person's. SHARED is every Projects reader's,
/// and writable by owner/admin (and the project lead for a project view).
enum PmViewScope {
  PERSONAL
  SHARED
}

/// WARP-3522 — the layout a saved view opens in. BOARD and LIST exist today;
/// TABLE (WS-6b), CALENDAR and TIMELINE (WS-7) are accepted now so a view saved
/// by the API or the assistant does not need a migration when they land, and a
/// layout the dashboard cannot draw yet opens as the list.
enum PmViewLayout {
  BOARD
  LIST
  TABLE
  CALENDAR
  TIMELINE
}

/// WARP-3522 — a named, persisted answer to "which work items?" (ADR-069 s8).
/// `filter` is the filter DSL (packages/shared-types/src/pm-filter.ts),
/// validated on every write and re-validated on every read — it is data a person
/// or the assistant typed, never trusted because it came from our own column.
///
/// `projectId` null = a cross-project view (the whole workspace, minus archived
/// projects). `ownerId` is a User.id string, not an FK, like every PM
/// attribution column: deleting a user must not be able to cascade away a SHARED
/// view the whole team uses.
///
/// `groupBy` / `sortBy` / `columns` are carried now and drawn by WS-6b's table
/// layout; `columns` is an ordered list of column ids whose vocabulary that
/// slice owns.
///
/// INVARIANTS THE SCHEMA LANGUAGE CANNOT EXPRESS — all in raw migration SQL
/// (20261004060000_warp_3522_pm_saved_views) and proven against a real Postgres
/// in `pm-saved-view.pg.test.ts`:
///   * `PmSavedView_name_length`   — CHECK the trimmed name is 1..60 characters.
///   * `PmSavedView_filter_is_object` — CHECK `filter` is a JSON object.
///   * `PmSavedView_name_scope_key` — UNIQUE per (workspace, project-or-none,
///     scope, owner-if-personal, lower(name)): two shared views cannot both be
///     called "Overdue", two of one person's personal views cannot, and two
///     people's personal views can.
model PmSavedView {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   PmWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     PmProject?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String
  scope       PmViewScope  @default(PERSONAL)
  name        String
  layout      PmViewLayout @default(BOARD)
  filter      Json
  groupBy     String?
  sortBy      Json?
  columns     Json?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  /// The list endpoint's shape: one workspace, optionally one project, both scopes.
  @@index([workspaceId, projectId, scope])
  /// WARP-845 — the ON DELETE CASCADE scan when a project is deleted.
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service desk (ADR-069, WARP-3528)
//
// A ticket is a `PmWorkItem` in a project whose `kind` is SERVICE_DESK, plus one
// `PmTicket` row for the columns only a desk needs. Everything a work item
// already has — state, priority, assignees, labels, department, relations,
// activity, comments — a ticket has for free, and escalating one to engineering
// is an ordinary `PmWorkItemRelation` across projects. Every enum below is
// UPPERCASE, like `PmRelationKind` and the CRM enums: they are wire values the
// service and a CHECK constraint quote verbatim.
// ─────────────────────────────────────────────────────────────────────────────

/// Which surface owns a `PmProject`. See `PmProject.kind`.
enum PmProjectKind {
  PROJECT
  SERVICE_DESK
}

/// What a state does to a ticket's SLA time. See `PmState.slaClock`. RUNNING
/// counts business time, PAUSED holds it (waiting on the customer or a third
/// party), STOPPED ends it (solved or closed).
enum PmSlaClock {
  RUNNING
  PAUSED
  STOPPED
}

/// Who may see a comment. See `PmComment.visibility`.
enum PmCommentVisibility {
  INTERNAL
  PUBLIC
}

/// What kind of party wrote a comment. See `PmComment.authorKind`.
enum PmAuthorKind {
  USER
  CONTACT
  SYSTEM
  AUTOMATION
}

/// Whether a ticket's requester is an external person or a member of staff.
/// See `PmTicket.requesterKind`.
enum PmRequesterKind {
  CONTACT
  USER
}

/// Where a ticket came from. `INTERNAL` is a member of staff filing from the
/// dashboard; `PHONE` is the same person logging a call; the rest are reserved
/// for the paths that produce them (email intake, the assistant, an API token).
enum PmTicketChannel {
  EMAIL
  INTERNAL
  WEB_FORM
  CHAT
  API
  PHONE
}

/// Where a ticket stands against its SLA. `NONE` until a policy applies.
enum PmSlaStatus {
  NONE
  ON_TRACK
  AT_RISK
  BREACHED
  MET
  PAUSED
}

/// The requester's own verdict on a solved ticket. Three levels because that
/// is what a reply of "good", "bad" or a 1-5 number reduces to without losing
/// the middle; written by the CSAT slice, read by the support insights.
enum PmSatisfaction {
  GOOD
  NEUTRAL
  BAD
}

/// The desk-only half of a ticket: who asked, where it came from, and the
/// clocks. One row per ticket work item, keyed by it.
///
/// 🔴 INVARIANTS THE SCHEMA LANGUAGE CANNOT EXPRESS, all in raw migration SQL
/// (20261004120000_warp_3528_service_desk_core) and proven against a real
/// Postgres in `pm-ticket.pg.test.ts`:
///
///   * `PmTicket_requester_matches_kind` — CHECK: exactly the requester id that
///     matches `requesterKind` is set (CONTACT → `requesterContactId`, USER →
///     `requesterUserId`), and never both, never neither.
///   * `pmticket_item_in_service_desk` — trigger: a ticket row may only hang off
///     a work item whose project is SERVICE_DESK.
///
/// 🔴 NEITHER REQUESTER COLUMN IS A FOREIGN KEY, deliberately. `requesterUserId`
/// is a plain `User.id` like every PM reference to a person. `requesterContactId`
/// would be the one FK from PM to the address book, and a `Contact` is
/// owner-scoped and deleted by paths that must not be blocked by a customer's
/// ticket — an address-book source's cascade, the connector purge walker, the
/// filing undo. A Restrict FK would turn each of those into a raw 500; a SetNull
/// one cannot sit inside the CHECK above (the trap `CrmCompany.proposalId`
/// documents). So the ticket carries `requesterName` / `requesterEmail`: who
/// asked, as of intake. The live Contact or User is preferred for display while
/// it exists; once it is gone the snapshot is still the answer, and the reader
/// says so rather than inventing a person.
model PmTicket {
  workItemId String     @id
  workItem   PmWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  /// Explicit, never inferred from which id happens to be non-null.
  requesterKind      PmRequesterKind
  requesterContactId String?
  requesterUserId    String?
  /// Snapshot of who asked, as of intake — see the model comment.
  requesterName      String
  requesterEmail     String?

  /// The customer the requester belongs to. Set at intake only when the contact
  /// has exactly one company, and otherwise left for a human — never guessed.
  /// SetNull: deleting a customer must not delete the conversations with them.
  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  channel PmTicketChannel

  /// The first PUBLIC comment from a staff member. Stamped by a compare-and-set
  /// (`WHERE "firstRespondedAt" IS NULL`), so two simultaneous first replies
  /// leave one timestamp, not the later of two.
  firstRespondedAt     DateTime?
  /// When the ticket last entered a completed state. Cleared on reopen.
  solvedAt             DateTime?
  reopenCount          Int         @default(0)
  lastPublicActivityAt DateTime?

  slaStatus    PmSlaStatus     @default(NONE)
  satisfaction PmSatisfaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// WARP-3529 — the emails this ticket is made of.
  emailLinks PmTicketEmailLink[]

  /// "Other tickets from this requester".
  @@index([requesterContactId])
  @@index([requesterUserId])
  /// WARP-845 — the ON DELETE SET NULL scan index.
  @@index([companyId])
  /// The "solved recently" queue.
  @@index([solvedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service desk email channel (ADR-069 §4, WARP-3529)
//
// A desk binds one existing `EmailAccount`; the sync the box already runs is the
// intake and the account's own send path is the delivery. Every enum below is
// UPPERCASE like the rest of the desk's, and every state is a column a service
// writes on purpose — nothing is derived from a NULL.
// ─────────────────────────────────────────────────────────────────────────────

/// What a channel is. One value today; the column is the seam for the channels
/// ADR-069 §4 reserves (it ships no public web form).
enum PmSupportChannelKind {
  EMAIL
}

/// Whether a message of a ticket's email conversation came in or went out.
enum PmEmailDirection {
  INBOUND
  OUTBOUND
}

/// See `PmComment.deliveryStatus`.
enum PmDeliveryStatus {
  NONE
  PENDING
  SENT
  FAILED
}

/// Why a reply was not delivered. A closed list, never the mail server's own
/// words (which can name hosts and addresses): the detail stays on the
/// `EmailDraft` row for an administrator.
enum PmDeliveryFailure {
  /// The `outbound_email` off-LAN channel is off (ADR-012).
  OUTBOUND_BLOCKED
  /// The Email module is off, or not set up on this box, so nothing would send it.
  EMAIL_UNAVAILABLE
  /// The customer has no email address on record.
  NO_RECIPIENT
  /// The mail service tried to send it and failed.
  SEND_FAILED
}

/// See `PmState.onCustomerReply`.
enum PmCustomerReplyEffect {
  /// The message is added and the status stays.
  NONE
  /// The ticket returns to the desk's working status. From a completed status
  /// that is a reopen, allowed for `PmSupportChannel.reopenWindowDays` after it
  /// was solved; after that the message opens a follow-up instead.
  REOPEN
  /// The ticket is final: the message opens a new ticket linked to it.
  FOLLOW_UP
}

/// See `EmailMessage.deskIntakeStatus`.
enum PmEmailIntakeStatus {
  PENDING
  DONE
  IGNORED
  FAILED
}

/// Why the desk did not turn a message into (part of) a ticket. The first eight
/// are IGNORED — the loop-protection rules and two of their kin — and the last
/// two are FAILED. A CHECK keeps each status to its own reasons.
enum PmEmailIntakeReason {
  /// `Auto-Submitted` was anything but `no` (RFC 3834).
  AUTO_SUBMITTED
  /// `Precedence: bulk | junk | list | auto_reply`.
  PRECEDENCE_BULK
  /// `X-Autoreply` or `X-Autorespond` was present.
  AUTO_REPLY_HEADER
  /// A delivery-status report, a null `Return-Path`, or a mailer-daemon sender.
  BOUNCE
  /// Sent from the address of a mailbox this box operates — its own outbound.
  OWN_ADDRESS
  /// The message is one this desk sent (its Message-ID is a stored outbound one).
  OWN_MESSAGE
  /// More than 20 messages in an hour from one sender.
  RATE_LIMITED
  /// The desk was archived when the message reached the front of the queue.
  DESK_ARCHIVED
  /// The desk raised an error on every attempt (see the log).
  PROCESSING_ERROR
  /// The channel's contact owner is no longer an active member, so no contact
  /// could be created for a stranger. Fixed by choosing another owner.
  CONTACT_OWNER_UNAVAILABLE
}

/// A desk's email front door: one mailbox, bound to one desk.
///
/// 🔴 `contactOwnerUserId` is explicit and NOT NULL. A `Contact` is owner-scoped
/// (`Contact.userId`), so every stranger the intake turns into a contact has to
/// be somebody's, chosen on purpose by an owner or admin when the channel is
/// bound — the desk lead by default. It is a plain `User.id` like every PM
/// reference to a person.
///
/// 🔴 `enabledAt` is the intake's floor: mail received before it is never made
/// into a ticket (connecting a mailbox imports thirty days of history, and a box
/// that answered all of it the moment somebody bound a desk would email a month
/// of strangers). The service resets it each time `enabled` goes false -> true.
///
/// INVARIANTS THE SCHEMA LANGUAGE CANNOT EXPRESS, in raw migration SQL
/// (20261004130000_warp_3529_service_desk_email) and proven in
/// `support-email.pg.test.ts`:
///   * `PmSupportChannel_reopen_window_range` — 0..365 days.
///   * `pmsupportchannel_project_is_service_desk` — trigger: a channel only ever
///     hangs off a SERVICE_DESK project.
model PmSupportChannel {
  id        String               @id @default(uuid())
  projectId String
  project   PmProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      PmSupportChannelKind @default(EMAIL)

  /// One mailbox serves one desk. Cascade: a channel is meaningless without its
  /// mailbox (disconnecting one is already a warned, cascading act).
  emailAccountId String       @unique
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())

  contactOwnerUserId String

  /// Off by default: an acknowledgement is mail to a stranger.
  autoAckEnabled  Boolean @default(false)
  /// Plain text with `{{requester.firstName}}`, `{{ticket.key}}`,
  /// `{{ticket.title}}` and `{{desk.name}}` — validated when saved (a name
  /// outside that list is refused) and escaped when rendered.
  autoAckTemplate String

  /// How long after a ticket was solved a customer's reply reopens it rather
  /// than opening a follow-up.
  reopenWindowDays Int @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// One email channel per desk: with two mailboxes there would be no rule for
  /// which one answers a ticket nobody emailed in, and a rule nobody wrote down
  /// is a guess.
  @@unique([projectId, kind])
}

/// One email of a ticket's conversation — the way a later message finds its
/// ticket, and the way the conversation finds the files an email carried.
///
/// One row per message, in either direction:
///   * INBOUND — a stored `EmailMessage` the desk took in (`emailMessageId`).
///   * OUTBOUND — an email the desk sent or tried to send (`emailDraftId`):
///     `messageIdHeader` is the id the orchestrator chose, known before it left,
///     which is what makes a reply to a conversation the desk started matchable
///     by header. A retry is a NEW row; the failed attempt's id stays findable,
///     because the failure may have been the mail service's report and not the
///     mail's.
/// `emailThreadId` is the stored thread the message belongs to, once there is
/// one (an outbound-first conversation has none until the customer answers). It
/// is not unique: a thread holds many messages, and after a follow-up it belongs
/// to the newer of two tickets.
///
/// `workItemId` references the TICKET row, not the work item: a link can only
/// exist for a ticket, which is only ever in a SERVICE_DESK project.
///
/// INVARIANT in raw migration SQL: `PmTicketEmailLink_direction_matches_ref` — an
/// inbound row never names a draft and an outbound row never names a message.
model PmTicketEmailLink {
  id         String   @id @default(uuid())
  workItemId String
  ticket     PmTicket @relation(fields: [workItemId], references: [workItemId], onDelete: Cascade)

  direction PmEmailDirection
  /// The RFC 5322 Message-ID of this email, no brackets.
  messageIdHeader String

  emailThreadId  String?
  emailThread    EmailThread?  @relation(fields: [emailThreadId], references: [id], onDelete: SetNull)
  emailMessageId String?       @unique
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  emailDraftId   String?       @unique
  emailDraft     EmailDraft?   @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)

  /// The comment this email is: a customer's reply, a staff reply, or the
  /// automatic acknowledgement. NULL for the message a ticket was opened from
  /// (its body is the ticket's description).
  commentId String?
  comment   PmComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([workItemId, messageIdHeader])
  /// Header matching: "which ticket has this Message-ID".
  @@index([messageIdHeader])
  /// "The thread's current ticket" is its newest link.
  @@index([emailThreadId, createdAt])
  @@index([workItemId, createdAt])
  @@index([commentId])
}

/// KAN-6 — internal, operator-invisible one-shot markers for data migrations
/// that can't run as pure SQL (they need runtime-resolved values like the
/// box's local IANA timezone). NOT a user-facing setting — no route reads or
/// writes it (unlike WorkspaceSetting, which the Settings surface enumerates).
/// A backfill writes its `key` once on success and short-circuits on every
/// later boot, so the conversion runs exactly once even though it lives in the
/// startup path rather than a SQL migration. State is the presence of the row
/// (an explicit marker we insert), never an IS-NULL on domain data.
model SystemFlag {
  key       String   @id
  valueJson Json     @default("{}")
  createdAt DateTime @default(now())
}

// ── WARP-537: OTA update audit table (WARP-534 epic) ──

/// Advance-only lifecycle of one discovered OTA release on this device.
/// `status` is the canonical state column (CLAUDE.md / WARP-218 pattern —
/// never derived from absent timestamps). The table is append-only
/// (WARP-541): rows advance status, they are never deleted.
///
///   pending ──► superseded                 (WARP-538: newer release found)
///   pending ──► verifying ──► applying ──► committed         (WARP-539)
///                    │             └─────► rolled_back       (WARP-539)
///                    │                          └─► failed   (rollback also
///                    │                              failed; the
///                    │                              degraded_health verdict
///                    │                              rides `failureReason`)
///                    └───► rejected        (schema downgrade & friends)
enum DeviceUpdateStatus {
  pending
  superseded
  verifying
  applying
  committed
  rolled_back
  failed
  rejected
}

/// WARP-3007 follow-up (Stefan on #2302; Romain approved 2026-09-23): what an
/// apply actually did to the box, recorded as an explicit column instead of
/// being read out of status + failureReason + logs. `status` stays the
/// advance-only lifecycle; `outcome` is the verdict an operator acts on —
/// notably a committed update whose post-commit start of a newly-enabled
/// service failed, which `status` (committed, final) cannot say.
enum DeviceUpdateOutcome {
  /// No swap outcome yet: pending, verifying, applying, rejected, superseded.
  not_applied
  /// Committed; the post-commit start of services new to this box is running.
  starting_services
  /// Committed; every service this box enables is running.
  committed
  /// Committed, but a newly-enabled service did not start or never went healthy.
  services_start_failed
  /// A health gate failed; the previous release is back and healthy.
  rolled_back
  /// The rollback's own health gate failed too (status failed, degraded_health).
  rollback_failed
}

/// WARP-3193 PERF-3 — is an apply run holding this DeviceUpdate row? Explicit,
/// never derived from `applyClaimId IS NULL` (CLAUDE.md "No guessing").
enum DeviceUpdateApplyClaim {
  unclaimed
  claimed
}

/// One row per release the update agent decided to track (signature-verified
/// at discovery time — a release that fails signature verification writes NO
/// row, only an `update.signature_failed` log event, per WARP-538).
///
/// `manifestJson` snapshots the FULL verified manifest at discovery so the
/// apply step (WARP-539) acts on exactly the bytes that were verified —
/// re-fetching at apply time would reopen the verify/use TOCTOU window.
/// `manifestSha256` is the hex digest over those bytes for the audit trail.
model DeviceUpdate {
  id             String             @id @default(cuid())
  status         DeviceUpdateStatus @default(pending)
  /// Release channel this row came from. Single `stable` channel today
  /// (WARP-534); the column keeps history honest if channels ever grow.
  channel        String             @default("stable")
  /// GitHub Release tag the manifest was downloaded from (e.g.
  /// `ota-42-gabc1234`). Nullable: unit-test/manual discoveries may not
  /// come from a tagged release.
  releaseTag     String?
  /// `release.gitSha` from the verified manifest — the commit this release
  /// was built from.
  gitSha         String
  /// `release.builtAt` from the verified manifest.
  builtAt        DateTime
  /// Hex sha256 over the verified release.json bytes.
  manifestSha256 String
  /// The full verified manifest (design schema v1).
  manifestJson   Json
  /// Canonical refusal/failure vocabulary: `UpdateFailureReason` from
  /// src/services/update-agent/manifest.ts (e.g. `schema_downgrade`), or an
  /// apply-time verdict such as `degraded_health` (WARP-539). Null while the
  /// row is healthy.
  failureReason  String?
  /// WARP-3007 — explicit apply outcome (see DeviceUpdateOutcome).
  outcome        DeviceUpdateOutcome @default(not_applied)
  /// WARP-3193 PERF-3 — whether an apply run owns this row right now. Taken
  /// by a conditional `updateMany` (`applyClaim = unclaimed`) BEFORE any side
  /// effect by every runner (POST /updates/apply-now, the cron apply window,
  /// the boot resume), so two runners can never both snapshot and stage into
  /// the same update directory. Handed back when the run ends; a claim left
  /// by a process that died is cleared by `resumeInterruptedApply` at boot.
  applyClaim     DeviceUpdateApplyClaim @default(unclaimed)
  /// The run that holds the claim; the release is conditioned on it.
  applyClaimId   String?
  /// When the claim was taken (forensics only — nothing reads it as state).
  applyClaimedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([gitSha])
}

// ── WARP-1094: ERP-connector framework (Eaglesoft direct-SQL integration) ──
//
// Droplet-side control-plane models for the first-party ERP-connector
// framework (EAGLESOFT-INTEGRATION-ARCHITECTURE-BRIEF §12). Eaglesoft is
// provider #1 behind a generic connector abstraction; the schema is
// provider-agnostic. Every lifecycle state is an EXPLICIT enum column
// (architecture-guard rule 10 / CLAUDE.md / WARP-218) — never derived from
// a NULL. Credentials NEVER live here: `secretRef` is a pointer into the
// encrypted secret store (brief §7.4). PHI in `ErpEntityCache` is encrypted
// at rest by the application layer (brief §10.2, §14).
//
// This migration is the DB-INDEPENDENT foundation only — the live-database
// read/write paths are stubbed until a copy of `PattersonPM.db` + the SAP
// SQL Anywhere client are available (Phase 0 of the phased plan, brief §17).

/// Connection status for an ERP integration. Explicit lifecycle (brief §12):
/// NOT_CONFIGURED → PROVISIONING → CONNECTED, with DEGRADED (transient sync
/// failure, §15), DRIFT_LOCKED (schema fingerprint mismatch froze writes,
/// invariant 9), NEEDS_RECONNECT (the customer's credential died and only a
/// person pasting a new one fixes it), ERROR (unrecoverable), and DISABLED
/// (operator turned it off).
///
/// NEEDS_RECONNECT is the member ADR-041 §5 names as mandatory and ADR-042 §6
/// makes load-bearing for customer-supplied credentials. It MUST stay
/// distinguishable from NOT_CONFIGURED and from DISABLED for the same reason
/// `M365ConnectionState.NEEDS_RECONNECT` must stay distinguishable from
/// DISCONNECTED: all three look identical to a "does a credential decrypt?"
/// check and mean opposite things to the person reading the dashboard.
enum IntegrationStatus {
  /// No connection has ever been configured for this provider. The default.
  NOT_CONFIGURED
  /// A credential is present and the connection is being established. A row
  /// may NOT rest here after a completed probe — see `connect()`.
  PROVISIONING
  /// Usable. The last probe against the vendor succeeded.
  CONNECTED
  /// Usable, and ONE dataset is refused. The credential is valid, the
  /// handshake succeeded, and everything else reads — the vendor withholds a
  /// single resource because of the account's PLAN or the app's granted
  /// SCOPES. A Basic-plan Shopify store reads orders, products and inventory
  /// and withholds only customer identities; a Mailchimp account on a plan
  /// without a resource is otherwise entirely healthy.
  ///
  /// It is NOT ERROR, and that is the whole reason it exists: ERROR renders as
  /// "Can't connect" and sends the owner to repair a connection with nothing
  /// wrong with it, while hiding the one thing they CAN act on — the plan or
  /// the scope grant, both of which live in the vendor's console. It is not
  /// NEEDS_RECONNECT either: a new key changes nothing.
  ///
  /// Sync keeps running (`POLLABLE_CONNECTION_STATUSES`) — withholding one
  /// dataset is not a reason to stop reading the others.
  CAPABILITY_LIMITED
  /// Transient sync failure (brief §15). A health signal, not a request for
  /// human action — nobody needs to go and paste anything.
  DEGRADED
  /// The schema fingerprint changed and writes are frozen (invariant 9).
  DRIFT_LOCKED
  /// The stored credential no longer works: the customer revoked it in their
  /// own vendor console, rotated it, or removed the admin who created it.
  /// This is NOT an error — ADR-041 calls it routine — and reconnecting DOES
  /// fix it, which is exactly what separates it from ERROR. Sync pauses;
  /// already-synced data is untouched. The owner is asked to paste a new key.
  NEEDS_RECONNECT
  /// Something reconnecting will not fix — the configuration is wrong, the
  /// vendor rejects the integration itself, the track is unbuildable.
  ERROR
  /// The operator turned this connection off deliberately.
  DISABLED
}

/// One configured ERP connection. `provider` keys the connector framework
/// ("eaglesoft" today, many later). `secretRef` is a pointer into Droplet's
/// encrypted secret store — the `droplet_ro`/`droplet_rw` passwords are NEVER
/// persisted in a row, an export, or a log (brief §7.4, invariant 10).
/// `schemaHash` is the drift-guard fingerprint (brief §9.2, invariant 9);
/// `writeEnabled` is the per-practice write opt-in and defaults OFF
/// (invariant 1, §11.5).
model IntegrationConnection {
  id            String            @id @default(cuid())
  provider      String
  status        IntegrationStatus @default(NOT_CONFIGURED)
  host          String
  /// TCP port of the practice's box. NULL = the track's default (2638 direct
  /// SQL, 9888 REST). Persisted because `connect()` has always ACCEPTED a port
  /// and, before this column, silently dropped it — so a site on a non-default
  /// port could not be configured at all.
  port          Int?
  databaseName  String
  secretRef     String
  schemaVersion String?
  schemaHash    String?
  writeEnabled  Boolean           @default(false)
  lastHealthyAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // --- REST-track ("eaglesoft-api") connection material ---------------------
  // All three are nullable and unused by the direct-SQL provider, which keeps
  // its credentials behind `secretRef` and needs no route contract.

  /// aes-256-gcm blob (encryption.service) of {integrationKey,userId,password}.
  /// `secretRef` stays the human-facing POINTER/label; this is the ciphertext
  /// it points at. Cleartext is never stored, logged, or returned by the API.
  apiCredentialsEnc String?

  /// The DISCOVERED route contract (verbs/templates/field maps) for this box,
  /// shaped as `EaglesoftApiRouteMap`. Supplied by the operator from the box's
  /// own /help page — never guessed, and never auto-parsed from a format we
  /// have not seen (see erp-connector/src/api-route-map.ts).
  apiRouteMap Json?

  /// PEM of the CA to trust for this box's certificate (Patterson's private
  /// PdcoTechCA in production; the harness's own CA in a rehearsal). Absent =
  /// use the system trust store. Certificate verification is never disabled.
  apiCaCert String?

  // --- Cloud-track (ADR-041) connection material ---------------------------
  // WARP-2137. The columns above describe a box on the practice LAN; a cloud
  // track has no host to reach and instead needs the vendor's own identifiers.
  // Both are nullable and ignored by every LAN track.

  /// Provider-specific connection facts the Eaglesoft-shaped columns cannot
  /// express: `quickbooks-online` needs `{ realmId }` (Intuit's company id) and
  /// `dentrix-ascend` needs `{ organizationId, locationId? }`; both accept an
  /// optional `baseUrl` so a sandbox company can be pointed at the sandbox host
  /// without a release. Deliberately NOT reusing `databaseName` or `host` for
  /// these — borrowing a LAN column would collide with its own default and make
  /// a misconfigured row indistinguishable from a mistyped one.
  ///
  /// Structurally validated per provider on read (`parseProviderConfig`), never
  /// cast: a row written by an older build must degrade to "not configured",
  /// which blocks the connector honestly, rather than reaching the vendor with
  /// a missing identifier and collecting an opaque 4xx.
  providerConfig Json?

  /// The cloud track's OAuth tokens, encrypted with `column-crypto`'s
  /// `deriveErpCloudTokenKey()` and AAD-bound to this row's `id`, so a blob
  /// moved to another connection fails closed instead of authenticating as the
  /// wrong company.
  ///
  /// Distinct from `apiCredentialsEnc`, which holds Eaglesoft's static
  /// {integrationKey,userId,password} triple under the older `encryptSecret`:
  /// these are ROTATING bearer/refresh tokens with a different lifecycle, and
  /// Intuit rotates the refresh token on every use — the connector's
  /// `persistTokens` writes the new one back here, and failing to do so strands
  /// the connection at the next refresh.
  providerTokensEnc String?

  /// WARP-2549 — what this connection landed. RESTRICT on the far side, so a
  /// delete here fails loudly rather than taking a customer's records with it.
  landedContacts  Contact[]
  landedCompanies CrmCompany[]
  landedDeals     CrmDeal[]
  landedPipeline  CrmPipeline?

  /// WARP-2581 — the invoices and bills this connection landed.
  documents ErpDocument[]

  /// WARP-2562 — the parties linked to records in THIS connection's upstream.
  /// Required for the WARP-2461 purge walker to answer "what did this
  /// connection land", which it cannot do from the provider name alone when
  /// two connections share one.
  partyLinks PartyLink[]

  @@index([provider, status])
}

/// Sync state for one ERP / cloud-connector cursor (WARP-2218), modelled
/// member-for-member on `M365SyncState` because the poller shape is the same:
/// claim a due cursor, run one read, release it into an explicit outcome.
///
/// Explicit column, never inferred from whether `watermark` happens to be
/// null — IDLE-with-no-watermark (never synced) and RESYNC_REQUIRED (the
/// vendor rejected the position we held, re-enumerate) both have a null
/// watermark and mean opposite things to whoever is reading the dashboard.
enum ErpSyncState {
  /// Never run, or finished cleanly and waiting for its next tick.
  IDLE
  /// A run is in progress. Guards against two ticks overlapping on one cursor
  /// — the claim flips IDLE/BACKOFF/RESYNC_REQUIRED to this conditionally, so
  /// a second tick's conditional update matches zero rows and skips.
  SYNCING
  /// Throttled or wobbling. `nextAttemptAt` says when to try again, and is set
  /// from `sync-policy.ts` `computeBackoffMs` — which obeys `Retry-After`
  /// exactly when the vendor sends one.
  BACKOFF
  /// The vendor will not honour the position we held (a dead page token, a
  /// cursor aged out, a 410). The next run re-enumerates from scratch.
  /// A normal transition, not a failure: it does not count toward the failure
  /// streak and is not delayed by backoff, because delaying it only leaves
  /// the owner's data stale for longer.
  RESYNC_REQUIRED
  /// Broken in a way retrying will not fix. Needs a person to look.
  FAILED
}

/// Incremental-sync watermark per (connection, entity). `watermark` is an
/// EXPLICIT string column (a discovered timestamp / rowversion, brief §10.2)
/// — the cursor position is never inferred from the absence of a row.
///
/// WARP-2218 gave this model its first writers. `state` is the explicit
/// lifecycle column; the poller reads it, never a null check.
model ErpSyncCursor {
  id           String @id @default(cuid())
  connectionId String
  entity       String

  /// The vendor-side position the next incremental read resumes from.
  ///
  /// NULL means **never synced** — nothing has been read for this
  /// (connection, entity) yet, so the next run enumerates from the beginning.
  /// That is NOT the same thing as `state = RESYNC_REQUIRED`, which means a
  /// position existed and the vendor stopped honouring it. Both show a null
  /// watermark; only `state` distinguishes them, which is exactly why `state`
  /// is a column and not a derivation.
  watermark String?

  /// Explicit lifecycle. Never derived from `watermark IS NULL`.
  state ErpSyncState @default(IDLE)

  /// Consecutive failed runs, feeding `computeBackoffMs`'s exponent. Reset to
  /// 0 by a success and by a RESYNC_REQUIRED, which is not a failure.
  consecutiveFailures Int @default(0)

  /// When this cursor may next be claimed. NULL = claimable now.
  nextAttemptAt DateTime?

  /// Last successful incremental run. Distinct from `lastSweepAt`.
  lastSyncedAt DateTime?

  /// Last completed full reconciliation sweep. Persisted so a restart does not
  /// re-trigger the expensive re-enumeration immediately — the sweep is the
  /// half that can trip a vendor rate limit.
  lastSweepAt DateTime?

  /// The vendor's grant is dead (revoked in their console, credential
  /// rotated, consent withdrawn) and only a person pasting a new credential
  /// fixes it. ADR-041 treats this as ROUTINE, so it is its own explicit
  /// column rather than an ERROR status: a reconnect-needed connection must
  /// stay distinguishable from both "never configured" and "broken", exactly
  /// as `M365ConnectionState.NEEDS_RECONNECT` is at :4990-5012.
  needsReconnect Boolean @default(false)

  /// Operator-facing reason for BACKOFF / FAILED. Must never carry a token,
  /// an API key, a page cursor or raw bearer material — same prohibition
  /// `M365ConnectionState.lastError` carries. Redacted on the way in.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, entity])
  /// The scheduler's "what is due now" query.
  @@index([state, nextAttemptAt])
  @@index([connectionId])
}

/// What one reconciliation sweep found for one (connection, entity)
/// (WARP-2463). An EXPLICIT enum, and the row is written on EVERY sweep —
/// including a clean one — so "no drift" is a stored fact rather than the
/// absence of a row. Absence must never be the signal: a sweep that never
/// ran and a sweep that found nothing are opposite answers to "is the
/// incremental path trustworthy for this vendor", and only a row can tell
/// them apart.
///
/// `reconcile.ts` emits TWO independent drift classes and both can fire on
/// the same pass, so the co-occurrence is enumerated as its own member
/// rather than left to a nullable second column. One column fully determines
/// what the sweep found; there is no pair of fields a reader has to combine
/// (and no combination a reader can get wrong).
enum ErpDriftClassification {
  /// The full re-enumeration found nothing the incremental read had missed,
  /// and its high-water mark was not ahead. The incremental path was
  /// trustworthy for this entity on this pass — the signal that justifies
  /// lengthening the sweep cadence, and the reason a zero-drift sweep still
  /// writes a row.
  NONE
  /// Records the full read returned that the incremental read did not, with
  /// a marker STRICTLY AFTER the watermark. The vendor's own filter said
  /// nothing had changed and a full read disagreed — the HubSpot (eventually
  /// consistent Search) and Stripe (no guaranteed event ordering) class.
  MISSED_NEWER
  /// The full read's high-water mark is ahead of the incremental read's: the
  /// incremental path is running behind the account and every subsequent tick
  /// inherits the gap. The Xero class, where `UpdatedDateUTC` does not move on
  /// a DueDate / SentToContact / contact-balance change.
  WATERMARK_BEHIND
  /// Both of the above on the same pass. Enumerated explicitly because the
  /// model stores ONE row per (connection, entity) per sweep, so a single
  /// column has to be able to say "both" — and because dropping either half
  /// would misreport the diagnosis, which is the whole product of this table.
  MISSED_NEWER_AND_WATERMARK_BEHIND
}

/// One reconciliation sweep's finding for one (connection, entity)
/// (WARP-2463).
///
/// WARP-2218 built the sweep and the drift report it emits, but the report
/// reached only a log line and an ActivityRow scope. Log retention on the box
/// is not designed as a data store, so the one question the sweep exists to
/// answer — *has the incremental path been trustworthy for this vendor, and
/// is it getting better or worse* — had no queryable answer. This model is
/// that answer.
///
/// ## Counts and timestamps ONLY
///
/// The same PHI-free rule the audit scope obeys, and here it is structural
/// rather than a convention: there is no column a record identifier, a
/// customer name, an amount or an email could land in. `watermarkAt` and
/// `earliestMissedAt` are `DateTime`, NOT the vendor's raw marker string —
/// a vendor whose ordering key is the record id (Stripe cursors are object
/// ids) would otherwise put an invoice number in this table through a column
/// that looks like a timestamp. A marker that is not a real timestamp is
/// stored as NULL, which loses nothing an operator was going to read anyway.
///
/// This table is a diagnostics artefact. A diagnostics artefact full of
/// invoice numbers is a customer-content export wearing a different label.
model ErpDriftRecord {
  id String @id @default(cuid())

  /// The `IntegrationConnection` this sweep covered. A plain column, matching
  /// `ErpSyncCursor.connectionId` — no Prisma relation, so no foreign key and
  /// no back-relation churn on `IntegrationConnection`.
  connectionId String

  /// Vendor key (`xero`, `stripe`, ...). Denormalised deliberately: the
  /// question this table exists to answer is asked PER VENDOR ("has the
  /// incremental path been trustworthy for Xero this month"), and a vendor key
  /// is a product identifier, not customer content.
  provider String

  /// Canonical dataset name (`invoice`, `bill`) — never a record id.
  entity String

  /// When the sweep ran. Every row one sweep writes shares this instant, which
  /// is what makes "was that whole sweep clean" a groupable question.
  sweepAt DateTime

  /// Explicit outcome. No default: every writer states what it found, so a row
  /// can never mean "nobody set this".
  classification ErpDriftClassification

  /// Records the full read returned that the incremental read did not, with a
  /// marker after the watermark. 0 on a clean sweep, and that 0 is the point.
  missedCount Int @default(0)

  /// Rows the full re-enumeration returned. The DENOMINATOR: 3 missed out of
  /// 4 and 3 missed out of 40,000 are not the same health signal, and
  /// `missedCount` alone cannot tell them apart.
  fullCount Int @default(0)

  /// Rows the incremental read returned in the same pass.
  incrementalCount Int @default(0)

  /// The position the incremental read was issued FROM, as a timestamp.
  /// NULL when the cursor had never synced, or when the vendor's marker is not
  /// a timestamp at all — see the PHI note above.
  watermarkAt DateTime?

  /// Oldest marker among the missed records. Answers "how far back did the gap
  /// start", which is the forensic question when an owner reports the
  /// assistant did not know about something. NULL when nothing was missed.
  earliestMissedAt DateTime?

  createdAt DateTime @default(now())

  /// The endpoint's query: one connection, most recent first, over a window.
  @@index([connectionId, sweepAt])
  /// The retention trim's query, and the only one that scans across
  /// connections.
  @@index([sweepAt])
}

/// Read-model cache row (brief §10.2). A convenience/uptime layer, NEVER the
/// system of record — every cached view is timestamped in the UI ("as of N
/// min ago"). `payload` PHI is encrypted at rest by the application layer.
model ErpEntityCache {
  id           String   @id @default(cuid())
  connectionId String
  entity       String
  sourceKey    String
  payload      Json
  syncedAt     DateTime @default(now())

  @@unique([connectionId, entity, sourceKey])
  @@index([connectionId, entity])
}

/// What a document is: money owed TO the business, or money owed BY it.
///
/// Two kinds rather than two tables, because every column below is the same on
/// both sides and only the counterparty's role differs — and because the
/// question the owner asks ("what is overdue") crosses both.
/// WARP-2739 (ADR-049 §4.1) — who wrote this document.
///
/// Mirrors `CrmRecordOrigin`, the pattern the CRM already proved, with one
/// deliberate difference in vocabulary: the CRM's non-local value is `EXTERNAL`
/// and carries "uneditable, archive-only, overwritten by the next landing
/// tick". Here the value is `LANDED` and means exactly the same thing — the
/// vendor owns the row — but the CRM's enum is not reused, because a shared
/// enum across two tables with different lifecycles is how one table's widening
/// becomes the other's migration.
enum ErpDocumentOrigin {
  /// A copy of what a vendor's server decided. `land-money.ts` owns it, the
  /// vendor is the system of record, and the box may never edit it.
  LANDED
  /// The box's own document. Nothing outside this appliance has ever seen it,
  /// and a person can correct it.
  LOCAL
}

/// WARP-2739 (ADR-049 §4.1) — WHAT the document is.
///
/// 🔴 This enum used to be `RECEIVABLE | PAYABLE`, WHICH IS A DIRECTION, NOT A
/// KIND. A quote and an invoice are both receivable; a credit note is
/// receivable and negative; a receipt is receivable and already settled. The
/// old pair could not tell any of those apart, so a native invoice had nowhere
/// to live that a quote did not also occupy.
///
/// Direction is now DERIVED from kind (`money.service.ts`), which is the only
/// place it was ever needed and the only place it stays correct as kinds are
/// added.
enum ErpDocumentKind {
  /// An offer. Becomes an INVOICE by COPY, never by reference (§4.3).
  QUOTE
  ORDER
  /// Money owed to the business.
  INVOICE
  /// Money owed by the business — the half WARP-1991 records as having had no
  /// data source anywhere in the product.
  BILL
  /// Receivable and negative.
  CREDIT_NOTE
  RECEIPT
}

/// WARP-2739 (ADR-049 §4.2) — where a LOCAL document is in its life.
///
/// 🔴 ONE column with a per-kind allowed-transition map, not one enum per kind.
/// Five enums are five things to keep in sync and a `switch` in every read
/// path; the map lives in `document-status.ts` and is asserted cell by cell.
///
/// 🔴 NULL on every LANDED row, and the CHECK enforces it. A vendor's own
/// status word is carried verbatim in `vendorStatus` and is NOT mapped onto
/// these values: every vendor spells this differently, and folding five
/// vocabularies into fourteen values would decide, silently, that "Voided" and
/// "Paid" mean something this box chose for them.
enum ErpDocumentStatus {
  /// Every kind starts here.
  DRAFT

  // QUOTE: DRAFT -> SENT -> ACCEPTED | DECLINED | EXPIRED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED

  // ORDER: DRAFT -> CONFIRMED -> FULFILLED | CANCELLED
  CONFIRMED
  FULFILLED
  CANCELLED

  // INVOICE / BILL: DRAFT -> SENT -> PART_PAID -> PAID | VOID | WRITTEN_OFF
  PART_PAID
  PAID
  VOID
  WRITTEN_OFF

  // CREDIT_NOTE: DRAFT -> ISSUED -> APPLIED
  ISSUED
  APPLIED
}

/// WARP-2581 — an invoice or bill, landed from a CLOUD ACCOUNTING connection.
///
/// The first money this box keeps. Until now the only money in the product was
/// one live-read accounts-receivable number on /reports, which vanished the
/// moment the vendor's server was off, because nothing was stored.
///
/// 🔴 CLOUD ACCOUNTING TRACKS ONLY. A LAN practice-management track that
/// declares `invoice` must never land here: its receivables are a patient
/// ledger, and PHI on this box is read-through behind the ERP router's gate
/// (ADR-044 §3). `land-money.ts` refuses a non-cloud provider, and the refusal
/// is a test, not a comment.
///
/// 🔴 `amountMinor` and `balanceMinor` are DIFFERENT NUMBERS. An invoice
/// part-paid still carries its original amount; summing amounts where you
/// meant balances overstates receivables. Every surface says which it is.
///
/// Provenance is NOT NULL here, unlike the CRM tables: every row in this table
/// is landed by definition, so there is no locally typed shape to allow for.
model ErpDocument {
  id String @id @default(uuid())

  /// WARP-2739 — LANDED or LOCAL, and the CHECK below makes the three
  /// provenance columns follow from it.
  ///
  /// Defaults to LANDED because every row that existed when this column was
  /// added was landed by definition, and a default of LOCAL would have made
  /// the migration rewrite history.
  origin ErpDocumentOrigin @default(LANDED)

  /// The connection that landed it. NULL on a LOCAL row — nothing outside this
  /// box has ever seen it.
  ///
  /// 🔴 A LOCAL ROW MAY NOT BORROW A CONNECTION, and the CHECK refuses it. A
  /// document with a connection is vendor-owned, which on the CRM side means
  /// uneditable, archive-only, and overwritten by the next landing tick. A
  /// document a person has to be able to correct cannot be that.
  ///
  /// RESTRICT for the same reason the CRM tables use it — nothing deletes an
  /// `IntegrationConnection` today, and if something starts, this fails loudly
  /// rather than silently dropping a business's ledger.
  connectionId String?
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// Vendor key, denormalised so a row can be displayed without a join.
  /// Derived from `connection.provider` on write, never accepted from a caller.
  externalSystem String?
  /// The vendor's own id for this document. Scoped to the CONNECTION: two
  /// QuickBooks companies both number their invoices from 1.
  externalId     String?

  /// WARP-2737 — the number printed ON the document, for a LOCAL row.
  ///
  /// 🔴 NOT `externalId`, and the distinction is load-bearing. `externalId` is
  /// the VENDOR's identifier and is NULL on every local row by the provenance
  /// CHECK; reusing it for a number this box read off a PDF would put a value
  /// no vendor ever issued into the column the reconcile key is built from.
  ///
  /// Nullable because a document can arrive without one — a quote often has
  /// none until it is sent — and because nothing on this box ISSUES numbers
  /// yet. Sequence allocation is a decision about a business's books, not a
  /// detail for a filing slice.
  documentNumber String?

  kind ErpDocumentKind

  issuedAt DateTime?
  dueAt    DateTime?

  /// The vendor's id for the customer or supplier. Opaque, and NOT a foreign
  /// key: the counterparty may not have landed, may never land (a supplier is
  /// not a CRM customer), and must not block the document.
  counterpartyExternalId String?
  /// The landed customer, when one matches. SetNull: losing the customer must
  /// not lose the invoice.
  companyId              String?
  company                CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// The counterparty's name as the vendor gave it, so a document reads
  /// correctly even when nothing matched.
  counterpartyName       String?

  /// 🔴 EXACT DECIMALS, not minor units — and the difference is forced, not
  /// preferred.
  ///
  /// `CrmDeal` holds minor units because a deal's currency is always known, so
  /// its exponent is known. A ledger document's is NOT: `invoice` and `bill`
  /// are named in `SINGLE_CURRENCY_LEDGER_DATASETS`, exempt from the
  /// money-needs-a-currency rule because a QuickBooks company file has ONE
  /// home currency and its export carries no per-row currency column to map.
  /// Minor units cannot be computed without an exponent, and guessing 2 is
  /// wrong by a factor of 100 on a yen ledger.
  ///
  /// `NUMERIC(20,6)` holds any vendor decimal exactly, sums exactly in
  /// Postgres, and crosses the API as a STRING — `Number()` would round above
  /// 2^53 exactly as it does for the CRM.
  amount  Decimal? @db.Decimal(20, 6)
  /// What remains UNPAID. Not the same number as `amount` — an invoice
  /// part-paid still carries its original amount, and summing amounts where
  /// you meant balances overstates receivables.
  balance Decimal? @db.Decimal(20, 6)

  /// The vendor's currency when it names one per row, and NULL when the
  /// ledger's own home currency is the only answer — which is the ordinary
  /// case today.
  ///
  /// 🔴 A NULL here is why a total may only be computed PER CONNECTION. One
  /// ledger is one currency by construction; two ledgers are not, and adding
  /// them would produce a confident wrong number. Unknown behaves exactly like
  /// mixed: the total is withheld.
  currency String?

  /// The vendor's own status word, carried verbatim. Not an enum: every vendor
  /// spells this differently and mapping five vocabularies onto three values
  /// would decide, silently, that "Voided" and "Paid" are the same thing.
  ///
  /// WARP-2739 renamed this from `status` so the box's own lifecycle could take
  /// that name. The two are mutually exclusive by origin, and the CHECK says
  /// so: a LANDED row has a vendor word and no lifecycle, a LOCAL row has a
  /// lifecycle and no vendor word. Keeping one column for both would mean a
  /// query for "my unpaid invoices" silently matching the string "Paid".
  vendorStatus String?

  /// WARP-2739 — the box's own lifecycle, for LOCAL rows only.
  ///
  /// 🔴 Maintained ONLY by `moveDocumentStatus`, which writes the transition
  /// and its timeline entry inside one `$transaction`. `moveDealStage`
  /// established that rule and `updateDeal` routes stage changes through it
  /// precisely so a PATCH cannot skip the timeline; a guard test asserts no
  /// other writer sets this column.
  status ErpDocumentStatus?

  /// When the VENDOR last changed it — never presented as "up to date".
  /// Xero's `UpdatedDateUTC` does not fire on a due-date edit, a
  /// send-to-contact, or a contact-balance change (WARP-2383).
  vendorUpdatedAt DateTime?

  /// When this box last read it. The only freshness claim the surface may make.
  lastReadAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The reconcile key, for LANDED rows. Postgres treats NULLs as distinct, so
  /// this constrains nothing on a LOCAL row — which is right: a LOCAL document
  /// has no vendor id to be unique about.
  @@unique([connectionId, kind, externalId])
  @@index([connectionId, kind, dueAt])
  @@index([companyId])
  @@index([kind, dueAt])
  /// "The quotes I have out", "the invoices I have not sent". A LOCAL-document
  /// list is always filtered by all three.
  @@index([origin, kind, status])
}

/// WARP-2751 (ADR-051) — the TIME AXIS for money. `ErpDocument` holds one row
/// per document carrying only its LATEST state, because `land-money.ts`
/// overwrites `amount`/`balance`/`vendorStatus` in place on every sync tick.
/// Yesterday is destroyed 96 times a day. Ageing, DSO drift, "our overdue
/// balance has doubled since June", "which customers slowed down" are all
/// structurally unanswerable against that, however good the model is.
///
/// Append-only, one row per subject per DAY.
///
/// 🔴 WHY A SNAPSHOT AND NOT AN AUDIT LOG. An audit log answers "what changed";
/// this answers "what was it worth on this date", which is the shape every
/// trend question has and the shape a `GROUP BY capturedOn` serves cheaply.
/// `ErpAuditLog` already exists and does not do this.
///
/// 🔴 NO `workspaceId`, despite the ticket proposing one. This schema has no
/// tenancy concept — `workspaceId` appears on `PmProject` alone, and inventing
/// a second, unenforced one here would be a column every future query has to
/// remember to filter and no constraint would ever check. `subjectId` is a
/// uuid and globally unique, so the unique key below is complete without it.
model MoneySnapshot {
  id String @id @default(uuid())

  /// The DAY this value was true. `@db.Date`, not a timestamp: the grain IS
  /// one day, and storing a time would let two rows for the same day differ
  /// and defeat the unique key that makes the 15-minute cadence idempotent.
  capturedOn DateTime @db.Date

  /// What was measured. A string rather than an enum because the next two
  /// subjects (`crm_deal`, `pipeline`) are not landed yet and an enum whose
  /// members arrive one migration at a time buys nothing over a documented
  /// vocabulary.
  subjectType String
  /// The subject's own id. NOT a foreign key: a snapshot must survive the
  /// document it describes, or the series ends the moment a vendor deletes an
  /// invoice — which is exactly the history worth keeping.
  subjectId   String

  /// The same shape `ErpDocument` carries, so the series and the live row are
  /// directly comparable. `Decimal(20,6)` and NOT minor units, for the reason
  /// `ErpDocument.amount` gives: a ledger's exponent is unknowable when its
  /// currency is null, and guessing 2 is wrong by 100x on a yen ledger.
  amount   Decimal? @db.Decimal(20, 6)
  balance  Decimal? @db.Decimal(20, 6)
  currency String?
  /// The vendor's own word, carried verbatim — see `ErpDocument.vendorStatus`.
  /// Free text, because five vendors spell this five ways.
  status   String?

  createdAt DateTime @default(now())

  /// The idempotency key. A document synced twelve times in one day must
  /// produce ONE row, and this is what makes the upsert converge on the day's
  /// last-seen value instead of appending ninety-six near-duplicates.
  @@unique([capturedOn, subjectType, subjectId])
  /// "The 90-day series for this document" — the query the whole table exists
  /// to serve, and the one the retention downsample scans.
  @@index([subjectType, subjectId, capturedOn])
  /// Retention sweeps by date across all subjects.
  @@index([capturedOn])
}


/// Lifecycle of a staged write in the outbox → confirm → apply → verify
/// pipeline (brief §11.1). Explicit enum; a write advances through these
/// states and is never derived from a NULL. DISCREPANCY = Eaglesoft's own
/// app logic altered/rejected the write at VERIFY (brief §11.1 step 4).
enum WriteStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  APPLYING
  APPLIED
  DISCREPANCY
  FAILED
  REVERSED
  REJECTED
}

/// One staged write request (the outbox, brief §11.1). Created at INTENT
/// with status PENDING_CONFIRMATION; nothing touches Eaglesoft until a human
/// confirms (invariant 1, §11.2). `command` is a registered command NAME
/// (never arbitrary SQL, invariant 4); `reversal` snapshots prior values for
/// reversible commands; `discrepancy` records a VERIFY-step mismatch.
// ============================================================================
// ADR-048 - auto-filing (WARP-2727 / WARP-2729)
//
// Three tables: what the box PROPOSED, what the owner CORRECTED, and what the
// owner CONSENTED to. The queue itself is not here - it is the claim columns on
// `FileIndexStatus` and `EmailMessage`, because those rows already say "new
// content exists" and a shadow queue would be a second source of truth.
//
// EVERY ACTOR COLUMN BELOW IS A PLAIN `String`, NOT AN FK, and that is a
// decision rather than an omission. Two of them sit inside NOT-NULL CHECKs, and
// an `onDelete: SetNull` FK under such a CHECK makes the row UN-DELETABLE: the
// SetNull fires inside the same statement that the CHECK then rejects, so the
// parent delete fails. That trap is live here twice over - `EmailMessage.
// accountId` is `onDelete: Cascade`, so a `DELETE /api/email/accounts` would
// cascade into every email proposal - and the house pattern already avoids it:
// `ErpWriteRequest.requestedBy`, `ToolSpec.ownerId` and `PmComment.createdById`
// are all bare strings. These columns are an AUDIT of who consented or decided,
// and that fact stays true after the user row is gone. A dangling id is caught
// by the worker's per-tick `resolveAttributedToolAccess`, which fails closed and
// pauses filing with "the person who turned this on is no longer active" -
// which is the designed behaviour, not a degradation.
// ============================================================================

enum IngestSourceKind {
  FILE
  EMAIL
}

enum IngestProposalKind {
  /// Attach a file to a record that already exists. Reversible, additive.
  LINK_FILE
  /// Put an inbound email on an existing customer's timeline.
  LOG_EMAIL_ACTIVITY
  /// Set `PmProject.companyId` where it is currently NULL. Never overwrites.
  SET_PROJECT_CUSTOMER
  CREATE_CUSTOMER
  CREATE_PROJECT
  /// Never auto-applies, in any mode, on any vertical: a person is where PHI
  /// lives on a practice box.
  CREATE_CONTACT
  /// Several candidates matched; a human picks. Never auto-applies.
  MATCH_REVIEW
  /// Held until the ADR-049 section 4 `ErpDocument` widening (WARP-2739). Money
  /// is never auto-applied even after that.
  CREATE_MONEY_DOC
}

enum IngestProposalStatus {
  PENDING
  APPLIED
  REJECTED
  /// The owner said "not the same" - recorded as a FilingDecision too, so the
  /// pair is never offered again.
  NOT_SAME
  EXPIRED
  UNDONE
}

/// What the POLICY TABLE (`services/filing/policy.ts`) decided, evaluated in
/// code and never by the model. `NEVER` is unappliable even by a human, and a
/// CHECK enforces that rather than a branch.
enum FilingPolicyClass {
  AUTO
  REVIEW
  NEVER
}

enum PhiVerdict {
  CLEAN
  /// A vendor invoice that names patients - the document a dental practice
  /// actually receives every week. Company and money survive; every person
  /// entity and every verbatim quote is dropped, and confidence is capped
  /// below every auto floor so it can never apply unattended.
  MENTIONS
  /// Terminal. No extraction pass, no proposal, no evidence stored.
  RECORD
}

enum IngestMatchKind {
  EMAIL
  DOMAIN
  NAME
  NONE
}

model IngestProposal {
  id String @id @default(uuid())

  sourceKind IngestSourceKind

  /// The durable source identity, `file:<ncFileId>` or `email:<uuid>`. TEXT and
  /// NOT NULL on purpose: it is what the dedupe key is scoped by, and unlike the
  /// two optional pointers below it survives the source row being deleted, so
  /// no CHECK here can ever be broken by a cascade.
  sourceRef String

  /// Convenience pointers, deliberately NOT covered by any CHECK. See the block
  /// comment above: `emailMessageId` is SetNull under a Cascade parent, so a
  /// CHECK requiring it would make deleting an email account impossible.
  ncFileId       Int?
  emailMessageId String?
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  kind         IngestProposalKind
  status       IngestProposalStatus @default(PENDING)
  policyClass  FilingPolicyClass
  /// Rendered in words on the review card: "Not applied automatically because
  /// the sender uses a personal email address."
  policyReason String?

  confidence Int
  phiVerdict PhiVerdict
  matchKind  IngestMatchKind

  /// The proposed fields, validated by a zod `.strict()` per-kind allow-list
  /// that has no `dob`/`chart`/`insurance`/`treatment` member anywhere - the
  /// model has nowhere to put PHI, which is a structural control rather than a
  /// prompt rule.
  payload Json

  /// Verbatim quotes proving each extracted field, each verified to be a real
  /// substring of the text actually sent. NULLED in the same transaction as a
  /// reject / not-same / PHI skip, and 30 days after an apply.
  evidence Json?

  extractorVersion String
  dedupeKey        String

  requestedById String
  /// Who decided, and when. Required for every decided status INCLUDING
  /// UNDONE — an undone proposal was applied by somebody first, and undoing
  /// it does not unmake that.
  decidedById   String?
  decidedAt     DateTime?
  appliedAt     DateTime?
  autoApplied   Boolean   @default(false)
  undoneById    String?
  undoneAt      DateTime?
  /// "delete" or "archive" - which branch the undo took, per the landed-purge
  /// rule (a row that acquired a human note is archived, never deleted).
  undoMode      String?

  /// Back-pointers to what applying this actually created. The "Created by
  /// Droplet" chip reads `origin === 'EXTRACTED'`, never `createdById IS NULL`
  /// - state is never derived from a NULL.
  createdCompanyId    String?
  createdContactId    String?
  createdProjectId    String?
  createdEntityLinkId String?
  createdActivityId   String?

  /// WARP-2737 — the money document this proposal created, if it created one.
  ///
  /// A plain `String?` with NO foreign key, exactly like its four siblings and
  /// for the same reason: undo reverses ONLY through these back-pointers and
  /// never searches for a row that "looks like" what it made. An FK would add
  /// nothing to that and would drag the SetNull-under-a-CHECK trap in with it.
  createdErpDocumentId String?

  /// A child proposal (e.g. LINK_FILE against a customer this run also
  /// proposes creating) that cannot apply until its parent does.
  dependsOnProposalId String?

  /// What applying this actually produced. Named relations because the plain
  /// `createdCompanyId` / `createdContactId` columns above are audit strings
  /// with no FK — only the row's own `proposalId` back-pointer is referential,
  /// so a reader can always ask a record "did Droplet file you?" without a
  /// join through this table.
  companiesFiled CrmCompany[] @relation("CompanyFiledByProposal")
  contactsFiled  Contact[]    @relation("ContactFiledByProposal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Re-extraction of the same source at the same extractor version must not
  /// mint a second proposal for the same thing.
  @@unique([sourceRef, kind, dedupeKey, extractorVersion])
  @@index([status, createdAt])
  @@index([sourceRef])
  @@index([ncFileId])
  @@index([emailMessageId])
  @@index([dependsOnProposalId])
}

enum IngestKeyKind {
  EMAIL_ADDRESS
  EMAIL_DOMAIN
  NAME
  NC_FOLDER
}

enum FilingDecisionKind {
  /// "Not this customer" - never offer this pair again.
  NOT_SAME
  /// "Mail from @northgatedental.com always files under Northgate Dental."
  ALWAYS_HERE
  /// "Ignore anything from this sender or folder."
  IGNORE_SOURCE
}

/// The correction memory, and the reason auto mode survives week two: a
/// correction made once is never made twice, and the owner can READ and REVOKE
/// what they taught it. Consulted BEFORE the matcher searches.
model FilingDecision {
  id       String             @id @default(uuid())
  keyKind  IngestKeyKind
  /// Lowercased on write.
  keyValue String
  verdict  FilingDecisionKind

  /// Required for NOT_SAME and ALWAYS_HERE, forbidden for IGNORE_SOURCE - a
  /// CHECK, because a rule pointing at no customer is not a rule.
  companyId String?

  createdById String
  createdAt   DateTime @default(now())

  @@index([keyKind, keyValue])
}

enum AutoFilingMode {
  off
  /// Everything waits for a click.
  propose
  /// Owner-promoted classes apply unattended, within caps.
  auto
}

enum AutoFilingLevel {
  /// Default: attach files, log email on existing customers, set a project's
  /// customer. Never creates.
  links_only
  also_create
}

enum AutoFilingVertical {
  general
  /// ASKED at enable time, never derived at read time. A LAN dental connector
  /// only pre-fills the answer - a heuristic must not silently decide a PHI
  /// posture.
  healthcare
}

/// Consent as a ROW with constraints, not a settings blob: the record proving a
/// human authorised unattended CRM writes must be one the database refuses to
/// leave half-filled.
model AutoFilingSetting {
  id String @id @default("singleton")

  mode     AutoFilingMode     @default(off)
  level    AutoFilingLevel    @default(links_only)
  vertical AutoFilingVertical @default(general)

  /// Who turned it on, server-stamped. Plain String, no FK - see the block
  /// comment at the top of this section.
  enabledById String?
  /// Bounds the ledger: a source older than this is retired `not_needed/
  /// backlog` rather than claimed, so enabling filing never files three years
  /// of history overnight.
  enabledAt   DateTime?

  folders      Json?
  pathDenylist Json?
  sources      Json?

  hourlyApplyCap Int @default(50)
  dailyCreateCap Int @default(10)
  digestHour     Int @default(8)

  /// `mode = 'auto'` is refused by a CHECK until an extraction-eval run has
  /// recorded a pass on THIS box's model (WARP-2732). The canary is auto mode's
  /// own merge condition, so it is a database invariant rather than a promise.
  canaryPassedAt DateTime?
  canaryModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErpWriteRequest {
  id           String      @id @default(cuid())
  connectionId String
  command      String
  params       Json
  status       WriteStatus @default(PENDING_CONFIRMATION)
  requestedBy  String
  confirmedBy  String?
  reversal     Json?
  discrepancy  Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([connectionId, status])
}

/// WARP-1255: department (or team) — a shared space with files, members, and
/// explicit access rights per member. Top-level departments have no parent;
/// teams are nested one level under a department parent. Household is the
/// legacy system department adopted from WS-5.
model Department {
  id                String                 @id @default(uuid())
  name              String                 @unique // display + groupfolder mount_point
  slug              String                 @unique // lowercase-dash; NC groups dept-<slug>{,-ro}; teams: dept-<deptslug>-<teamslug>
  parentId          String? // TEAM → its DEPARTMENT; null for HOUSEHOLD/DEPARTMENT (2026-07-11 amendment)
  /// WARP-2634: `onDelete: Restrict` is declared explicitly to match what
  /// 20260711000000_warp_1255_departments actually created. Prisma's implicit
  /// default for an optional relation is SetNull, so leaving it off made the
  /// datamodel promise a behaviour no migrated box has ever had. Nothing
  /// row-deletes a Department today — `DELETE /api/departments/:id` archives
  /// (sets `archivedAt`) — so this declaration changes no behaviour; it stops
  /// the datamodel lying. Whether RESTRICT or SetNull is the RIGHT product
  /// behaviour for deleting a parent department is a separate product call.
  parent            Department?            @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  teams             Department[]           @relation("DeptHierarchy")
  description       String?
  kind              DepartmentKind         @default(DEPARTMENT)
  state             ProvisionState         @default(pending)
  provisionError    String?
  /// WARP-1651: when this row FIRST failed to converge, or null while it is
  /// converging normally. The durable clock the reconciler bounds the
  /// re-verify state with — `updatedAt` cannot serve, because
  /// provisionDepartment rewrites `state` on every retry and so refreshes it
  /// each tick. Stamped once per failure episode, cleared on convergence.
  nonConvergedSince DateTime?
  ncGroupRw         String?                @unique // "dept-<slug>"; household: legacy householdGroupName()
  ncGroupRo         String?                @unique // "dept-<slug>-ro"; null for kind=HOUSEHOLD
  ncGroupfolderId   Int?                   @unique // discovered via gfListFolders; NEVER a sentinel key
  quotaBytes        BigInt? // null = unlimited; pushed via gfSetQuota
  aclVersion        Int                    @default(0) // bumped in-tx on EVERY membership/state mutation
  createdBy         String // local User.id
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?
  memberships       DepartmentMembership[]
  shares            DepartmentShare[]
  inviteGrants      UserInviteDepartment[]
  /// WARP-2717 — the WORK this department owns. Back-relations only: this
  /// model stays a Nextcloud groupfolder and knows nothing about PM. Nothing on
  /// the storage side (provisioner, reconciler, membership service) reads
  /// these, and nothing in PM reads `state`/`provisionError`/`quotaBytes` — the
  /// two halves share a row and nothing else.
  pmProjects        PmProject[]            @relation("PmProjectDepartment")
  pmWorkItems       PmWorkItem[]           @relation("PmWorkItemDepartment")
  // WARP-2748 (ADR-051): department-scoped brain rows. Cascade on the owning
  // side — a digest naming a deleted department would fall through the
  // membership test, so an access key must never dangle.
  brainDigests      BrainDigest[]
  brainFindings     BrainFinding[]
  /// WARP-2976 (ADR-059 P1): how this department is ARRANGED in the dashboard
  /// (switcher, /d/<slug> home). Absent = "not set up" — a state the UI names,
  /// never a template inferred from the department's name. Only DEPARTMENT rows
  /// carry one: a TEAM reads its parent's, HOUSEHOLD has none.
  profile           DepartmentProfile?
  /// WARP-2981 (DS-003): the people whose shell is arranged around this
  /// department. Back-relation only; a row cascades away with the department.
  activeChoices     ActiveDepartmentChoice[]

  @@index([state])
  /// WARP-2634: declared to match `Department_parentId_idx`, which
  /// 20260711000000_warp_1255_departments has always created. Postgres does
  /// not auto-index FK columns and the reconciler reads teams by parentId, so
  /// the index is doing real work — the datamodel was the side that was wrong.
  @@index([parentId])
}

/// WARP-2976 (ADR-059 P1) — a department's dashboard arrangement. Shows,
/// never grants: `navHrefs` is intersected with the viewer's existing nav gates
/// (role / capability / module) on the client, so a destination the person may
/// not reach stays hidden and an href that no longer exists renders nothing.
/// The server validates SHAPE only; the nav definition lives in the dashboard.
model DepartmentProfile {
  departmentId String             @id
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  template     DepartmentTemplate
  /// lucide icon name, lowercase-dash (validated by the route's zod schema)
  icon         String
  /// ordered dashboard hrefs, e.g. ["/cameras", "/events"]
  navHrefs     String[]
  /// ordered [{ widget, size }] — unknown widget ids are skipped by the client
  homeWidgets  Json
  /// local User.id of the last writer (the ActivityRow carries the audit)
  updatedBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// WARP-2981 (ADR-059 DS-003) — the department a person's shell is arranged
/// around, on every device (web, Android, the Windows WebView).
///
/// The row IS the person's choice, and `scope` says which: Whole business or a
/// department. No row means they have never chosen, on any device. The box
/// then shows Whole business (DS-014) without claiming they picked it, so a
/// browser still holding a P1 choice keeps it. Choosing Whole business writes
/// a `whole_business` row; only the cascades delete one.
///
/// `departmentId` is set exactly when `scope = department`: the
/// `ActiveDepartmentChoice_scope_shape` CHECK in the migration (Prisma cannot
/// declare it).
///
/// SHOWS, never grants (§2.5). The department must be choosable when written
/// (PUT) and is re-checked when read (GET): a person removed from it, or a
/// department archived since, reads as Whole business. The row is left in
/// place on read (GET never writes); the next PUT replaces it.
///
/// Last write wins across devices; no version column — two devices racing to
/// arrange one person's own shell is not a conflict worth a 409.
model ActiveDepartmentChoice {
  userId       String                @id
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope        ActiveDepartmentScope
  departmentId String?
  department   Department?           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  updatedAt    DateTime              @updatedAt

  @@index([departmentId])
}

/// WARP-2981 — what a person chose to arrange their shell around.
enum ActiveDepartmentScope {
  whole_business
  department
}

/// WARP-1255: department membership — explicit access rights for a user in a
/// department. The sync state tracks whether NC group membership has converged.
model DepartmentMembership {
  id               String          @id @default(uuid())
  departmentId     String
  userId           String // local User.id UUID
  right            DepartmentRight @default(contributor)
  syncState        NcSyncState     @default(pending)
  syncError        String?
  ncPermissionMask Int? // last mask confirmed pushed (15 | 1) — drift forensics
  grantedBy        String
  grantedAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  department       Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@index([syncState])
}

/// WARP-1255: shares on department content are minted by the NC admin credential
/// (members' masks withhold the share bit), so NC's uidOwner is the admin account —
/// this table holds the TRUE creator for authz.
model DepartmentShare {
  id           String     @id @default(uuid())
  departmentId String
  ncShareId    Int        @unique
  createdById  String // local User.id of the manager who minted it
  shareType    Int // 0=user, 1=group (phase 2), 3=link
  path         String // dept-root-relative, display/audit only
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([createdById])
}

/// WARP-1255: department rights granted to a user via an invite. When the invite
/// is accepted, these rights become a DepartmentMembership row in each department.
model UserInviteDepartment {
  id           String          @id @default(uuid())
  inviteId     String
  departmentId String
  right        DepartmentRight @default(contributor)
  invite       UserInvite      @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([inviteId, departmentId])
}

/// WARP-1255: per-user storage and usage policy. Controls storage quota,
/// upload size limit, and optional LLM daily message cap.
model UserUsagePolicy {
  userId             String      @id // FK User, onDelete Cascade
  storageQuotaBytes  BigInt? // local desired state → ncUpdateUser(...,'quota',...)
  quotaSyncState     NcSyncState @default(pending)
  maxUploadSizeMb    Int? // per-user override of config.MAX_UPLOAD_SIZE_MB
  llmDailyMessageCap Int? // optional (decision D-7)
  updatedBy          String
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ADR-032 / WARP-1525 (RBAC v2): admin-authored custom access role. A role
/// is a ROW, not a new `Role` enum value — the pgEnum is migration-gated and
/// triple-duplicated in TS by design (ADR-029 departments precedent: rows,
/// not enum values). `startingPoint` IS the built-in tier its people receive:
/// assigning the role sets `User.role = startingPoint` in the same
/// transaction (T3), so every ADR-004 `requireRole` floor keeps working
/// unchanged and the per-axis grant rows below can only NARROW within it.
model AccessRole {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  description        String?
  // CHECK: admin|family|guest — never owner/service. Enforced in the service
  // layer + zod (T3 role-mutation-guard), deliberately NOT a DB check
  // constraint; the column stays the plain Role enum.
  startingPoint      Role
  // active | archived. Stays a String default "active" (the ADR-032 §2 spec
  // shape); the two-value lifecycle is service-managed and archived roles
  // keep their rows (the design's archive-don't-delete affordance).
  state              String   @default("active")
  // axis c — usage DEFAULTS for people in this role; a person's
  // UserUsagePolicy row overrides per person. Null = box default.
  storageQuotaBytes  BigInt?
  maxUploadSizeMb    Int?
  llmDailyMessageCap Int? // rendered; enforcement stays deferred (llm.ts:401)
  // axis d — the two off-box booleans that are per-role, not per-domain.
  cloudModelsAllowed Boolean  @default(false) // under the workspace cloud_model_escape backstop
  mayOperateLocks    Boolean  @default(false) // Tier-2; handler-side confirm stays regardless
  createdBy          String // local User.id
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users           User[]
  invites         UserInvite[]
  featureGrants   AccessRoleFeatureGrant[]
  toolGrants      AccessRoleToolGrant[]
  connectorGrants AccessRoleConnectorGrant[]
}

/// ADR-032 / WARP-1525 (RBAC v2), axis a + b: per-role feature grant. Absent
/// row = feature OFF for the role (the chat/home/settings always-on floor is
/// service-enforced, not a row). `moduleId` reuses the App-Modules `ModuleId`
/// enum — ONE feature vocabulary shared between the module registry,
/// ModuleSetting rows, and role grants; no parallel list to drift.
model AccessRoleFeatureGrant {
  roleId   String
  moduleId ModuleId
  level    FeatureAccessLevel
  role     AccessRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId])
}

/// ADR-032 / WARP-1525 (RBAC v2), axis d on-box: per-role tool-domain grant.
/// Absent row = domain OFF for this role. `domain` is a String holding a
/// ToolDomain value from the tools-core catalog (packages/tools-core
/// catalog.ts) — that union is TS-only, not a pgEnum, so the DB deliberately
/// does not re-declare it; the T5 resolver validates values against the
/// catalog at write time.
model AccessRoleToolGrant {
  roleId String
  domain String // ToolDomain value from tools-core catalog (string — the TS enum is not a pgEnum)
  level  ToolAccessLevel
  role   AccessRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, domain])
}

/// ADR-032 / WARP-1525 (RBAC v2), axis d off-box: per-role connector grant.
/// Absent row = none. `provider` matches IntegrationConnection.provider
/// ("eaglesoft"). A grant sits UNDER the connection-level `writeEnabled`
/// gate and the staged-outbox human confirm — role grants only ever narrow.
model AccessRoleConnectorGrant {
  roleId   String
  provider String // IntegrationConnection.provider ("eaglesoft")
  level    ConnectorAccessLevel
  role     AccessRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, provider])
}

/// ADR-032 / WARP-1525 (RBAC v2), design D-A: small, secondary per-person
/// exception list — feature axis ONLY in v1 (tool/connector exceptions are a
/// v2 candidate). `level` is required when effect=allow — service-enforced
/// (T3), so nullable here; the resolver clamps allows to the same ADR-004
/// catalog ceiling as role grants. Rows cascade with their user.
model UserAccessException {
  id        String                @id @default(uuid())
  userId    String
  moduleId  ModuleId
  effect    AccessExceptionEffect
  level     FeatureAccessLevel?
  grantedBy String // local User.id
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

/// Append-only PHI audit trail (brief §11, §14, invariant 11). Every read of
/// patient data and every write records actor / action / entity / row scope.
/// Rows are never updated or deleted — the table is write-once.
model ErpAuditLog {
  id           String   @id @default(cuid())
  connectionId String
  actor        String
  action       String
  entity       String
  scope        Json
  at           DateTime @default(now())

  @@index([connectionId, at])
}

/// WARP-1396 — device rooms (the household map). Rooms are a Droplet-LOCAL
/// concept (orchestrator data, never Matter fabric state); room names feed the
/// assistant's device-targeting vocabulary ("turn off the kitchen").
model Room {
  id        String        @id @default(cuid())
  name      String
  icon      String        @default("home")
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  aliases   DeviceAlias[]
}

/// WARP-1396 — a device's household identity: a friendly (speakable) name and
/// its room, keyed by the Matter nodeId. Deliberately NOT the Matter
/// `nodeLabel` (bridged ecosystems fight over it); the alias is Droplet-local,
/// which also makes it survive re-commissioning. A device belongs to zero or
/// one room; deleting the room nulls the link (devices are never deleted with
/// a room — brief §5.5).
model DeviceAlias {
  nodeId    String   @id
  name      String?
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@index([roomId])
}

/// WARP-1683 — Team chat v1: thread shape. `direct` is a 1:1 DM (deduped —
/// one thread per user pair); `group` is a small named group. Lowercase
/// members per the ChatMessageStatus enum style.
enum TeamChatThreadKind {
  direct
  group
}

/// WARP-1683 — what a team-chat message carries: plain text, a forwarded
/// Files document (cached name/path + ncFileId), or a forwarded AI-chat
/// transcript (immutable snapshot taken at send time).
/// WARP-1685 appends the two meeting kinds: `meeting_invite` (the card a
/// meeting create posts into its thread) and `meeting_reminder` (the card
/// the reminder sweep posts as the meeting approaches). Append-only.
enum TeamChatMessageKind {
  text
  file_share
  ai_chat_share
  meeting_invite
  meeting_reminder
}

/// WARP-1685 — meeting lifecycle. Explicit column, never derived from
/// absence (CLAUDE.md no-guessing rule). `cancelled` keeps the row (and
/// its invite card) around so the thread history stays truthful.
enum TeamChatMeetingStatus {
  scheduled
  cancelled
}

/// WARP-1685 — reminder lifecycle for the 60s sweep. `pending` → `sent`
/// happens in the SAME transaction as the meeting_reminder message insert
/// (exactly-once, restart-safe); `not_needed` is the explicit terminal for
/// meetings that were cancelled or slipped past the grace window — never a
/// silent skip.
enum TeamChatMeetingReminderStatus {
  pending
  sent
  not_needed
}

/// WARP-1685 — a participant's RSVP. Two-state on purpose: "no row yet"
/// is the honest representation of "hasn't answered", and rows are only
/// ever created with an answer (upsert), so absence is a real state here,
/// not a guessed one.
enum TeamChatRsvpResponse {
  accepted
  declined
}

/// WARP-1683 — an internal member-to-member conversation (DM or small
/// group). LAN-local only; served by routes/team-chat.ts behind the
/// `team_chat` module gate.
///
/// `createdById` is the LOCAL `User.id` UUID (`req.user.id`) — NEVER the
/// username (ADR-027 IDOR rule; FileComment.authorUserId precedent: a bare
/// column, no FK, so user deletion never cascades a shared history away).
/// `lastMessageAt` is denormalized for the thread-list sort + is bumped in
/// the same transaction as every message insert.
model TeamChatThread {
  id            String                @id @default(uuid())
  kind          TeamChatThreadKind
  /// Optional display title for `group` threads; `direct` threads render
  /// the other participant's name instead.
  title         String?
  createdById   String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt
  lastMessageAt DateTime              @default(now())
  participants  TeamChatParticipant[]
  messages      TeamChatMessage[]
  meetings      TeamChatMeeting[]

  @@index([lastMessageAt(sort: Desc)])
}

/// WARP-1683 — membership + per-member read cursor. `userId` is the LOCAL
/// `User.id` UUID (ADR-027 — never username). Unread for a member = messages
/// in the thread newer than THEIR `lastReadAt` from OTHER senders — an
/// explicit cursor defaulted to now() at join, never null-absence semantics
/// (CLAUDE.md no-guessing rule).
model TeamChatParticipant {
  id         String         @id @default(uuid())
  threadId   String
  thread     TeamChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  joinedAt   DateTime       @default(now())
  lastReadAt DateTime       @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

/// WARP-1683 — one message in a team-chat thread. `senderId` is the LOCAL
/// `User.id` UUID (ADR-027). `body` is the text for kind=text and the
/// optional caption for the two forward kinds.
///
/// file_share: `sharedNcFileId` + cached `sharedFileName`/`sharedFilePath`
/// (display cache stamped at send time — the card keeps rendering after a
/// rename/move; the link resolves through /files' own access control).
///
/// ai_chat_share: `sharedChatSnapshot` holds the immutable
/// `{title, messages:[{role, content, createdAt}]}` transcript taken at
/// send time; `sharedChatSessionId` is provenance only — SetNull on session
/// delete so the forward survives the source conversation's deletion.
model TeamChatMessage {
  id                  String              @id @default(uuid())
  threadId            String
  thread              TeamChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId            String
  kind                TeamChatMessageKind
  body                String?
  sharedNcFileId      Int?
  sharedFileName      String?
  sharedFilePath      String?
  /// WARP-1898 — the Files space `sharedFilePath` is relative to
  /// ("personal" | "shared" | "dept:<uuid>"). Without it the recipient's
  /// link fell through to /files' silent personal-space default and
  /// resolved the SENDER's path inside the RECIPIENT's own namespace.
  /// Derived server-side from the file registry where a row exists; the
  /// sender's claim is only a fallback. Null on rows written before this
  /// ticket — treated as unknown, never as personal.
  sharedFileSpace     String?
  sharedChatSessionId String?
  sharedChatSession   ChatSession?        @relation(fields: [sharedChatSessionId], references: [id], onDelete: SetNull)
  sharedChatSnapshot  Json?
  /// WARP-1685 — set on meeting_invite / meeting_reminder messages so the
  /// card renders from the live meeting row in one fetch. SetNull on
  /// meeting delete: the message survives as history.
  meetingId           String?
  meeting             TeamChatMeeting?    @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())

  @@index([threadId, createdAt])
  @@index([sharedChatSessionId])
  @@index([meetingId])
}

/// WARP-1685 — a meeting scheduled inside a team-chat thread. Invitees are
/// the THREAD's participants (no separate invite list). `createdById` is
/// the organizer's LOCAL `User.id` UUID — a bare column, no FK, per the
/// v1 TeamChatThread.createdById / FileComment.authorUserId precedent.
///
/// `inviteMessageId` links back to the meeting_invite card posted in the
/// same transaction as the meeting create. `calendarEventId` links the
/// local CalendarEvent mirrored onto the organizer's calendar — created
/// best-effort AFTER the transaction (a calendar hiccup never loses the
/// meeting), deleted best-effort on cancel. Both are bare columns: the
/// message/event tables never cascade a meeting away.
///
/// `@@index([reminderStatus, startsAt])` is the sweep's scan key.
model TeamChatMeeting {
  id                    String                        @id @default(uuid())
  threadId              String
  thread                TeamChatThread                @relation(fields: [threadId], references: [id], onDelete: Cascade)
  inviteMessageId       String?
  calendarEventId       String?
  title                 String
  startsAt              DateTime
  durationMinutes       Int?
  location              String?
  /// WARP-1874 — https-only video-call link for the meeting. Mirrors onto
  /// the organizer's CalendarEvent.meetingUrl; same parseMeetingLink gate.
  meetingUrl            String?
  note                  String?
  createdById           String
  status                TeamChatMeetingStatus         @default(scheduled)
  reminderMinutesBefore Int                           @default(15)
  reminderStatus        TeamChatMeetingReminderStatus @default(pending)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @default(now()) @updatedAt
  rsvps                 TeamChatMeetingRsvp[]
  messages              TeamChatMessage[]

  @@index([reminderStatus, startsAt])
  @@index([threadId])
}

/// WARP-1685 — one participant's answer to a meeting. `userId` is the
/// LOCAL `User.id` UUID (ADR-027 — never username). Upsert-only surface:
/// a member may flip accepted ↔ declined; `@@unique` keeps one answer per
/// member per meeting.
model TeamChatMeetingRsvp {
  id          String               @id @default(uuid())
  meetingId   String
  meeting     TeamChatMeeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  response    TeamChatRsvpResponse
  respondedAt DateTime             @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

/// WARP-1749 (ADR-036 Phase 2) — rollback journal for the model-id migration.
///
/// The Ollama→OCI map is LOSSY: `gemma4:26b` and `gemma4:31b` both become
/// `ai/gemma4` (see `services/model-id-map.ts`). A reversed lookup table
/// therefore cannot restore what a row held — only a record of the actual
/// before-value can. That is what this pair of tables is.
///
/// Created EMPTY by its migration and stays empty until an operator runs
/// `npm run model-id-migrate -- --apply`. Nothing on the boot path writes
/// here: `migrate deploy` (scripts/migrate-and-start.sh) adds the tables, the
/// data rewrite is an explicit operator step and never runs by itself.
///
/// `state` is an EXPLICIT column, never derived from the absence of a later
/// row (CLAUDE.md rule 10 — same discipline as ADR-035's ApDevice states).
///   - `direction`  `forward` (Ollama→OCI) | `backward` (the revert)
///   - `state`      `applied` | `reverted`. A `backward` batch is born
///                  `applied` and is never itself reverted — re-running the
///                  forward migration creates a NEW forward batch instead.
model ModelIdMigrationBatch {
  id             String                  @id @default(uuid())
  direction      String
  state          String
  /// Set on a `backward` batch: the `forward` batch it undid. NULL on a
  /// forward batch — this is provenance, not state.
  revertsBatchId String?
  /// Free-text operator note (`--note`), so a box can say WHY it was run.
  note           String?
  startedAt      DateTime                @default(now())
  entries        ModelIdMigrationEntry[]

  @@index([direction, state, startedAt])
}

/// WARP-1749 — one column of one row, rewritten by one batch.
///
/// `beforeValue`/`afterValue` are stored verbatim (not normalised): rollback
/// re-checks that the row STILL holds `afterValue` before restoring, so a row
/// somebody changed by hand in between is skipped and reported rather than
/// clobbered.
model ModelIdMigrationEntry {
  id          String                @id @default(uuid())
  batchId     String
  batch       ModelIdMigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// `workspace_setting` | `chat_session` | `chat_message`
  site        String
  /// Primary key of the row (or the WorkspaceSetting `key`).
  rowKey      String
  /// `valueJson` | `model`
  column      String
  beforeValue String
  afterValue  String

  @@index([batchId])
  @@index([site, rowKey])
}

/// WARP-1906 — premade business locations: one named conference room in a
/// building, offered as a Location suggestion when creating a calendar event
/// (ahead of the Nominatim results) and managed from Settings → Locations.
///
/// One row per room, with the building as a plain grouping label rather than
/// its own table: v1 carries no building-level metadata, so a separate
/// Building model would add a join with nothing in it. The box is a
/// single-workspace appliance (Workspace is the id=1 singleton, WARP-1341
/// business-only), so there is no workspace FK — every row belongs to THE
/// workspace, and route auth (any member reads, owner/admin writes) is the
/// scoping boundary.
model WorkspaceLocation {
  id        String   @id @default(uuid())
  /// Building / site label, e.g. "HQ", "2nd Floor".
  building  String
  /// Room name, e.g. "Room Aurora", "Fishbowl".
  room      String
  /// Username of the admin who created the row — display/audit attribution,
  /// same shape as `Workspace.setBy` (never the User.id UUID, WARP-1014).
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([building, room])
  @@index([building])
}

// ---------------------------------------------------------------------------
// Microsoft 365 cloud connector (WARP-2115, ADR-041)
// ---------------------------------------------------------------------------

/// Lifecycle of one person's Microsoft 365 link. Explicit column, never
/// inferred from whether a token happens to be present — the repo's
/// no-guessing-from-absence rule (cf. BrainMemoryItemStatus, WARP-218).
/// NEEDS_RECONNECT in particular MUST be distinguishable from DISCONNECTED:
/// they look identical from "is there a working token" but mean opposite
/// things to the person reading the dashboard.
enum M365ConnectionState {
  /// No Microsoft account linked. The default, and where a disconnect returns.
  DISCONNECTED
  /// A sign-in is in flight: the person is at Microsoft's sign-in page
  /// (authorization code, WARP-2704) or approving a code on another device
  /// (device code, the fallback). Expires — see `pendingFlowExpiresAt`.
  PENDING_CONSENT
  /// Usable. A refresh token is held and the last refresh succeeded.
  CONNECTED
  /// Tokens exist but no longer work: the grant was revoked, an admin reset
  /// the password, or the box sat powered off past the refresh window. This is
  /// NOT an error — it is a normal, expected state that asks the person to
  /// sign in again. Sync pauses; already-synced data is untouched.
  NEEDS_RECONNECT
  /// Something reconnecting will not fix — the app registration is rejected,
  /// the tenant blocks the flow, config is wrong. `lastError` carries why.
  ERROR
}

/// A customer's Microsoft 365 account connected to the box as a CLOUD
/// CONNECTOR (ADR-041): outbound-only, owner-enabled, off until connected.
///
/// One row per Droplet user, because ADR-041 mandates DELEGATED authorization
/// rather than application permissions — the box reads Microsoft as that
/// person, so it can never see what they cannot. Application permissions would
/// have granted "read every mailbox in the tenant".
model M365Connection {
  id String @id @default(uuid())

  /// The Droplet user who owns this link. Unique: one Microsoft account per
  /// person. Not an FK — matches how other per-user rows in this schema key
  /// off the directory id without coupling deletes.
  userId String @unique

  state M365ConnectionState @default(DISCONNECTED)

  /// Entra's stable account identifier (MSAL `homeAccountId`). Selects the
  /// right account out of the cache when refreshing.
  homeAccountId String?

  /// The customer's Entra tenant id. Display and support, and it detects the
  /// case where someone reconnects a DIFFERENT tenant than before.
  tenantId String?

  /// WARP-2705 — the Application (client) id of the CUSTOMER'S OWN Entra app
  /// registration this link signs in through. Not a secret: a public-client id
  /// is designed to ship inside the client, and the flows use no client
  /// secret. Per connection rather than one box-wide id, because a single
  /// Warp-Lab multitenant app is the PARTNER_GATED shape ADR-042 §3 rules out
  /// and pools Graph's per-app throttling ceiling across every customer.
  ///
  /// Survives a disconnect on purpose: it is configuration, not a credential,
  /// and keeping it is what makes "connect again" one click.
  appClientId String?

  /// WARP-2705 — the tenant that app is registered in (a GUID or a verified
  /// domain). The sign-in authority is `${M365_AUTHORITY_HOST}/${appTenantId}`:
  /// a single-tenant registration only issues tokens on its own tenant
  /// authority, never on `/organizations`. Survives a disconnect, like
  /// `appClientId`. `tenantId` above is what Microsoft REPORTS for the
  /// signed-in account; this is what the owner CONFIGURED.
  appTenantId String?

  /// WARP-2704 — SHA-256 (hex) of the OAuth `state` of an in-flight
  /// authorization-code sign-in. The callback finds the row by it; the raw
  /// value only ever travels in the redirect and an httpOnly cookie. Cleared
  /// the moment a callback claims it, so a replayed callback finds nothing.
  pendingStateHash String? @unique

  /// WARP-2704 — `dcv1:` blob of the in-flight sign-in's PKCE code verifier,
  /// nonce and redirect URI, sealed under the token-cache key with its own
  /// AAD. Cleared together with `pendingStateHash`.
  pendingFlowEnc String?

  /// User principal name (e.g. `sam@practice.com`), shown in the dashboard so
  /// the owner can see which account is connected. Not a secret.
  accountUpn String?

  /// `dcv1:` blob (column-crypto.service) of the MSAL token cache, which
  /// CONTAINS THE REFRESH TOKEN — functionally a long-lived key to this
  /// person's mail and files. AAD-bound to `userId`, so a blob copied onto
  /// another row fails to decrypt rather than granting access. Never logged,
  /// never returned by any route, purged on disconnect.
  ///
  /// The key derives from DEVICE_SECRET_KEY, which setup.sh regenerates on a
  /// factory reset — so a wipe crypto-shreds every stored token even if the
  /// database rows survive.
  tokenCacheEnc String?

  /// Scopes Microsoft actually granted, space-separated as returned. May be
  /// narrower than requested; the sync engine reads this to decide which
  /// workloads it is allowed to attempt.
  grantedScopes String?

  /// WARP-3059 (#2347 review) — which link this person's M365DeltaCursor rows
  /// were built under: a SHA-256 (hex) of the app client id, homeAccountId and
  /// tenantId of the sign-in that last connected. A delta link and a folder id
  /// are positions in one mailbox read through one app, so a sign-in that
  /// completes as anything else purges the cursors before the row turns
  /// CONNECTED; the same link keeps them. Unlike the account columns it
  /// survives a sign-in STARTING, because the cursors do. A hash, so a
  /// DISCONNECTED row still names no account through it. Cleared with the
  /// cursors on disconnect; NULL means "not known" and counts as a change.
  cursorLinkHash String?

  /// When the in-flight sign-in stops being valid. Microsoft expires a device
  /// code in ~15 minutes, and an authorization-code sign-in gets the same
  /// window. A PENDING_CONSENT row past this is swept back to DISCONNECTED —
  /// an orchestrator restart drops the in-memory device-code flow, a person can
  /// close the Microsoft tab, and without this the row would sit "pending"
  /// forever.
  pendingFlowExpiresAt DateTime?

  /// First successful connect. Kept across a NEEDS_RECONNECT round-trip so the
  /// UI can say how long this account has been linked.
  connectedAt     DateTime?
  lastRefreshOkAt DateTime?

  /// Operator-facing reason for ERROR / NEEDS_RECONNECT. Must never carry a
  /// token, code, or raw bearer material — only Entra's error identifier and a
  /// plain-language sentence.
  lastError String?

  /// WARP-3538 — has this person opted in to SharePoint document libraries?
  /// An explicit column, never inferred from the grant or from cursors that
  /// happen to exist (the no-guessing-from-absence rule): discovery of the
  /// `sharepoint` workload runs only when this is true AND the grant covers
  /// `Sites.Read.All`, and a sign-in asks Microsoft for that scope only when
  /// it is true. Off by default and reset by a disconnect — a person who did
  /// not ask for SharePoint must never be asked for the scope, because a
  /// tenant that has not approved it fails the WHOLE sign-in ("Need admin
  /// approval") under Microsoft-managed consent settings, mail and calendar
  /// included.
  sharePointEnabled Boolean @default(false)

  /// WARP-3538 — how many document libraries the last discovery that could say
  /// found beyond MAX_SHAREPOINT_LIBRARIES_PER_PERSON and so did NOT register.
  /// Persisted because the cap is visible by design (the card says "N more
  /// libraries not read") and nothing else keeps the count: dropped libraries
  /// have no row. Written only by a discovery that read enough to know, never
  /// by one that failed or stopped at a page bound.
  sharePointLibrariesCapped Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

/// Per-resource sync state for the Microsoft 365 connector (WARP-2118).
/// Explicit column, never inferred from whether `deltaLink` happens to be
/// null — IDLE-with-no-token (never synced) and RESYNC_REQUIRED (token died,
/// must re-enumerate) both have a null link and mean different things.
enum M365SyncState {
  /// Never run, or finished cleanly and waiting for its next tick.
  IDLE
  /// A run is in progress. Guards against two ticks overlapping on one cursor.
  SYNCING
  /// Throttled or wobbling. `nextAttemptAt` says when to try again.
  BACKOFF
  /// The delta token is dead (410 Gone / syncStateNotFound). The next run
  /// re-enumerates from scratch. A normal transition, not a failure.
  RESYNC_REQUIRED
  /// Broken in a way retrying will not fix. Needs a person to look.
  FAILED
}

/// One delta cursor per (person, workload, resource).
///
/// The grain matters: **mail delta is a per-folder operation**, so a mailbox
/// with ten folders has ten cursors, not one. Drives, calendars and contact
/// folders are likewise addressed individually. Getting this wrong means
/// either losing changes or re-downloading a mailbox on every tick.
model M365DeltaCursor {
  id String @id @default(uuid())

  /// The Droplet user whose connection this cursor syncs under. Matches
  /// M365Connection.userId; delegated auth means every read is scoped to them.
  userId String

  /// `mail` | `calendar` | `contacts` | `files` | `todo` | `sharepoint`. Free
  /// text here; `M365_WORKLOADS` (graph-resources.ts) is the gate.
  workload String

  /// The specific resource inside that workload — a mail folder id, a drive
  /// id, a calendar id. Never a path: Graph is explicit that drive items must
  /// be tracked by id, since a rename would silently orphan a path-keyed row.
  resourceId String

  /// The FULL `@odata.deltaLink`, stored opaquely and replayed verbatim. It
  /// encodes `$select` and other request state, so rebuilding it by hand
  /// silently changes what the next sync asks for — a bug that presents as
  /// missing data rather than as a bad URL. Null = nothing synced yet, or a
  /// resync is pending (see `state`, which is what actually distinguishes them).
  deltaLink String?

  /// WARP-3059 — where an enumeration too big for one tick resumes: the
  /// `@odata.nextLink` of the last page the run HANDLED before its page budget
  /// ran out. Separate from `deltaLink` on purpose — the cursor still advances
  /// only when a run reaches its deltaLink; this is a checkpoint inside one run,
  /// written only after every page before it was handled. Without it a folder
  /// over the budget re-read the same pages every tick and never finished.
  /// Cleared on completion and on a resync. Stored verbatim, never logged.
  resumeLink String?

  state M365SyncState @default(IDLE)

  /// Drives the exponential backoff. Reset to 0 on every success.
  consecutiveFailures Int @default(0)

  /// Earliest time the scheduler may try this cursor again. Set from
  /// Microsoft's `Retry-After` when it sends one — obeyed exactly, because
  /// throttled requests still count against the tenant's budget.
  nextAttemptAt DateTime?

  lastSyncedAt DateTime?

  /// Redacted, human-readable reason for BACKOFF / FAILED. Never a token,
  /// and never a raw delta link (which carries a token of its own).
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One cursor per resource per person — the upsert key.
  @@unique([userId, workload, resourceId])
  /// The scheduler's claim query: "what is due now".
  @@index([state, nextAttemptAt])
  @@index([userId])
}

/// WARP-3538 (ADR-041 §4) — which cloud a landed file, and the source it sits in,
/// came from. One value today. Google Drive and Dropbox add theirs
/// (`ALTER TYPE ... ADD VALUE`, additive) in the changes that build their
/// connectors, together with the writer that needs each one: a value here that
/// nothing writes is a promise nothing keeps.
enum CloudFileProvider {
  M365
}

/// WARP-3538 — what KIND of container a `CloudFileSource` is. A person's own
/// drive and a shared library are different things to say to them ("OneDrive"
/// versus "Front desk › Documents") and to read (one implicit cursor versus one
/// per library), so the kind is an explicit column — never inferred from a null
/// `siteId`, and never from which cursor happens to reference the source. Later
/// providers add their own kinds additively.
enum CloudFileSourceKind {
  ONEDRIVE
  SHAREPOINT_LIBRARY
}

/// WARP-3538 — a container a person's cloud-file sync reads: their OneDrive, one
/// SharePoint document library, and (in the changes that follow) a Google Drive
/// or a Dropbox account. It is the identity and the display names of what a sync
/// cursor addresses by a bare id — Microsoft's cursor knows only a drive id, and
/// this is what the card and the file search show for it ("Front desk ›
/// Documents").
///
/// PROVIDER-AGNOSTIC on purpose (WARP-3538 D13). Google Drive and Dropbox are
/// built right after this and must land into the SAME store and be found by the
/// SAME search tool, so a person asks once and gets every cloud. Three concrete
/// providers in the same programme is not a premature abstraction. `sourceId` is
/// the provider's own container id (M365: the Graph DRIVE id) and `siteId` is the
/// one column that is M365's alone.
///
/// The names and the URL are `dcv1:` blobs under the `cloud-file-metadata` key
/// (cloud-file-crypto.ts), AAD-bound to (provider, userId, sourceId, column): a
/// site or library name can carry a patient or a matter. Not a foreign key, like
/// every cloud-connector table — disconnect, a leaver's deletion and switching
/// SharePoint off delete these rows by hand, and a COMPLETE discovery prunes the
/// libraries that are gone.
model CloudFileSource {
  id String @id @default(uuid())

  /// The Droplet user whose connection reads this source. Every query is scoped
  /// to it — a person only ever sees their own rows.
  userId String

  provider CloudFileProvider
  kind     CloudFileSourceKind

  /// The provider's id for the container. M365: the Graph DRIVE id, which is the
  /// `sharepoint` cursor's `resourceId` (and, for OneDrive, the id `GET
  /// /me/drive` returns, since the OneDrive cursor's own resource is the
  /// singleton `-`). Never a path and never a name.
  sourceId String

  /// M365 SharePoint: Graph's composite site id (`hostname,siteCollectionId,webId`).
  /// Null for OneDrive, which sits under no site.
  siteId String?

  /// `dcv1:` blob of the site's display name. Null where there is no site.
  siteNameEnc String?

  /// `dcv1:` blob of the container's name — a library's name; for OneDrive, the
  /// drive's own name.
  nameEnc String

  /// `dcv1:` blob of the container's browser URL, when the provider sent one.
  webUrlEnc String?

  /// True when the person FOLLOWS the site, false when it was found by search
  /// alone. Explicit, because the order libraries are registered in (and so
  /// which survive the per-person cap) depends on it.
  followed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per container per provider per person — the upsert key.
  @@unique([userId, provider, sourceId])
  @@index([userId])
}

/// WARP-3538 — one file or folder, as a cloud provider's change feed reports it.
/// The first thing the Microsoft 365 sync engine LANDS (ADR-041 §4): until this
/// table every page it read was counted and discarded.
///
/// METADATA ONLY — never content. A file's bytes are a 302 to a per-tenant host
/// no `allowed-egress.yaml` entry can name, so nothing here is ever fetched.
///
/// The human-readable columns (`nameEnc`, `webUrlEnc`, `lastModifiedByEnc`) are
/// `dcv1:` blobs under their OWN column-crypto label (`cloud-file-metadata`). A
/// file name in a practice routinely carries a patient's name, and ADR-041 §4
/// requires synced content be encrypted at rest. WARP-2549's narrow reading would
/// have allowed plaintext here (this table makes no encryption promise to break)
/// — encrypted anyway, because a table should claim only what it implements and
/// what this one implements is the stronger thing. The AAD is an unambiguous
/// encoding of (provider, userId, sourceId, externalId, column) — see
/// cloud-file-crypto.ts — so a ciphertext cannot be moved between rows, people or
/// columns.
///
/// Not encrypted, on purpose: ids, the folder flag, MIME type, size and the
/// timestamps. They are what the table is filtered, ordered and swept by.
///
/// Items are tracked by ID, never by path: a provider's change feed may carry no
/// path at all (Graph's delta returns no `parentReference.path`), and a rename
/// would silently orphan a path-keyed row. `userId` is not a foreign key (like
/// every cloud-connector table): nothing cascades, so disconnect, a leaver's
/// deletion, switching SharePoint off and a reconnect as a different account all
/// delete these rows by hand.
model CloudFileItem {
  id String @id @default(uuid())

  /// The Droplet user whose connection read this item. Every query is scoped to
  /// it — a person only ever sees their own rows.
  userId String

  provider CloudFileProvider

  /// The `CloudFileSource.sourceId` this item sits in. M365: for `sharepoint`
  /// the cursor's resource id (the library's drive id); for OneDrive the id of
  /// the person's OneDrive source, because that cursor's own resource is the
  /// singleton `-`.
  sourceId String

  /// The provider's own item id — M365: Graph's driveItem id, stable across
  /// renames and moves.
  externalId String

  /// The containing folder's `externalId` — the chain a path is rebuilt from, and
  /// how a deleted folder's descendants are found. Null for an item directly
  /// under the source's root, which is not stored.
  parentExternalId String?

  isFolder Boolean

  /// `dcv1:` blob of the item's name. Never null: an item with no name is not
  /// landed.
  nameEnc String

  /// `dcv1:` blob of the browser URL, when the provider sent one.
  webUrlEnc String?

  /// `dcv1:` blob of the last modifier's display name, when the provider sent one.
  lastModifiedByEnc String?

  mimeType String?

  /// A FILE's size. Null for a folder (a provider reports a folder's cumulative
  /// size, which is not what anyone asks for), and BigInt because a file can pass
  /// 2 GiB. It reaches the wire as a JS number — exact below 2^53 bytes (8 PiB),
  /// which no file approaches.
  sizeBytes BigInt?

  /// The provider's own created / modified times — not when this row was written.
  remoteCreatedAt  DateTime?
  remoteModifiedAt DateTime?

  /// The state of a FULL enumeration's sweep, explicit and durable across the
  /// ticks a big source takes: a run that starts from scratch marks every row of
  /// the source `true`, every item it sees sets it back to `false`, and when the
  /// run reaches its end the rows still `true` were not returned — they are gone
  /// upstream — and are deleted. Incremental runs never touch it.
  sweepPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per item per source per provider per person — the upsert key. Its
  /// (userId, provider, sourceId) prefix also serves every "all of this source"
  /// statement: counting, marking, sweeping, pruning.
  @@unique([userId, provider, sourceId, externalId])
  /// Finding a deleted folder's children: a provider may report the folder as
  /// gone without listing what was in it.
  @@index([userId, provider, sourceId, parentExternalId])
  @@index([userId, remoteModifiedAt])
}

// ============================================================================
// Contacts — WARP-2018 (carddav-3)
//
// The ONE contact entity on the box. WARP-2117 makes this the CRM's person
// record rather than inventing a second one: the box must not end up with a
// CardDAV contact, a Graph contact and a CRM contact that are three rows for
// one human. A CardDAV address book is a SOURCE that fills this table
// (`AddressBookSource`); so is Microsoft Graph; so is a person typed in by
// hand. `origin` says which, explicitly.
//
// Modelled on `IntegrationConnection`/`IntegrationStatus`, NOT on
// `CalendarSource` — that one derives health from `lastSyncError IS NULL`,
// which is the WARP-218 pattern this repo forbids.
// ============================================================================

/// Lifecycle of one address-book source. Explicit column; never derived from
/// the nullability of `lastSyncError` or `collectionUrl`.
enum AddressBookStatus {
  /// No source has been configured. The default.
  NOT_CONFIGURED
  /// Credentials accepted, discovery in flight. A row may not rest here after
  /// a completed verify.
  VERIFYING
  /// Usable — the last sync against the server succeeded.
  CONNECTED
  /// Transient sync failure. A health signal, not a request for human action.
  DEGRADED
  /// The stored credential no longer works. Split from DEGRADED deliberately:
  /// it needs operator action and must BACK OFF rather than retry into an
  /// account lockout.
  AUTH_FAILED
  /// The server answered, but not with something we can read (no addressbook
  /// collection, or a vCard version we do not support). Retrying will not fix
  /// it and neither will new credentials.
  UNSUPPORTED_SERVER
  /// The operator turned this source off deliberately.
  DISABLED
}

/// What the server actually negotiated — persisted so the dashboard reports
/// the real mechanism rather than the one we intended.
enum AddressBookSyncMode {
  SYNC_COLLECTION
  ETAG_DIFF
  FULL_PULL
}

/// Where a contact row came from. Explicit, because "has an externalUid" is
/// exactly the derive-state-from-NULL shape the repo forbids — and because a
/// locally-authored contact that later gets matched to a synced one must not
/// silently change class.
enum ContactOrigin {
  /// Typed into Droplet. Droplet owns it; no sync will overwrite it.
  LOCAL
  /// Pulled from a source (CardDAV, Graph, a CRM connector). The source owns
  /// the synced fields.
  EXTERNAL
  /// ADR-048 — derived by Droplet from a document or an email. Editable like
  /// LOCAL; see `CrmRecordOrigin.EXTRACTED`.
  EXTRACTED
}

model AddressBookSource {
  id String @id @default(uuid())

  /// Owner of this address book. Delegated auth: a source can never expose
  /// data its owner could not read at the server.
  userId String
  name   String

  /// What the operator pasted. Kept verbatim so a failed discovery can be
  /// diagnosed against the input rather than against our rewrite of it.
  serverUrl String

  /// Resolved by discovery. NULL until a verify succeeds — which is a FACT
  /// about discovery, not the source's lifecycle state (see `status`).
  collectionUrl String?

  authMode String  @default("basic")
  username String?

  /// aes-256-gcm blob (encryption.service `encryptSecret`), same key and
  /// format as `CalendarSource.passwordEnc` and `DeviceClient.ncAppPassword`.
  /// Never returned by any route, never logged.
  passwordEnc String?

  status AddressBookStatus @default(NOT_CONFIGURED)

  /// Named vocabulary explaining a non-CONNECTED `status` to a human:
  /// `vcard_version_unsupported`, `no_addressbook_collection`,
  /// `off_lan_denied`, `credentials_rejected`. A closed set, unlike
  /// `lastSyncError`.
  statusReason String?

  syncMode        AddressBookSyncMode @default(FULL_PULL)
  syncToken       String?
  ctag            String?
  syncIntervalSec Int                 @default(900)
  lastSyncAt      DateTime?

  /// DIAGNOSTIC DETAIL ONLY — never the state. Read `status` for that.
  lastSyncError String?

  /// A CardDAV server off the LAN is an egress decision the owner has to make
  /// deliberately; the default is no.
  offLanAllowed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  @@index([userId, status])
}

model Contact {
  id String @id @default(uuid())

  /// ADR-048 - see `CrmCompany.proposalId`. Not in any CHECK.
  proposalId String?
  proposal   IngestProposal? @relation("ContactFiledByProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  userId String

  /// The source that owns this row, when it has one. Schema-level cascade
  /// (NOT a hand-rolled `$transaction` sweep like `calendar.service.ts` does)
  /// so deleting a source in a live DB cannot leave orphans behind.
  sourceId String?
  source   AddressBookSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  origin ContactOrigin @default(LOCAL)

  // --- Provenance (WARP-2117) ---------------------------------------------
  // Free TEXT, mirroring `IntegrationConnection.provider`: a new upstream
  // needs no migration. `externalSystem` names the vendor ("m365",
  // "salesforce", "hubspot", "carddav"); `externalId` is that vendor's id.

  /// Vendor key of the upstream that owns this row. NULL for LOCAL rows.
  externalSystem String?

  /// Stable id in the upstream system — the reconcile key that stops two
  /// connectors from each creating their own copy of one person.
  externalId   String?
  /// WARP-2549 — WHICH connection landed this row. NOT NULL is impossible here
  /// (a locally typed row has no connection), but a landed row without one is
  /// forbidden by the `*_provenance_complete` CHECK below.
  ///
  /// 🔴 The vendor's id is scoped to the CONNECTION, not to the vendor. Two
  /// HubSpot portals both serve an object `123` and they are unrelated
  /// customers; keying provenance on `(externalSystem, externalId)` refused the
  /// second one forever as "already linked". WARP-2461's purge walker also keys
  /// on this column, and its own mutation test proves that scoping a purge by
  /// PROVIDER destroys the sibling connection's data.
  ///
  /// RESTRICT, deliberately not CASCADE: nothing deletes an
  /// `IntegrationConnection` today (`disconnect()` flips it to DISABLED and
  /// purges in place), so this fires only if something new starts deleting
  /// them — at which point the landed rows must be purged deliberately, by a
  /// walker that knows to keep what a human wrote against them.
  connectionId String?
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// CardDAV's own identity/versioning triple.
  externalUid  String?
  href         String?
  etag         String?
  vcardVersion String?

  displayName  String
  givenName    String?
  familyName   String?
  organization String?
  jobTitle     String?
  note         String?

  /// String, NOT DateTime. RFC 6350 §4.3.1 permits partial dates — a birthday
  /// of `--0423` (April 23rd, year unknown) has no Date representation, and
  /// coercing it invents a year.
  birthday String?

  photoStorageKey String? @unique
  photoMimeType   String?
  photoSizeBytes  Int?

  /// Bounded at 64 KB by the write path.
  rawVcard String?

  /// WARP-2554 — the same explicit archive pair `CrmCompany` and `CrmDeal`
  /// carry, and for a reason `Contact` needs more than either of them:
  /// a row whose `origin` is EXTERNAL cannot be edited or deleted (the source
  /// owns its fields, and a delete would simply be undone by the next sync),
  /// so without this there is NO action a human can take to get a synced
  /// person off their screen. Archiving is that action — it is the owner's
  /// decision, it survives a re-sync, and it does not fight the source.
  ///
  /// Explicit boolean, never derived from `archivedAt IS NOT NULL` (WARP-884).
  /// `archivedAt` is the audit timestamp only.
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails        ContactEmail[]
  phones        ContactPhone[]
  companyLinks  CrmCompanyContact[]
  dealLinks     CrmDealContact[]
  crmActivities CrmActivity[]
  /// WARP-2562 (ADR-044) — this person's records in upstream systems.
  /// Distinct from `externalSystem`/`externalId` above, which say where this
  /// ROW came from. See the PartyLink model for why those are not the same
  /// question.
  partyLinks    PartyLink[]
  /// WARP-2585 — files related to this person (an ID scan, a signed form).
  fileLinks     EntityLink[]

  /// Same idempotency-key shape as `CalendarEvent` — one row per (source,
  /// upstream id), so a re-sync updates rather than duplicates.
  @@unique([sourceId, externalUid])
  /// The cross-connector reconcile key.
  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([userId, displayName])
  @@index([userId, origin])
  /// The default listing is "this person's contacts, unarchived, by name".
  @@index([userId, isArchived])
  @@index([proposalId])
}

model ContactEmail {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  address String

  /// Indexed lowercase form — the join key to `EmailMessage.fromAddr` and the
  /// cross-book dedupe key. Derived on write, never read from user input.
  addressLower String

  label     String?
  isPrimary Boolean @default(false)

  @@index([contactId])
  @@index([addressLower])
}

model ContactPhone {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// `tel:` scheme stripped on write.
  number    String
  label     String?
  isPrimary Boolean @default(false)

  @@index([contactId])
}

// ============================================================================
// CRM — WARP-2117
//
// Built, not adopted: every mature open-source CRM is AGPL-3 on purpose and
// shipping the appliance is conveyance, so copyleft attaches (see WARP-2113 /
// ADR-041 for the licence argument). Structure informed by Atomic CRM
// (Marmelab, MIT) as a reference model; zero AGPL-derived code.
//
// This is deliberately THIN. It owns companies, deals, a configurable
// pipeline and a timeline — and it reuses the box's existing primitives for
// everything else: `Contact` above for people, `Note` / `EmailMessage` /
// `CalendarEvent` / `PmWorkItem` for timeline content, the files+RAG path for
// attachments, and `PmProject` for the work that delivers a won deal.
// ============================================================================

/// Where a CRM row came from. Explicit for the same reason `ContactOrigin` is.
enum CrmRecordOrigin {
  LOCAL
  EXTERNAL
  /// ADR-048 — created by Droplet from a document or an email, then applied by
  /// a human (or by an owner-promoted auto-apply class). Behaves like LOCAL:
  /// the shipped `*_provenance_complete` CHECK's first arm carries NO origin
  /// predicate, so an EXTRACTED row with all-NULL provenance already passes,
  /// and the edit/delete guards key on `EXTERNAL` — so a person can correct an
  /// EXTRACTED draft freely, which is the whole point of not landing it as
  /// EXTERNAL under a fabricated connection.
  EXTRACTED
}

/// What reaching a stage MEANS. An explicit outcome class, never inferred from
/// a stage's position, its name, or the absence of a `closedAt` — a pipeline's
/// stages are owner-configurable, so position and name carry no guarantees.
enum CrmStageKind {
  OPEN
  WON
  LOST
}

/// Which record a timeline entry hangs off. Exactly one of the three id
/// columns on `CrmActivity` is non-NULL, enforced by a CHECK constraint in the
/// migration (Prisma cannot express it).
enum CrmActivitySubject {
  COMPANY
  CONTACT
  DEAL
}

/// The timeline vocabulary. `NOTE` / `EMAIL` / `MEETING` / `TASK` carry a
/// reference to the record that already holds the content; `STAGE_CHANGE`,
/// `CREATED` and `SYNCED` are audit events the CRM itself writes.
enum CrmActivityKind {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK
  STAGE_CHANGE
  CREATED
  SYNCED
}

model CrmCompany {
  id String @id @default(uuid())

  /// ADR-048 - the proposal that created this row, when Droplet filed it.
  /// Deliberately NOT referenced by any CHECK: it is `onDelete: SetNull`, and
  /// a SetNull FK inside a NOT-NULL CHECK makes the row un-deletable and the
  /// purge walker un-runnable.
  proposalId String?
  proposal   IngestProposal? @relation("CompanyFiledByProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  name String

  /// Primary web domain, lowercased on write. The natural dedupe key when a
  /// connector and a human both create the same account.
  domain String?

  industry String?
  phone    String?
  website  String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?

  note String?

  /// The person accountable for this account. A `User.id`, kept as a plain
  /// column (the house style for cross-surface owner references — cf.
  /// `PmProject.leadId`).
  ownerId String?

  origin         CrmRecordOrigin        @default(LOCAL)
  externalSystem String?
  externalId     String?
  /// WARP-2549 — WHICH connection landed this row. NOT NULL is impossible here
  /// (a locally typed row has no connection), but a landed row without one is
  /// forbidden by the `*_provenance_complete` CHECK below.
  ///
  /// 🔴 The vendor's id is scoped to the CONNECTION, not to the vendor. Two
  /// HubSpot portals both serve an object `123` and they are unrelated
  /// customers; keying provenance on `(externalSystem, externalId)` refused the
  /// second one forever as "already linked". WARP-2461's purge walker also keys
  /// on this column, and its own mutation test proves that scoping a purge by
  /// PROVIDER destroys the sibling connection's data.
  ///
  /// RESTRICT, deliberately not CASCADE: nothing deletes an
  /// `IntegrationConnection` today (`disconnect()` flips it to DISABLED and
  /// purges in place), so this fires only if something new starts deleting
  /// them — at which point the landed rows must be purged deliberately, by a
  /// walker that knows to keep what a human wrote against them.
  connectionId   String?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// Explicit archive flag — never derived from `archivedAt IS NOT NULL`
  /// (WARP-884). `archivedAt` is the audit timestamp only.
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contactLinks CrmCompanyContact[]
  deals        CrmDeal[]
  activities   CrmActivity[]
  /// WARP-2562 (ADR-044) — the work delivered for this customer, and this
  /// customer's records in upstream systems. With `deals` and `contactLinks`
  /// these are the four things the customer record reads.
  projects     PmProject[]
  partyLinks   PartyLink[]
  /// WARP-3528 — the tickets raised by this customer's people. SetNull on the
  /// ticket side: the conversation outlives the customer record.
  pmTickets    PmTicket[]

  /// WARP-2581 — money owed by or to this customer, when a document matched.
  documents ErpDocument[]
  /// WARP-2585 — files in /files that BELONG to this customer. Pointers, not
  /// copies; deleting the company deletes the links and none of the files.
  fileLinks EntityLink[]

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([name])
  @@index([domain])
  @@index([ownerId, isArchived])
  @@index([proposalId])
}

/// WARP-2562 (ADR-044) — how a link came to exist. An explicit column, never
/// inferred from `confidence IS NULL`: the same rule that made `origin` and
/// `isArchived` real columns under WARP-884, and for the same reason — a
/// reader must not have to work out which flavour of null they are holding.
enum PartyLinkOrigin {
  /// A human said these are the same customer.
  MANUAL
  /// A matcher proposed it and someone accepted. Carries a `confidence`.
  MATCHED
  /// Asserted by an upstream that already knew the correspondence.
  IMPORTED
}

/// Joins a party this box owns — a `Contact` or a `CrmCompany` — to a record
/// in an upstream system, WITHOUT copying that record in.
///
/// The ERP stays the system of record. This row is a POINTER: a provider key
/// and an opaque id, holding no PHI of its own. Detail is fetched live through
/// the existing connector, under the existing PHI gate.
///
/// 🔴 Why this is not `Contact.externalSystem` / `externalId`, which already
/// exist and already carry a provider and an id:
///
/// That pair is `@@unique` ON THE PARTY, so it models PROVENANCE — one
/// upstream owns this row, and a re-sync updates rather than duplicates. It
/// cannot model CORRESPONDENCE: this person is a HubSpot contact AND patient
/// #4471 in Eaglesoft AND customer cus_9f2 in Stripe. A customer is routinely
/// all three. Overloading the pair would force a choice of which connector
/// "owns" a customer, which is the wrong question — and the wrong answer would
/// be re-litigated by every connector added after it.
///
/// 🔴 ADR-044 §3 — a row here is created ONLY by an explicit act: a human
/// links a customer, or a proposed match is accepted. ERP patients are never
/// projected into `Contact` (PHI spill: the address book has no `canViewPhi`
/// gate, is reachable by `family`, and is readable by the local model through
/// the `contacts` tool domain). Do not add a sync that writes these in bulk
/// without re-reading that section.
model PartyLink {
  id String @id @default(uuid())

  /// Exactly one of the two is set. Prisma cannot express an XOR, so the real
  /// guard is the CHECK constraint `PartyLink_party_exactly_one` in the
  /// migration; the service's own check is the friendly error, not the
  /// invariant. `party-link.pg.test.ts` proves the database half — a mocked
  /// Prisma cannot, which is why that file carries the `.pg.` infix.
  contactId String?
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 🔴 The CONNECTION the upstream id belongs to — not merely the provider.
  ///
  /// A business can connect two HubSpot portals, and `externalSystem` alone
  /// cannot tell them apart. Two consequences, both real:
  ///
  ///   • HubSpot object ids are PORTAL-scoped, so portal A's object `123` and
  ///     portal B's object `123` are different records that collide under a
  ///     `(externalSystem, externalId)` unique. The second portal's link is
  ///     refused as "already linked" to someone else's customer.
  ///   • WARP-2461's purge walker is NOT WRITTEN YET, and this column is what
  ///     will let it be written correctly: it must key on `connectionId`,
  ///     because scoping a purge by PROVIDER would destroy the sibling
  ///     connection's data. A link table with no `connectionId` could not be
  ///     purged correctly at all — disconnecting one portal would take the
  ///     other's links with it. Whoever writes that walker should pin this
  ///     with a mutation test, the way `crm-activity-cascade.pg.test.ts`
  ///     already pins the cascade it will have to reckon with.
  ///
  /// `Restrict`, not `Cascade`: a connection row is never deleted (disconnect
  /// flips it to DISABLED and purges its secrets in place), so this can only
  /// fire if something new starts deleting them — and when that happens the
  /// landed links must be purged deliberately, not swept away by a foreign
  /// key. Cascade here would silently delete a human's confirmed matches.
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// Verbatim `IntegrationConnection.provider` — free TEXT, deliberately not
  /// an enum or a catalog id. `eaglesoft-api` and `quickbooks-online` are
  /// provider keys, not catalog ids, and typing this as a `ConnectorId` is the
  /// lie that broke the hub's join in WARP-2291. A new upstream needs no
  /// migration, exactly as `IntegrationConnection.provider` intends.
  ///
  /// DERIVED from `connection.provider` on write, never accepted from the
  /// caller. It is denormalised so a link can be read and displayed without a
  /// join; taking it from the request body instead would let a link claim a
  /// provider its own connection contradicts, and nothing downstream could
  /// tell which half was true.
  externalSystem String
  /// The upstream's own key — an Eaglesoft chart number, a Stripe customer id.
  externalId     String

  linkedBy   PartyLinkOrigin @default(MANUAL)
  /// 0-100, and only meaningful for `MATCHED`. A confidence on a link a human
  /// made by hand is a number nobody computed.
  confidence Int?

  /// WARP-884 shape. Unlinking is reversible and auditable rather than a hard
  /// delete — "these were never the same customer" is a claim worth keeping.
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  /// 🔴 One LIVE upstream claim per record — and the unique that enforces it
  /// is NOT on this model. It is a PARTIAL index and Prisma has no datamodel
  /// syntax for one, so it lives in
  /// `20260903010000_warp_2562_party_link_archive_scope`:
  ///
  ///     CREATE UNIQUE INDEX "PartyLink_connectionId_externalId_active_key"
  ///       ON "PartyLink" ("connectionId", "externalId")
  ///       WHERE "isArchived" = false;
  ///
  /// Two LIVE links to the same record — even from different parties — is a
  /// contradiction, not a second opinion, and surfaces as a 409. Two ARCHIVED
  /// ones are a history: an archived row is the record that a claim was
  /// WITHDRAWN, and an index that kept asserting over withdrawn rows made
  /// archiving a trap. It held the record forever, so the correct party could
  /// never be linked and the only recovery restored the wrong link.
  ///
  /// Scoped by CONNECTION, not by provider: "the same record" means the same
  /// id in the same portal. Under the old `(externalSystem, externalId)` key a
  /// second HubSpot portal's object `123` was a contradiction with the first
  /// portal's object `123`, which is two different customers.
  ///
  /// Consequence worth knowing before you re-add `@@unique` here: without a
  /// compound unique on the model there is no
  /// `partyLink.findUnique({ where: { connectionId_externalId } })`, and that
  /// is the point. That call cannot mention `isArchived`, so it cannot ask the
  /// question the index now answers. `party-link.service.ts` uses `findFirst`
  /// with an explicit `isArchived: false`.
  @@index([contactId])
  @@index([companyId])
  /// The purge walker's index (WARP-2461): "everything this connection landed".
  @@index([connectionId])
}

/// Company↔Contact as a link table rather than a foreign key on `Contact`:
/// people change jobs, and a person can legitimately be reachable at two
/// organizations at once. Deleting either side deletes only the link.
model CrmCompanyContact {
  id String @id @default(uuid())

  companyId String
  company   CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Role at THIS company, which may differ from the contact's own jobTitle.
  title     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([companyId, contactId])
  @@index([contactId])
}

/// A named pipeline. Owner-configurable and plural from day one, because a
/// business that sells two things sells them through two processes.
model CrmPipeline {
  id String @id @default(uuid())

  name String

  /// Exactly one pipeline is the default new deals land in. Enforced by a
  /// partial unique index in the migration.
  /// WARP-2549 — the connection whose deals land into this pipeline, when it is
  /// a synced one. UNIQUE: a connection gets exactly one pipeline, created on
  /// its first landed deal.
  ///
  /// A vendor's stages are not the owner's stages. Landing HubSpot deals into
  /// the owner's own pipeline would either invent a mapping between two sets of
  /// stage names nobody reconciled, or dump every synced deal into whichever
  /// stage happened to sort first. A pipeline of its own keeps the owner's
  /// board theirs and makes the purge scope obvious.
  connectionId String?                @unique
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  isDefault Boolean @default(false)

  sortOrder Int @default(0)

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages CrmPipelineStage[]
  deals  CrmDeal[]

  @@index([isArchived, sortOrder])
}

model CrmPipelineStage {
  id String @id @default(uuid())

  pipelineId String
  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name String

  /// Explicit ordering column. The board renders by this, never by insertion
  /// order or by name.
  sortOrder Int

  /// What landing here means for the deal. Owner-configurable stage NAMES,
  /// fixed outcome SEMANTICS.
  kind        CrmStageKind @default(OPEN)
  /// WARP-2549 — the vendor's own value for this stage (HubSpot `dealstage`),
  /// on a synced pipeline. The reconcile key: stage NAMES are owner-editable
  /// and re-landing must not create a second stage because someone renamed one.
  externalKey String?

  /// Optional forecast weighting, 0-100. Advisory only — nothing derives an
  /// outcome from it.
  probability Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals CrmDeal[]

  @@unique([pipelineId, sortOrder])
  @@unique([pipelineId, externalKey])
  @@index([pipelineId, kind])
}

model CrmDeal {
  id String @id @default(uuid())

  title String

  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  pipelineId String
  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)

  stageId String
  stage   CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  /// Minor units (cents), never a float — money in a binary fraction is how
  /// pipelines stop adding up.
  amountMinor BigInt?

  /// ISO-4217. NULL only when `amountMinor` is NULL.
  currency String?

  expectedCloseOn DateTime?

  /// Audit timestamp of when the deal reached a WON/LOST stage. The OUTCOME
  /// lives in `stage.kind`; this is only when it happened.
  closedAt DateTime?

  /// Free-text reason, typically for a LOST deal.
  closeReason String?

  ownerId String?

  /// WARP-2117: a won deal becomes the job that delivers it. SetNull because
  /// deleting the project must not delete the commercial record of the sale.
  projectId String?
  project   PmProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  origin         CrmRecordOrigin        @default(LOCAL)
  externalSystem String?
  externalId     String?
  /// WARP-2549 — WHICH connection landed this row. NOT NULL is impossible here
  /// (a locally typed row has no connection), but a landed row without one is
  /// forbidden by the `*_provenance_complete` CHECK below.
  ///
  /// 🔴 The vendor's id is scoped to the CONNECTION, not to the vendor. Two
  /// HubSpot portals both serve an object `123` and they are unrelated
  /// customers; keying provenance on `(externalSystem, externalId)` refused the
  /// second one forever as "already linked". WARP-2461's purge walker also keys
  /// on this column, and its own mutation test proves that scoping a purge by
  /// PROVIDER destroys the sibling connection's data.
  ///
  /// RESTRICT, deliberately not CASCADE: nothing deletes an
  /// `IntegrationConnection` today (`disconnect()` flips it to DISABLED and
  /// purges in place), so this fires only if something new starts deleting
  /// them — at which point the landed rows must be purged deliberately, by a
  /// walker that knows to keep what a human wrote against them.
  connectionId   String?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contactLinks CrmDealContact[]
  activities   CrmActivity[]
  /// WARP-2585 — the quote, the contract, the signed order for THIS deal.
  fileLinks    EntityLink[]

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([pipelineId, stageId])
  @@index([stageId])
  @@index([companyId])
  @@index([ownerId, isArchived])
  @@index([expectedCloseOn])
  // WARP-2577 — `projectId` is ON DELETE SET NULL and Postgres does not
  // auto-index a foreign key column, so deleting a project had to seq-scan
  // this table to find the deals it must null. Same hazard WARP-845 documents
  // and indexes on its own relation; this one was missed.
  @@index([projectId])
}

model CrmDealContact {
  id String @id @default(uuid())

  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Their part in THIS deal — "economic buyer", "champion", "blocker".
  role String?

  createdAt DateTime @default(now())

  @@unique([dealId, contactId])
  @@index([contactId])
}

/// The timeline unit, and the thing the local model reads when asked about a
/// customer. It REFERENCES the record that holds the content rather than
/// copying it — a note stays one note, an email stays one email.
model CrmActivity {
  id String @id @default(uuid())

  /// Which of the three subject columns below is populated. Explicit, so a
  /// query can filter without three IS-NULL tests, and so the CHECK constraint
  /// has something to check against.
  subjectType CrmActivitySubject

  /// 🔴 WARP-2554 — READ THIS BEFORE WRITING ANY PURGE OR DELETE.
  ///
  /// All three subject relations are `onDelete: Cascade`, and they have to be:
  /// `CrmActivity_subject_exactly_one` forbids an orphan, so a subject column
  /// cannot be SetNull. The cascade is the only coherent behaviour.
  ///
  /// The consequence is NOT obvious and is the thing to know: deleting a
  /// subject destroys EVERY activity attached to it — including ones a human
  /// typed, whose own `origin` is LOCAL. So a purge written as
  /// `deleteMany({ where: { origin: "EXTERNAL" } })` on this table reads as
  /// though it spares the owner's notes and does not: deleting the synced
  /// parent has already taken them.
  ///
  /// If a purge must preserve locally-authored activity, it has to re-parent
  /// or export it BEFORE deleting the subject.
  /// `apps/orchestrator/src/__tests__/crm-activity-cascade.pg.test.ts` pins this
  /// for all three subject types against real Postgres, so the behaviour is met
  /// as an assertion rather than discovered in production. (The `.pg.` infix is
  /// load-bearing: a mocked Prisma cannot prove a database cascade, so the suite
  /// is RUN_PG_INTEGRATION-gated and runs in CI's pg-integration lane.)
  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  kind CrmActivityKind

  /// One line for the timeline. For a referenced record this is a caption
  /// (subject line, meeting title) — never a copy of the body.
  summary String

  /// Who did it. A `User.id`, or NULL when the box itself wrote the row.
  actorId String?

  /// When it HAPPENED (an email's sent time), which is not when the row was
  /// written (`createdAt`).
  occurredAt DateTime @default(now())

  // --- References to the primitives that already hold the content ----------
  // All nullable, all SetNull: deleting the underlying note or email must not
  // erase the fact that the interaction happened, and must not leave a
  // dangling id behind either.

  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)

  emailMessageId String?
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  calendarEventId String?
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  workItemId String?
  workItem   PmWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  // --- STAGE_CHANGE detail -------------------------------------------------

  fromStageId String?
  toStageId   String?

  origin         CrmRecordOrigin @default(LOCAL)
  externalSystem String?
  externalId     String?

  /// WARP-2587 — the notify claim (see PmActivity for why it is an enum and
  /// not an IS-NULL over `notifiedAt`). Only a STAGE_CHANGE whose destination
  /// stage has kind WON or LOST is ever notified; every other row reaches
  /// `not_needed` on its first sweep, so a connector backfill of 10,000
  /// SYNCED rows drains to terminal instead of being rescanned forever.
  notifyStatus NotifyStatus @default(pending)
  notifiedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([externalSystem, externalId])
  @@index([dealId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([kind, occurredAt])
  // WARP-2577 — the four reference columns are ON DELETE SET NULL, and
  // Postgres does not auto-index a foreign key. Unindexed, deleting one note,
  // email, calendar event or work item seq-scanned this whole table to find
  // the rows to null — on the timeline table, which is the largest one here.
  // The subject columns above are already covered by their composite indexes;
  // these four were not covered by anything.
  @@index([noteId])
  @@index([emailMessageId])
  @@index([calendarEventId])
  @@index([workItemId])
  /// createdAt, NOT occurredAt — unlike every index above it. `occurredAt` is
  /// when the interaction HAPPENED and is caller-supplied: a connector
  /// backdates it and a MEETING can carry a future one, and a sweep gated on a
  /// future occurredAt would leave that row pending forever. `createdAt` is
  /// the row-write clock and is monotone.
  @@index([notifyStatus, createdAt])
}

// ============================================================================
// WARP-2585 (ADR-045 slice 6) — a file belongs to a business record.
// ============================================================================

/// Which record a file link hangs off. Exactly one of the five id columns on
/// `EntityLink` is non-NULL, and this names WHICH — an explicit discriminator,
/// never five IS-NULL tests (CLAUDE.md "No guessing, ever"). Agreement between
/// the two is enforced by a CHECK constraint in the migration; Prisma cannot
/// express it. Mirrors `CrmActivitySubject`.
enum EntityLinkSubject {
  COMPANY
  CONTACT
  DEAL
  PROJECT
  WORK_ITEM
}

/// WHY this file is attached — a closed vocabulary the customer record groups
/// documents by, and the thing an extractor classifies into. Explicit, never
/// guessed from a filename or a MIME type.
enum EntityLinkRole {
  CONTRACT
  INVOICE
  QUOTE
  SCAN
  CORRESPONDENCE
  OTHER
}

/// HOW the link was made. `MANUAL` is a human's act and carries no confidence —
/// a score on a link somebody made by hand is a number nobody computed.
/// `SUGGESTED` (a matcher proposed it) and `EXTRACTED` (a document extractor
/// found the reference) both require one, so a review queue can rank and
/// threshold. The all-or-nothing pairing is a CHECK in the migration, the same
/// shape as `CrmDeal_amount_needs_currency`.
enum EntityLinkOrigin {
  MANUAL
  SUGGESTED
  EXTRACTED
}

/// A file in /files, related to a business record.
///
/// NOT an upload. `PmAttachment` COPIES bytes onto a work item under its own
/// `storageKey @unique`; this is a POINTER and the two coexist. A link grants
/// no byte access — /files re-runs its own gate on every read.
///
/// Keyed on `ncFileId` (oc:fileid, resolved via `ncGetFileId`) because
/// `FileComment`'s docstring already adjudicated the three incompatible file
/// identities this box ships: oc:fileid SURVIVES a rename/move and
/// `FileCitation.filePath` does not. `fileName`/`filePath`/`fileSpace` are a
/// DISPLAY CACHE only (the `TeamChatMessage.sharedFile*` precedent), so a link
/// whose file was later deleted in Nextcloud renders as a name a human can act
/// on instead of a bare integer.
///
/// THERE IS NO FK TO `File`, AND THERE CANNOT BE. The registry is deliberately
/// incomplete — `upsertFileRegistryEntry` never throws, and an absent row is a
/// supported state every metadata route branches on — so an FK would reject a
/// link to any unregistered file, which is most of them. A dangling link is a
/// state this table tolerates and the UI shows. No column pretends to track it:
/// a `fileState` nothing maintains is a column that always lies.
///
/// IDOR: `createdById` is the LOCAL `User.id` UUID (`req.user.id`), NEVER the
/// Nextcloud username. FileComment records the real bug from storing one and
/// filtering on the other. Here it is PROVENANCE ONLY and gates nothing — the
/// `FileTag.addedByUserId` posture, because a link is business-shared like
/// every other CRM row.
///
/// VISIBILITY is the question a link raises that a comment does not: the row
/// carries a file NAME, so an unfiltered listing tells a reader that a file
/// they cannot open exists. `entity-link.service.ts` drops rows whose file is
/// registered to a department the viewer cannot read, using the same
/// registry+space composition `routes/files.ts` and `routes/team-chat.ts` run.
///
/// Uniqueness is FIVE PARTIAL unique indexes in the migration, one per subject
/// column — deliberately NOT a compound `@@unique` over all five. Four of the
/// five are NULL on every row and NULL never equals NULL, so a compound index
/// would reject nothing and P2002 would never fire. Because Prisma cannot
/// address a partial index, the write path is updateMany-then-create with a
/// P2002 retry.
model EntityLink {
  id String @id @default(uuid())

  /// oc:fileid — survives rename/move. Resolve via `ncGetFileId`.
  ncFileId Int

  /// Display cache, refreshed on every re-link. Derived from `filePath`
  /// server-side, never accepted as client prose.
  fileName String
  filePath String

  /// WARP-1898 — the Files space `filePath` is relative to ("personal" |
  /// "shared" | "dept:<uuid>"). Without it a reader's link falls through to
  /// /files' silent personal-space default and resolves the LINKER's path
  /// inside the READER's namespace. Registry-derived where a row exists.
  fileSpace String

  /// Which of the five columns below is populated. Explicit, so a query can
  /// filter without five IS-NULL tests and the CHECK has something to check.
  subjectType EntityLinkSubject

  /// All five Cascade, and they have to be: `EntityLink_subject_exactly_one`
  /// forbids an orphan, so a subject column cannot be SetNull. Deleting the
  /// record deletes its links — it does NOT delete the files.
  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  projectId String?
  project   PmProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workItemId String?
  workItem   PmWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  role     EntityLinkRole   @default(OTHER)
  linkedBy EntityLinkOrigin @default(MANUAL)

  /// 0–100, and meaningful ONLY when `linkedBy` is not MANUAL. Integer, not a
  /// float, mirroring `CrmPipelineStage.probability`.
  confidence Int?

  note String?

  /// Explicit archive flag — never derived from `archivedAt IS NOT NULL`
  /// (WARP-884). `archivedAt` is the audit timestamp only.
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  /// LOCAL `User.id` UUID. Provenance; it does NOT gate reads.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The subject column LEADS each composite, so one index serves both the
  /// CASCADE delete (Postgres does not index an FK for you — WARP-845, and
  /// `crm.service.ts` shipped five unindexed) and the "unarchived documents on
  /// this record" listing.
  @@index([ncFileId])
  @@index([companyId, isArchived])
  @@index([contactId, isArchived])
  @@index([dealId, isArchived])
  @@index([projectId, isArchived])
  @@index([workItemId, isArchived])
}

/// WARP-2426 (ADR-043 §2, ADR-056 I4) — the operator-owned classification
/// record for a tool this box did not author: a remote MCP server's today, a
/// desktop-hosted server's or a customer extension's tomorrow.
///
/// One row per (server, wire tool name), written by exactly ONE import path
/// (`remote-tool-classification.service.ts` `recordDiscoveredRemoteTools`),
/// and every row that path creates is a CONFIRMING WRITE — `requiresWrite`
/// and `requiresConfirmation` both true — whatever the wire says the tool is.
/// A server can declare `search_issues` with `readOnlyHint: true` and thereby
/// choose its own privilege level; this row is what refuses to let it. The
/// default costs a click, never data.
///
/// Demoting a tool (to a read, or to blocked) is a person's act: `reviewedBy`
/// and `reviewedAt` are set by the owner route and nothing else. A row with
/// no reviewer is the import default and reads as one. `denied` is explicit
/// state, never inferred from a missing row — a missing row means "never
/// seen", which the call policy refuses with its own code.
///
/// `wireDescription` is recorded for the operator's eyes and is never read as
/// truth by any policy (ADR-043 §2: the wire's annotations are not read).
model RemoteToolClassification {
  id                   String    @id @default(uuid())
  serverId             String
  toolName             String
  requiresWrite        Boolean   @default(true)
  requiresConfirmation Boolean   @default(true)
  denied               Boolean   @default(false)
  reviewedBy           String?
  reviewedAt           DateTime?
  wireDescription      String?
  /// WARP-2900: sha256 of the tool's canonical inputSchema when it was last
  /// discovered. A re-discovery with the same name and hash keeps the
  /// reviewed classification; a changed hash resets it (H3).
  inputSchemaHash      String?
  firstSeenAt          DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())

  @@unique([serverId, toolName])
  @@index([serverId])
}

/// WARP-2251 — morning briefing: one agent-written day plan per user per
/// box-local day. Self-only: every read is scoped by `userId` (decision 2,
/// 2026-08-27). Status is an explicit enum (CLAUDE.md "No guessing"): never
/// derive readiness from `body IS NOT NULL` or failure from `endedAt IS NULL`.
/// `body` is NOT encrypted at rest in v1 (decision 1); 30-day retention.
model MorningBriefing {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Box-local calendar date the briefing is FOR (not when it ran).
  forDate       DateTime            @db.Date
  status        BriefingStatus      @default(pending)
  skipReason    String?
  failureReason String?
  headline      String?
  vibe          BriefingVibe?
  /// The validated output contract (WARP-2248). Null until status = ready.
  body          Json?
  /// Tool names actually called, from the agent trace.
  sources       Json?
  model         String?
  iterations    Int?
  artKind       BriefingArtKind     @default(ascii)
  photoStatus   BriefingPhotoStatus @default(none)
  /// "<YYYY-MM-DD>/<theme>/<pexelsId>" (WARP-2263); null when no photo.
  photoRef      String?
  triggeredBy   BriefingTrigger     @default(scheduler)
  startedAt     DateTime?
  endedAt       DateTime?
  readAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, forDate])
  @@index([userId, forDate(sort: Desc)])
  @@index([status, forDate])
}

enum BriefingStatus {
  pending
  running
  ready
  failed
  skipped
}

enum BriefingVibe {
  calm
  focused
  busy
  urgent
  celebratory
  quiet
  stormy
  fresh
}

enum BriefingArtKind {
  ascii
  svg
  photo
}

enum BriefingPhotoStatus {
  none
  fetched
  fetch_failed
  disabled
}

enum BriefingTrigger {
  scheduler
  user
}
