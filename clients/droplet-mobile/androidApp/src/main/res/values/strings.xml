    <!-- Welcome -->
    <string name="welcome_title">Pair your Droplet</string>
    <string name="welcome_subtitle">Connect this device to your home Droplet to access your files, photos, and chats — all stored on your hardware.</string>
    <string name="welcome_step_scan">Scan the QR code on your dashboard</string>
    <string name="welcome_step_secure">Sign in once — credentials never leave the device</string>
    <string name="welcome_step_local">Talks directly to your Droplet over your network</string>
    <string name="welcome_cta">Pair with Droplet</string>

    <!-- Scan -->
    <string name="scan_hint">Point at the pair QR on your Droplet dashboard</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_try_again">Try again</string>

    <!-- Permission -->
    <string name="permission_camera_title">Camera access</string>
    <string name="permission_camera_body">Droplet uses the camera only to read the pair QR. Frames are processed on-device and never uploaded.</string>
    <string name="permission_camera_rationale">Droplet still needs camera access to read the pair QR. Open system settings to grant access if the prompt no longer appears.</string>
    <string name="permission_grant">Grant access</string>

