// Droplet iOS client — Xcode brand configuration.
//
// Import this into the project's Debug and Release xcconfig files to
// override the Nextcloud defaults.

PRODUCT_BUNDLE_IDENTIFIER = com.droplet.ios
PRODUCT_NAME = Droplet
MARKETING_VERSION = 1.0.0

// URL scheme for pairing flow
DROPLET_URL_SCHEME = droplet

// Default server (pre-filled in the account wizard)
DROPLET_DEFAULT_SERVER = https://droplet.local/nextcloud
