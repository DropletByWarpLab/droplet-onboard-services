# ───────────────────────────────────────────────────────────────────
# Droplet dev stack — environment defaults.
#
# Copy this to the REPO ROOT as `.env` (NOT into docker/dev/):
#
#   cp docker/dev/.env.example .env
#
# docker compose -f docker/docker-compose.dev.yml automatically reads
# the .env file in the directory you invoke compose from. Run compose
# from the repo root.
#
# These are DEV-ONLY secrets — they have "dev" in the name on purpose
# to make them visually obvious in a tcpdump trace. Never let them
# leak into a production deploy.
# ───────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=droplet
POSTGRES_PASSWORD=dropletdev

# Nextcloud admin (created on first boot of the nextcloud container)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=dropletdev

# Orchestrator JWT signing secrets. The orchestrator refuses to start
# without these — empty values mean rejecting every login attempt.
JWT_SECRET=dev-only-jwt-secret-do-not-ship-replace-on-prod-32-chars-min
DEVICE_SECRET=dev-only-device-secret-do-not-ship-replace-on-prod-32-chars

# Seed the database with 2 users / 5 cameras / 3 matter / 10 files /
# 3 conversations on first boot. Set to 0 to skip.
DROPLET_DEV_SEED=1
