# ───────────────────────────────────────────────────────────────────
# Droplet dev stack — environment defaults.
#
# Copy this to the REPO ROOT as `.env` (NOT into docker/dev/):
#
#   cp docker/dev/.env.example .env
#
# Compose looks for .env in the PROJECT directory — which for
# `-f docker/docker-compose.dev.yml` is docker/, NOT your shell's cwd —
# so pass it explicitly from the repo root:
#
#   docker compose --env-file .env -f docker/docker-compose.dev.yml up
#
# These are DEV-ONLY secrets — they have "dev" in the name on purpose
# to make them visually obvious in a tcpdump trace. Never let them
# leak into a production deploy.
# ───────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=droplet
POSTGRES_PASSWORD=dropletdev

# Nextcloud admin (created on first boot of the nextcloud container)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=dropletdev

# Orchestrator JWT signing secrets. The orchestrator refuses to start
# without these — empty values mean rejecting every login attempt.
JWT_SECRET=dev-only-jwt-secret-do-not-ship-replace-on-prod-32-chars-min
DEVICE_SECRET=dev-only-device-secret-do-not-ship-replace-on-prod-32-chars

# Seed the database with 2 users / 5 cameras / 3 matter / 10 files /
# 3 conversations on first boot. Set to 0 to skip.
DROPLET_DEV_SEED=1

# ── The dev account (WARP-2844) ────────────────────────────────────
# Set this and the seed creates dev@warp-lab.ai as the box owner on first
# boot, with every module switched on — so you can walk the whole app
# without a Droplet attached and without touching the setup wizard.
#
# There is NO DEFAULT, on purpose: a tracked default password on an
# owner-role account would be a backdoor. Leave it unset and the seed
# skips the account and tells you why; you can still walk the wizard.
#
# Must satisfy the product's own policy — 12-128 characters, at least 3 of
# {lowercase, uppercase, digit, symbol} — or the seed refuses it, because
# an account seeded below that bar could not later change its password.
#
# The seed also refuses when NODE_ENV=production and whenever an owner
# already exists, so it can never take over a real box or overwrite an
# existing owner. Sign in with the EMAIL, not the username.
DROPLET_DEV_OWNER_PASSWORD=

# First-run claim code override (claim-code.service.ts provisioning hook).
# On the box the minted code renders on the lid display; the dev stack has
# no display, so set a known code to make the wizard's Claim step walkable.
# Unambiguous alphabet only (no 0/O/1/I). Leave unset to mint randomly.
CLAIM_CODE=DRPL7K2Q9F4M
