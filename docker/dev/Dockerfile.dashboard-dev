# Dev image for the web-dashboard. Runs `next dev -p 3001` against a
# bind-mounted workspace so .tsx edits on Windows hot-reload in the
# browser. Production uses apps/web-dashboard/Dockerfile (standalone
# Next.js build); this image is dev-only.
#
# WHY bookworm-slim (not alpine): consistent with the orchestrator
# image + native modules (sharp, in particular, has had alpine
# trouble historically).

FROM node:20-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl ca-certificates tini && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/apps/web-dashboard

# Windows host bind-mount + Linux container = inotify doesn't fire
# reliably. Polling is slower (CPU + battery) but predictable.
# Next.js 14 picks up both names. CHOKIDAR is what Webpack 5 uses;
# WATCHPACK is the dev-server's own watcher.
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_INTERVAL=500

# Next.js telemetry off in dev — drops a noisy line on first boot
# and CI doesn't care.
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "/workspace/docker/dev/entrypoint-dashboard.sh"]
