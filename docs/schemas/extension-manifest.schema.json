{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:droplet:extension-manifest:1",
  "title": "Droplet extension manifest (schemaVersion 1)",
  "description": "WARP-2900 / ADR-056 slice H. Language-neutral mirror of extensionManifestSchema in apps/orchestrator/src/services/extension-manifest.ts. Strict: every object refuses keys it does not name, except a tool's inputSchema and a routine draft's steps, which are open JSON Schema / ToolSpec documents. Duplicate tool names and duplicate routine slugs are refused by parseExtensionManifest, which JSON Schema cannot express. A drift test runs one corpus through both.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "kind",
    "runtime",
    "provides",
    "resources",
    "egress"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "extension",
        "app"
      ]
    },
    "runtime": {
      "enum": [
        "node20",
        "python312",
        "static"
      ]
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(\\/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "routineDrafts",
        "proposedGrants"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/tool"
          }
        },
        "routineDrafts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/routineDraft"
          }
        },
        "proposedGrants": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/proposedGrant"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryMb",
        "processes"
      ],
      "properties": {
        "memoryMb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "processes": {
          "const": 1
        }
      }
    },
    "egress": {
      "const": "none"
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health"
      ],
      "properties": {
        "health": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?!.*\\.\\.)/[A-Za-z0-9._~/-]*$"
        },
        "dir": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?!.*\\.\\.)(\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*)$"
        },
        "spa": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "inputSchema",
        "export",
        "classificationProposal"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "classificationProposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requiresWrite",
            "requiresConfirmation"
          ],
          "properties": {
            "requiresWrite": {
              "type": "boolean"
            },
            "requiresConfirmation": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "routineDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "steps"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "proposedGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "domain"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:-]{0,63}$"
        },
        "level": {
          "enum": [
            "view",
            "use"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "app"
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "http"
        ],
        "properties": {
          "provides": {
            "properties": {
              "tools": {
                "maxItems": 0,
                "type": "array"
              }
            },
            "type": "object"
          },
          "http": {}
        },
        "type": "object"
      },
      "else": {
        "not": {
          "required": [
            "http"
          ],
          "properties": {
            "http": {}
          },
          "type": "object"
        },
        "properties": {
          "provides": {
            "properties": {
              "tools": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "static"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "kind": {
            "const": "app"
          },
          "http": {
            "required": [
              "dir"
            ],
            "properties": {
              "dir": {}
            },
            "type": "object"
          }
        },
        "not": {
          "required": [
            "entrypoint"
          ],
          "properties": {
            "entrypoint": {}
          },
          "type": "object"
        },
        "type": "object"
      },
      "else": {
        "required": [
          "entrypoint"
        ],
        "properties": {
          "http": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "dir"
                  ],
                  "properties": {
                    "dir": {}
                  },
                  "type": "object"
                },
                {
                  "required": [
                    "spa"
                  ],
                  "properties": {
                    "spa": {}
                  },
                  "type": "object"
                }
              ]
            }
          },
          "entrypoint": {}
        },
        "type": "object"
      }
    }
  ]
}
