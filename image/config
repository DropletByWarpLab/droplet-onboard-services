# =============================================================================
# pi-gen config — Droplet appliance OS image (app box)
# =============================================================================
# Checked-in, templated pi-gen config. scripts/build-image.sh copies this into
# the cloned pi-gen tree and appends DROPLET_IMAGE_RELEASE_REF at build time.
#
# TOPOLOGY: this is the APP appliance half of the DUAL-IMAGE topology
# (cite ADR-005 canonical-system-architecture; docs/SINGLE_BOX.md multi-box).
# The OpenWrt ROUTER image is built separately by openwrt/build.sh.
#
# SECURITY: NO baked credentials. No FIRST_USER_PASSWORD, no STAGE_LIST entry
# that creates a default login. SSH is key-only. All device-unique secrets are
# generated on FIRST BOOT by scripts/setup.sh (scripts/lib/secrets.sh) — never
# baked into the tracked image. This mirrors the OpenWrt 99-droplet-setup
# first-boot credential-generation precedent.
# =============================================================================

# --- Image identity ---
IMG_NAME="droplet-appliance"
TARGET_HOSTNAME="droplet"

# --- Release / arch — Bookworm arm64 Lite ---
RELEASE="bookworm"
# arm64 (64-bit). PostgreSQL 16 Alpine + Node 20 in the stack require aarch64;
# scripts/lib/preflight.sh rejects 32-bit ARM, so we never build armhf.
ARCH="arm64"

# --- Stage trimming: Lite only (stage0..stage2), then our custom stage ---
# stage0 = bootstrap, stage1 = truly minimal, stage2 = Lite (the Lite image).
# stage3..stage5 (desktop / full) are skipped by build-image.sh (SKIP markers).
# stage-droplet is our custom stage; its EXPORT_IMAGE marker produces the
# single deployable artifact.
STAGE_LIST="stage0 stage1 stage2 stage-droplet"

# --- Deploy as a gzipped .img (NOT a zip) ---
DEPLOY_COMPRESSION="gz"
DEPLOY_ZIP="0"
COMPRESSION_LEVEL="6"

# --- SSH: enabled but key-only. NO baked password. ---
ENABLE_SSH="1"
# PUBKEY_ONLY_SSH=1 disables password auth in sshd_config — the operator must
# supply an authorized key (PUBKEY_SSH_FIRST_USER) at build time or via the
# Pi Imager customization. We deliberately do NOT set FIRST_USER_PASSWORD.
PUBKEY_ONLY_SSH="1"

# --- First user: name only, NO password baked (security) ---
# pi-gen requires a first user account to exist; we name it but never bake a
# password. With PUBKEY_ONLY_SSH=1 and no password, remote login is key-only.
# The operator injects PUBKEY_SSH_FIRST_USER at build time (or uses Pi Imager's
# advanced options) — keys are operator-supplied, never committed here.
FIRST_USER_NAME="droplet"
# FIRST_USER_PASS intentionally unset — see SECURITY note above.

# --- Locale / keyboard (sane non-interactive defaults) ---
LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="Etc/UTC"

# --- Disable interactive prompts in the containerized build ---
WPA_ESSID=""
WPA_PASSWORD=""
WPA_COUNTRY=""
