[Unit]
# =============================================================================
# Droplet first-boot provisioning (oneshot)
# =============================================================================
# Runs scripts/setup.sh ONCE on the first boot of a freshly-flashed appliance
# image to generate device-unique secrets and bring the stack up. Explicit
# completion is gated by an explicit sentinel file (ConditionPathExists),
# mirroring the OpenWrt uci-defaults "run once then mark done" precedent and the
# repo's explicit-state convention (ADR-005-ap §"why an enum, not a derived
# flag"). NEVER derives "already done" from absence/ambiguity.
#
# This is the STATIC baked counterpart of
# scripts/lib/systemd.sh::install_firstboot_service — keep them in lockstep.
# =============================================================================
Description=Droplet Edge Platform — first-boot provisioning (oneshot)
Documentation=https://github.com/DropletByWarpLab/droplet-onboard-services
# Provision after the network and Docker are up so setup.sh can pull/build and
# bring the compose stack online.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Run before the steady-state stack unit so the .env / secrets exist first.
Before=droplet.service
# Explicit-completion guard: skip entirely once the sentinel exists.
ConditionPathExists=!/var/lib/droplet/.firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/droplet/edge-platform
# setup.sh is idempotent and installs droplet.service via --systemd. It
# generates ALL device-unique secrets on this first run (scripts/lib/secrets.sh)
# — nothing is baked into the image.
ExecStart=/opt/droplet/edge-platform/scripts/setup.sh --systemd
# Mark completion explicitly only on success (oneshot ExecStartPost runs after a
# successful ExecStart). A failed first boot leaves the sentinel absent so the
# next boot retries instead of silently skipping a half-provisioned device.
ExecStartPost=/usr/bin/touch /var/lib/droplet/.firstboot-done
# Generous timeout: first boot may pull a model / build images on the device if
# the build-time warm-up was skipped.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
