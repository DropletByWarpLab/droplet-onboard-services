# =============================================================================
# Droplet Network Configuration
# =============================================================================
# ETH0 (onboard BCM54213PE) -> WAN - picks up address via DHCP from upstream
# ETH1 (USB NIC: ASIX AX88179B or TP-Link UE306 / RTL8153B) -> LAN bridge
# LAN subnet:      192.168.50.1/24
# Cameras subnet:  192.168.100.1/24 via 802.1Q VLAN 100 tagged on eth1
# =============================================================================
#
# IMPORTANT: this file MUST be LF-terminated. A trailing CR is included in the
# UCI section-name token and the parser aborts with "invalid character in name
# field", which prevents br-lan from coming up (no LAN, no DHCP, no WiFi AP).
# The repo's openwrt/.gitattributes pins LF; do not override in your editor.
# =============================================================================

config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

# --- WAN: onboard Ethernet (eth0) --- DHCP from upstream router/ISP
config interface 'wan'
    option device 'eth0'
    option proto 'dhcp'
    option peerdns '1'
    option delegate '0'

config interface 'wan6'
    option device 'eth0'
    option proto 'dhcpv6'
    option reqaddress 'try'
    option reqprefix 'auto'

# --- LAN bridge: USB NIC (eth1) + WiFi ---
# Anonymous section: UCI in 24.10 rejects section names containing '-' (so
# `config device 'br-lan'` fails to parse). The bridge name is set via
# `option name`, which is what netifd and the kernel actually use.
config device
    option type 'bridge'
    option name 'br-lan'
    list ports 'eth1'
    option stp '0'

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '192.168.50.1'
    option netmask '255.255.255.0'
    option ip6assign '60'
    option delegate '0'

# --- Camera VLAN (isolated subnet for IP cameras) ---
# VLAN 100 carried as an 802.1Q sub-interface on eth1 directly (eth1.100).
# We deliberately do NOT use `config bridge-vlan` on br-lan here: netifd in
# 24.10 flips the bridge to vlan_filtering=1 but does not attach eth1 to
# VLAN 1 with PVID 1, so untagged LAN frames are dropped on ingress and the
# bridge shows RX=0. A plain sub-interface avoids the problem without
# losing VLAN isolation (the switch still tags/untags per port).
config interface 'cameras'
    option device 'eth1.100'
    option proto 'static'
    option ipaddr '192.168.100.1'
    option netmask '255.255.255.0'

# --- Globals ---
config globals 'globals'
    option ula_prefix 'fdb2:c4a0:de07::/48'
    option packet_steering '1'
