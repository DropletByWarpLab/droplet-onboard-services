# =============================================================================
# Droplet Wireless Configuration — MediaTek MT7922 (PCIe over FPC)
# =============================================================================
# Hardware swap from Intel BE200 to MT7922 in PR feat/openwrt-mt7922-support.
# The BE200 worked as a client but failed AP-mode ACS ("Unable to collect
# survey data") and was replaced. The MT7922 is dual-band (2.4 + 5 GHz),
# Wi-Fi 6, and works as an AP on the legacy multi-box router host *only* when:
#
#   1. A 32-bit-DMA device-tree overlay is loaded at boot on the router
#      host's SBC (forces 32-bit DMA addressing — without this the mt7921e
#      probe fails with -ENOMEM / error -12). See uci-defaults/99-droplet-setup.
#   2. The `mt7921e` driver is loaded with `disable_aspm=1` (avoids ASPM
#      L0s/L1 power-state-related probe stalls on the PCIe host bridge). See
#      etc/modules.d/mt7921e.
#   3. The `kmod-mt7921e` driver and `kmod-mt7922-firmware` blob are
#      installed (both baked into the legacy router image).
#
# Path string `axi/1000110000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0`
# is the FPC PCIe x1 slot on the router host's SBC (NOT the on-SoC I/O
# controller at 1000120000 — that's the SoC's own I/O hub and must not be
# touched here).
#
# NOTE: this overlay feeds the LEGACY multi-box bare-metal router image only.
# The single-box shape runs OpenWrt IN-CONTAINER (see openwrt/singlebox-image/)
# and does NOT consume this file; its wireless config is created at runtime.
#
# All radios are bridged into br-lan (192.168.50.0/24).
# =============================================================================

# --- 5 GHz — primary AP (Wi-Fi 6, channel 149, HE80) ---
#
# Channel 149 is UNII-3 in the US (5725-5850 MHz), no DFS, broad device
# support. iPhones / iPads connect cleanly with WPA2-only encryption
# (WPA3 transition mode caused association failures on older iOS).
#
# Known limitation: the chip's TX power on this build is currently capped
# at ~3 dBm by the firmware regardless of the in-kernel regdomain saying
# 30 dBm is allowed on this channel. Coverage is room-scale; long-range
# clients should use a downstream AP. Tracking as a follow-up — likely
# needs a newer mt76 driver via custom OpenWrt build.
config wifi-device 'radio3'
    option type 'mac80211'
    option path 'axi/1000110000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
    option band '5g'
    option channel '149'
    option htmode 'HE80'
    option country 'US'
    option cell_density '0'
    option noscan '1'
    option disabled '0'

config wifi-iface 'default_radio3'
    option device 'radio3'
    option network 'lan'
    option mode 'ap'
    option ssid 'Droplet-AI'
    option encryption 'psk2'
    option key 'ChangeMe!2024'
    option ieee80211w '0'
    option disabled '0'

# --- 2.4 GHz — disabled by default ---
#
# MT7922 supports simultaneous dual-band operation but enabling 2.4 GHz
# adds beacon airtime and IoT-device support overhead. Left disabled until
# the operator decides they want a 2.4 GHz AP (some legacy IoT devices
# can't see 5 GHz). To enable: `uci set wireless.radio3_2g.disabled=0;
# uci set wireless.default_radio3_2g.disabled=0; uci commit; wifi reload`.
config wifi-device 'radio3_2g'
    option type 'mac80211'
    option path 'axi/1000110000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
    option band '2g'
    option channel '6'
    option htmode 'HE40'
    option country 'US'
    option cell_density '0'
    option disabled '1'

config wifi-iface 'default_radio3_2g'
    option device 'radio3_2g'
    option network 'lan'
    option mode 'ap'
    option ssid 'Droplet-AI-2G'
    option encryption 'psk2'
    option key 'ChangeMe!2024'
    option ieee80211w '0'
    option disabled '1'

# --- Onboard SDIO radio — DISABLED ---
#
# The router host SBC's onboard SDIO Wi-Fi (brcmfmac) was the previous
# fallback AP while the BE200 was being debugged. Now that MT7922 is the
# production chip, the onboard radio is disabled to free CPU/memory and
# avoid SSID confusion. Re-enable by setting disabled=0 if the MT7922
# needs to be swapped out.
config wifi-device 'radio4'
    option type 'mac80211'
    option path 'platform/axi/1001100000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:1'
    option band '2g'
    option channel '6'
    option htmode 'HE40'
    option country 'US'
    option cell_density '0'
    option disabled '1'

config wifi-iface 'default_radio4'
    option device 'radio4'
    option network 'lan'
    option mode 'ap'
    option ssid 'Droplet-AI-Onboard'
    option encryption 'psk2'
    option key 'ChangeMe!2024'
    option ieee80211w '0'
    option disabled '1'

# =============================================================================
# ADR-024 Phase 4 — EasyMesh controller (prplMesh). DRAFT / UNVALIDATED:
# prplMesh's HAL targets Intel/Qualcomm, NOT mt76 — controller-only mode +
# hostapd Multi-AP fronthaul on mt76 needs real-hardware validation on the lab
# box before this ships. See docs/ADR-024 §2.
# =============================================================================
#
# Multi-AP FRONTHAUL BSS on the box's MT7922 5 GHz radio.
#
# `option multi_ap '1'` is the hostapd Multi-AP fronthaul flag — the
# nl80211/mac80211-SUPPORTED EasyMesh onboarding primitive (WPS-style M1/M2
# credential exchange happens over this BSS). mt76 IS an nl80211 driver, so
# this fronthaul flag is the part of Multi-AP that CAN run on our radio — the
# controller logic (1905.1 control plane, the part prplMesh's mt76-incompatible
# HAL would otherwise own) runs in prplMesh CONTROLLER-only userspace, not in
# the radio. The box is NEVER an EasyMesh RF agent (ADR-024 §2).
#
# multi_ap values: '1' = fronthaul (clients + onboarding; what we want on the
# box), '2' = backhaul, '3' = both. We want fronthaul on the box's own BSS so a
# certified third-party Agent can be onboarded through it.
#
# UNVALIDATED: that mt76 + this hostapd build honor `multi_ap '1'` cleanly, and
# that a real TP-Link EasyMesh Agent onboards over it, is the Phase-4 lab exit
# gate (ADR-024 §2 residual risk). This stanza is `disabled '1'` by default so
# it is INERT until that validation passes and EasyMesh is provisioned.
config wifi-iface 'droplet_easymesh_fh'
    option device 'radio3'
    option network 'lan'
    option mode 'ap'
    option ssid 'Droplet-AI'
    option encryption 'psk2'
    option key 'ChangeMe!2024'
    option ieee80211w '0'
    # hostapd Multi-AP fronthaul — the nl80211-supported onboarding primitive.
    option multi_ap '1'
    option disabled '1'
