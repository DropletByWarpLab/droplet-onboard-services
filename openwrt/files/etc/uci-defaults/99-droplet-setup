#!/bin/sh
# =============================================================================
# Droplet First-Boot Setup Script
# =============================================================================
# This script runs once on first boot and then deletes itself.
# It generates unique per-device credentials, configures the droplet-ai RPC
# user, enables services, and advertises the router via mDNS.
# =============================================================================

echo "Droplet: Running first-boot setup..."

# ---------------------------------------------------------------------------
# 1. Generate unique per-device root password
# ---------------------------------------------------------------------------
# Generate a random 16-char alphanumeric password for this device
ROOT_PASS=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 16)
echo "root:${ROOT_PASS}" | chpasswd

# Store the generated root password for initial access
echo "${ROOT_PASS}" > /etc/droplet/root-password
chmod 600 /etc/droplet/root-password

echo "Droplet: Root password generated. Retrieve from /etc/droplet/root-password"

# ---------------------------------------------------------------------------
# 2. Generate unique per-device droplet-ai RPC password
# ---------------------------------------------------------------------------
AI_PASS=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)
echo "${AI_PASS}" > /etc/droplet/droplet-ai-password
chmod 600 /etc/droplet/droplet-ai-password

# Create the droplet-ai system user so rpcd's $p$ PAM auth can verify
echo "droplet-ai:x:900:900:Droplet AI Agent:/var/empty:/bin/false" >> /etc/passwd
echo "droplet-ai:x:900:" >> /etc/group
echo "droplet-ai:${AI_PASS}" | chpasswd

# rpcd uses $p$ prefix for password verification via PAM-like mechanism
uci set rpcd.@login[0].password="\$p\$droplet-ai"
uci commit rpcd

echo "Droplet: AI agent password generated. Retrieve from /etc/droplet/droplet-ai-password"

# ---------------------------------------------------------------------------
# 3. Ensure uhttpd has ubus endpoint configured
# ---------------------------------------------------------------------------
uci set uhttpd.main.ubus_prefix='/ubus'
uci set uhttpd.main.ubus_socket='/var/run/ubus/ubus.sock'
uci commit uhttpd

# ---------------------------------------------------------------------------
# 4. Configure mDNS so the appliance can discover router as Droplet.local
# ---------------------------------------------------------------------------
if [ -f /etc/config/umdns ]; then
    uci set umdns.@umdns[0]=umdns
    uci set umdns.@umdns[0].jail='1'
    uci commit umdns
fi

# mDNS service advertisement (no API path exposed)
mkdir -p /etc/umdns
cat > /etc/umdns/droplet.json << 'MDNS_EOF'
{
  "droplet-router": {
    "service": "_droplet._tcp",
    "port": 80,
    "txt": [
      "version=1.0",
      "type=openwrt-router"
    ]
  }
}
MDNS_EOF

# WARP-446: extender APs announce themselves on _droplet-ap._tcp so
# the main router's orchestrator can auto-discover them via mDNS.
# See docs/ADR-005-ap-auto-onboarding.md.
#
# Role differentiation: the main router (this script's primary use)
# advertises role=router; extender APs ALSO advertise on the same
# service type but with role=extender (decided by a small marker
# file at /etc/droplet/role). Operator's first-run flow on an
# extender writes that file before running the same uci-defaults
# script.
DROPLET_ROLE_FILE=/etc/droplet/role
if [ -f "${DROPLET_ROLE_FILE}" ]; then
    DROPLET_ROLE=$(cat "${DROPLET_ROLE_FILE}" 2>/dev/null | tr -d '\n\r ')
else
    DROPLET_ROLE=router
fi

# Source-of-truth MAC for the box. Falls back to the onboard NIC's
# MAC if /etc/droplet/mac isn't present.
DROPLET_MAC=""
if [ -f /sys/class/net/eth0/address ]; then
    DROPLET_MAC=$(tr 'a-f' 'A-F' < /sys/class/net/eth0/address)
fi
if [ -n "${DROPLET_MAC}" ]; then
    DROPLET_MAC_NORMALIZED=$(echo "${DROPLET_MAC}" | tr -d ':' | tr 'A-F' 'a-f')
else
    DROPLET_MAC_NORMALIZED="unknown"
fi

# Model + serial. Both best-effort; missing fields surface as
# empty strings in the TXT record which the orchestrator tolerates.
DROPLET_MODEL=""
if [ -f /proc/device-tree/compatible ]; then
    DROPLET_MODEL=$(tr -d '\0' < /proc/device-tree/compatible | head -c 64)
fi

DROPLET_SERIAL=""
if [ -f /sys/firmware/devicetree/base/serial-number ]; then
    DROPLET_SERIAL=$(tr -d '\0' < /sys/firmware/devicetree/base/serial-number | head -c 32)
fi

cat > /etc/umdns/droplet-ap.json << MDNS_AP_EOF
{
  "droplet-ap-${DROPLET_MAC_NORMALIZED}": {
    "service": "_droplet-ap._tcp",
    "port": 80,
    "txt": [
      "mac=${DROPLET_MAC}",
      "model=${DROPLET_MODEL}",
      "serial=${DROPLET_SERIAL}",
      "version=1.0",
      "role=${DROPLET_ROLE}"
    ]
  }
}
MDNS_AP_EOF

# WARP-446: dawn band-steering daemon. Same package on every AP;
# the daemon's own UDP multicast handles cross-AP coordination at
# runtime. Defaults are reasonable for the Apple-roaming case (see
# ADR-005 §2 for why we chose dawn over usteer); operators can tune
# via the future Advanced panel.
if [ -x /etc/init.d/dawn ]; then
    /etc/init.d/dawn enable 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 4b. EasyMesh controller (prplMesh) — CONTROLLER-ONLY, gated + idempotent
# ---------------------------------------------------------------------------
# ADR-024 Phase 4 — EasyMesh controller (prplMesh). DRAFT / UNVALIDATED:
# prplMesh's HAL targets Intel/Qualcomm, NOT mt76 — controller-only mode +
# hostapd Multi-AP fronthaul on mt76 needs real-hardware validation on the lab
# box before this ships. See docs/ADR-024 §2.
#
# Enables prplMesh in CONTROLLER-ONLY mode (the box owns the 1905.1 control
# plane + M1/M2 credential push; its mt76 radio is never an EasyMesh RF agent —
# the certified third-party AP is the Agent). GATED so this whole block is a
# NO-OP unless EasyMesh has been provisioned: it runs only when the provisioning
# marker /etc/droplet/easymesh-controller exists AND the prplMesh init script is
# installed (the controller package is a research-needed prpl-feed addition, see
# openwrt/build.sh — absent on a stock image, so the -x guard skips cleanly).
#
# Idempotent like the umdns/dawn blocks above: each uci set is convergent and
# the init-script enable is a no-op when already enabled, so re-running the
# uci-defaults script (or droplet-openwrt-attach re-applying it) changes nothing.
EASYMESH_MARKER=/etc/droplet/easymesh-controller
if [ -f "${EASYMESH_MARKER}" ] && [ -x /etc/init.d/prplmesh_controller ]; then
    # Controller-only: enable the controller role, explicitly DISABLE any local
    # agent role (the box must not act as an mt76 EasyMesh agent — ADR-024 §2).
    if [ -f /etc/config/prplmesh ]; then
        uci set prplmesh.config.management_mode='Multi-AP-Controller'
        uci set prplmesh.config.operating_mode='Controller'
        uci set prplmesh.config.enable='1'
        uci commit prplmesh
    fi
    /etc/init.d/prplmesh_controller enable 2>/dev/null || true
    echo "Droplet: EasyMesh controller (prplMesh) enabled in controller-only mode."
else
    echo "Droplet: EasyMesh controller not provisioned (marker/init-script absent) — skipping (no-op)."
fi

# ---------------------------------------------------------------------------
# 5. Enable and start essential services
# ---------------------------------------------------------------------------
for svc in uhttpd rpcd dnsmasq firewall network wireless umdns; do
    /etc/init.d/$svc enable 2>/dev/null || true
done

# ---------------------------------------------------------------------------
# 6. Set up WiFi — ensure the MT7922 5 GHz radio is enabled
# ---------------------------------------------------------------------------
# Pre-MT7922-swap this section enabled radio0/1/2 (the Intel BE200 stubs).
# Those sections no longer exist in /etc/config/wireless after the
# MT7922 swap (see PR feat/openwrt-mt7922-support); keeping their uci-set
# calls would be silent no-ops and confuse future readers. radio3 is the
# MT7922 5 GHz primary AP, radio3_2g + radio4 stay disabled by default
# per the wireless config file's own settings.
uci set wireless.radio3.disabled='0'
uci commit wireless

# ---------------------------------------------------------------------------
# 7. Verify USB NIC (eth1) will be detected
# ---------------------------------------------------------------------------
echo "Droplet: Detected network interfaces:" > /tmp/droplet-firstboot.log
ip link show >> /tmp/droplet-firstboot.log 2>&1
echo "---" >> /tmp/droplet-firstboot.log
lsusb >> /tmp/droplet-firstboot.log 2>&1
echo "---" >> /tmp/droplet-firstboot.log
lspci >> /tmp/droplet-firstboot.log 2>&1

# ---------------------------------------------------------------------------
# 8. Apply and restart
# ---------------------------------------------------------------------------
echo "Droplet: First-boot setup complete. Restarting services..."

/etc/init.d/rpcd restart
/etc/init.d/uhttpd restart
/etc/init.d/network restart
/etc/init.d/umdns restart 2>/dev/null || true

echo "Droplet: Router ready at 192.168.50.1"
echo "Droplet: Credentials stored in /etc/droplet/ — retrieve during appliance provisioning"

exit 0
