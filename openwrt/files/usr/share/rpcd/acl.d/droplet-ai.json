{
  "droplet-ai": {
    "description": "Network management access for Droplet AI agent (appliance)",
    "read": {
      "ubus": {
        "system": ["board", "info"],
        "network.interface.*": ["status", "dump"],
        "network.device": ["status"],
        "network.wireless": ["status"],
        "iwinfo": ["info", "scan", "assoclist", "freqlist", "countrylist", "phyname"],
        "dhcp": ["ipv4leases", "ipv6leases"],
        "uci": ["get", "state", "configs"],
        "file": ["read", "list", "stat"],
        "service": ["list"],
        "session": ["access", "list"],
        "hostapd.*": ["get_clients", "get_status"],
        "luci-rpc": ["getBoardJSON", "getNetworkDevices", "getWirelessDevices", "getDHCPLeases", "getHostHints"],
        "umdns": ["browse", "update"]
      },
      "uci": ["network", "wireless", "dhcp", "firewall", "system"],
      "file": {
        "/usr/share/rpcd/acl.d/droplet-ai.json": ["read"]
      }
    },
    "write": {
      "ubus": {
        "network": ["restart"],
        "network.interface.*": ["up", "down"],
        "network.wireless": ["up", "down", "reconf", "notify"],
        "uci": ["set", "add", "delete", "rename", "reorder", "commit", "apply", "confirm", "rollback", "changes", "revert"],
        "system": ["reboot"],
        "service": ["set", "delete", "signal", "event"],
        "session": ["login", "destroy"],
        "hostapd.*": ["del_client"],
        "wireguard": ["*"],
        "file": ["exec"]
      },
      "file": {
        "/etc/init.d/dnsmasq restart": ["exec"]
      },
      "uci": ["network", "wireless", "dhcp", "firewall", "system"]
    }
  }
}
