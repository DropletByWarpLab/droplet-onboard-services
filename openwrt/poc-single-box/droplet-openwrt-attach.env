# /etc/default/droplet-openwrt-attach — env for droplet-openwrt-attach.service
#
# Read by /usr/local/sbin/droplet-openwrt-attach via the
# EnvironmentFile= directive in droplet-openwrt-attach.service. Override
# any of these to customise the photo-studio AP without touching the script.
#
# DROPLET_AP_SSID         — SSID broadcast inside the openwrt container
#                           (default if unset: "Droplet-POC")
# DROPLET_AP_PSK          — WPA2-PSK passphrase (default: "droplet-poc-password")
# DROPLET_AP_PHY          — phy index to move into the container netns
#                           (default: "phy1" — typical iwlwifi/AX210). Set to
#                           "phy0" on the photo-studio Ryzen box because the
#                           MT7922 is phy0 and supports Wi-Fi 6 at full
#                           22 dBm in AP mode; the AX210 is firmware-capped
#                           at 3 dBm on AP.
# DROPLET_AP_IFACE        — interface name the moved phy surfaces with
#                           (default: "wlp7s0"). Must match the kernel name
#                           assigned for $DROPLET_AP_PHY. MT7922 -> wlp14s0.
# DROPLET_AP_DOMAIN       — DNS suffix dnsmasq-ap answers locally
#                           (default: "droplet.local")
# DROPLET_AP_HOSTNAME     — bare hostname mapped to 192.168.20.1
#                           (default: "droplet")
# DROPLET_GATEWAY_CONTAINER — name of the nginx gateway container that the
#                           AP-side DNAT for :80/:443 points at
#                           (default: "droplet-pi-platform-gateway-1")
#
# The attach script regenerates /etc/hostapd.conf and /etc/dnsmasq-ap.conf
# inside the container from these on every run, so changing values here +
# `systemctl restart droplet-openwrt-attach.service` is enough to apply.

DROPLET_AP_SSID=Droplet
DROPLET_AP_PSK=Droplet123!

# Photo-studio Ryzen box specifics: the MT7922 (mt7921e driver) is phy0 and
# surfaces as wlp14s0 inside the openwrt container. It carries the AP at
# 22 dBm with Wi-Fi 6 (HE) enabled. Pinning here makes the choice
# deterministic regardless of probe order.
DROPLET_AP_PHY=phy0
DROPLET_AP_IFACE=wlp14s0
