[Unit]
Description=Droplet Router Monitor — inference host ↔ OpenWrt connectivity
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/droplet
ExecStart=/usr/bin/python3 /opt/droplet/router-connect.py --daemon --interval 30
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Security hardening
ProtectSystem=strict
ReadWritePaths=/opt/droplet /tmp
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
