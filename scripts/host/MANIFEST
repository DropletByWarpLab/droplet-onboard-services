# --- hardware watchdog (WARP-2192) -------------------------------------------
# Both halves or nothing: systemd never loads watchdog drivers itself (no
# /dev/watchdog without the modules-load fragment) and RuntimeWatchdogSec is off
# by default (PID1 never pets it without the system.conf drop-in). Either one
# missing makes the whole feature a silent no-op — which is exactly the state
# the bench box was found in.
dir   -                                                                      /etc/modules-load.d                                                   -     present  sp5100_tco is loaded from here at boot
dir   -                                                                      /etc/systemd/system.conf.d                                            -     present  PID1 reads RuntimeWatchdogSec from here at startup
file  scripts/host/etc-modules-load.d/droplet-watchdog-hw.conf               /etc/modules-load.d/droplet-watchdog-hw.conf                          0644  track
file  scripts/host/etc-systemd-system.conf.d/droplet-watchdog.conf           /etc/systemd/system.conf.d/droplet-watchdog.conf                      0644  track

