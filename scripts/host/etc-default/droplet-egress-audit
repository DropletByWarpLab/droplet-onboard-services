DROPLET_EGRESS_ALLOWLIST=
DROPLET_EGRESS_ORCHESTRATOR_URL=http://127.0.0.1:3000
DROPLET_EGRESS_LOG_DIR=/var/lib/droplet/egress-audit
DROPLET_EGRESS_NETWORK=droplet_default
