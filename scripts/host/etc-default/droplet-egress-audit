# WARP-268 — knobs for droplet-egress-audit.service, sourced by
# /usr/local/sbin/droplet-egress-audit. DROPLET_ENV_FILE and
# DROPLET_EGRESS_ALLOWLIST are filled in by scripts/lib/single-box.sh on
