# /etc/default/droplet-watchdog — per-box tuning for the unified self-heal
# watchdog (WARP-1002). Read by droplet-watchdog.service via EnvironmentFile.
# Every value here is optional; the defaults baked into
# /usr/local/sbin/droplet-watchdog are safe on every deployment shape because
# each check also self-gates on hardware/tooling presence (not_applicable).
#
# Installed once by setup.sh (scripts/lib/single-box.sh) and NEVER overwritten
# on re-runs — operator edits survive. Reference copy:
# scripts/host/etc-default/droplet-watchdog. No secrets belong in this file.

# Which checks run on this box (space-separated). Anything not listed reports
# an explicit not_applicable in status.json — never silently absent.
#DROPLET_WATCHDOG_CHECKS="wifi voice_dsp docker_dns container_crashloop host_unit_staleness host_artefacts app_downloads router_auth"

# Escalation: consecutive heal failures before a check goes `escalated`
# (CRITICAL log + suspended heals), and how many runs between suspended
# re-tries (5 runs ≈ 15 min at the 3-min timer cadence).
#DROPLET_WATCHDOG_ESCALATE_AFTER=2
#DROPLET_WATCHDOG_ESCALATED_RETRY_EVERY=5

# XVF3800 voice DSP self-heal. setup.sh (scripts/lib/single-box.sh) now installs
# the vendored, checksum-verified xvf_host + its libs durably to /usr/local/bin
# (WARP-1408) — so the baked defaults below are correct on a stock box. Override
# only for a non-standard tool location or to widen the USB vendor allow-list
# (space-separated: XMOS 20b1 + the Seeed reSpeaker XVF3800's own VID 2886).
#DROPLET_WATCHDOG_XVF_HOST=/usr/local/bin/xvf_host
#DROPLET_WATCHDOG_XVF_USB_VENDOR="20b1 2886"
#DROPLET_WATCHDOG_XHCI_THRESHOLD=3

# Docker DNS probe: hostname to resolve, and (optionally) which running
# container to probe from (default: first container of the compose project).
#DROPLET_WATCHDOG_DNS_PROBE=registry-1.docker.io
#DROPLET_WATCHDOG_DNS_CONTAINER=
#DROPLET_WATCHDOG_COMPOSE_PROJECT=droplet

# Crash-loop detection: flag a container whose RestartCount grows by MORE
# than this between two watchdog runs; capture this many log lines once per
# episode into /var/lib/droplet/watchdog/diagnostics/.
#DROPLET_WATCHDOG_CRASHLOOP_THRESHOLD=3
#DROPLET_WATCHDOG_LOG_TAIL=200

# Host-unit staleness (WARP-1829) + host-artefact audit (WARP-2574) both shell
# out to this one binary — `check` for the first, `audit` for the second. It is
# installed by setup.sh; both checks report not_applicable when it is absent, so
# the default is safe on any shape. Override only for a non-standard location.
#DROPLET_WATCHDOG_HOST_UNITS_BIN=/usr/local/sbin/droplet-host-units

# Router auth (WARP-3838): detect-only. Reads routing's /health and reports
# heal_failed with the health `error` text when routing cannot authenticate to
# the router (never heals; re-pairing credentials is a human action).
# not_applicable when routing does not answer or ROUTING_MODE is not `real`.
# setup.sh adds DROPLET_ENV_FILE pointing at the deployment .env. The watchdog
# reads its DROPLET_INTERNAL_TLS flag and, when enabled, uses HTTPS with the
# deployment's data/secrets/service-tls/host-admin bundle. Explicit
# DROPLET_INTERNAL_TLS and DROPLET_TLS_CA/CERT/KEY here override those defaults.
#DROPLET_ENV_FILE=/path/to/droplet/.env
#DROPLET_WATCHDOG_ROUTING_URL=http://localhost:8080
#ROUTING_MODE=real
