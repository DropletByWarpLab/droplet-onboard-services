[Unit]
# Host-side networking for the single-box:
#   - persistent /32 route to the managed switch (192.168.1.77 via br-lan)
#   - dedicated dnsmasq instance serving DHCP on br-lan (192.168.20.0/24)
#
# Without this, devices plugged into the managed switch never get an IP —
# the OpenWrt container's dnsmasq is scoped to the AP-side LAN, not the
# host's br-lan. See scripts/host/usr-local-sbin/droplet-host-net for details.
Description=Droplet host networking (br-lan DHCP + managed switch route)
After=network-online.target docker.service
# Wants=, NOT Requires=docker.service (P6): ExecStart never calls Docker — it
# assigns br-lan's address/route and runs dnsmasq. A hard Requires= cascade-stops
# this unit on any clean docker.service stop (engine upgrade, `systemctl restart
# docker`), and a clean stop does not trip Restart=on-failure — the single-box LAN
# loses DHCP until reboot. After= still orders us after Docker; Wants= won't cascade.
Wants=network-online.target docker.service

# WARP-2575: br-lan is NOT created by this repo. The only definition of it is
# scripts/host/etc-netplan/70-eth.yaml.example — an *example* that setup.sh
# never installs — and droplet-openwrt-attach only ever *consumes* the bridge
# (it enslaves veth-dap into an existing one). So on a stock single-box the
# bridge is simply absent, ExecStart's very first `ip addr replace ... dev
# br-lan` dies under `set -e`, and single-box.sh has nonetheless `enable`d us:
# measured on the bench 2026-08-31, 7251 restarts in 10.5 h of uptime, 60% of
# every line in the journal.
#
# Skipping on a missing bridge is what the sibling unit already does — see the
# "host br-lan not found — falling back to routed AP mode" branch in
# /usr/local/sbin/droplet-openwrt-attach. This unit was the outlier that
# hard-failed instead of degrading.
#
# The condition is evaluated when a start job runs, NOT continuously: a br-lan
# created after boot (e.g. `netplan apply` of the example file) needs an
# explicit `systemctl start droplet-host-net` to pick it up. netplan-created
# bridges exist well before network-online.target, so the ordering above
# already covers the normal case.
ConditionPathExists=/sys/class/net/br-lan

# WARP-2575: a start limit that can actually trip. systemd's defaults are
# StartLimitIntervalSec=10s / StartLimitBurst=5, and at RestartSec=5s only TWO
# restarts fit in a 10 s window — the burst ceiling of 5 is unreachable by
# construction, which is why the loop above ran unbounded instead of parking
# after five tries. Widening the window to 120 s makes the ceiling reachable:
# a genuine transient (a bridge a moment late, a bad lan-dhcp.conf) still gets
# 5 attempts across ~25 s, and anything permanent lands in `failed` — loud
# once, rather than loud forever.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/default/droplet-host-net
ExecStart=/usr/local/sbin/droplet-host-net
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
