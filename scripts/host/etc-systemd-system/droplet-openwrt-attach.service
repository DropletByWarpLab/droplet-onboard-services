[Unit]
# Bootstrap the droplet-openwrt container after docker comes up:
#   - move the AP wireless phy into the container netns
#   - un-bridge eth0 from br-lan + restore Docker's L3 IP/route
#   - opkg install hostapd-mbedtls + wireguard-tools (idempotent)
#   - set OpenWrt root password from /home/droplet/edge-platform/docker/secrets/openwrt_password
#   - generate /etc/hostapd.conf + /etc/dnsmasq-ap.conf, start AP
#   - re-kick routing service if it's caught with a stale OpenWrt session
#
# This is the systemd glue around scripts/poc/droplet-openwrt-attach.sh —
# install via `bash scripts/poc/install-attach-service.sh` on the POC box.
Description=Bootstrap droplet-openwrt container (AP + RPC + routing recovery)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/droplet-openwrt-attach
# WARP-808 follow-up: customer Wi-Fi writes from the sandboxed device-bridge
# land in this droplet-owned file (DROPLET_HOSTAPD_ENV_FILE in
# droplet-device-bridge.service) — the bridge cannot write root-owned
# /etc/default under ProtectSystem=strict/User=droplet. Loaded LAST so the
# customer's DROPLET_AP_SSID/DROPLET_AP_PSK override the provisioning
# defaults above (systemd EnvironmentFile: last assignment wins). Absent on
# a fresh/factory-reset box (`=-`), which falls back to the defaults.
EnvironmentFile=-/var/lib/droplet-bridge/openwrt-attach.env
ExecStart=/usr/local/sbin/droplet-openwrt-attach

[Install]
WantedBy=multi-user.target
