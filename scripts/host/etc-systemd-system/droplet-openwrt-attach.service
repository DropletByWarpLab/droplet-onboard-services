[Unit]
# Bootstrap the droplet-openwrt container after docker comes up:
#   - move the AP wireless phy into the container netns
#   - un-bridge eth0 from br-lan + restore Docker's L3 IP/route
#   - opkg install hostapd-mbedtls + wireguard-tools (idempotent)
#   - set OpenWrt root password from /home/droplet/edge-platform/docker/secrets/openwrt_password
#   - generate /etc/hostapd.conf + /etc/dnsmasq-ap.conf, start AP
#   - re-kick routing service if it's caught with a stale OpenWrt session
#
# This is the systemd glue around /usr/local/sbin/droplet-openwrt-attach,
# installed by scripts/lib/single-box.sh (setup.sh --single-box). (The old
# scripts/poc/* paths were retired with the single-box rename — INFRA-009.)
Description=Bootstrap droplet-openwrt container (AP + RPC + routing recovery)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/droplet-openwrt-attach
# WARP-843: customer Wi-Fi writes from the sandboxed device-bridge land in the
# bridge's own StateDirectory (/var/lib/droplet-bridge/openwrt-attach.env —
# DROPLET_HOSTAPD_ENV_FILE in droplet-device-bridge.service), which is
# droplet-owned, so the write succeeds without the bridge ever touching
# root-owned /etc/default (this is what fixes the wizard's 422). That creds
# file is DELIBERATELY NOT an EnvironmentFile here: (a) drop-ins (override.conf)
# re-load /etc/default after the main unit, so EnvironmentFile ordering would
# silently clobber the customer's values (PR #551 review blocker), and (b) — the
# security invariant — a droplet-writable file must NEVER inject arbitrary env
# into a root unit: an EnvironmentFile loads EVERY key, so a compromised bridge
# could set e.g. AP_PSK_FILE=/root/.ssh/authorized_keys and have this ROOT
# service write it (LPE). Instead the attach script parses ONLY
# DROPLET_AP_SSID/DROPLET_AP_PSK (+ the DROPLET_GUEST_* keys) out of that file,
# with hard validation — see the customer_ap_creds / customer_guest_creds
# blocks in /usr/local/sbin/droplet-openwrt-attach.
# The re-apply is closed with ZERO grants to the droplet user: the repo-tracked
# droplet-openwrt-attach.path unit watches that StateDirectory creds file and
# re-runs this service via the -reapply relay (this unit is RemainAfterExit, so
# a path-triggered start alone would be a no-op). That replaced the PR #551
# polkit-restart route, which never worked without polkitd JS-rules support.
# The EnvironmentFile above therefore carries operator/hardware config ONLY (the
# provisioning SSID default + DROPLET_AP_PHY/IFACE pins) and stays root-owned.
ExecStart=/usr/local/sbin/droplet-openwrt-attach

[Install]
WantedBy=multi-user.target
