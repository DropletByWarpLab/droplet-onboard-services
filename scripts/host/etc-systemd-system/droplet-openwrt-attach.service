[Unit]
# Bootstrap the droplet-openwrt container after docker comes up:
#   - move the AP wireless phy into the container netns
#   - un-bridge eth0 from br-lan + restore Docker's L3 IP/route
#   - opkg install hostapd-mbedtls + wireguard-tools (idempotent)
#   - set OpenWrt root password from /home/droplet/edge-platform/docker/secrets/openwrt_password
#   - generate /etc/hostapd.conf + /etc/dnsmasq-ap.conf, start AP
#   - re-kick routing service if it's caught with a stale OpenWrt session
#
# This is the systemd glue around /usr/local/sbin/droplet-openwrt-attach,
# installed by scripts/lib/single-box.sh (setup.sh --single-box). (The old
# scripts/poc/* paths were retired with the single-box rename — INFRA-009.)
Description=Bootstrap droplet-openwrt container (AP + RPC + routing recovery)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/droplet-openwrt-attach
# WARP-843: customer Wi-Fi writes from the sandboxed device-bridge land
# DIRECTLY in /etc/default/droplet-openwrt-attach — the file is provisioned
# droplet:droplet 0600 and the bridge unit carves ReadWritePaths=/etc/default,
# so the unprivileged bridge rewrites it in place (both scripts hard-validate
# SSID/PSK before writing, and the attach script re-validates what it
# consumes). The repo-tracked droplet-openwrt-attach.path unit watches the
# file and re-runs this service (via the -reapply relay — this unit is
# RemainAfterExit, so a path-triggered start alone would be a no-op).
# The PR #551 StateDirectory shadow copy (/var/lib/droplet-bridge/
# openwrt-attach.env) is retired; install-device-bridge.sh migrates any
# leftover customer keys from it and deletes it. The attach script's
# customer_ap_creds block still parses that path IF present purely as a
# pre-migration fallback.
ExecStart=/usr/local/sbin/droplet-openwrt-attach

[Install]
WantedBy=multi-user.target
