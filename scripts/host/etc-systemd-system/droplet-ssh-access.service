[Unit]
# WARP-1984 — the privileged half of the dashboard's "Allow SSH" toggle.
# Started by droplet-ssh-access.path whenever the orchestrator rewrites
# /var/lib/droplet-ssh-access/intent.
#
# ── WHY THERE IS NO EnvironmentFile HERE ────────────────────────────────────
# The intent file is DROPLET-WRITABLE and this unit is ROOT. Pointing
# `EnvironmentFile=` at it would be the ADR-037 LPE: EnvironmentFile loads
# EVERY key in the file, so anything that could write it could inject an
# arbitrary variable into a root service. The same reasoning is spelled out at
# length on droplet-openwrt-attach.service, which keeps its customer-writable
# creds file out of EnvironmentFile for exactly this reason.
#
# Instead ExecStart parses ONE key out of the file itself and validates it
# against `on|off` before acting. The file's contents never reach a shell.
Description=Apply the dashboard's SSH-access intent (WARP-1984, WARP-2887)
After=network.target

[Service]
# Plain oneshot — NOT RemainAfterExit. The path unit that triggers this starts
# it on every change, and a start of an already-active unit is a no-op, so
# adding RemainAfterExit=yes here would silently break the toggle after its
# first use. (droplet-openwrt-attach needs a relay unit precisely because it
# made the other choice.)
Type=oneshot
ExecStart=/usr/local/sbin/droplet-ssh-access

# Hardening. Kept as tight as the job allows — this is the unit an attacker
# would most want to influence — but the job grew with WARP-2887.
NoNewPrivileges=yes
ProtectSystem=strict
# WARP-2887 — the login half creates a real system account: useradd/usermod
# rename /etc/passwd, /etc/shadow, /etc/group, /etc/gshadow and take
# /etc/.pwd.lock (so the /etc DIRECTORY must be writable, not just the files),
# chpasswd writes /etc/shadow, and install_sshd_match rewrites
# /etc/ssh/sshd_config; useradd -m creates the account's /home directory.
# Under ProtectSystem=strict those are all read-only, so WITHOUT these
# carve-outs every login save fails EROFS on the first write and the card
# reports "refused" forever (the WARP-2887 review's DOA finding). The WARP-1984
# toggle half (systemctl start/stop ssh + the state file) needs none of this;
# the widening is the price of managing an OS account from a root unit, and it
# is deliberately the NARROWEST set that lets useradd/chpasswd/sshd_config
# succeed while everything else stays read-only.
#
# WARP-2048: a bare ReadWritePaths= target that does not exist when the unit
# starts fails the whole mount-namespace setup, so the unit never runs. /etc
# and /home always exist on the appliance, but tests/systemd-readwritepaths-
# must-exist.test.sh cannot prove that statically — it requires every carve-out
# to be StateDirectory-created or '-'-prefixed. The '-' prefix means "carve this
# out read-write IF present, don't hard-fail if absent": behaviour-identical
# here (both always exist) and it satisfies the guard.
ReadWritePaths=-/etc -/home
# ProtectHome must be OFF: useradd -m writes under /home, and ProtectHome=yes
# takes precedence over a ReadWritePaths=-/home carve-out (systemd makes /home
# inaccessible before the carve-out applies). ProtectSystem=strict + the narrow
# ReadWritePaths above keep the rest of the tree read-only regardless.
ProtectHome=no
StateDirectory=droplet-ssh-access
PrivateTmp=yes

# ── WHY THERE IS NO [Install] SECTION ───────────────────────────────────────
# The path watcher is the ONLY thing that may start this unit. An
# [Install]/WantedBy= stanza here would be inert — the installer never
# enables this unit — right up until some future installer edit ran
# `systemctl enable droplet-ssh-access.service`, at which point the applier
# would run at every boot with whatever the intent file already said, and
# SSH would silently survive reboots as a standing open door. With no stanza,
# that `enable` fails loudly ("has no installation config") instead of
# succeeding silently. The boot-time OFF default lives in
# droplet-ssh-access-boot-reset.service, which is the unit that is MEANT to
# run at boot.
