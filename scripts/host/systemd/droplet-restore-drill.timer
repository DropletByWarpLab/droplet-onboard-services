# =============================================================================
# WARP-254 — monthly trigger for droplet-restore-drill.service
# =============================================================================
#
# First of the month, 05:00 local — after that night's backups so the drill
# exercises a fresh snapshot. Persistent=true fires a missed drill on the
# next boot (a box powered off on the 1st still gets its monthly proof).
# =============================================================================
[Unit]
Description=Monthly Droplet backup restore drill
Documentation=https://warp-lab.atlassian.net/browse/WARP-254

[Timer]
OnCalendar=*-*-01 05:00:00
RandomizedDelaySec=1800
Persistent=true
Unit=droplet-restore-drill.service

[Install]
WantedBy=timers.target
