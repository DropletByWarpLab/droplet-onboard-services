#!/bin/bash
# Bring up the OpenWrt container's AP after a (re)start. Idempotent.
#
# Phase K: AP clients reach the dashboard via DNAT — phone hits
# https://droplet.local/ (DNS served by openwrt's dnsmasq) which resolves
# to 192.168.20.1, openwrt DNATs :443/:80 to the docker gateway container.
# No cross-subnet TCP needed from the phone's perspective.
set +e

# --- Customer-facing knobs (override via env) -----------------------------
AP_SSID="${DROPLET_AP_SSID:-Droplet}"
# WARP-819: AP_PSK is resolved by resolve_ap_psk() below — NEVER a shared
# hardcoded default. An explicit DROPLET_AP_PSK (real, non-placeholder) wins;
# otherwise a strong per-box PSK is generated ONCE, persisted 0600, and re-read
# on every subsequent boot. Seed it from the env here so the resolver can honor
# an operator override; the resolver overwrites it with the persisted/generated
# value when no real override is set.
AP_PSK="${DROPLET_AP_PSK:-}"
AP_DOMAIN="${DROPLET_AP_DOMAIN:-droplet.local}"
AP_HOSTNAME="${DROPLET_AP_HOSTNAME:-droplet}"
# Where the per-box AP PSK is persisted host-side (0600). Stable across reboots;
# generated once if absent. Overridable for tests.
AP_PSK_FILE="${AP_PSK_FILE:-/etc/droplet/ap-psk}"
# The device-bridge env file the bridge reads DROPLET_AP_PSK from. We mirror the
# resolved PSK into it so the pairing QR/text the bridge renders ALWAYS equals
# the PSK hostapd actually serves (WARP-819 coherence AC). Overridable for tests.
DEVICE_BRIDGE_ENV_FILE="${DEVICE_BRIDGE_ENV_FILE:-/etc/droplet/device-bridge.env}"

# --- Guest Wi-Fi knobs (optional second BSS) ------------------------------
# The guest network is an OPTIONAL, isolated second hostapd BSS on the same
# radio, with its own subnet (192.168.30.0/24), its own dnsmasq, and its own
# default-deny firewall zone (internet only, no LAN, client-isolated). It is
# configured on demand by droplet-set-guest-wifi.sh — which upserts these keys
# into the customer env file below — and stays OFF unless DROPLET_GUEST_ENABLED=1
# with a valid SSID + PSK. Seeded from the process env here so an operator can
# pin it; the customer_guest_creds block overrides from the device-bridge file.
GUEST_SSID="${DROPLET_GUEST_SSID:-}"
GUEST_PSK="${DROPLET_GUEST_PSK:-}"
GUEST_ENABLED="${DROPLET_GUEST_ENABLED:-0}"
# The guest BSS surfaces as its own netdev; default "<ap_iface>_g" (resolved
# after detect_ap_radio fills AP_IFACE). Overridable for an operator/test.
GUEST_IFACE="${DROPLET_GUEST_IFACE:-}"
# Guest L3 gateway. Distinct from the AP subnet (192.168.20.0/24) and mgmt
# (192.168.10.0/24) so the zones never overlap.
GUEST_GW="${DROPLET_GUEST_GW:-192.168.30.1}"

# >>> customer_ap_creds (WARP-808 follow-up; WARP-843 canonical customer path)
# The setup wizard's customer Wi-Fi write lands in the device-bridge's OWN
# StateDirectory (/var/lib/droplet-bridge/openwrt-attach.env) — droplet-owned,
# so the sandboxed bridge writes it with no access to root-owned /etc (the
# PR #551 split, kept intact; the root droplet-openwrt-attach.path unit watches
# THIS file and re-applies via the reapply relay).
#
# SECURITY BOUNDARY (do NOT turn this into a `.`/`source` or an EnvironmentFile):
# this file is DROPLET-WRITABLE, so it must NEVER be loaded as this ROOT
# service's EnvironmentFile — an EnvironmentFile imports EVERY key, so a
# compromised bridge could inject AP_PSK_FILE=/root/.ssh/authorized_keys (or
# OPENWRT_PASSWORD_FILE=/etc/shadow, DROPLET_RPCD_ACL=/etc/cron.d/x, …) and have
# root write attacker-controlled content (LPE). Root consumes it ONLY through
# this WHITELIST parse: read ONLY DROPLET_AP_SSID/DROPLET_AP_PSK (+ the guest
# keys below), re-validated with the same bounds droplet-set-hostapd.sh enforces
# (SSID 1-32, PSK 8-63, no control characters), and IGNORE every other key.
# Customer creds, when present and valid, win over the env-provided values;
# resolve_ap_psk() then treats the customer PSK as an explicit real value,
# keeps it, and mirrors it to the pairing QR.
CUSTOMER_AP_ENV="${DROPLET_CUSTOMER_AP_ENV:-/var/lib/droplet-bridge/openwrt-attach.env}"
if [ -f "$CUSTOMER_AP_ENV" ]; then
  c_ssid="$(grep -m1 '^DROPLET_AP_SSID=' "$CUSTOMER_AP_ENV" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')"
  c_psk="$(grep -m1 '^DROPLET_AP_PSK=' "$CUSTOMER_AP_ENV" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')"
  case "$c_ssid" in *[[:cntrl:]]*) c_ssid="";; esac
  case "$c_psk"  in *[[:cntrl:]]*) c_psk="";;  esac
  if [ -n "$c_ssid" ] && [ "${#c_ssid}" -le 32 ]; then
    AP_SSID="$c_ssid"
  fi
  if [ -n "$c_psk" ] && [ "${#c_psk}" -ge 8 ] && [ "${#c_psk}" -le 63 ]; then
    AP_PSK="$c_psk"
  fi
fi
# <<< customer_ap_creds

# >>> customer_guest_creds
# The guest Wi-Fi SSID/PSK/enabled flag live in the SAME device-bridge file
# (droplet-set-guest-wifi.sh writes them there). Parse them out with the same
# hard validation root applies to the AP keys — a control char or out-of-range
# value must never reach hostapd via a bss= stanza (it would take the WHOLE
# radio down, home AP included). Customer values win over the env seed.
if [ -f "$CUSTOMER_AP_ENV" ]; then
  cg_ssid="$(grep -m1 '^DROPLET_GUEST_SSID=' "$CUSTOMER_AP_ENV" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')"
  cg_psk="$(grep -m1 '^DROPLET_GUEST_PSK=' "$CUSTOMER_AP_ENV" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')"
  cg_en="$(grep -m1 '^DROPLET_GUEST_ENABLED=' "$CUSTOMER_AP_ENV" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')"
  case "$cg_ssid" in *[[:cntrl:]]*) cg_ssid="";; esac
  case "$cg_psk"  in *[[:cntrl:]]*) cg_psk="";;  esac
  [ -n "$cg_ssid" ] && GUEST_SSID="$cg_ssid"
  [ -n "$cg_psk" ]  && GUEST_PSK="$cg_psk"
  [ -n "$cg_en" ]   && GUEST_ENABLED="$cg_en"
fi
# Guest needs BOTH a valid SSID (1-32) and PSK (8-63); otherwise force-disable
# so a half-written/partial guest config can never feed hostapd a bad BSS.
if [ "${GUEST_ENABLED:-0}" = 1 ]; then
  if [ -z "$GUEST_SSID" ] || [ "${#GUEST_SSID}" -gt 32 ] || \
     [ -z "$GUEST_PSK" ] || [ "${#GUEST_PSK}" -lt 8 ] || [ "${#GUEST_PSK}" -gt 63 ]; then
    echo "droplet-openwrt-attach: WARN: guest Wi-Fi enabled but SSID/PSK invalid or missing — guest network NOT brought up"
    GUEST_ENABLED=0
  fi
fi
# <<< customer_guest_creds

# WARP-1363: persist the LIVE AP SSID host-side for the matter-controller
# sidecar. The sidecar's DROPLET_MATTER_WIFI_SSID env is written once at
# setup and goes stale on an AP rename (claim / wizard Wi-Fi save) — the
# commissionee is then told to join a network that no longer broadcasts
# (ScanNetworks -> NetworkNotFound, proven live on .87 2026-07-17: env said
# "Droplet", the AP broadcast "WarpLab"). The sidecar resolves the SSID
# file-first per commission (DROPLET_MATTER_WIFI_SSID_FILE — same pattern
# as the WARP-1035 PSK file), so writing the resolved SSID here on EVERY
# attach keeps Matter provisioning pointed at whatever hostapd actually
# broadcasts. Not a secret (an SSID is broadcast in the clear) — 0644, in
# the same /etc/droplet home as ap-psk.
# >>> persist_ap_ssid (WARP-1363)
AP_SSID_FILE="${DROPLET_AP_SSID_FILE:-/etc/droplet/ap-ssid}"
persist_ap_ssid() {
  ssid_dir="$(dirname "$AP_SSID_FILE")"
  mkdir -p "$ssid_dir" 2>/dev/null || true
  if printf '%s
' "$AP_SSID" > "$AP_SSID_FILE.tmp" 2>/dev/null; then
    mv "$AP_SSID_FILE.tmp" "$AP_SSID_FILE" 2>/dev/null || true
    chmod 0644 "$AP_SSID_FILE" 2>/dev/null || true
  else
    echo "droplet-openwrt-attach: WARN: could not persist AP SSID to $AP_SSID_FILE — Matter Wi-Fi provisioning may target a stale SSID"
  fi
}
persist_ap_ssid
# <<< persist_ap_ssid (WARP-1363)

# WARP-986: the dnsmasq-ap instance this script regenerates below is the ONLY
# resolver AP (Wi-Fi) clients use — the uci hostrecord leg the routing service
# writes lands in a dnsmasq that is NOT running in single-box AP mode, and the
# host-net dnsmasq has DNS disabled (port=0). So unless dnsmasq-ap itself
# answers the ADR-023 public per-device FQDN, AP clients can never resolve the
# box's publicly-trusted cert name and the green-padlock path is dead on AP
# Wi-Fi (proven live on the .87 box, 2026-07-01). Resolution order: an explicit
# DROPLET_PUBLIC_FQDN env (via /etc/default/droplet-openwrt-attach) wins;
# otherwise read the value droplet-set-public-fqdn.sh persisted into the repo
# .env (same fixed repo path the OPENWRT_PASSWORD_FILE / DROPLET_RPCD_ACL
# defaults use). Re-validated here with the SAME conservative shape
# droplet-set-public-fqdn.sh enforces (1-253 chars of lowercase [a-z0-9.-],
# no leading/trailing dot or hyphen, must contain a dot) because root must not
# trust the file and the value is interpolated into the dnsmasq-ap config — an
# invalid value is dropped (name simply not served), never emitted.
# Sentinel-delimited so it is unit-testable in isolation
# (tests/openwrt-attach-public-fqdn.test.sh), mirroring resolve_ap_psk.
# >>> resolve_public_fqdn (WARP-986)
PUBLIC_FQDN="${DROPLET_PUBLIC_FQDN:-}"
REPO_ENV_FILE="${DROPLET_PUBLIC_FQDN_ENV_FILE:-/home/droplet/edge-platform/.env}"
resolve_public_fqdn() {
  if [ -z "$PUBLIC_FQDN" ] && [ -f "$REPO_ENV_FILE" ]; then
    PUBLIC_FQDN="$(grep -m1 '^DROPLET_PUBLIC_FQDN=' "$REPO_ENV_FILE" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')"
  fi
  [ -n "$PUBLIC_FQDN" ] || return 0
  if [ "${#PUBLIC_FQDN}" -gt 253 ] || \
     ! printf '%s' "$PUBLIC_FQDN" | grep -Eq '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$'; then
    echo "droplet-openwrt-attach: WARN: DROPLET_PUBLIC_FQDN is not a valid hostname — dnsmasq-ap will not serve it"
    PUBLIC_FQDN=""
    return 0
  fi
  case "$PUBLIC_FQDN" in
    *.*)
      echo "droplet-openwrt-attach: public FQDN resolved — dnsmasq-ap will answer $PUBLIC_FQDN -> 192.168.20.1"
      ;;
    *)
      echo "droplet-openwrt-attach: WARN: DROPLET_PUBLIC_FQDN is not a dotted FQDN — dnsmasq-ap will not serve it"
      PUBLIC_FQDN=""
      ;;
  esac
  return 0
}
resolve_public_fqdn
# <<< resolve_public_fqdn (WARP-986)

# Which wireless phy to move into the container netns, and what interface name
# it surfaces with. These are AUTO-DETECTED below (detect_ap_radio) so the
# attach works on whatever Wi-Fi card the box actually ships — the MT7922
# single-box enumerates phy0/wlp14s0, an AX210 box phy1/wlp7s0, others wlan0,
# etc. Hardcoding one card's layout (WARP-826: was phy1/wlp7s0) meant a
# mismatched card left the radio un-moved into the netns and hostapd binding a
# nonexistent iface → the AP never appeared. An explicit DROPLET_AP_PHY /
# DROPLET_AP_IFACE env override stays AUTHORITATIVE: if set (non-empty) it is
# used verbatim and detection is skipped, so an operator can always pin the
# radio (e.g. to force the full-power MT7922 over a weaker AX210 on a dual-card
# box). Seed from the env here; detect_ap_radio fills any unset side.
AP_PHY="${DROPLET_AP_PHY:-}"
AP_IFACE="${DROPLET_AP_IFACE:-}"
GATEWAY_CONTAINER="${DROPLET_GATEWAY_CONTAINER:-droplet-gateway-1}"
# Phase L: root password for OpenWrt rpcd. Read from the docker secret
# the routing service also reads, so both sides stay in lockstep.
OPENWRT_PASSWORD_FILE="${OPENWRT_PASSWORD_FILE:-/home/droplet/edge-platform/docker/secrets/openwrt_password}"
# --------------------------------------------------------------------------

# WARP-819: resolve the per-box AP PSK. Replaces the old shared hardcoded
# fallback (`droplet-default-wifi`) so every box ships a UNIQUE Wi-Fi password
# with zero prior config. Priority:
#   1. an explicit, REAL DROPLET_AP_PSK env (operator override) — used verbatim;
#   2. the persisted 0600 secret file ($AP_PSK_FILE) if present + non-empty
#      — read it (NEVER regenerate; the SSID/PSK must be stable across reboots);
#   3. otherwise GENERATE a strong 16-char passphrase ONCE, persist it 0600,
#      and use it.
# Placeholder/shared sentinels (empty, the old shared default, the setup-wizard
# placeholder) are treated as "not set" so a stale .env can't reinstate a shared
# password. The resolved value is mirrored into the device-bridge env so the
# pairing QR/text the bridge renders always equals the PSK hostapd serves
# (coherence AC). Idempotent; sentinel-delimited so it is unit-testable in
# isolation (tests/openwrt-attach-ap-psk.test.sh).
# >>> resolve_ap_psk (WARP-819)
resolve_ap_psk() {
  psk_file="${AP_PSK_FILE:-/etc/droplet/ap-psk}"
  bridge_env="${DEVICE_BRIDGE_ENV_FILE:-/etc/droplet/device-bridge.env}"

  # Is the candidate a real PSK, or a placeholder/shared sentinel to ignore?
  _is_placeholder() {
    case "$1" in
      ""|droplet-default-wifi|CHANGE_ME_VIA_SETUP_WIZARD|changeme|CHANGEME)
        return 0 ;;
      *) return 1 ;;
    esac
  }

  # 1) Explicit operator override (real value only).
  if ! _is_placeholder "${AP_PSK:-}"; then
    : # keep AP_PSK as-is
  # 2) Persisted per-box secret.
  elif [ -r "$psk_file" ] && [ -s "$psk_file" ]; then
    AP_PSK="$(tr -d '\r\n' < "$psk_file")"
  fi

  # 3) Still nothing real → generate once.
  if _is_placeholder "${AP_PSK:-}"; then
    # 16 chars from a url-safe-ish alphabet (no quotes/backslash/$ so it is a
    # safe hostapd wpa_passphrase + safe to single-quote downstream). First char
    # forced to a digit so iOS/Android password fields don't auto-capitalize it
    # (silent auto-cap → user types lowercase, submits capitalized → PSK
    # mismatch). ~80 bits of entropy — far past any practical WPA2 attack.
    gen="$( { openssl rand -base64 48 2>/dev/null || head -c 96 /dev/urandom 2>/dev/null | base64; } \
            | tr -dc 'A-Za-z0-9' | cut -c1-15 )"
    # WARP-821: STRONG entropy only. If neither openssl nor /dev/urandom produced
    # a full-length key, HARD-FAIL rather than fall back to a weak PRNG — a
    # low-entropy Wi-Fi password silently shipping is worse than a loud failure a
    # human can fix. (Unreachable on the box; both sources are always present.)
    if [ "${#gen}" -lt 15 ]; then
      echo "droplet-openwrt-attach: FATAL — no strong entropy source (openssl or readable /dev/urandom) to generate the AP PSK; refusing to ship a weak Wi-Fi password. Install openssl or make /dev/urandom readable, then retry." >&2
      exit 1
    fi
    # Leading digit (2-9) sampled UNIFORMLY from the SAME strong source (no PRNG)
    # so the passphrase starts numeric (mobile auto-cap guard) → 16 chars total.
    # One random byte (0..255) reduced mod 8 and mapped to {2..9}: 256 is a
    # multiple of 8, so the modulo is bias-free. The previous version took the
    # first digit of a base64 stream and fell back to a constant 7 whenever the
    # stream had no digit (or it was 0/1) — a hardcoded value, not "the same
    # strong source", that over-represented 7. Entropy of the body is unchanged
    # (~89 bits); this only debiases the one leading digit.
    rbyte="$( { openssl rand -hex 1 2>/dev/null || head -c 1 /dev/urandom 2>/dev/null | od -An -tx1; } | tr -dc '0-9a-f' | cut -c1-2 )"
    if [ -z "$rbyte" ]; then
      echo "droplet-openwrt-attach: FATAL — no strong entropy source (openssl or readable /dev/urandom) to sample the AP PSK leading digit; refusing to ship a weak Wi-Fi password." >&2
      exit 1
    fi
    first=$(( 2 + (0x$rbyte % 8) ))
    AP_PSK="${first}${gen}"
  fi

  # Persist the resolved PSK 0600 so subsequent boots read the SAME value.
  # mkdir -p the parent (idempotent); write atomically; tighten perms.
  if [ -n "${AP_PSK:-}" ]; then
    psk_dir="$(dirname "$psk_file")"
    mkdir -p "$psk_dir" 2>/dev/null || true
    umask 077
    printf '%s\n' "$AP_PSK" > "$psk_file.tmp" 2>/dev/null && mv "$psk_file.tmp" "$psk_file" 2>/dev/null || true
    chmod 0600 "$psk_file" 2>/dev/null || true

    # Mirror into the device-bridge env (coherence AC): upsert the
    # DROPLET_AP_PSK line so the bridge's pairing QR/text matches the live AP.
    bridge_dir="$(dirname "$bridge_env")"
    mkdir -p "$bridge_dir" 2>/dev/null || true
    umask 077
    if [ -f "$bridge_env" ]; then
      grep -v '^DROPLET_AP_PSK=' "$bridge_env" > "$bridge_env.tmp" 2>/dev/null || true
    else
      : > "$bridge_env.tmp"
    fi
    printf 'DROPLET_AP_PSK=%s\n' "$AP_PSK" >> "$bridge_env.tmp"
    mv "$bridge_env.tmp" "$bridge_env" 2>/dev/null || true
    chmod 0600 "$bridge_env" 2>/dev/null || true
  fi
}
resolve_ap_psk
# <<< resolve_ap_psk (WARP-819)

# WARP-826: auto-detect the wireless phy + its netdev name so the attach works
# on ANY card, instead of the old hardcoded phy1/wlp7s0 (the AX210 layout) that
# silently no-op'd on the MT7922 single-box (phy0/wlp14s0) — radio never moved
# into the container netns, hostapd bound a nonexistent iface, AP never came up.
#
# Override stays authoritative: an explicit DROPLET_AP_PHY / DROPLET_AP_IFACE
# (seeded into AP_PHY/AP_IFACE above) is used verbatim; detection only fills the
# side(s) left empty. Detection reads /sys/class/ieee80211 for the phy and
# `iw dev` for the iface (parsing the `phy#N` / `Interface <name>` grouping),
# preferring the phy that the chosen/declared iface belongs to and otherwise the
# first phy present. No wireless hardware → both stay empty and the downstream
# guards (the `[ -e /sys/class/ieee80211/$AP_PHY ]` netns move + hostapd bring-up)
# handle the absence; the function never aborts the attach.
#
# Sentinel-delimited so it is unit-testable in isolation against a fake sysfs +
# stub `iw` (tests/openwrt-attach-iface-detect.test.sh), mirroring
# resolve_ap_psk / ap_firewall_zone. SYS_CLASS_IEEE80211 is overridable for that
# test; in production it defaults to the real /sys path.
# >>> detect_ap_radio (WARP-826)
detect_ap_radio() {
  sysfs="${SYS_CLASS_IEEE80211:-/sys/class/ieee80211}"

  # phy -> netdev name and netdev -> phy, parsed once from `iw dev`. `iw dev`
  # groups interfaces under a `phy#N` header followed by `\tInterface <name>`:
  #   phy#0
  #       Interface wlp14s0
  #           type managed
  # Build two newline-delimited maps ("phyN<TAB>iface") we can grep. `iw` absent
  # (no wireless tooling) -> empty maps; we then fall back to sysfs-only for the
  # phy and leave the iface empty.
  _iwmap=""
  if command -v iw >/dev/null 2>&1; then
    _cur_phy=""
    while IFS= read -r line; do
      case "$line" in
        phy#*)
          # "phy#0" -> "phy0"
          _n="${line#phy#}"
          _cur_phy="phy${_n}"
          ;;
        *Interface\ *)
          _if="${line##*Interface }"
          _if="${_if%% *}"
          [ -n "$_cur_phy" ] && [ -n "$_if" ] && \
            _iwmap="${_iwmap}${_cur_phy}	${_if}
"
          ;;
      esac
    done <<EOF
$(iw dev 2>/dev/null)
EOF
  fi

  # 1) If an iface is pinned/known but the phy is not, recover the phy from the
  #    iface's grouping in the iw map (never leave a known iface with a blank phy).
  if [ -n "$AP_IFACE" ] && [ -z "$AP_PHY" ]; then
    AP_PHY="$(printf '%s' "$_iwmap" | awk -F '\t' -v i="$AP_IFACE" '$2==i{print $1; exit}')"
  fi

  # 2) If the phy is pinned/known but the iface is not, fill the iface from that
  #    phy's grouping.
  if [ -n "$AP_PHY" ] && [ -z "$AP_IFACE" ]; then
    AP_IFACE="$(printf '%s' "$_iwmap" | awk -F '\t' -v p="$AP_PHY" '$1==p{print $2; exit}')"
  fi

  # 3) Nothing declared yet — pick the first wireless phy present in sysfs, then
  #    resolve its iface from the iw map. sysfs is the source of truth for "which
  #    phys exist"; iw maps a phy to its netdev.
  if [ -z "$AP_PHY" ]; then
    if [ -d "$sysfs" ]; then
      for d in "$sysfs"/phy*; do
        [ -e "$d" ] || continue   # nullglob-safe: skip the literal when no match
        AP_PHY="$(basename "$d")"
        break
      done
    fi
  fi
  if [ -n "$AP_PHY" ] && [ -z "$AP_IFACE" ]; then
    AP_IFACE="$(printf '%s' "$_iwmap" | awk -F '\t' -v p="$AP_PHY" '$1==p{print $2; exit}')"
  fi

  if [ -n "$AP_PHY" ] && [ -n "$AP_IFACE" ]; then
    echo "droplet-openwrt-attach: AP radio detected — phy=$AP_PHY iface=$AP_IFACE"
  else
    echo "droplet-openwrt-attach: WARN: no wireless phy/iface resolved (phy='${AP_PHY}' iface='${AP_IFACE}'); set DROPLET_AP_PHY/DROPLET_AP_IFACE if the card is present — AP will not come up otherwise"
  fi
  return 0
}
# <<< detect_ap_radio (WARP-826)

# >>> onboard_radio_policy (WARP-2054)
# FOUNDER RULE (2026-07-28): "we will never use the onboard droplet radios for
# the aps. droplet box should be totally local always ... the final box will
# have onboard radios deactivated and all traffic will go through the pi router
# for security." AP duty belongs to the EXTERNAL AP (Zyxel NWA50BE); an on-box
# AP is dev scaffolding.
#
# So the onboard AP is OFF BY DEFAULT, opted into only with DROPLET_AP_ONBOARD=1.
# It was ON by default until 2026-08-27, and that cost two distinct things:
#
#   1. detect_ap_radio resolved the phy and the attach MOVED it into the
#      container netns, leaving the radio claimed and powered - exactly what
#      the rule forbids. (It also makes the host look like it has no Wi-Fi
#      card at all, which reads as a hardware fault during triage.)
#   2. hostapd was then attempted and failed on EVERY boot, so this unit sat
#      permanently `failed` - and this same unit installs the WireGuard overlay
#      NAT. A real overlay-NAT failure and a cosmetic AP failure were
#      indistinguishable by unit state, so `systemctl is-active` was useless as
#      a health signal here. That masking is the reason this is a bug and not
#      merely untidiness.
#
# The AP could not have worked anyway: openwrt-singlebox:24.10.2 ships
# /usr/share/hostap/hostapd.uc without the ucode `common` module it imports, so
# hostapd exits before it ever touches the radio. Fixing that image is a
# separate concern - it does not belong on the shipping path either way.
#
# With the policy off we do not detect, do not move the phy, and never start
# hostapd, so a `failed` unit now means a REAL failure of the overlay-NAT /
# rpcd / routing legs.
AP_ONBOARD="${DROPLET_AP_ONBOARD:-0}"
AP_POLICY_OFF=0
if [ "$AP_ONBOARD" = 1 ]; then
  detect_ap_radio
  # A previous policy-off boot leaves the radio soft-blocked. An opt-in that
  # silently kept it blocked would present as "the AP still does not work" -
  # the very symptom this ticket is about - so undo it here rather than making
  # the operator discover rfkill on their own.
  if command -v rfkill >/dev/null 2>&1; then
    rfkill unblock wlan 2>/dev/null || true
  fi
else
  AP_POLICY_OFF=1
  # Force both sides empty even if an operator left a stale DROPLET_AP_PHY /
  # DROPLET_AP_IFACE pin in the env file: that pin is AUTHORITATIVE elsewhere in
  # this script, so without this it would carry the AP phase straight past the
  # WARP-2150 gate onto a radio policy says must not be used.
  AP_PHY=""
  AP_IFACE=""
  # Deactivate, do not merely ignore: a powered-but-unused radio is still a
  # transmitter, and the rule says the radio is off. rfkill is chip-agnostic
  # (unlike a modprobe blacklist, which only helps if you already know the
  # card), so this holds on whatever is seated.
  # Bluetooth is a SEPARATE rfkill class and is deliberately NOT touched -
  # Matter BLE commissioning needs the adapter, and on the MT7922 it is a
  # different USB function of the same chip.
  if command -v rfkill >/dev/null 2>&1; then
    rfkill block wlan 2>/dev/null || true
  fi
  echo "droplet-openwrt-attach: onboard radio DISABLED by policy (WARP-2054 founder rule) - Wi-Fi is served by the external AP; radio soft-blocked and not moved into the container. Set DROPLET_AP_ONBOARD=1 in /etc/default/droplet-openwrt-attach for a dev-only on-box AP."
fi
# <<< onboard_radio_policy (WARP-2054)

# WARP-2150: decide ONCE whether the AP phase may run at all. The first
# validated fresh install (2026-08-24) shipped a host without iw(8): line 449
# died with `iw: command not found`, detect_ap_radio resolved iface='' (its iw
# map was empty), and the attach then LIMPED ON into the AP phase — emitting
# nft rules with an empty iifname ("Empty string is not allowed"), `ip link set
# "" up` ("Device \"\" does not exist"), and three doomed hostapd retries,
# before failing the unit with a misleading "AP/package prerequisites" message.
# An empty AP_IFACE can never produce a working AP, so gate the whole AP phase
# on it here and say WHY in one actionable line. AP_ATTACH is exported into the
# container body (docker exec -e) where the AP-phase blocks honor it; every
# non-AP duty (eth0 unbridge, package install, root pw, rpcd ACL, WG overlay
# NAT, routing recovery) still runs.
#
# Unit semantics — succeed-degraded, deliberately: nothing in the fleet gates
# on this unit's failure (no Requires=/OnFailure= anywhere in scripts/host; the
# only consumer is provision_single_box_openwrt, which merely log_warns), so
# failing here buys no automation — and a hard fail would poison the WARP-843
# reapply path on a box whose radio already lives in the container netns (the
# host then resolves iface='' while the AP is healthily up). The WARP-826b
# fail-loud doctrine stays intact for the case where the AP SHOULD start and
# hostapd actually fails; here we deliberately never start it and say why.
# >>> ap_attach_gate (WARP-2150)
AP_ATTACH=1
if [ -z "$AP_IFACE" ]; then
  AP_ATTACH=0
  if [ "${AP_POLICY_OFF:-0}" = 1 ]; then
    _ap_skip_why="the onboard radio is disabled by policy (WARP-2054 founder rule) - this is the intended shipping state, not a fault"
  elif ! command -v iw >/dev/null 2>&1; then
    _ap_skip_why="the host has no iw(8) installed, so the phy cannot be mapped to its netdev — run: sudo apt-get install -y iw (setup.sh now ensures it)"
  elif [ -z "$AP_PHY" ]; then
    _ap_skip_why="no wireless phy visible on the host (no card seated, or the radio already lives in the container netns)"
  else
    _ap_skip_why="phy ${AP_PHY} exposes no netdev to bind"
  fi
  # Under the WARP-2054 policy this is the intended state and already logged
  # above, so do not tell the operator to "fix the cause" of something we
  # deliberately did.
  if [ "${AP_POLICY_OFF:-0}" != 1 ]; then
    echo "droplet-openwrt-attach: WARN: wireless iface unresolved — skipping AP bring-up (${_ap_skip_why}); no nft/hostapd will be attempted with an empty iface. Fix the cause or pin DROPLET_AP_PHY/DROPLET_AP_IFACE in /etc/default/droplet-openwrt-attach, then: systemctl restart droplet-openwrt-attach"
  fi
fi
# <<< ap_attach_gate (WARP-2150)

# Guest BSS surfaces as its own netdev derived from the AP iface (e.g.
# wlp14s0_g) now that detect_ap_radio has filled AP_IFACE. The short "_g" suffix
# keeps it <=15 chars (IFNAMSIZ). Empty AP_IFACE (no radio) yields a harmless
# "_g" that the GUEST_ENABLED guards below never act on.
[ -n "$GUEST_IFACE" ] || GUEST_IFACE="${AP_IFACE}_g"

for i in $(seq 1 60); do
  state=$(docker inspect -f '{{.State.Running}}' droplet-openwrt 2>/dev/null)
  [ "$state" = "true" ] && break
  sleep 1
done
[ "$state" = "true" ] || { echo "droplet-openwrt not running"; exit 1; }

PID=$(docker inspect -f '{{.State.Pid}}' droplet-openwrt)
IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' droplet-openwrt)
GW=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}' droplet-openwrt)

# Resolve dashboard gateway IP at attach time — it's stable in practice but
# we read it fresh so a docker-compose recreate that shuffles IPs is handled.
# Wait for a valid IPv4 here: at boot this can run before the gateway container
# has been assigned its IP, and wiring a DNAT with an empty/garbage value makes
# the fw4 reload fail ("syntax error, unexpected colon"), so the AP zone never
# activates — and the failed unit then triggers a systemd retry that re-moves
# and re-indexes the radio (phy0->phy1), breaking the AP. Bounded ~60s.
GATEWAY_IP=""
for _gwtry in $(seq 1 30); do
  _gw=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$GATEWAY_CONTAINER" 2>/dev/null) || {
    echo "$GATEWAY_CONTAINER container not found — cannot wire DNAT"; exit 1
  }
  case "$_gw" in
    ''|*[!0-9.]*) sleep 2 ;;
    *.*.*.*)
      # Reject multi-network concatenations (e.g. 172.18.0.5172.20.0.3) and
      # transient 0.0.0.0: the glob *.*.*.*  accepts both, so require exactly
      # four dot-separated decimal octets and a non-zero address.
      if [[ "$_gw" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && [[ "$_gw" != "0.0.0.0" ]]; then
        GATEWAY_IP="$_gw"; break
      else
        sleep 2
      fi
      ;;
    *) sleep 2 ;;
  esac
done
[ -n "$GATEWAY_IP" ] || { echo "$GATEWAY_CONTAINER has no valid IPv4 after waiting — cannot wire DNAT"; exit 1; }

# Phase L: read OpenWrt root password from the docker secret so we can
# (re)set it inside the container on every attach. Empty -> skip the set,
# but log so the operator notices.
OPENWRT_ROOT_PW=""
if [ -r "$OPENWRT_PASSWORD_FILE" ]; then
  OPENWRT_ROOT_PW=$(tr -d '\n' < "$OPENWRT_PASSWORD_FILE")
fi
if [ -z "$OPENWRT_ROOT_PW" ]; then
  echo "warn: OpenWrt password secret at $OPENWRT_PASSWORD_FILE is empty or unreadable"
  echo "       routing service will not be able to auth to ubus until this is set"
fi

# Move the AP phy into the container netns (no-op if it's already there
# from a prior attach run). Phy choice driven by $AP_PHY so the operator
# picks which radio carries the customer AP — e.g. mt7921e/phy0 for full
# 22 dBm and Wi-Fi 6, vs iwlwifi/phy1 capped at 3 dBm in AP mode.
# WARP-2150: only when the AP phase is live (a phy moved with no netdev
# resolved would just strand the radio), and only through a guarded iw — the
# bare invocation was the live `line 449: iw: command not found` crash on the
# first validated fresh install.
if [ "$AP_ATTACH" = 1 ] && [ -e "/sys/class/ieee80211/$AP_PHY" ]; then
  if command -v iw >/dev/null 2>&1; then
    iw phy "$AP_PHY" set netns "$PID"
  else
    echo "droplet-openwrt-attach: WARN: iw(8) not installed on the host — cannot move $AP_PHY into the container netns (AP bring-up will fail); run: sudo apt-get install -y iw" >&2
  fi
fi

# WARP-1364: bridge the main-BSS AP into the host's br-lan so Wi-Fi clients
# share L2 with the host netns. ADR-022 (matter-controller host sidecar)
# rests on the host being able to multicast to the Droplet's own Wi-Fi
# clients "natively" — the routed-AP shape (wlp14s0 holding 192.168.20.1/24
# inside the container netns with its own dnsmasq-ap) broke that premise:
# a Matter device provisioned onto the AP joins Wi-Fi, then the sidecar can
# neither hear its operational mDNS nor route to it, and commissioning
# aborts at the Reconnect step (proven live on .87, 2026-07-17, GE Cync).
# Bridged mode: hostapd enslaves the radio into a container-local br-ap,
# which a veth pair trunks into the host br-lan — one 192.168.20.0/24 L2
# for wired + Wi-Fi + host. The host-net dnsmasq (already authoritative on
# br-lan) serves DHCP/DNS; dnsmasq-ap retires; the guest BSS stays routed
# and isolated in-container exactly as before. DROPLET_AP_BRIDGE=0 forces
# the legacy routed shape; any bridge-setup failure demotes to routed too,
# so Wi-Fi never dies harder than the status quo.
# >>> ap_bridge_veth (WARP-1364)
AP_BRIDGE="${DROPLET_AP_BRIDGE:-1}"
if [ "$AP_BRIDGE" = 1 ] && ! ip link show br-lan >/dev/null 2>&1; then
  echo "droplet-openwrt-attach: WARN: host br-lan not found — falling back to routed AP mode"
  AP_BRIDGE=0
fi
if [ "$AP_BRIDGE" = 1 ]; then
  # Idempotent across re-attach AND container recreate: a live veth pair has
  # both ends; a container recreate strands the host end (peer dies with the
  # old netns) so a missing container end means recreate the pair.
  if ! ip link show veth-dap >/dev/null 2>&1 || \
     ! docker exec droplet-openwrt ip link show veth-dapc >/dev/null 2>&1; then
    ip link del veth-dap 2>/dev/null
    docker exec droplet-openwrt ip link del veth-dapc 2>/dev/null
    if ip link add veth-dap type veth peer name veth-dapc && \
       ip link set veth-dapc netns "$PID"; then
      echo "droplet-openwrt-attach: created veth-dap<->veth-dapc (host br-lan <-> container br-ap)"
    else
      echo "droplet-openwrt-attach: WARN: veth pair creation failed — falling back to routed AP mode"
      ip link del veth-dap 2>/dev/null
      AP_BRIDGE=0
    fi
  fi
fi
if [ "$AP_BRIDGE" = 1 ]; then
  if ! ip link set veth-dap master br-lan up; then
    echo "droplet-openwrt-attach: WARN: could not enslave veth-dap into br-lan — falling back to routed AP mode"
    AP_BRIDGE=0
  fi
fi
# <<< ap_bridge_veth (WARP-1364)

docker exec -i \
  -e CONT_IP="$IP" -e CONT_GW="$GW" \
  -e GATEWAY_IP="$GATEWAY_IP" \
  -e AP_SSID="$AP_SSID" -e AP_PSK="$AP_PSK" \
  -e AP_IFACE="$AP_IFACE" -e AP_BRIDGE="$AP_BRIDGE" \
  -e AP_ATTACH="$AP_ATTACH" \
  -e AP_DOMAIN="$AP_DOMAIN" -e AP_HOSTNAME="$AP_HOSTNAME" \
  -e PUBLIC_FQDN="$PUBLIC_FQDN" \
  -e GUEST_SSID="$GUEST_SSID" -e GUEST_PSK="$GUEST_PSK" \
  -e GUEST_ENABLED="$GUEST_ENABLED" -e GUEST_IFACE="$GUEST_IFACE" \
  -e GUEST_GW="$GUEST_GW" \
  -e OPENWRT_ROOT_PW="$OPENWRT_ROOT_PW" \
  droplet-openwrt sh -c '
  # Container network bootstrap (CONT_IP/CONT_GW/GATEWAY_IP/AP_* from env).
  # NB: do this FIRST and again AFTER any /etc/init.d/network restart, since
  # netifd restart wipes Dockers pre-assigned eth0 IP and breaks docker-proxy.
  #
  # 2026-05-18 fix: the stock OpenWrt 24.10.2 rootfs ships a config that
  # bridges eth0 into br-lan with IP 192.168.1.1/24. Inside a docker
  # container that means kernel routes L3 through br-lan, not through
  # eth0 — Dockers 172.18.0.10 IP on eth0 is a phantom address that
  # never carries traffic. Symptom cascade: cant ping 8.8.8.8 →
  # opkg install silently fails → hostapd never installs → no AP.
  # And host->container:8081 RPC times out because the SYN-ACK gets
  # routed back through br-lan instead of eth0.
  #
  # Fix is two-layered: (a) UCI delete eth0 from br-lans port list so
  # /etc/init.d/network restart wont re-bridge it, (b) `ip link set
  # eth0 nomaster` here so the running kernel state is corrected even
  # before network restart fires. Both are idempotent — no-op if eth0
  # is already standalone or the UCI entry is already gone.
  unbridge_eth0() {
    # Runtime: detach eth0 from whatever bridge it might be in.
    ip link set eth0 nomaster 2>/dev/null
    # Persist: remove eth0 from the br-lan UCI device port list so the
    # next /etc/init.d/network restart doesnt re-attach it.
    if uci -q show network | grep -q "ports=.*eth0"; then
      uci -q del_list network.@device[0].ports=eth0 2>/dev/null
      uci -q commit network
    fi
  }
  unbridge_eth0
  bootstrap_net() {
    # eth0 must be UP — network restart can leave it DOWN.
    ip link set eth0 up 2>/dev/null
    ip addr show eth0 | grep -q "$CONT_IP" || ip addr add "${CONT_IP}/16" dev eth0
    ip route | grep -q "^default" || ip route add default via "$CONT_GW"
  }
  bootstrap_net
  grep -q 8.8.8.8 /etc/resolv.conf 2>/dev/null || {
    echo "nameserver 8.8.8.8" > /etc/resolv.conf
    echo "nameserver 1.1.1.1" >> /etc/resolv.conf
  }
  echo 1 > /proc/sys/net/ipv4/ip_forward

  # Install packages if missing (wiped by --force-recreate; will move to a
  # custom Dockerfile baked into compose build context for production).
  # Phase L: added wireguard-tools, kmod-wireguard, luci-proto-wireguard
  # so the routing service can mint VPN peers against this container.
  # KAN-9: added miniupnpd so the dashboard UPnP / NAT-PMP card lights up
  # (the routing SDK reads /etc/config/upnpd; absent it the card is "Not
  # available"). Like the VPN packages it is NOT load-bearing for the AP, so it stays out of
  # the hard-verify gate. The image bakes it + a disabled-by-default upnpd
  # config; this runtime install is the safety net for pre-bake containers.
  NEED_INSTALL=0
  command -v hostapd >/dev/null || NEED_INSTALL=1
  command -v wg >/dev/null      || NEED_INSTALL=1
  [ -f /lib/netifd/proto/wireguard.sh ] || NEED_INSTALL=1
  # Fresh-provision fix: umdns is the mDNS daemon the routing service
  # browses for _droplet-ap._tcp (AP auto-discovery, ADR-005). Stock
  # openwrt/rootfs ships without it, so a fresh container / post-factory-
  # reset box loses AP discovery entirely until it is installed. Trigger a
  # (re)install when the binary is absent.
  [ -x /usr/sbin/umdns ] || NEED_INSTALL=1
  # >>> install_ap_pkgs (WARP-826b)
  # Install the AP/router packages, hardened against the first-boot race where
  # the container has no internet yet — a single opkg attempt then silently
  # fails and the AP never installs (the failure mode at L276, seen live on the
  # .87 box: hostapd + iw absent, attach still exited 0). Wait for the feed,
  # retry update + install, and NEVER hide a persistent failure. Knobs default to
  # prod values; the unit tests shrink them: OPKG_FEED_TRIES / OPKG_INSTALL_TRIES
  # / OPKG_RETRY_SLEEP.
  install_ap_pkgs() {
    _feed_tries="${OPKG_FEED_TRIES:-12}"
    _inst_tries="${OPKG_INSTALL_TRIES:-3}"
    _nap="${OPKG_RETRY_SLEEP:-5}"
    # Capture (do NOT swallow) the last opkg output so a hard-fail can SURFACE the
    # real error — a generic "feed unreachable" line hides whether it was DNS, no
    # route, a 404 feed, or a dependency conflict, which is what an operator needs.
    _upd_out=""
    _inst_out=""
    _i=1
    _feed_ok=0
    while [ "$_i" -le "$_feed_tries" ]; do
      _upd_out="$(opkg update 2>&1)"; _upd_rc=$?
      if [ "$_upd_rc" -eq 0 ]; then _feed_ok=1; break; fi
      sleep "$_nap"
      _i=$((_i + 1))
    done
    [ "$_feed_ok" = 1 ] || echo "droplet-openwrt-attach: ERROR: opkg feed unreachable after ${_feed_tries} tries — AP/router packages cannot install until container connectivity returns" >&2
    _i=1
    while [ "$_i" -le "$_inst_tries" ]; do
      _inst_out="$(opkg install \
        hostapd-mbedtls hostapd-utils wireless-regdb iw-full \
        uhttpd uhttpd-mod-ubus rpcd rpcd-mod-rpcsys rpcd-mod-iwinfo rpcd-mod-file \
        umdns \
        wireguard-tools kmod-wireguard luci-proto-wireguard \
        miniupnpd \
        2>&1)"; _inst_rc=$?
      [ "$_inst_rc" -eq 0 ] && break
      sleep "$_nap"
      _i=$((_i + 1))
    done
    # Hard-verify the load-bearing AP binaries actually landed — BOTH hostapd and
    # iw (iw is required for nl80211 phy/iface control; a present hostapd with no
    # iw still cannot bring the radio into AP mode). Do NOT return success with a
    # silently-broken AP (the recurring L276 failure this guards).
    if command -v hostapd >/dev/null 2>&1 && command -v iw >/dev/null 2>&1; then
      return 0
    fi
    echo "droplet-openwrt-attach: ERROR: AP prerequisites still missing after opkg install retries — the default Wi-Fi AP cannot start:" >&2
    command -v hostapd >/dev/null 2>&1 || echo "  - hostapd not installed" >&2
    command -v iw >/dev/null 2>&1      || echo "  - iw not installed" >&2
    # Surface the captured opkg output so the journal shows the ROOT cause, not
    # just the symptom (the brief: do not swallow opkg output on the failure path).
    echo "droplet-openwrt-attach: last opkg update output:" >&2
    printf "%s\n" "$_upd_out" >&2
    echo "droplet-openwrt-attach: last opkg install output:" >&2
    printf "%s\n" "$_inst_out" >&2
    return 1
  }
  # <<< install_ap_pkgs (WARP-826b)
  if [ "$NEED_INSTALL" = 1 ]; then
    # Propagate a persistent install failure: exit the docker-exec body non-zero
    # so EXEC_RC in the outer script carries a failed status to the oneshot
    # systemd unit. Limping on with no hostapd/iw is the silent no-AP this whole
    # change exists to prevent (the live .87 failure) — fail loud + visible, do
    # NOT mask it with `|| true`.
    if ! install_ap_pkgs; then
      exit 1
    fi
    # netifd was started before luci-proto-wireguard arrived, so it didnt
    # load the wireguard protocol handler. Restart it so ifup wg0 works
    # for any subsequent peer-add via the routing service.
    /etc/init.d/network restart >/dev/null 2>&1
    sleep 2
    # network restart wiped eth0s docker IP + default route AND may have
    # re-bridged eth0 into br-lan if the UCI delete above didnt take —
    # re-run unbridge before bootstrap so the new IP lands on the actual
    # L3 interface, not on a bridge port that the kernel ignores.
    unbridge_eth0
    bootstrap_net
    # uhttpd binds to eth0 too; nudge it so docker-proxy can talk to ubus.
    /etc/init.d/uhttpd restart >/dev/null 2>&1
  fi

  # Fresh-provision fix: enable + start umdns every attach (idempotent). The
  # routing service browses it for _droplet-ap._tcp; without it the
  # /aps/discovered call returns a ubus error and AP auto-discovery never
  # sees a plugged-in AP.
  /etc/init.d/umdns enable >/dev/null 2>&1
  /etc/init.d/umdns restart >/dev/null 2>&1
  echo "droplet-openwrt-attach: umdns enabled + started (_droplet-ap._tcp discovery)"

  # Fresh-provision fix: unbridge_eth0 (above) pulls eth0 out of br-lan,
  # which also drops it out of the lan firewall zone, so fw4 DROPs input on
  # eth0 and the host docker-proxy:8181 -> uhttpd ubus path is refused. The
  # routing service then crash-loops at startup (Connection reset by peer).
  # Re-add eth0 as a device on the lan zone so management input (ubus on
  # :80) is accepted on the host-only docker interface. Idempotent; eth0 is
  # a host-only docker veth (172.18.0.0/16), never the LAN or WAN.
  trust_eth0_fw() {
    lansec=$(uci show firewall 2>/dev/null | grep "\.name=.lan." | head -1 | cut -d. -f2)
    [ -n "$lansec" ] || { echo "droplet-openwrt-attach: WARN: no lan firewall zone found; eth0 left untrusted (router may be unreachable)"; return 0; }
    uci -q get "firewall.$lansec.device" 2>/dev/null | grep -qw eth0 || \
      uci add_list "firewall.$lansec.device=eth0"
    # A read-only overlay right after a docker restart (see the session-cache
    # note below) makes commit/reload fail silently, leaving the router
    # unreachable with no breadcrumb — warn so the attach log shows why ubus
    # input is refused, matching the OPENWRT_ROOT_PW warn above.
    if uci -q commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; then
      echo "droplet-openwrt-attach: eth0 trusted on lan zone $lansec (ubus input accepted)"
    else
      echo "droplet-openwrt-attach: WARN: firewall commit/reload failed; eth0 may stay DROPped (router unreachable)"
    fi
  }
  trust_eth0_fw

  # WARP-810: put the AP iface ($AP_IFACE, e.g. wlp14s0) into its own fw4
  # firewall zone. Field-confirmed bug on the single-box: the AP comes up at
  # 192.168.20.1/24 with dnsmasq-ap serving DHCP, but $AP_IFACE is in NO zone.
  # The inet fw4 input chain is policy-drop and only accepts new input from the
  # lan zone (eth0 + br-lan), so a client DHCP DISCOVER (new, not established)
  # is DROPped -> the phone associates to hostapd but never gets a lease (~15s
  # timeout, looks like "cannot connect"). The fix:
  #   - a zone named "ap" covering $AP_IFACE with input=ACCEPT, so DHCP (:67)
  #     and DNS (:53) reach dnsmasq-ap. This is the critical "get an IP" fix.
  #   - forwarding ap -> lan, because on the single-box the real uplink is the
  #     docker veth eth0, which trust_eth0_fw (above) places in the lan zone;
  #     the baked lan->wan forwarding then chains AP egress onward when a wan
  #     member exists. (The baked wan zone has no live member on this box, so
  #     forwarding to wan would be a dead end here.)
  #   - a fw4 NAT MASQUERADE scoped to the AP subnet (192.168.20.0/24) leaving
  #     the lan zone, so AP clients reach the internet. Scoping to src_ip keeps
  #     it from double-NATing the lan zone own clients on the multi-box shape
  #     (their 192.168.50.x source never matches).
  # Mechanism is UCI + fw4 reload, mirroring trust_eth0_fw. Idempotent: every
  # section is upserted by a stable name (zone "ap" / forwarding
  # "droplet_ap_fwd" / nat "droplet_ap_masq"), and the device list is guarded,
  # so re-running the attach never duplicates config. Default-drop input stays
  # intact for every other interface (no global defaults flip, no policy
  # accept). NB: NO APOSTROPHES in this block (single-quoted docker exec body).
  # >>> ap_firewall_zone (WARP-810)
  ap_firewall_zone() {
    apif="${AP_IFACE:-wlp14s0}"
    # Egress zone = wherever the uplink iface lives. On the single-box eth0 is
    # pulled into the lan zone by trust_eth0_fw; on multi-box lan is br-lan.
    lansec=$(uci show firewall 2>/dev/null | grep "\.name=.lan." | head -1 | cut -d. -f2)
    if [ -z "$lansec" ]; then
      echo "droplet-openwrt-attach: WARN: no lan firewall zone found; AP zone left unrouted (Wi-Fi clients get no internet)"
    fi

    # --- AP zone (named, so it is upsert-able) ---------------------------
    if ! uci -q get firewall.droplet_ap >/dev/null 2>&1; then
      uci set firewall.droplet_ap=zone
    fi
    uci set firewall.droplet_ap.name=ap
    uci set firewall.droplet_ap.input=ACCEPT
    uci set firewall.droplet_ap.output=ACCEPT
    # forward=REJECT on the zone itself keeps AP clients from reaching the LAN
    # unfiltered; cross-zone routing is opened explicitly via the forwarding
    # section below (ap -> lan -> wan), never a blanket forward.
    uci set firewall.droplet_ap.forward=REJECT
    # Bind the AP iface to the zone by device. Guarded so a second run does not
    # append a duplicate (uci add_list has list semantics and would dupe).
    if ! uci -q get firewall.droplet_ap.device 2>/dev/null | grep -qw "$apif"; then
      uci add_list "firewall.droplet_ap.device=$apif"
    fi

    # --- forwarding ap -> lan (egress path) ------------------------------
    if [ -n "$lansec" ]; then
      lanname=$(uci -q get "firewall.$lansec.name" 2>/dev/null)
      [ -n "$lanname" ] || lanname=lan
      if ! uci -q get firewall.droplet_ap_fwd >/dev/null 2>&1; then
        uci set firewall.droplet_ap_fwd=forwarding
      fi
      uci set firewall.droplet_ap_fwd.src=ap
      uci set firewall.droplet_ap_fwd.dest="$lanname"

      # --- NAT: masquerade AP-subnet egress out the lan (uplink) zone ----
      if ! uci -q get firewall.droplet_ap_masq >/dev/null 2>&1; then
        uci set firewall.droplet_ap_masq=nat
      fi
      uci set firewall.droplet_ap_masq.name=droplet_ap_masq
      uci set firewall.droplet_ap_masq.src="$lanname"
      uci set firewall.droplet_ap_masq.src_ip=192.168.20.0/24
      uci set firewall.droplet_ap_masq.target=MASQUERADE
    fi

    if uci -q commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; then
      echo "droplet-openwrt-attach: AP zone configured ($apif input=ACCEPT, forward ap->${lanname:-lan}, masq 192.168.20.0/24) — Wi-Fi clients can DHCP + reach internet"
    else
      echo "droplet-openwrt-attach: WARN: firewall commit/reload failed; AP zone may not be active (Wi-Fi clients may not get a lease)"
    fi
  }
  # WARP-1364: the fw4 AP zone exists to let ROUTED-mode clients DHCP against
  # dnsmasq-ap and egress via eth0. In bridged mode wlp14s0 is an L2 port on
  # br-ap — client traffic never enters this netns at L3, DHCP is served by
  # the host, and the zone would only emit misleading WARNs. Skip it.
  if [ "${AP_BRIDGE:-0}" = 1 ]; then
    echo "droplet-openwrt-attach: bridged AP mode — skipping fw4 AP zone (host serves DHCP/DNS)"
  else
    ap_firewall_zone
  fi
  # <<< ap_firewall_zone (WARP-810)

  # Guest Wi-Fi firewall zone — mirrors droplet_ap but DEFAULT-DENY on input
  # (only DHCP/DNS are opened, via explicit rules) so guests reach the internet
  # ONLY, never the router/dashboard. forward=REJECT on the zone keeps guests off
  # the LAN; an explicit guest->lan(uplink) forwarding + a masq scoped to the
  # guest subnet (192.168.30.0/24) give internet egress. Client-to-client
  # isolation is enforced at hostapd (ap_isolate=1 on the guest BSS). Idempotent,
  # upsert-able by stable section names, and tears the zone DOWN when guest is
  # disabled. NB: NO APOSTROPHES in this block (single-quoted docker exec body).
  # >>> guest_firewall_zone (guest Wi-Fi)
  guest_firewall_zone() {
    gif="${GUEST_IFACE:-wlp14s0_g}"
    lansec=$(uci show firewall 2>/dev/null | grep "\.name=.lan." | head -1 | cut -d. -f2)

    # Remove static image-overlay sections that share the same fw4 zone name;
    # the dynamic droplet_guest* sections below are the canonical source.
    for s in guest_zone guest_to_wan guest_dhcp guest_dns; do
      uci -q delete "firewall.$s" 2>/dev/null
    done

    # Teardown when guest is off: delete every guest section, then reload.
    if [ "${GUEST_ENABLED:-0}" != 1 ]; then
      for s in droplet_guest droplet_guest_fwd droplet_guest_masq droplet_guest_dhcp droplet_guest_dns; do
        uci -q delete "firewall.$s" 2>/dev/null
      done
      if uci -q commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; then
        echo "droplet-openwrt-attach: guest firewall zone removed (guest Wi-Fi off)"
      fi
      return 0
    fi

    # --- guest zone (named, upsert-able) ---------------------------------
    if ! uci -q get firewall.droplet_guest >/dev/null 2>&1; then
      uci set firewall.droplet_guest=zone
    fi
    uci set firewall.droplet_guest.name=guest
    # input=REJECT: guests get NO router services except the DHCP/DNS opened by
    # the two rules below (the brief: input ACCEPT for DHCP/DNS only).
    uci set firewall.droplet_guest.input=REJECT
    uci set firewall.droplet_guest.output=ACCEPT
    uci set firewall.droplet_guest.forward=REJECT
    if ! uci -q get firewall.droplet_guest.device 2>/dev/null | grep -qw "$gif"; then
      uci add_list "firewall.droplet_guest.device=$gif"
    fi

    # --- DHCP + DNS input rules (the only input guests may reach) ---------
    if ! uci -q get firewall.droplet_guest_dhcp >/dev/null 2>&1; then
      uci set firewall.droplet_guest_dhcp=rule
    fi
    uci set firewall.droplet_guest_dhcp.name=Allow-Guest-DHCP
    uci set firewall.droplet_guest_dhcp.src=guest
    uci set firewall.droplet_guest_dhcp.proto=udp
    uci set firewall.droplet_guest_dhcp.dest_port=67-68
    uci set firewall.droplet_guest_dhcp.target=ACCEPT

    if ! uci -q get firewall.droplet_guest_dns >/dev/null 2>&1; then
      uci set firewall.droplet_guest_dns=rule
    fi
    uci set firewall.droplet_guest_dns.name=Allow-Guest-DNS
    uci set firewall.droplet_guest_dns.src=guest
    uci set firewall.droplet_guest_dns.proto=tcpudp
    uci set firewall.droplet_guest_dns.dest_port=53
    uci set firewall.droplet_guest_dns.target=ACCEPT

    # --- forwarding guest -> lan (uplink) + masq the guest subnet --------
    if [ -n "$lansec" ]; then
      lanname=$(uci -q get "firewall.$lansec.name" 2>/dev/null)
      [ -n "$lanname" ] || lanname=lan
      if ! uci -q get firewall.droplet_guest_fwd >/dev/null 2>&1; then
        uci set firewall.droplet_guest_fwd=forwarding
      fi
      uci set firewall.droplet_guest_fwd.src=guest
      uci set firewall.droplet_guest_fwd.dest="$lanname"

      if ! uci -q get firewall.droplet_guest_masq >/dev/null 2>&1; then
        uci set firewall.droplet_guest_masq=nat
      fi
      uci set firewall.droplet_guest_masq.name=droplet_guest_masq
      uci set firewall.droplet_guest_masq.src=guest
      uci set firewall.droplet_guest_masq.src_ip=192.168.30.0/24
      uci set firewall.droplet_guest_masq.target=MASQUERADE
    else
      echo "droplet-openwrt-attach: WARN: no lan firewall zone found; guest zone left unrouted (guests get no internet)"
    fi

    if uci -q commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; then
      echo "droplet-openwrt-attach: guest zone configured ($gif input=REJECT+DHCP/DNS, forward guest->${lanname:-lan}, masq 192.168.30.0/24, client-isolated)"
    else
      echo "droplet-openwrt-attach: WARN: firewall commit/reload failed; guest zone may not be active"
    fi
  }
  guest_firewall_zone
  # <<< guest_firewall_zone (guest Wi-Fi)

  # Phase L: set root password from $OPENWRT_ROOT_PW so the routing services
  # rpcd login works. Idempotent. WARP-834: stock OpenWrt ships root with an
  # EMPTY password hash, and rpcd accepts ANY password against an empty-hash
  # account (field-confirmed on the box: ubus session login returned a session
  # for a bogus password while /etc/shadow showed "root:"). So the bare
  # login-with-the-secret probe never fails on a passwordless root and passwd
  # would be skipped, leaving root unprotected. Force the set when the hash is
  # still empty ("^root::"); otherwise fall back to the login probe so a later
  # rotation (hash already set to some OTHER value) still re-applies.
  if [ -n "$OPENWRT_ROOT_PW" ]; then
    if grep -q "^root::" /etc/shadow || ! ubus call session login "{\"username\":\"root\",\"password\":\"$OPENWRT_ROOT_PW\"}" >/dev/null 2>&1; then
      printf "%s\n%s\n" "$OPENWRT_ROOT_PW" "$OPENWRT_ROOT_PW" | passwd root >/dev/null 2>&1
      # rpcd caches sometimes; nudge it to re-read shadow
      /etc/init.d/rpcd restart >/dev/null 2>&1
    fi
  fi

  # --- Phase L: wg-sync helper -----------------------------------------
  # netifds wireguard.sh proto handler doesnt cleanly re-apply UCI peer
  # changes to a running wg0 in this container (ubus call network reload
  # times out). Workaround: when the routing service writes a peer via
  # uci.apply, /etc/config/network is rewritten — we poll-watch UCI peer
  # hash and call `wg syncconf wg0 <runtime-conf>` to push to the kernel.
  # ~2s propagation, no interface bounce.
  mkdir -p /usr/local/sbin
  cat > /usr/local/sbin/wg-sync <<"WGSYNC"
#!/bin/sh
# Apply UCI WireGuard peer state to the running wg0 interface via wg syncconf.
# Idempotent; safe to call on every network commit.
IFACE="${1:-wg0}"
ip link show "$IFACE" >/dev/null 2>&1 || exit 0
SRV_PK=$(uci -q get network.$IFACE.private_key) || exit 0
SRV_PORT=$(uci -q get network.$IFACE.listen_port)
CONF=$(mktemp -t wg-runtime.XXXXXX)
{
  echo "[Interface]"
  echo "PrivateKey = $SRV_PK"
  [ -n "$SRV_PORT" ] && echo "ListenPort = $SRV_PORT"
  i=0
  while uci -q get network.@wireguard_${IFACE}[$i].public_key >/dev/null 2>&1; do
    PK=$(uci -q get network.@wireguard_${IFACE}[$i].public_key)
    AIP=$(uci -q get network.@wireguard_${IFACE}[$i].allowed_ips)
    KA=$(uci -q get network.@wireguard_${IFACE}[$i].persistent_keepalive)
    EP=$(uci -q get network.@wireguard_${IFACE}[$i].endpoint_host)
    EPP=$(uci -q get network.@wireguard_${IFACE}[$i].endpoint_port)
    echo ""
    echo "[Peer]"
    echo "PublicKey = $PK"
    [ -n "$AIP" ] && echo "AllowedIPs = $AIP"
    [ -n "$KA" ]  && echo "PersistentKeepalive = $KA"
    if [ -n "$EP" ]; then
      [ -n "$EPP" ] && echo "Endpoint = $EP:$EPP" || echo "Endpoint = $EP"
    fi
    i=$((i+1))
  done
} > "$CONF"
wg syncconf "$IFACE" "$CONF" 2>&1
rc=$?
rm -f "$CONF"
exit $rc
WGSYNC
  chmod +x /usr/local/sbin/wg-sync

  # 2-second poll loop — busybox in this image lacks inotifyd, so we just
  # re-run wg-sync periodically. wg syncconf is idempotent, so the no-change
  # case is a cheap noop. Wraps the call in a hash check so the log only
  # records actual changes.
  cat > /usr/local/sbin/wg-sync-loop <<"WGLOOP"
#!/bin/sh
LAST=""
while true; do
  HASH=$(uci show network 2>/dev/null | grep -E "^network\.(wg0\.|@wireguard_wg0\[)" | md5sum | cut -d" " -f1)
  if [ "$HASH" != "$LAST" ]; then
    /usr/local/sbin/wg-sync wg0 >>/tmp/wg-sync.log 2>&1
    LAST="$HASH"
  fi
  sleep 2
done
WGLOOP
  chmod +x /usr/local/sbin/wg-sync-loop

  # Spawn the poll loop via start-stop-daemon (busybox applet) so it daemonizes
  # cleanly under PID 1 = /sbin/init, surviving docker exec returns.
  start-stop-daemon -K -q -p /var/run/wg-sync.pid 2>/dev/null
  rm -f /var/run/wg-sync.pid
  start-stop-daemon -S -b -m -p /var/run/wg-sync.pid -x /usr/local/sbin/wg-sync-loop
  # ---------------------------------------------------------------------

  # --- eth0 watchdog -----------------------------------------------------
  # OpenWrts procd / netifd brings eth0 DOWN seconds after this attach
  # script ends, because we removed the eth0 port from br-lans UCI device
  # entry (so docker-proxy can keep L3 ownership of 172.18.0.10/16). With
  # no UCI interface referencing eth0, netifd treats it as orphaned and
  # admin-downs it on every reconcile pass — which kills the routing
  # services next outbound RPC call before its docker healthcheck even
  # fires.
  #
  # Symmetry with the wg-sync poll loop above: a 2-second watchdog
  # idempotently re-asserts UP + the docker-assigned IP + default route
  # whenever it notices eth0 is missing them. Cheap (one ip-link-show
  # + a couple of grep checks per cycle) and the recovery is sub-second.
  # Storage target: /tmp, NOT /usr/local/sbin. The overlay upperdir
  # housing /usr/local/sbin is briefly read-only right after `docker
  # restart` while procd boots, so the first attach after every
  # container restart silently fails to write to /usr/local/sbin/...
  # (see the cluster of `Read-only file system` lines in the journal
  # from earlier attach runs). /tmp is a tmpfs mounted before procd
  # even starts, so writes always succeed there. The trade-off — the
  # watchdog file is wiped on container restart — is fine because the
  # attach script runs after every restart and rewrites it.
  cat > /tmp/eth0-keepalive <<"ETHWD"
#!/bin/sh
# eth0 watchdog. Bring eth0 back up + restore the docker IP/default
# route if procd/netifd has admin-downed it again.
IP_ADDR="${1:-172.18.0.10/16}"
GW="${2:-172.18.0.1}"
while true; do
  STATE=$(ip -o link show eth0 2>/dev/null | head -1)
  case "$STATE" in
    *"state UP"*) : ;;
    *)
      ip link set eth0 up 2>/dev/null
      ;;
  esac
  ip addr show eth0 2>/dev/null | grep -q "${IP_ADDR%/*}" || \
    ip addr add "$IP_ADDR" dev eth0 2>/dev/null
  ip route 2>/dev/null | grep -q "^default" || \
    ip route add default via "$GW" 2>/dev/null
  sleep 2
done
ETHWD
  chmod +x /tmp/eth0-keepalive

  start-stop-daemon -K -q -p /var/run/eth0-keepalive.pid 2>/dev/null
  rm -f /var/run/eth0-keepalive.pid
  start-stop-daemon -S -b -m -p /var/run/eth0-keepalive.pid \
    -x /tmp/eth0-keepalive -- "${CONT_IP}/16" "$CONT_GW"
  # ---------------------------------------------------------------------

  # --- ip nat table: masq egress + DNAT ingress for AP clients ----------
  nft list table ip nat >/dev/null 2>&1 || nft add table ip nat

  # postrouting: masq 192.168.20.0/24 going out eth0 — ROUTED mode only. In
  # bridged mode (WARP-1364) AP clients NAT on the HOST (its existing
  # 192.168.20.0/24 masquerade), and a container-side masq would only catch
  # strays; flush it so the container never NATs the bridged subnet.
  nft list chain ip nat postrouting >/dev/null 2>&1 || \
    nft add chain ip nat postrouting "{ type nat hook postrouting priority 100 ; }"
  if [ "${AP_BRIDGE:-0}" = 1 ]; then
    for h in $(nft -a list chain ip nat postrouting 2>/dev/null | grep "192.168.20.0/24" | grep -oE "handle [0-9]+" | awk "{print \$2}"); do
      nft delete rule ip nat postrouting handle $h
    done
  else
    nft list chain ip nat postrouting | grep -q "192.168.20.0/24" || \
      nft add rule ip nat postrouting ip saddr 192.168.20.0/24 oifname \"eth0\" masquerade
  fi

  # Guest subnet masq — same egress NAT, scoped to 192.168.30.0/24. Flush any
  # prior guest masq rule by handle first, then re-add ONLY when guest is on, so
  # a teardown (guest disabled) drops the rule too. (The fw4 droplet_guest_masq
  # is the UCI-managed equivalent; this raw rule is the single-box belt-and-
  # braces, mirroring the AP masq above whose fw4 masq may not fire when the
  # uplink is the docker veth eth0.)
  for h in $(nft -a list chain ip nat postrouting 2>/dev/null | grep "192.168.30.0/24" | grep -oE "handle [0-9]+" | awk "{print \$2}"); do
    nft delete rule ip nat postrouting handle $h
  done
  if [ "${GUEST_ENABLED:-0}" = 1 ]; then
    nft add rule ip nat postrouting ip saddr 192.168.30.0/24 oifname \"eth0\" masquerade
  fi

  # prerouting: DNAT $AP_IFACE:80/:443 -> gateway container so phones can hit
  # https://droplet.local/ (which resolves to 192.168.20.1) and land on nginx
  nft list chain ip nat prerouting >/dev/null 2>&1 || \
    nft add chain ip nat prerouting "{ type nat hook prerouting priority -100 ; }"
  # Flush prior DNAT rules so a gateway-IP change doesnt leave a stale target
  for h in $(nft -a list chain ip nat prerouting 2>/dev/null | grep "dnat to" | grep -oE "handle [0-9]+" | awk "{print \$2}"); do
    nft delete rule ip nat prerouting handle $h
  done
  # Critical: scope DNAT to traffic destined for 192.168.20.1 (the openwrt
  # AP IP) ONLY. Without the `ip daddr` predicate, every :80/:443 packet
  # leaving the AP gets hijacked to the dashboard gateway — so a client
  # browsing https://google.com ends up on the Droplet login page with a
  # cert mismatch (looks like a captive portal). With the daddr filter,
  # the rule only fires for clients explicitly hitting the router IP
  # (droplet.local resolves to 192.168.20.1 -> rule kicks in -> dashboard),
  # while everything else passes through to the real internet.
  # WARP-1364: the AP-iface DNAT is ROUTED-mode only. In bridged mode client
  # packets to 192.168.20.1 terminate on the HOST (docker-proxy publishes
  # :443/:80 on 0.0.0.0) without ever entering this netns at L3.
  # WARP-2150: and only when the host resolved a wireless iface — an empty
  # AP_IFACE renders iifname "" and nft rejects the whole rule (Empty string
  # is not allowed), which is exactly the fresh-install journal noise.
  if [ "${AP_ATTACH:-1}" = 1 ] && [ "${AP_BRIDGE:-0}" != 1 ]; then
    nft add rule ip nat prerouting iifname \"$AP_IFACE\" ip daddr 192.168.20.1 tcp dport 443 dnat to ${GATEWAY_IP}:443
    nft add rule ip nat prerouting iifname \"$AP_IFACE\" ip daddr 192.168.20.1 tcp dport 80  dnat to ${GATEWAY_IP}:80
  fi
  # WireGuard remote-access clients land on the same dashboard. Their peer
  # .conf (apps/orchestrator/src/services/vpn.service.ts) advertises
  # AllowedIPs = 192.168.20.0/24 + the tunnel subnet and DNS = 192.168.20.1,
  # so a connected phone has only one route to the dashboard:
  # https://192.168.20.1 — which arrives on wg0, not $AP_IFACE. Without
  # these two mirror rules the AP-scoped DNAT above never matches VPN
  # ingress and the dashboard is unreachable over the tunnel even with a
  # healthy handshake (observed on the .87 single-box, 2026-06-10). Same
  # daddr predicate, same hijack-avoidance rationale.
  nft add rule ip nat prerouting iifname \"wg0\" ip daddr 192.168.20.1 tcp dport 443 dnat to ${GATEWAY_IP}:443
  nft add rule ip nat prerouting iifname \"wg0\" ip daddr 192.168.20.1 tcp dport 80  dnat to ${GATEWAY_IP}:80
  # ----------------------------------------------------------------------

  # WARP-2150: the whole AP phase — hostapd conf + start + watchdog, dnsmasq-ap,
  # br-ap, the AP-iface L3/link-up, guest BSS L3 — is meaningless with an empty
  # AP_IFACE and used to grind through empty-iface errors plus three doomed
  # hostapd retries before failing the unit with a misleading package message.
  # The host decides AP_ATTACH once (see ap_attach_gate there); default 1 so an
  # unset env keeps the historical path. Interior deliberately NOT re-indented
  # (same style as the AP_BRIDGE routed/bridged blocks below). NB: NO
  # APOSTROPHES anywhere in this gated region (single-quoted docker exec body).
  # >>> ap_phase_gate (WARP-2150)
  if [ "${AP_ATTACH:-1}" = 1 ]; then

  # Stop procd dnsmasq so our manual one can bind 192.168.20.1
  /etc/init.d/dnsmasq stop 2>/dev/null
  /etc/init.d/dnsmasq disable 2>/dev/null

  # hostapd config — regenerate every run so SSID/PSK env changes propagate.
  # Wi-Fi 6 (HE) + HT enabled on 2.4 GHz ch 6; hostapd auto-falls back to
  # HT20 if 40 MHz neighbours preclude it (CCA scan during HT_SCAN state).
  # AC is intentionally absent — 802.11ac is 5 GHz only and would just emit
  # warnings here.
  # WARP-1364: in bridged mode hostapd itself enslaves the radio into br-ap
  # (created below) — the veth trunk to host br-lan completes the L2. The
  # var stays an empty line in routed mode so the CHANGED gate is stable.
  AP_BRIDGE_CONF=""
  [ "${AP_BRIDGE:-0}" = 1 ] && AP_BRIDGE_CONF="bridge=br-ap"

  cat > /etc/hostapd.conf.new <<HOSTAPD
interface=$AP_IFACE
$AP_BRIDGE_CONF
driver=nl80211
ssid=$AP_SSID
hw_mode=g
channel=6
country_code=US
ieee80211d=1
ieee80211n=1
ieee80211ax=1
ht_capab=[HT40+][SHORT-GI-20][SHORT-GI-40][DSSS_CCK-40]
he_oper_chwidth=0
he_oper_centr_freq_seg0_idx=8
wmm_enabled=1
auth_algs=1
wpa=2
wpa_passphrase=$AP_PSK
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
ieee80211w=1
HOSTAPD

  # Guest BSS — appended as a SECOND hostapd BSS on the SAME radio when guest
  # Wi-Fi is enabled with valid creds. The "# >>> droplet guest bss" marker lets
  # the start-failure fallback strip it (home AP only) so a guest misconfig or a
  # multi-BSS-unsupported card never takes the household Wi-Fi down. ap_isolate=1
  # isolates guest clients from each other; the guest firewall zone isolates them
  # from the LAN. NB: NO APOSTROPHES (single-quoted docker exec body).
  if [ "${GUEST_ENABLED:-0}" = 1 ] && [ -n "$GUEST_SSID" ]; then
    cat >> /etc/hostapd.conf.new <<HOSTAPDGUEST
# >>> droplet guest bss
bss=$GUEST_IFACE
ssid=$GUEST_SSID
auth_algs=1
wpa=2
wpa_passphrase=$GUEST_PSK
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
ieee80211w=1
ap_isolate=1
HOSTAPDGUEST
  fi

  HOSTAPD_CHANGED=0
  if [ ! -f /etc/hostapd.conf ] || ! cmp -s /etc/hostapd.conf /etc/hostapd.conf.new; then
    mv /etc/hostapd.conf.new /etc/hostapd.conf
    HOSTAPD_CHANGED=1
  else
    rm -f /etc/hostapd.conf.new
  fi

  # dnsmasq-ap config — regenerate every run so name mappings propagate.
  # NOTE dhcp-option=6 points phones at openwrt itself for DNS, NOT 8.8.8.8,
  # so phones can resolve AP_DOMAIN / AP_HOSTNAME locally.
  # WARP-1364: ROUTED mode only — in bridged mode the host-net dnsmasq is the
  # single DHCP/DNS authority for the unified 192.168.20.0/24 (the outer
  # script ports the local-name answers into lan-dhcp.conf); a second
  # authoritative DHCP server on one L2 would race it.
  if [ "${AP_BRIDGE:-0}" = 1 ]; then
    pgrep -f "dnsmasq -C /etc/dnsmasq-ap.conf" | xargs -r kill 2>/dev/null
    rm -f /etc/dnsmasq-ap.conf /etc/dnsmasq-ap.conf.new
  else
  cat > /etc/dnsmasq-ap.conf.new <<DNSMASQ
interface=$AP_IFACE
bind-interfaces
# dnsmasq defaults to /var/lib/misc/dnsmasq.leases, which doesnt exist in
# the openwrt minimal rootfs after a fresh container. Pin to /tmp/ where
# it always exists and gets reset on container restart (which is what we
# want — clients re-DHCP fresh after a reboot anyway).
dhcp-leasefile=/tmp/dhcp.leases
dhcp-range=192.168.20.10,192.168.20.100,255.255.255.0,12h
dhcp-option=3,192.168.20.1
dhcp-option=6,192.168.20.1
server=8.8.8.8
server=1.1.1.1
no-resolv
# Customer-facing hostnames -> openwrt IP (DNATs to dashboard)
address=/$AP_HOSTNAME/192.168.20.1
address=/$AP_DOMAIN/192.168.20.1
DNSMASQ

  # WARP-986 / ADR-023: dnsmasq-ap is the ONLY resolver AP clients use, so the
  # public per-device FQDN must be answered HERE for the green-padlock cert
  # name to resolve on AP Wi-Fi. Appended only when the outer script resolved
  # AND validated the name (resolve_public_fqdn); the CHANGED gate below then
  # bounces dnsmasq so a newly-learned name goes live without a reboot.
  # NB: NO APOSTROPHES in this block (single-quoted docker exec body).
  # >>> dnsmasq_ap_public_fqdn (WARP-986)
  if [ -n "$PUBLIC_FQDN" ]; then
    cat >> /etc/dnsmasq-ap.conf.new <<DNSMASQFQDN
# Public per-device FQDN -> openwrt IP (WARP-986 / ADR-023 split horizon)
address=/$PUBLIC_FQDN/192.168.20.1
DNSMASQFQDN
  fi
  # <<< dnsmasq_ap_public_fqdn (WARP-986)

  DNSMASQ_CHANGED=0
  if [ ! -f /etc/dnsmasq-ap.conf ] || ! cmp -s /etc/dnsmasq-ap.conf /etc/dnsmasq-ap.conf.new; then
    mv /etc/dnsmasq-ap.conf.new /etc/dnsmasq-ap.conf
    DNSMASQ_CHANGED=1
  else
    rm -f /etc/dnsmasq-ap.conf.new
  fi
  fi

  # >>> ap_bridge_lan (WARP-1364)
  # Bridged mode: br-ap is the container-local L2 hub — hostapd enslaves the
  # radio (bridge=br-ap in the conf), the veth trunk (created by the outer
  # script, enslaved to host br-lan there) completes the path. No IP lives
  # on this bridge: the L3 gateway for the whole segment is the HOST at
  # 192.168.20.1. Idempotent.
  if [ "${AP_BRIDGE:-0}" = 1 ]; then
    ip link show br-ap >/dev/null 2>&1 || ip link add br-ap type bridge
    ip link set br-ap up 2>/dev/null
    if ip link show veth-dapc >/dev/null 2>&1; then
      ip link set veth-dapc master br-ap up 2>/dev/null
    else
      echo "droplet-openwrt-attach: WARN: veth-dapc missing in container — bridged AP has no path to host br-lan"
    fi
  fi
  # <<< ap_bridge_lan (WARP-1364)

  # Bring up $AP_IFACE + (re)start daemons only if config changed or not running
  # WARP-1364: the 192.168.20.1/24 gateway address belongs on $AP_IFACE ONLY
  # in routed mode. Bridged, the iface is an L2 port — a duplicate .20.1 here
  # would ARP-fight the host; strip it on transition.
  ip link set "$AP_IFACE" up 2>/dev/null
  if [ "${AP_BRIDGE:-0}" = 1 ]; then
    ip addr show "$AP_IFACE" | grep -q 192.168.20.1 && ip addr del 192.168.20.1/24 dev "$AP_IFACE" 2>/dev/null
  else
    ip addr show "$AP_IFACE" | grep -q 192.168.20.1 || ip addr add 192.168.20.1/24 dev "$AP_IFACE"
  fi

  # >>> start_hostapd (WARP-826b)
  # Start hostapd and VERIFY it actually came up. The old fire-and-forget
  # (pgrep || hostapd -B) hid launch failures — a dead AP while the attach
  # reported success (seen live on .87). Retry a few times, then log loudly so a
  # broken AP is never silent. Knobs: HOSTAPD_START_TRIES / HOSTAPD_START_SLEEP.
  #
  # Verification is two-layered: the hostapd -B PROCESS must be alive AND the AP
  # iface must actually be in AP mode (`iw dev <if> info` -> `type AP`). The iface
  # check is the real proof — a hostapd that started but failed to bind the radio
  # exits, and even a lingering process would not have put the iface into AP mode
  # (the pgrep-only check would false-pass on a bind failure). iw should always be
  # present (install_ap_pkgs hard-verifies it); if it is somehow unavailable we
  # fall back to the process check rather than false-fail a working AP.
  start_hostapd() {
    _htries="${HOSTAPD_START_TRIES:-3}"
    _hnap="${HOSTAPD_START_SLEEP:-1}"
    _haperr=/tmp/hostapd-start.err

    _ap_running() {
      pgrep -f "hostapd -B" >/dev/null 2>&1 || return 1
      # Confirm AP mode when iw is usable; otherwise accept the live process.
      if command -v iw >/dev/null 2>&1; then
        iw dev "${AP_IFACE}" info 2>/dev/null | grep -qE "type[[:space:]]+AP" || return 1
      fi
      return 0
    }

    if _ap_running; then return 0; fi
    _h=1
    while [ "$_h" -le "$_htries" ]; do
      # Capture hostapds stderr (the -B daemon detaches and would otherwise
      # swallow its startup error) so the loud failure below can show the cause.
      hostapd -B -P /run/hostapd.pid /etc/hostapd.conf >/dev/null 2>>"$_haperr" || true
      sleep "$_hnap"
      if _ap_running; then
        echo "droplet-openwrt-attach: hostapd up on ${AP_IFACE} (type AP)"
        return 0
      fi
      _h=$((_h + 1))
    done
    echo "droplet-openwrt-attach: ERROR: hostapd failed to bring up the AP after ${_htries} tries — default Wi-Fi AP is DOWN (hostapd installed? iface ${AP_IFACE} present + type AP? /etc/hostapd.conf valid?)" >&2
    # Surface the captured hostapd error (do not swallow it on the failure path).
    [ -s "$_haperr" ] && { echo "droplet-openwrt-attach: last hostapd error:" >&2; tail -10 "$_haperr" >&2; }
    return 1
  }
  # <<< start_hostapd (WARP-826b)
  if [ "$HOSTAPD_CHANGED" = 1 ]; then
    pgrep -f "hostapd -B" | xargs -r kill 2>/dev/null
    sleep 1
  fi
  # Propagate a persistent hostapd failure to the oneshot unit (no `|| true`
  # masking): a dead AP that reported success is exactly the live .87 bug.
  if ! start_hostapd; then
    # If a guest BSS is configured, it may be why hostapd refused (a guest
    # misconfig, or a card that does not support multiple BSSes). Strip the
    # guest stanza (everything from its marker to EOF — it is always appended
    # LAST) and retry with the HOME AP ONLY, so guest Wi-Fi can never take the
    # household network down. Roll back the guest firewall zone + nft masq we
    # staged earlier this run; the guest L3/dnsmasq block below then takes its
    # teardown branch because GUEST_ENABLED is now cleared. A home-only failure
    # still fails the unit.
    if [ "${GUEST_ENABLED:-0}" = 1 ] && grep -q "^# >>> droplet guest bss" /etc/hostapd.conf 2>/dev/null; then
      echo "droplet-openwrt-attach: WARN: hostapd refused WITH the guest BSS; retrying home AP only (guest Wi-Fi disabled this boot)" >&2
      sed -i "/^# >>> droplet guest bss/,\$d" /etc/hostapd.conf
      GUEST_ENABLED=0
      guest_firewall_zone
      for h in $(nft -a list chain ip nat postrouting 2>/dev/null | grep "192.168.30.0/24" | grep -oE "handle [0-9]+" | awk "{print \$2}"); do
        nft delete rule ip nat postrouting handle $h
      done
      pgrep -f "hostapd -B" | xargs -r kill 2>/dev/null
      sleep 1
      start_hostapd || exit 1
    else
      exit 1
    fi
  fi

  # --- hostapd watchdog --------------------------------------------------
  # start_hostapd verifies the AP at ATTACH time, but the attach is a oneshot —
  # if hostapd later crashes (a transient nl80211/driver hiccup, an OOM kill)
  # nothing brings it back and the AP silently disappears until reboot. Rather
  # than a host-side .timer that would re-run this whole heavyweight attach
  # (opkg, firewall, routing restart) every tick — disproportionate — add a
  # lightweight in-container respawn loop modeled EXACTLY on the eth0 watchdog
  # below: a 2-second loop that idempotently re-launches hostapd if pgrep shows
  # it gone. Same /tmp storage rationale as eth0-keepalive (the overlay housing
  # /usr/local/sbin is briefly read-only right after a docker restart; /tmp is a
  # tmpfs mounted before procd, so writes always succeed; the file being wiped
  # on restart is fine because this attach rewrites it every run). Best-effort by
  # design — the LOUD failure signal is the start_hostapd verify above (which
  # fails the unit); this just keeps a healthy AP healthy across crashes.
  cat > /tmp/hostapd-keepalive <<"HOSTAPDWD"
#!/bin/sh
# hostapd watchdog. Re-launch hostapd -B if procd/a crash left it gone.
# Idempotent: the pgrep guard makes the no-change case a cheap noop.
CONF="${1:-/etc/hostapd.conf}"
PIDF="${2:-/run/hostapd.pid}"
while true; do
  pgrep -f "hostapd -B" >/dev/null 2>&1 || hostapd -B -P "$PIDF" "$CONF" 2>/dev/null
  sleep 2
done
HOSTAPDWD
  chmod +x /tmp/hostapd-keepalive

  start-stop-daemon -K -q -p /var/run/hostapd-keepalive.pid 2>/dev/null
  rm -f /var/run/hostapd-keepalive.pid
  start-stop-daemon -S -b -m -p /var/run/hostapd-keepalive.pid \
    -x /tmp/hostapd-keepalive -- /etc/hostapd.conf /run/hostapd.pid
  # ---------------------------------------------------------------------

  # WARP-1364: routed mode only — bridged mode removed the conf above and the
  # host-net dnsmasq owns the segment; starting a confless dnsmasq here would
  # just fail loudly.
  if [ "${AP_BRIDGE:-0}" != 1 ]; then
    if [ "$DNSMASQ_CHANGED" = 1 ]; then
      pgrep -f "dnsmasq -C /etc/dnsmasq-ap.conf" | xargs -r kill 2>/dev/null
      sleep 1
    fi
    pgrep -f "dnsmasq -C /etc/dnsmasq-ap.conf" >/dev/null || dnsmasq -C /etc/dnsmasq-ap.conf
  fi

  # --- Guest L3 + dnsmasq -----------------------------------------------
  # Bring up the guest BSS netdev (hostapd created it from the bss= stanza), give
  # it the guest gateway IP, and serve DHCP/DNS on the isolated guest subnet via
  # a SECOND dnsmasq. The guest dnsmasq deliberately does NOT advertise the
  # dashboard hostnames (guests reach the internet only, never droplet.local).
  # Same CHANGED-gate as dnsmasq-ap so an unchanged config never bounces guest
  # clients. When guest is off (or the home-AP fallback cleared it), tear the
  # guest dnsmasq down. NB: NO APOSTROPHES (single-quoted docker exec body).
  if [ "${GUEST_ENABLED:-0}" = 1 ]; then
    ip link set "$GUEST_IFACE" up 2>/dev/null
    ip addr show "$GUEST_IFACE" 2>/dev/null | grep -q "${GUEST_GW}" || \
      ip addr add "${GUEST_GW}/24" dev "$GUEST_IFACE" 2>/dev/null
    GUEST_NET=$(echo "$GUEST_GW" | cut -d. -f1-3)

    cat > /etc/dnsmasq-guest.conf.new <<DNSMASQGUEST
interface=$GUEST_IFACE
bind-interfaces
dhcp-leasefile=/tmp/dhcp-guest.leases
dhcp-range=${GUEST_NET}.10,${GUEST_NET}.100,255.255.255.0,12h
dhcp-option=3,$GUEST_GW
dhcp-option=6,$GUEST_GW
server=8.8.8.8
server=1.1.1.1
no-resolv
DNSMASQGUEST

    GUEST_DNSMASQ_CHANGED=0
    if [ ! -f /etc/dnsmasq-guest.conf ] || ! cmp -s /etc/dnsmasq-guest.conf /etc/dnsmasq-guest.conf.new; then
      mv /etc/dnsmasq-guest.conf.new /etc/dnsmasq-guest.conf
      GUEST_DNSMASQ_CHANGED=1
    else
      rm -f /etc/dnsmasq-guest.conf.new
    fi
    if [ "$GUEST_DNSMASQ_CHANGED" = 1 ]; then
      pgrep -f "dnsmasq -C /etc/dnsmasq-guest.conf" | xargs -r kill 2>/dev/null
      sleep 1
    fi
    if pgrep -f "dnsmasq -C /etc/dnsmasq-guest.conf" >/dev/null || dnsmasq -C /etc/dnsmasq-guest.conf; then
      echo "droplet-openwrt-attach: guest Wi-Fi up (ssid set, subnet 192.168.30.0/24 on $GUEST_IFACE, isolated)"
    else
      echo "droplet-openwrt-attach: WARN: guest dnsmasq failed to start — guest clients will not get a lease" >&2
    fi
  else
    # Guest off / fell back: stop the guest dnsmasq + drop its config.
    pgrep -f "dnsmasq -C /etc/dnsmasq-guest.conf" | xargs -r kill 2>/dev/null
    rm -f /etc/dnsmasq-guest.conf 2>/dev/null
  fi
  # ---------------------------------------------------------------------

  else
    echo "droplet-openwrt-attach: AP bring-up skipped inside the container — wireless iface unresolved on the host (see the WARP-2150 skip message in the attach log; is iw installed on the host?)"
  fi
  # <<< ap_phase_gate (WARP-2150)

  # Final pass — re-run bootstrap_net AFTER everything else in this docker
  # exec block has run. Procd / hostapd / dnsmasq init can race against
  # the early unbridge_eth0 + bootstrap_net calls at the top of this
  # block — netifd in particular brings eth0 DOWN again on a clean
  # container restart because eth0 has no UCI interface (we removed it
  # from br-lan + left it un-managed by design, so docker-proxy keeps L3
  # ownership). With no UCI to bring it back up, netifd happily leaves
  # eth0 down, host:8081 cannot reach uhttpd, routing service times out,
  # orchestrator reports router:false. Idempotent re-run here is the
  # simplest fix: procd and netifd are quiesced by this point and we get
  # the last word.
  #
  # NB: NO APOSTROPHES allowed in this comment block — the whole docker
  # exec body is wrapped in single quotes by the outer script, so a stray
  # `cant` or `dont` would close the heredoc early and the trailing
  # function calls would run in the OUTER bash where they are undefined.
  # (Found the hard way: a `cannot` rendered as cant prematurely closed
  # the heredoc, two systemctl restarts ago.)
  unbridge_eth0
  bootstrap_net
'
# Capture the docker-exec exit status. The body above `exit 1`s on a hard-fail
# (opkg could not install the AP prerequisites, or hostapd never brought up the
# AP) — that exit becomes docker exec`s exit code. The outer script runs
# `set +e`, so without capturing + re-exiting here a failed container body would
# be MASKED and the oneshot unit would report success on a silent no-AP. Record
# it, finish the best-effort host-side tail (rpcd ACL + routing recovery — still
# worth attempting), then exit non-zero at the end so the systemd unit shows
# failed and the failure is visible.
EXEC_RC=$?

# WARP-1364: bridged mode moved DHCP/DNS authority for the unified
# 192.168.20.0/24 to the host-net dnsmasq — which shipped with DNS off
# (port=0) and no local names, because dnsmasq-ap used to answer them for
# Wi-Fi clients. Port the WARP-986 name set (AP hostname/domain + validated
# public FQDN -> 192.168.20.1) into lan-dhcp.conf via a sentinel-managed
# block, drop port=0, and bounce droplet-host-net only when the file really
# changed (same CHANGED-gate discipline as hostapd/dnsmasq-ap).
# >>> host_lan_dns (WARP-1364)
if [ "$AP_BRIDGE" = 1 ]; then
  LAN_DHCP_CONF="${DROPLET_LAN_DHCP_CONF:-/etc/droplet-host-net/lan-dhcp.conf}"
  if [ -f "$LAN_DHCP_CONF" ]; then
    _lantmp=$(mktemp)
    sed -e '/^port=0$/d' \
        -e '/^# >>> droplet-ap-bridge dns/,/^# <<< droplet-ap-bridge dns/d' \
        "$LAN_DHCP_CONF" > "$_lantmp"
    {
      echo "# >>> droplet-ap-bridge dns (WARP-1364) — managed by droplet-openwrt-attach; do not edit by hand"
      echo "no-resolv"
      echo "server=1.1.1.1"
      echo "server=8.8.8.8"
      echo "address=/$AP_HOSTNAME/192.168.20.1"
      echo "address=/$AP_DOMAIN/192.168.20.1"
      [ -n "$PUBLIC_FQDN" ] && echo "address=/$PUBLIC_FQDN/192.168.20.1"
      echo "# <<< droplet-ap-bridge dns (WARP-1364)"
    } >> "$_lantmp"
    if ! cmp -s "$_lantmp" "$LAN_DHCP_CONF"; then
      cat "$_lantmp" > "$LAN_DHCP_CONF"
      if systemctl restart droplet-host-net.service; then
        echo "droplet-openwrt-attach: host br-lan dnsmasq now serves DNS + local names for bridged AP clients"
      else
        echo "droplet-openwrt-attach: WARN: droplet-host-net restart failed — bridged AP clients may lack DHCP/DNS" >&2
      fi
    fi
    rm -f "$_lantmp"
  else
    echo "droplet-openwrt-attach: WARN: $LAN_DHCP_CONF not found — bridged AP clients get no local-name DNS" >&2
  fi
fi
# <<< host_lan_dns (WARP-1364)

# >>> overlay_wg_host_nat (WARP-1385)
# HOST-level WireGuard NAT for the direct-punch remote-access overlay
# (ADR-030 / epic WARP-1382). wg0 lives INSIDE droplet-openwrt.
#
# Until WARP-1385 the host published udp/51820 via docker-proxy (compose
# `51820:51820/udp`). docker-proxy owns the host port and rewrites the
# container's OUTBOUND wg packets with an EPHEMERAL host source port, so the
# box's egress NAT mapping never matched the inbound path — the upstream
# (AT&T) NAT binding for the phone→box direction and the box→phone direction
# diverged and the hole-punch failed (verified live on .87, 2026-06-10).
#
# The compose publish is now REMOVED. These two host rules replace it and,
# crucially, PRESERVE source port 51820 on egress so inbound and outbound share
# one public mapping (that shared mapping IS the punch — the box's STUN probe in
# device-bridge observes it from the SAME source port):
#   (a) DNAT inbound udp/51820 (arriving on the uplink, destined to the box's
#       own uplink IP) -> the openwrt container's :51820 where wg0 listens.
#   (b) source-port-PRESERVING masquerade for container-sourced udp sport 51820
#       egressing the uplink -> keep source port 51820 on the wire.
#
# The rules live in a DEDICATED nft table so they NEVER clobber Docker's own
# `ip nat` table, and the table is torn down + rebuilt on every attach so a
# container re-IP is picked up and the rules survive container re-attach (a
# hot-applied rule would vanish on the next attach — the same discipline the
# container-side wg0 dashboard DNAT already follows).
#
# LIVE-APPLY IS STEFAN-GATED: applying on .87 also needs the compose port
# removed (done) + `systemctl restart droplet-openwrt-attach`. Code + tests only.
if command -v nft >/dev/null 2>&1; then
  # Resolve the openwrt container IP with the SAME validated retry idiom the
  # GATEWAY_IP DNAT resolution uses above — reject empty / 0.0.0.0 / multi-net
  # concatenations, since a garbage DNAT target makes the whole `nft add` fail.
  OVERLAY_OPENWRT_IP=""
  for _owtry in $(seq 1 30); do
    _owip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' droplet-openwrt 2>/dev/null) || true
    if [[ "$_owip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && [ "$_owip" != "0.0.0.0" ]; then
      OVERLAY_OPENWRT_IP="$_owip"; break
    fi
    sleep 1
  done
  # Uplink iface + source IP via the read-only FIB query — the SAME probe the
  # device-bridge /host/uplink-ip endpoint uses. The uplink iface scopes both
  # rules; the uplink IP is the ip-daddr hijack guard on the DNAT (so a stray
  # udp/51820 seen on br-lan / docker0 can never be hijacked into the container).
  OVERLAY_UPLINK_LINE=$(ip -o route get 1.1.1.1 2>/dev/null || true)
  OVERLAY_UPLINK_IFACE=$(printf '%s\n' "$OVERLAY_UPLINK_LINE" | grep -oE 'dev [^ ]+' | awk '{print $2}' | head -1)
  OVERLAY_UPLINK_IP=$(printf '%s\n' "$OVERLAY_UPLINK_LINE" | grep -oE 'src [0-9.]+' | awk '{print $2}' | head -1)
  # WARP-1980: `ip route get` yields exactly ONE src, but a box routinely holds
  # several addresses on the uplink NIC — this one has a static 192.168.9.250 AND
  # a DHCP lease 192.168.9.195, and the route-src is the LEASE. Binding the DNAT
  # to that single address meant a client dialling the static (the address the
  # dashboard and the docs hand out) got ICMP port-unreachable, verified by
  # capture on 2026-08-13. Widen the hijack guard to the uplink interface's OWN
  # addresses: still a real guard (a stray udp/51820 on br-lan / docker0 can
  # never match), but it now answers on whichever of the box's own addresses the
  # client actually used. Fall back to the single route-src if enumeration finds
  # nothing, so this can only ever widen, never blank, the match.
  OVERLAY_UPLINK_ADDRS=$(ip -o -4 addr show dev "$OVERLAY_UPLINK_IFACE" 2>/dev/null \
    | awk '{print $4}' | cut -d/ -f1 \
    | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
    | LC_ALL=C sort -u | paste -sd, -)
  [ -n "$OVERLAY_UPLINK_ADDRS" ] || OVERLAY_UPLINK_ADDRS="$OVERLAY_UPLINK_IP"
  if [ -n "$OVERLAY_OPENWRT_IP" ] && [ -n "$OVERLAY_UPLINK_IFACE" ] && [ -n "$OVERLAY_UPLINK_IP" ]; then
    # Idempotent: drop + recreate the whole dedicated table on every attach.
    nft list table ip droplet_overlay_nat >/dev/null 2>&1 && nft delete table ip droplet_overlay_nat
    nft add table ip droplet_overlay_nat
    # priority -110 (= dstnat - 10) so this DNAT lands the conntrack binding
    # BEFORE Docker's own dstnat chain (-100) can act.
    nft add chain ip droplet_overlay_nat prerouting "{ type nat hook prerouting priority -110 ; }"
    # priority 90 (= srcnat - 10) so the source-port-preserving masquerade sets
    # the conntrack NAT binding BEFORE Docker's generic masquerade (100) picks an
    # ephemeral port.
    nft add chain ip droplet_overlay_nat postrouting "{ type nat hook postrouting priority 90 ; }"
    # (a) inbound punch — guarded by uplink iface AND the box's own addresses.
    nft add rule ip droplet_overlay_nat prerouting iifname "$OVERLAY_UPLINK_IFACE" ip daddr { $OVERLAY_UPLINK_ADDRS } udp dport 51820 dnat to ${OVERLAY_OPENWRT_IP}:51820
    # (b) outbound punch — PRESERVE source port 51820 on egress out the uplink.
    nft add rule ip droplet_overlay_nat postrouting oifname "$OVERLAY_UPLINK_IFACE" ip saddr "$OVERLAY_OPENWRT_IP" udp sport 51820 masquerade to :51820
    # (c) WARP-1980 — the FILTER half. A DNAT only rewrites the destination; the
    # packet still has to survive the filter FORWARD path. Docker runs
    # `-P FORWARD DROP` and its DOCKER chain ends in
    #   -A DOCKER ! -i br-<id> -o br-<id> -j DROP
    # whose only ACCEPTs are per-PUBLISHED-port. droplet-openwrt publishes
    # 80/tcp alone, so the DNATed udp/51820 was dropped there — silently, with
    # no REJECT and no log line. Capture on 192.168.9.250 (2026-08-13): the probe
    # drew no ICMP port-unreachable (the DNAT had consumed it) yet 0 packets
    # reached the docker bridge; with this rule, all 6 landed on the container.
    #
    # This CANNOT live in our own nft table. In nftables a verdict is per-chain:
    # an `accept` in a separate base chain does not stop Docker's chain at the
    # same hook from being evaluated, and only `drop` is final. It has to sit
    # inside the traversal that holds the DROP — DOCKER-USER, which Docker
    # documents as the user hook evaluated ahead of its own rules.
    #
    # Scoped to the uplink ingress AND the container as destination, so it is no
    # broader than the published port it replaces. DOCKER-USER is not ours to
    # flush (unlike the nft table above, which is torn down and rebuilt), so
    # delete any prior copy first or every re-attach stacks another duplicate.
    if command -v iptables >/dev/null 2>&1 && iptables -S DOCKER-USER >/dev/null 2>&1; then
      while iptables -D DOCKER-USER -i "$OVERLAY_UPLINK_IFACE" -d "$OVERLAY_OPENWRT_IP" -p udp --dport 51820 -j ACCEPT 2>/dev/null; do :; done
      iptables -I DOCKER-USER -i "$OVERLAY_UPLINK_IFACE" -d "$OVERLAY_OPENWRT_IP" -p udp --dport 51820 -j ACCEPT
    else
      echo "droplet-openwrt-attach: WARN: iptables/DOCKER-USER unavailable — the overlay DNAT will be installed but Docker's FORWARD DROP will discard inbound udp/51820 (remote access cannot handshake)" >&2
    fi
    echo "droplet-openwrt-attach: installed host WG overlay NAT (dnat udp/51820 on {${OVERLAY_UPLINK_ADDRS}} -> ${OVERLAY_OPENWRT_IP}:51820, src-port-preserving masq out ${OVERLAY_UPLINK_IFACE}, DOCKER-USER accept)"
  else
    echo "droplet-openwrt-attach: WARN: could not resolve openwrt container IP / uplink for host WG overlay NAT — direct remote-access punch will not work until the next successful attach (openwrt_ip='${OVERLAY_OPENWRT_IP}', uplink_iface='${OVERLAY_UPLINK_IFACE}', uplink_ip='${OVERLAY_UPLINK_IP}')" >&2
  fi
fi
# <<< overlay_wg_host_nat (WARP-1385)

echo "droplet-openwrt-attach: done (gateway=$GATEWAY_IP, ssid=$AP_SSID, domain=$AP_DOMAIN, ap_mode=$([ "$AP_BRIDGE" = 1 ] && echo bridged || echo routed))"
if [ "$EXEC_RC" -ne 0 ]; then
  echo "droplet-openwrt-attach: WARN: container bring-up reported failure (rc=$EXEC_RC) — AP/package prerequisites did not satisfy; see errors above. Continuing host-side recovery, then failing the unit." >&2
fi

# Fresh-provision fix: install the droplet rpcd ACL so the routing service
# session (root) is granted `umdns: [browse, update]` plus dhcp/iwinfo
# reads. Without it ubus returns "Access denied" on umdns browse and
# /aps/discovered 500s — AP auto-discovery cannot work.
#
# WARP-868: the singlebox image now BAKES this file (openwrt/singlebox-image/
# Dockerfile), but the host-side canonical ACL still WINS on every attach:
# the copy is UNCONDITIONAL whenever the host source is readable, so a
# long-lived container never sits on a stale ACL after new grants land on
# the host (/usr/share is not persisted, so the copy is cheap). The
# image-baked file is only the fallback when the host source is unreadable.
# And the path is no longer silenced: the 2026-06-11 reflash hit a docker-cp
# failure that `>/dev/null 2>&1` swallowed entirely, leaving /dhcp/leases,
# /aps/discovered 500ing with zero log signal.
# A copy or rpcd-restart failure now logs loudly and FAILS the unit
# (systemd's on-failure retry re-runs us).
DROPLET_RPCD_ACL="${DROPLET_RPCD_ACL:-/home/droplet/edge-platform/openwrt/files/usr/share/rpcd/acl.d/droplet-ai.json}"
if [ -r "$DROPLET_RPCD_ACL" ]; then
  if docker cp "$DROPLET_RPCD_ACL" droplet-openwrt:/usr/share/rpcd/acl.d/droplet-ai.json; then
    if docker exec droplet-openwrt /etc/init.d/rpcd restart; then
      echo "droplet-openwrt-attach: installed rpcd ACL (umdns browse/update + file reads) and restarted rpcd"
    else
      RPCD_RESTART_RC=$?
      echo "droplet-openwrt-attach: ERROR: rpcd restart failed (rc=$RPCD_RESTART_RC) after ACL copy — new grants will not load until rpcd restarts. Failing the unit so systemd retries." >&2
      EXEC_RC=1
    fi
  else
    echo "droplet-openwrt-attach: ERROR: rpcd ACL copy failed — /dhcp/leases + /aps/discovered will answer 500 (Access denied) until it lands. Failing the unit so systemd retries." >&2
    EXEC_RC=1
  fi
elif docker exec droplet-openwrt test -r /usr/share/rpcd/acl.d/droplet-ai.json 2>/dev/null; then
  echo "droplet-openwrt-attach: WARN: host ACL source unreadable at $DROPLET_RPCD_ACL — relying on the image-baked ACL already in the container (may be stale)." >&2
else
  echo "droplet-openwrt-attach: ERROR: rpcd ACL missing from container AND source unreadable at $DROPLET_RPCD_ACL — network reads will answer 500 (Access denied). Failing the unit so systemd retries." >&2
  EXEC_RC=1
fi

# WARP-868: enforce the uhttpd concurrency cap for containers created from
# pre-bake images (fresh containers get it via the image's uci-defaults).
# Stock max_requests=3 drops/resets the slowest rpcd invocations under the
# orchestrator's network-summary fan-out. Idempotent: only writes + restarts
# uhttpd when the value differs.
if [ "$(docker exec droplet-openwrt uci -q get uhttpd.main.max_requests 2>/dev/null)" != "10" ]; then
  if docker exec droplet-openwrt sh -c "uci set uhttpd.main.max_requests='10' && uci commit uhttpd && /etc/init.d/uhttpd restart" >/dev/null 2>&1; then
    echo "droplet-openwrt-attach: raised uhttpd max_requests to 10 (WARP-868)"
  else
    echo "droplet-openwrt-attach: WARN: could not raise uhttpd max_requests — concurrent ubus calls may reset under load" >&2
  fi
fi

# KAN-9: enforce UPnP opt-out default for containers created from pre-bake images.
# opkg install miniupnpd writes stock enable_upnp='1'/enable_natpmp='1'/enabled='1'
# to /etc/config/upnpd; uci-defaults only run on first boot so they don't fix it.
# Mirror the same idempotent-write pattern used for uhttpd max_requests (WARP-868).
if [ "$(docker exec droplet-openwrt uci -q get upnpd.config.enable_upnp 2>/dev/null)" != "0" ]; then
  if docker exec droplet-openwrt sh -c "uci set upnpd.config.enabled='0' && uci set upnpd.config.enable_upnp='0' && uci set upnpd.config.enable_natpmp='0' && uci commit upnpd" >/dev/null 2>&1; then
    echo "droplet-openwrt-attach: enforced UPnP opt-out default for pre-bake container (KAN-9)"
  else
    echo "droplet-openwrt-attach: WARN: could not enforce UPnP opt-out — dashboard may show UPnP enabled before owner consents" >&2
  fi
fi

# Routing service caches its OpenWrt session at startup and does not
# reconnect on RPC failure (the python-uci SDK holds the session token
# across calls). After ANY docker restart of droplet-openwrt — whether
# triggered by this attach run, a manual `docker restart`, or a host
# reboot — the routing service is left holding a stale session and the
# dashboard's next call lands on {"connected":false,"error":"Access
# denied"}.
#
# Earlier this block tried to probe routing's /health and conditionally
# restart, but the probe ran ~1s after openwrt came up — routing was
# still answering with its in-memory cache before its next outbound
# call failed, so the condition never fired. Since this script is a
# oneshot systemd unit (not a per-second poll), the unconditional
# restart is cheap (~15s on the POC box) and removes the race entirely.
# `docker restart` against an absent container is a hard error, so
# guard on `docker ps`.
if command -v docker >/dev/null 2>&1; then
  if docker ps --format '{{.Names}}' | grep -qx droplet-routing-1; then
    echo "droplet-openwrt-attach: restarting routing to drop any stale OpenWrt session"
    docker restart droplet-routing-1 >/dev/null 2>&1 || true
  fi
fi

# Propagate the container bring-up status as the script (and therefore the
# oneshot unit) exit code. Best-effort host-side recovery above always runs, but
# if the AP/package prerequisites failed inside the container we exit non-zero so
# `systemctl status droplet-openwrt-attach` shows failed instead of masking a
# silent no-AP behind a success.
exit "${EXEC_RC:-0}"
