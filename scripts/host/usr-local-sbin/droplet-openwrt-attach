#!/bin/bash
# Bring up the OpenWrt container's AP after a (re)start. Idempotent.
#
# Phase K: AP clients reach the dashboard via DNAT — phone hits
# https://droplet.local/ (DNS served by openwrt's dnsmasq) which resolves
# to 192.168.20.1, openwrt DNATs :443/:80 to the docker gateway container.
# No cross-subnet TCP needed from the phone's perspective.
set +e

# --- Customer-facing knobs (override via env) -----------------------------
AP_SSID="${DROPLET_AP_SSID:-Droplet}"
# WARP-819: AP_PSK is resolved by resolve_ap_psk() below — NEVER a shared
# hardcoded default. An explicit DROPLET_AP_PSK (real, non-placeholder) wins;
# otherwise a strong per-box PSK is generated ONCE, persisted 0600, and re-read
# on every subsequent boot. Seed it from the env here so the resolver can honor
# an operator override; the resolver overwrites it with the persisted/generated
# value when no real override is set.
AP_PSK="${DROPLET_AP_PSK:-}"
AP_DOMAIN="${DROPLET_AP_DOMAIN:-droplet.local}"
AP_HOSTNAME="${DROPLET_AP_HOSTNAME:-droplet}"
# Where the per-box AP PSK is persisted host-side (0600). Stable across reboots;
# generated once if absent. Overridable for tests.
AP_PSK_FILE="${AP_PSK_FILE:-/etc/droplet/ap-psk}"
# The device-bridge env file the bridge reads DROPLET_AP_PSK from. We mirror the
# resolved PSK into it so the pairing QR/text the bridge renders ALWAYS equals
# the PSK hostapd actually serves (WARP-819 coherence AC). Overridable for tests.
DEVICE_BRIDGE_ENV_FILE="${DEVICE_BRIDGE_ENV_FILE:-/etc/droplet/device-bridge.env}"
# Which wireless phy to move into the container netns, and what interface name
# it surfaces with. These are AUTO-DETECTED below (detect_ap_radio) so the
# attach works on whatever Wi-Fi card the box actually ships — the MT7922
# single-box enumerates phy0/wlp14s0, an AX210 box phy1/wlp7s0, others wlan0,
# etc. Hardcoding one card's layout (WARP-826: was phy1/wlp7s0) meant a
# mismatched card left the radio un-moved into the netns and hostapd binding a
# nonexistent iface → the AP never appeared. An explicit DROPLET_AP_PHY /
# DROPLET_AP_IFACE env override stays AUTHORITATIVE: if set (non-empty) it is
# used verbatim and detection is skipped, so an operator can always pin the
# radio (e.g. to force the full-power MT7922 over a weaker AX210 on a dual-card
# box). Seed from the env here; detect_ap_radio fills any unset side.
AP_PHY="${DROPLET_AP_PHY:-}"
AP_IFACE="${DROPLET_AP_IFACE:-}"
GATEWAY_CONTAINER="${DROPLET_GATEWAY_CONTAINER:-droplet-gateway-1}"
# Phase L: root password for OpenWrt rpcd. Read from the docker secret
# the routing service also reads, so both sides stay in lockstep.
OPENWRT_PASSWORD_FILE="${OPENWRT_PASSWORD_FILE:-/home/droplet/edge-platform/docker/secrets/openwrt_password}"
# --------------------------------------------------------------------------

# WARP-819: resolve the per-box AP PSK. Replaces the old shared hardcoded
# fallback (`droplet-default-wifi`) so every box ships a UNIQUE Wi-Fi password
# with zero prior config. Priority:
#   1. an explicit, REAL DROPLET_AP_PSK env (operator override) — used verbatim;
#   2. the persisted 0600 secret file ($AP_PSK_FILE) if present + non-empty
#      — read it (NEVER regenerate; the SSID/PSK must be stable across reboots);
#   3. otherwise GENERATE a strong 16-char passphrase ONCE, persist it 0600,
#      and use it.
# Placeholder/shared sentinels (empty, the old shared default, the setup-wizard
# placeholder) are treated as "not set" so a stale .env can't reinstate a shared
# password. The resolved value is mirrored into the device-bridge env so the
# pairing QR/text the bridge renders always equals the PSK hostapd serves
# (coherence AC). Idempotent; sentinel-delimited so it is unit-testable in
# isolation (tests/openwrt-attach-ap-psk.test.sh).
# >>> resolve_ap_psk (WARP-819)
resolve_ap_psk() {
  psk_file="${AP_PSK_FILE:-/etc/droplet/ap-psk}"
  bridge_env="${DEVICE_BRIDGE_ENV_FILE:-/etc/droplet/device-bridge.env}"

  # Is the candidate a real PSK, or a placeholder/shared sentinel to ignore?
  _is_placeholder() {
    case "$1" in
      ""|droplet-default-wifi|CHANGE_ME_VIA_SETUP_WIZARD|changeme|CHANGEME)
        return 0 ;;
      *) return 1 ;;
    esac
  }

  # 1) Explicit operator override (real value only).
  if ! _is_placeholder "${AP_PSK:-}"; then
    : # keep AP_PSK as-is
  # 2) Persisted per-box secret.
  elif [ -r "$psk_file" ] && [ -s "$psk_file" ]; then
    AP_PSK="$(tr -d '\r\n' < "$psk_file")"
  fi

  # 3) Still nothing real → generate once.
  if _is_placeholder "${AP_PSK:-}"; then
    # 16 chars from a url-safe-ish alphabet (no quotes/backslash/$ so it is a
    # safe hostapd wpa_passphrase + safe to single-quote downstream). First char
    # forced to a digit so iOS/Android password fields don't auto-capitalize it
    # (silent auto-cap → user types lowercase, submits capitalized → PSK
    # mismatch). ~80 bits of entropy — far past any practical WPA2 attack.
    gen="$( { openssl rand -base64 48 2>/dev/null || head -c 96 /dev/urandom 2>/dev/null | base64; } \
            | tr -dc 'A-Za-z0-9' | cut -c1-15 )"
    # WARP-821: STRONG entropy only. If neither openssl nor /dev/urandom produced
    # a full-length key, HARD-FAIL rather than fall back to a weak PRNG — a
    # low-entropy Wi-Fi password silently shipping is worse than a loud failure a
    # human can fix. (Unreachable on the box; both sources are always present.)
    if [ "${#gen}" -lt 15 ]; then
      echo "droplet-openwrt-attach: FATAL — no strong entropy source (openssl or readable /dev/urandom) to generate the AP PSK; refusing to ship a weak Wi-Fi password. Install openssl or make /dev/urandom readable, then retry." >&2
      exit 1
    fi
    # Leading digit (2-9) drawn from the SAME strong source (no PRNG) so the
    # passphrase starts numeric (mobile auto-cap guard) → 16 chars total.
    dnum="$( { openssl rand -base64 8 2>/dev/null || head -c 16 /dev/urandom 2>/dev/null | base64; } | tr -dc '0-9' | cut -c1 )"
    case "$dnum" in ""|0|1) first=7 ;; *) first="$dnum" ;; esac
    AP_PSK="${first}${gen}"
  fi

  # Persist the resolved PSK 0600 so subsequent boots read the SAME value.
  # mkdir -p the parent (idempotent); write atomically; tighten perms.
  if [ -n "${AP_PSK:-}" ]; then
    psk_dir="$(dirname "$psk_file")"
    mkdir -p "$psk_dir" 2>/dev/null || true
    umask 077
    printf '%s\n' "$AP_PSK" > "$psk_file.tmp" 2>/dev/null && mv "$psk_file.tmp" "$psk_file" 2>/dev/null || true
    chmod 0600 "$psk_file" 2>/dev/null || true

    # Mirror into the device-bridge env (coherence AC): upsert the
    # DROPLET_AP_PSK line so the bridge's pairing QR/text matches the live AP.
    bridge_dir="$(dirname "$bridge_env")"
    mkdir -p "$bridge_dir" 2>/dev/null || true
    umask 077
    if [ -f "$bridge_env" ]; then
      grep -v '^DROPLET_AP_PSK=' "$bridge_env" > "$bridge_env.tmp" 2>/dev/null || true
    else
      : > "$bridge_env.tmp"
    fi
    printf 'DROPLET_AP_PSK=%s\n' "$AP_PSK" >> "$bridge_env.tmp"
    mv "$bridge_env.tmp" "$bridge_env" 2>/dev/null || true
    chmod 0600 "$bridge_env" 2>/dev/null || true
  fi
}
resolve_ap_psk
# <<< resolve_ap_psk (WARP-819)

# WARP-826: auto-detect the wireless phy + its netdev name so the attach works
# on ANY card, instead of the old hardcoded phy1/wlp7s0 (the AX210 layout) that
# silently no-op'd on the MT7922 single-box (phy0/wlp14s0) — radio never moved
# into the container netns, hostapd bound a nonexistent iface, AP never came up.
#
# Override stays authoritative: an explicit DROPLET_AP_PHY / DROPLET_AP_IFACE
# (seeded into AP_PHY/AP_IFACE above) is used verbatim; detection only fills the
# side(s) left empty. Detection reads /sys/class/ieee80211 for the phy and
# `iw dev` for the iface (parsing the `phy#N` / `Interface <name>` grouping),
# preferring the phy that the chosen/declared iface belongs to and otherwise the
# first phy present. No wireless hardware → both stay empty and the downstream
# guards (the `[ -e /sys/class/ieee80211/$AP_PHY ]` netns move + hostapd bring-up)
# handle the absence; the function never aborts the attach.
#
# Sentinel-delimited so it is unit-testable in isolation against a fake sysfs +
# stub `iw` (tests/openwrt-attach-iface-detect.test.sh), mirroring
# resolve_ap_psk / ap_firewall_zone. SYS_CLASS_IEEE80211 is overridable for that
# test; in production it defaults to the real /sys path.
# >>> detect_ap_radio (WARP-826)
detect_ap_radio() {
  sysfs="${SYS_CLASS_IEEE80211:-/sys/class/ieee80211}"

  # phy -> netdev name and netdev -> phy, parsed once from `iw dev`. `iw dev`
  # groups interfaces under a `phy#N` header followed by `\tInterface <name>`:
  #   phy#0
  #       Interface wlp14s0
  #           type managed
  # Build two newline-delimited maps ("phyN<TAB>iface") we can grep. `iw` absent
  # (no wireless tooling) -> empty maps; we then fall back to sysfs-only for the
  # phy and leave the iface empty.
  _iwmap=""
  if command -v iw >/dev/null 2>&1; then
    _cur_phy=""
    while IFS= read -r line; do
      case "$line" in
        phy#*)
          # "phy#0" -> "phy0"
          _n="${line#phy#}"
          _cur_phy="phy${_n}"
          ;;
        *Interface\ *)
          _if="${line##*Interface }"
          _if="${_if%% *}"
          [ -n "$_cur_phy" ] && [ -n "$_if" ] && \
            _iwmap="${_iwmap}${_cur_phy}	${_if}
"
          ;;
      esac
    done <<EOF
$(iw dev 2>/dev/null)
EOF
  fi

  # 1) If an iface is pinned/known but the phy is not, recover the phy from the
  #    iface's grouping in the iw map (never leave a known iface with a blank phy).
  if [ -n "$AP_IFACE" ] && [ -z "$AP_PHY" ]; then
    AP_PHY="$(printf '%s' "$_iwmap" | awk -F '\t' -v i="$AP_IFACE" '$2==i{print $1; exit}')"
  fi

  # 2) If the phy is pinned/known but the iface is not, fill the iface from that
  #    phy's grouping.
  if [ -n "$AP_PHY" ] && [ -z "$AP_IFACE" ]; then
    AP_IFACE="$(printf '%s' "$_iwmap" | awk -F '\t' -v p="$AP_PHY" '$1==p{print $2; exit}')"
  fi

  # 3) Nothing declared yet — pick the first wireless phy present in sysfs, then
  #    resolve its iface from the iw map. sysfs is the source of truth for "which
  #    phys exist"; iw maps a phy to its netdev.
  if [ -z "$AP_PHY" ]; then
    if [ -d "$sysfs" ]; then
      for d in "$sysfs"/phy*; do
        [ -e "$d" ] || continue   # nullglob-safe: skip the literal when no match
        AP_PHY="$(basename "$d")"
        break
      done
    fi
  fi
  if [ -n "$AP_PHY" ] && [ -z "$AP_IFACE" ]; then
    AP_IFACE="$(printf '%s' "$_iwmap" | awk -F '\t' -v p="$AP_PHY" '$1==p{print $2; exit}')"
  fi

  if [ -n "$AP_PHY" ] && [ -n "$AP_IFACE" ]; then
    echo "droplet-openwrt-attach: AP radio detected — phy=$AP_PHY iface=$AP_IFACE"
  else
    echo "droplet-openwrt-attach: WARN: no wireless phy/iface resolved (phy='${AP_PHY}' iface='${AP_IFACE}'); set DROPLET_AP_PHY/DROPLET_AP_IFACE if the card is present — AP will not come up otherwise"
  fi
  return 0
}
detect_ap_radio
# <<< detect_ap_radio (WARP-826)

for i in $(seq 1 60); do
  state=$(docker inspect -f '{{.State.Running}}' droplet-openwrt 2>/dev/null)
  [ "$state" = "true" ] && break
  sleep 1
done
[ "$state" = "true" ] || { echo "droplet-openwrt not running"; exit 1; }

PID=$(docker inspect -f '{{.State.Pid}}' droplet-openwrt)
IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' droplet-openwrt)
GW=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}' droplet-openwrt)

# Resolve dashboard gateway IP at attach time — it's stable in practice but
# we read it fresh so a docker-compose recreate that shuffles IPs is handled.
GATEWAY_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$GATEWAY_CONTAINER" 2>/dev/null)
[ -z "$GATEWAY_IP" ] && { echo "$GATEWAY_CONTAINER not found — cannot wire DNAT"; exit 1; }

# Phase L: read OpenWrt root password from the docker secret so we can
# (re)set it inside the container on every attach. Empty -> skip the set,
# but log so the operator notices.
OPENWRT_ROOT_PW=""
if [ -r "$OPENWRT_PASSWORD_FILE" ]; then
  OPENWRT_ROOT_PW=$(tr -d '\n' < "$OPENWRT_PASSWORD_FILE")
fi
if [ -z "$OPENWRT_ROOT_PW" ]; then
  echo "warn: OpenWrt password secret at $OPENWRT_PASSWORD_FILE is empty or unreadable"
  echo "       routing service will not be able to auth to ubus until this is set"
fi

# Move the AP phy into the container netns (no-op if it's already there
# from a prior attach run). Phy choice driven by $AP_PHY so the operator
# picks which radio carries the customer AP — e.g. mt7921e/phy0 for full
# 22 dBm and Wi-Fi 6, vs iwlwifi/phy1 capped at 3 dBm in AP mode.
[ -e "/sys/class/ieee80211/$AP_PHY" ] && iw phy "$AP_PHY" set netns "$PID"

docker exec -i \
  -e CONT_IP="$IP" -e CONT_GW="$GW" \
  -e GATEWAY_IP="$GATEWAY_IP" \
  -e AP_SSID="$AP_SSID" -e AP_PSK="$AP_PSK" \
  -e AP_IFACE="$AP_IFACE" \
  -e AP_DOMAIN="$AP_DOMAIN" -e AP_HOSTNAME="$AP_HOSTNAME" \
  -e OPENWRT_ROOT_PW="$OPENWRT_ROOT_PW" \
  droplet-openwrt sh -c '
  # Container network bootstrap (CONT_IP/CONT_GW/GATEWAY_IP/AP_* from env).
  # NB: do this FIRST and again AFTER any /etc/init.d/network restart, since
  # netifd restart wipes Dockers pre-assigned eth0 IP and breaks docker-proxy.
  #
  # 2026-05-18 fix: the stock OpenWrt 24.10.2 rootfs ships a config that
  # bridges eth0 into br-lan with IP 192.168.1.1/24. Inside a docker
  # container that means kernel routes L3 through br-lan, not through
  # eth0 — Dockers 172.18.0.10 IP on eth0 is a phantom address that
  # never carries traffic. Symptom cascade: cant ping 8.8.8.8 →
  # opkg install silently fails → hostapd never installs → no AP.
  # And host->container:8081 RPC times out because the SYN-ACK gets
  # routed back through br-lan instead of eth0.
  #
  # Fix is two-layered: (a) UCI delete eth0 from br-lans port list so
  # /etc/init.d/network restart wont re-bridge it, (b) `ip link set
  # eth0 nomaster` here so the running kernel state is corrected even
  # before network restart fires. Both are idempotent — no-op if eth0
  # is already standalone or the UCI entry is already gone.
  unbridge_eth0() {
    # Runtime: detach eth0 from whatever bridge it might be in.
    ip link set eth0 nomaster 2>/dev/null
    # Persist: remove eth0 from the br-lan UCI device port list so the
    # next /etc/init.d/network restart doesnt re-attach it.
    if uci -q show network | grep -q "ports=.*eth0"; then
      uci -q del_list network.@device[0].ports=eth0 2>/dev/null
      uci -q commit network
    fi
  }
  unbridge_eth0
  bootstrap_net() {
    # eth0 must be UP — network restart can leave it DOWN.
    ip link set eth0 up 2>/dev/null
    ip addr show eth0 | grep -q "$CONT_IP" || ip addr add "${CONT_IP}/16" dev eth0
    ip route | grep -q "^default" || ip route add default via "$CONT_GW"
  }
  bootstrap_net
  grep -q 8.8.8.8 /etc/resolv.conf 2>/dev/null || {
    echo "nameserver 8.8.8.8" > /etc/resolv.conf
    echo "nameserver 1.1.1.1" >> /etc/resolv.conf
  }
  echo 1 > /proc/sys/net/ipv4/ip_forward

  # Install packages if missing (wiped by --force-recreate; will move to a
  # custom Dockerfile baked into compose build context for production).
  # Phase L: added wireguard-tools, kmod-wireguard, luci-proto-wireguard
  # so the routing service can mint VPN peers against this container.
  NEED_INSTALL=0
  command -v hostapd >/dev/null || NEED_INSTALL=1
  command -v wg >/dev/null      || NEED_INSTALL=1
  [ -f /lib/netifd/proto/wireguard.sh ] || NEED_INSTALL=1
  # Fresh-provision fix: umdns is the mDNS daemon the routing service
  # browses for _droplet-ap._tcp (AP auto-discovery, ADR-005). Stock
  # openwrt/rootfs ships without it, so a fresh container / post-factory-
  # reset box loses AP discovery entirely until it is installed. Trigger a
  # (re)install when the binary is absent.
  [ -x /usr/sbin/umdns ] || NEED_INSTALL=1
  # >>> install_ap_pkgs (WARP-826b)
  # Install the AP/router packages, hardened against the first-boot race where
  # the container has no internet yet — a single opkg attempt then silently
  # fails and the AP never installs (the failure mode at L276, seen live on the
  # .87 box: hostapd + iw absent, attach still exited 0). Wait for the feed,
  # retry update + install, and NEVER hide a persistent failure. Knobs default to
  # prod values; the unit tests shrink them: OPKG_FEED_TRIES / OPKG_INSTALL_TRIES
  # / OPKG_RETRY_SLEEP.
  install_ap_pkgs() {
    _feed_tries="${OPKG_FEED_TRIES:-12}"
    _inst_tries="${OPKG_INSTALL_TRIES:-3}"
    _nap="${OPKG_RETRY_SLEEP:-5}"
    _i=1
    _feed_ok=0
    while [ "$_i" -le "$_feed_tries" ]; do
      if opkg update >/dev/null 2>&1; then _feed_ok=1; break; fi
      sleep "$_nap"
      _i=$((_i + 1))
    done
    [ "$_feed_ok" = 1 ] || echo "droplet-openwrt-attach: ERROR: opkg feed unreachable after ${_feed_tries} tries — AP/router packages cannot install until container connectivity returns" >&2
    _i=1
    while [ "$_i" -le "$_inst_tries" ]; do
      if opkg install \
        hostapd-mbedtls hostapd-utils wireless-regdb iw-full \
        uhttpd uhttpd-mod-ubus rpcd rpcd-mod-rpcsys rpcd-mod-iwinfo rpcd-mod-file \
        umdns \
        wireguard-tools kmod-wireguard luci-proto-wireguard \
        >/dev/null 2>&1; then break; fi
      sleep "$_nap"
      _i=$((_i + 1))
    done
    # Hard-verify the load-bearing AP binary actually landed — do NOT return
    # success with a silently-broken AP (the recurring L276 failure this guards).
    if command -v hostapd >/dev/null 2>&1; then
      return 0
    fi
    echo "droplet-openwrt-attach: ERROR: hostapd still missing after opkg install retries — the default Wi-Fi AP cannot start (check container internet / opkg feed)" >&2
    return 1
  }
  # <<< install_ap_pkgs (WARP-826b)
  if [ "$NEED_INSTALL" = 1 ]; then
    install_ap_pkgs || true
    # netifd was started before luci-proto-wireguard arrived, so it didnt
    # load the wireguard protocol handler. Restart it so ifup wg0 works
    # for any subsequent peer-add via the routing service.
    /etc/init.d/network restart >/dev/null 2>&1
    sleep 2
    # network restart wiped eth0s docker IP + default route AND may have
    # re-bridged eth0 into br-lan if the UCI delete above didnt take —
    # re-run unbridge before bootstrap so the new IP lands on the actual
    # L3 interface, not on a bridge port that the kernel ignores.
    unbridge_eth0
    bootstrap_net
    # uhttpd binds to eth0 too; nudge it so docker-proxy can talk to ubus.
    /etc/init.d/uhttpd restart >/dev/null 2>&1
  fi

  # Fresh-provision fix: enable + start umdns every attach (idempotent). The
  # routing service browses it for _droplet-ap._tcp; without it the
  # /aps/discovered call returns a ubus error and AP auto-discovery never
  # sees a plugged-in AP.
  /etc/init.d/umdns enable >/dev/null 2>&1
  /etc/init.d/umdns restart >/dev/null 2>&1
  echo "droplet-openwrt-attach: umdns enabled + started (_droplet-ap._tcp discovery)"

  # Fresh-provision fix: unbridge_eth0 (above) pulls eth0 out of br-lan,
  # which also drops it out of the lan firewall zone, so fw4 DROPs input on
  # eth0 and the host docker-proxy:8181 -> uhttpd ubus path is refused. The
  # routing service then crash-loops at startup (Connection reset by peer).
  # Re-add eth0 as a device on the lan zone so management input (ubus on
  # :80) is accepted on the host-only docker interface. Idempotent; eth0 is
  # a host-only docker veth (172.18.0.0/16), never the LAN or WAN.
  trust_eth0_fw() {
    lansec=$(uci show firewall 2>/dev/null | grep "\.name=.lan." | head -1 | cut -d. -f2)
    [ -n "$lansec" ] || { echo "droplet-openwrt-attach: WARN: no lan firewall zone found; eth0 left untrusted (router may be unreachable)"; return 0; }
    uci -q get "firewall.$lansec.device" 2>/dev/null | grep -qw eth0 || \
      uci add_list "firewall.$lansec.device=eth0"
    # A read-only overlay right after a docker restart (see the session-cache
    # note below) makes commit/reload fail silently, leaving the router
    # unreachable with no breadcrumb — warn so the attach log shows why ubus
    # input is refused, matching the OPENWRT_ROOT_PW warn above.
    if uci -q commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; then
      echo "droplet-openwrt-attach: eth0 trusted on lan zone '$lansec' (ubus input accepted)"
    else
      echo "droplet-openwrt-attach: WARN: firewall commit/reload failed; eth0 may stay DROPped (router unreachable)"
    fi
  }
  trust_eth0_fw

  # WARP-810: put the AP iface ($AP_IFACE, e.g. wlp14s0) into its own fw4
  # firewall zone. Field-confirmed bug on the single-box: the AP comes up at
  # 192.168.20.1/24 with dnsmasq-ap serving DHCP, but $AP_IFACE is in NO zone.
  # The inet fw4 input chain is policy-drop and only accepts new input from the
  # lan zone (eth0 + br-lan), so a client DHCP DISCOVER (new, not established)
  # is DROPped -> the phone associates to hostapd but never gets a lease (~15s
  # timeout, looks like "cannot connect"). The fix:
  #   - a zone named "ap" covering $AP_IFACE with input=ACCEPT, so DHCP (:67)
  #     and DNS (:53) reach dnsmasq-ap. This is the critical "get an IP" fix.
  #   - forwarding ap -> lan, because on the single-box the real uplink is the
  #     docker veth eth0, which trust_eth0_fw (above) places in the lan zone;
  #     the baked lan->wan forwarding then chains AP egress onward when a wan
  #     member exists. (The baked wan zone has no live member on this box, so
  #     forwarding to wan would be a dead end here.)
  #   - a fw4 NAT MASQUERADE scoped to the AP subnet (192.168.20.0/24) leaving
  #     the lan zone, so AP clients reach the internet. Scoping to src_ip keeps
  #     it from double-NATing the lan zone own clients on the multi-box shape
  #     (their 192.168.50.x source never matches).
  # Mechanism is UCI + fw4 reload, mirroring trust_eth0_fw. Idempotent: every
  # section is upserted by a stable name (zone "ap" / forwarding
  # "droplet_ap_fwd" / nat "droplet_ap_masq"), and the device list is guarded,
  # so re-running the attach never duplicates config. Default-drop input stays
  # intact for every other interface (no global defaults flip, no policy
  # accept). NB: NO APOSTROPHES in this block (single-quoted docker exec body).
  # >>> ap_firewall_zone (WARP-810)
  ap_firewall_zone() {
    apif="${AP_IFACE:-wlp14s0}"
    # Egress zone = wherever the uplink iface lives. On the single-box eth0 is
    # pulled into the lan zone by trust_eth0_fw; on multi-box lan is br-lan.
    lansec=$(uci show firewall 2>/dev/null | grep "\.name=.lan." | head -1 | cut -d. -f2)
    if [ -z "$lansec" ]; then
      echo "droplet-openwrt-attach: WARN: no lan firewall zone found; AP zone left unrouted (Wi-Fi clients get no internet)"
    fi

    # --- AP zone (named, so it is upsert-able) ---------------------------
    if ! uci -q get firewall.droplet_ap >/dev/null 2>&1; then
      uci set firewall.droplet_ap=zone
    fi
    uci set firewall.droplet_ap.name=ap
    uci set firewall.droplet_ap.input=ACCEPT
    uci set firewall.droplet_ap.output=ACCEPT
    # forward=REJECT on the zone itself keeps AP clients from reaching the LAN
    # unfiltered; cross-zone routing is opened explicitly via the forwarding
    # section below (ap -> lan -> wan), never a blanket forward.
    uci set firewall.droplet_ap.forward=REJECT
    # Bind the AP iface to the zone by device. Guarded so a second run does not
    # append a duplicate (uci add_list has list semantics and would dupe).
    if ! uci -q get firewall.droplet_ap.device 2>/dev/null | grep -qw "$apif"; then
      uci add_list "firewall.droplet_ap.device=$apif"
    fi

    # --- forwarding ap -> lan (egress path) ------------------------------
    if [ -n "$lansec" ]; then
      lanname=$(uci -q get "firewall.$lansec.name" 2>/dev/null)
      [ -n "$lanname" ] || lanname=lan
      if ! uci -q get firewall.droplet_ap_fwd >/dev/null 2>&1; then
        uci set firewall.droplet_ap_fwd=forwarding
      fi
      uci set firewall.droplet_ap_fwd.src=ap
      uci set firewall.droplet_ap_fwd.dest="$lanname"

      # --- NAT: masquerade AP-subnet egress out the lan (uplink) zone ----
      if ! uci -q get firewall.droplet_ap_masq >/dev/null 2>&1; then
        uci set firewall.droplet_ap_masq=nat
      fi
      uci set firewall.droplet_ap_masq.name=droplet_ap_masq
      uci set firewall.droplet_ap_masq.src="$lanname"
      uci set firewall.droplet_ap_masq.src_ip=192.168.20.0/24
      uci set firewall.droplet_ap_masq.target=MASQUERADE
    fi

    if uci -q commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1; then
      echo "droplet-openwrt-attach: AP zone configured ($apif input=ACCEPT, forward ap->${lanname:-lan}, masq 192.168.20.0/24) — Wi-Fi clients can DHCP + reach internet"
    else
      echo "droplet-openwrt-attach: WARN: firewall commit/reload failed; AP zone may not be active (Wi-Fi clients may not get a lease)"
    fi
  }
  ap_firewall_zone
  # <<< ap_firewall_zone (WARP-810)

  # Phase L: set root password from $OPENWRT_ROOT_PW so the routing services
  # rpcd login works. Idempotent: only re-set if the current password fails.
  if [ -n "$OPENWRT_ROOT_PW" ]; then
    if ! ubus call session login "{\"username\":\"root\",\"password\":\"$OPENWRT_ROOT_PW\"}" >/dev/null 2>&1; then
      printf "%s\n%s\n" "$OPENWRT_ROOT_PW" "$OPENWRT_ROOT_PW" | passwd root >/dev/null 2>&1
      # rpcd caches sometimes; nudge it to re-read shadow
      /etc/init.d/rpcd restart >/dev/null 2>&1
    fi
  fi

  # --- Phase L: wg-sync helper -----------------------------------------
  # netifds wireguard.sh proto handler doesnt cleanly re-apply UCI peer
  # changes to a running wg0 in this container (ubus call network reload
  # times out). Workaround: when the routing service writes a peer via
  # uci.apply, /etc/config/network is rewritten — we poll-watch UCI peer
  # hash and call `wg syncconf wg0 <runtime-conf>` to push to the kernel.
  # ~2s propagation, no interface bounce.
  mkdir -p /usr/local/sbin
  cat > /usr/local/sbin/wg-sync <<"WGSYNC"
#!/bin/sh
# Apply UCI WireGuard peer state to the running wg0 interface via wg syncconf.
# Idempotent; safe to call on every network commit.
IFACE="${1:-wg0}"
ip link show "$IFACE" >/dev/null 2>&1 || exit 0
SRV_PK=$(uci -q get network.$IFACE.private_key) || exit 0
SRV_PORT=$(uci -q get network.$IFACE.listen_port)
CONF=$(mktemp -t wg-runtime.XXXXXX)
{
  echo "[Interface]"
  echo "PrivateKey = $SRV_PK"
  [ -n "$SRV_PORT" ] && echo "ListenPort = $SRV_PORT"
  i=0
  while uci -q get network.@wireguard_${IFACE}[$i].public_key >/dev/null 2>&1; do
    PK=$(uci -q get network.@wireguard_${IFACE}[$i].public_key)
    AIP=$(uci -q get network.@wireguard_${IFACE}[$i].allowed_ips)
    KA=$(uci -q get network.@wireguard_${IFACE}[$i].persistent_keepalive)
    EP=$(uci -q get network.@wireguard_${IFACE}[$i].endpoint_host)
    EPP=$(uci -q get network.@wireguard_${IFACE}[$i].endpoint_port)
    echo ""
    echo "[Peer]"
    echo "PublicKey = $PK"
    [ -n "$AIP" ] && echo "AllowedIPs = $AIP"
    [ -n "$KA" ]  && echo "PersistentKeepalive = $KA"
    if [ -n "$EP" ]; then
      [ -n "$EPP" ] && echo "Endpoint = $EP:$EPP" || echo "Endpoint = $EP"
    fi
    i=$((i+1))
  done
} > "$CONF"
wg syncconf "$IFACE" "$CONF" 2>&1
rc=$?
rm -f "$CONF"
exit $rc
WGSYNC
  chmod +x /usr/local/sbin/wg-sync

  # 2-second poll loop — busybox in this image lacks inotifyd, so we just
  # re-run wg-sync periodically. wg syncconf is idempotent, so the no-change
  # case is a cheap noop. Wraps the call in a hash check so the log only
  # records actual changes.
  cat > /usr/local/sbin/wg-sync-loop <<"WGLOOP"
#!/bin/sh
LAST=""
while true; do
  HASH=$(uci show network 2>/dev/null | grep -E "^network\.(wg0\.|@wireguard_wg0\[)" | md5sum | cut -d" " -f1)
  if [ "$HASH" != "$LAST" ]; then
    /usr/local/sbin/wg-sync wg0 >>/tmp/wg-sync.log 2>&1
    LAST="$HASH"
  fi
  sleep 2
done
WGLOOP
  chmod +x /usr/local/sbin/wg-sync-loop

  # Spawn the poll loop via start-stop-daemon (busybox applet) so it daemonizes
  # cleanly under PID 1 = /sbin/init, surviving docker exec returns.
  start-stop-daemon -K -q -p /var/run/wg-sync.pid 2>/dev/null
  rm -f /var/run/wg-sync.pid
  start-stop-daemon -S -b -m -p /var/run/wg-sync.pid -x /usr/local/sbin/wg-sync-loop
  # ---------------------------------------------------------------------

  # --- eth0 watchdog -----------------------------------------------------
  # OpenWrts procd / netifd brings eth0 DOWN seconds after this attach
  # script ends, because we removed the eth0 port from br-lans UCI device
  # entry (so docker-proxy can keep L3 ownership of 172.18.0.10/16). With
  # no UCI interface referencing eth0, netifd treats it as orphaned and
  # admin-downs it on every reconcile pass — which kills the routing
  # services next outbound RPC call before its docker healthcheck even
  # fires.
  #
  # Symmetry with the wg-sync poll loop above: a 2-second watchdog
  # idempotently re-asserts UP + the docker-assigned IP + default route
  # whenever it notices eth0 is missing them. Cheap (one ip-link-show
  # + a couple of grep checks per cycle) and the recovery is sub-second.
  # Storage target: /tmp, NOT /usr/local/sbin. The overlay upperdir
  # housing /usr/local/sbin is briefly read-only right after `docker
  # restart` while procd boots, so the first attach after every
  # container restart silently fails to write to /usr/local/sbin/...
  # (see the cluster of `Read-only file system` lines in the journal
  # from earlier attach runs). /tmp is a tmpfs mounted before procd
  # even starts, so writes always succeed there. The trade-off — the
  # watchdog file is wiped on container restart — is fine because the
  # attach script runs after every restart and rewrites it.
  cat > /tmp/eth0-keepalive <<"ETHWD"
#!/bin/sh
# eth0 watchdog. Bring eth0 back up + restore the docker IP/default
# route if procd/netifd has admin-downed it again.
IP_ADDR="${1:-172.18.0.10/16}"
GW="${2:-172.18.0.1}"
while true; do
  STATE=$(ip -o link show eth0 2>/dev/null | head -1)
  case "$STATE" in
    *"state UP"*) : ;;
    *)
      ip link set eth0 up 2>/dev/null
      ;;
  esac
  ip addr show eth0 2>/dev/null | grep -q "${IP_ADDR%/*}" || \
    ip addr add "$IP_ADDR" dev eth0 2>/dev/null
  ip route 2>/dev/null | grep -q "^default" || \
    ip route add default via "$GW" 2>/dev/null
  sleep 2
done
ETHWD
  chmod +x /tmp/eth0-keepalive

  start-stop-daemon -K -q -p /var/run/eth0-keepalive.pid 2>/dev/null
  rm -f /var/run/eth0-keepalive.pid
  start-stop-daemon -S -b -m -p /var/run/eth0-keepalive.pid \
    -x /tmp/eth0-keepalive -- "${CONT_IP}/16" "$CONT_GW"
  # ---------------------------------------------------------------------

  # --- ip nat table: masq egress + DNAT ingress for AP clients ----------
  nft list table ip nat >/dev/null 2>&1 || nft add table ip nat

  # postrouting: masq 192.168.20.0/24 going out eth0
  nft list chain ip nat postrouting >/dev/null 2>&1 || \
    nft add chain ip nat postrouting "{ type nat hook postrouting priority 100 ; }"
  nft list chain ip nat postrouting | grep -q "192.168.20.0/24" || \
    nft add rule ip nat postrouting ip saddr 192.168.20.0/24 oifname \"eth0\" masquerade

  # prerouting: DNAT $AP_IFACE:80/:443 -> gateway container so phones can hit
  # https://droplet.local/ (which resolves to 192.168.20.1) and land on nginx
  nft list chain ip nat prerouting >/dev/null 2>&1 || \
    nft add chain ip nat prerouting "{ type nat hook prerouting priority -100 ; }"
  # Flush prior DNAT rules so a gateway-IP change doesnt leave a stale target
  for h in $(nft -a list chain ip nat prerouting 2>/dev/null | grep "dnat to" | grep -oE "handle [0-9]+" | awk "{print \$2}"); do
    nft delete rule ip nat prerouting handle $h
  done
  # Critical: scope DNAT to traffic destined for 192.168.20.1 (the openwrt
  # AP IP) ONLY. Without the `ip daddr` predicate, every :80/:443 packet
  # leaving the AP gets hijacked to the dashboard gateway — so a client
  # browsing https://google.com ends up on the Droplet login page with a
  # cert mismatch (looks like a captive portal). With the daddr filter,
  # the rule only fires for clients explicitly hitting the router IP
  # (droplet.local resolves to 192.168.20.1 -> rule kicks in -> dashboard),
  # while everything else passes through to the real internet.
  nft add rule ip nat prerouting iifname \"$AP_IFACE\" ip daddr 192.168.20.1 tcp dport 443 dnat to ${GATEWAY_IP}:443
  nft add rule ip nat prerouting iifname \"$AP_IFACE\" ip daddr 192.168.20.1 tcp dport 80  dnat to ${GATEWAY_IP}:80
  # ----------------------------------------------------------------------

  # Stop procd dnsmasq so our manual one can bind 192.168.20.1
  /etc/init.d/dnsmasq stop 2>/dev/null
  /etc/init.d/dnsmasq disable 2>/dev/null

  # hostapd config — regenerate every run so SSID/PSK env changes propagate.
  # Wi-Fi 6 (HE) + HT enabled on 2.4 GHz ch 6; hostapd auto-falls back to
  # HT20 if 40 MHz neighbours preclude it (CCA scan during HT_SCAN state).
  # AC is intentionally absent — 802.11ac is 5 GHz only and would just emit
  # warnings here.
  cat > /etc/hostapd.conf.new <<HOSTAPD
interface=$AP_IFACE
driver=nl80211
ssid=$AP_SSID
hw_mode=g
channel=6
country_code=US
ieee80211d=1
ieee80211n=1
ieee80211ax=1
ht_capab=[HT40+][SHORT-GI-20][SHORT-GI-40][DSSS_CCK-40]
he_oper_chwidth=0
he_oper_centr_freq_seg0_idx=8
wmm_enabled=1
auth_algs=1
wpa=2
wpa_passphrase=$AP_PSK
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
ieee80211w=1
HOSTAPD

  HOSTAPD_CHANGED=0
  if [ ! -f /etc/hostapd.conf ] || ! cmp -s /etc/hostapd.conf /etc/hostapd.conf.new; then
    mv /etc/hostapd.conf.new /etc/hostapd.conf
    HOSTAPD_CHANGED=1
  else
    rm -f /etc/hostapd.conf.new
  fi

  # dnsmasq-ap config — regenerate every run so name mappings propagate.
  # NOTE dhcp-option=6 points phones at openwrt itself for DNS, NOT 8.8.8.8,
  # so phones can resolve AP_DOMAIN / AP_HOSTNAME locally.
  cat > /etc/dnsmasq-ap.conf.new <<DNSMASQ
interface=$AP_IFACE
bind-interfaces
# dnsmasq defaults to /var/lib/misc/dnsmasq.leases, which doesnt exist in
# the openwrt minimal rootfs after a fresh container. Pin to /tmp/ where
# it always exists and gets reset on container restart (which is what we
# want — clients re-DHCP fresh after a reboot anyway).
dhcp-leasefile=/tmp/dhcp.leases
dhcp-range=192.168.20.10,192.168.20.100,255.255.255.0,12h
dhcp-option=3,192.168.20.1
dhcp-option=6,192.168.20.1
server=8.8.8.8
server=1.1.1.1
no-resolv
# Customer-facing hostnames -> openwrt IP (DNATs to dashboard)
address=/$AP_HOSTNAME/192.168.20.1
address=/$AP_DOMAIN/192.168.20.1
DNSMASQ

  DNSMASQ_CHANGED=0
  if [ ! -f /etc/dnsmasq-ap.conf ] || ! cmp -s /etc/dnsmasq-ap.conf /etc/dnsmasq-ap.conf.new; then
    mv /etc/dnsmasq-ap.conf.new /etc/dnsmasq-ap.conf
    DNSMASQ_CHANGED=1
  else
    rm -f /etc/dnsmasq-ap.conf.new
  fi

  # Bring up $AP_IFACE + (re)start daemons only if config changed or not running
  ip link set "$AP_IFACE" up 2>/dev/null
  ip addr show "$AP_IFACE" | grep -q 192.168.20.1 || ip addr add 192.168.20.1/24 dev "$AP_IFACE"

  # >>> start_hostapd (WARP-826b)
  # Start hostapd and VERIFY it actually came up. The old fire-and-forget
  # (pgrep || hostapd -B) hid launch failures — a dead AP while the attach
  # reported success (seen live on .87). Retry a few times, then log loudly so a
  # broken AP is never silent. Knobs: HOSTAPD_START_TRIES / HOSTAPD_START_SLEEP.
  start_hostapd() {
    if pgrep -f "hostapd -B" >/dev/null 2>&1; then return 0; fi
    _htries="${HOSTAPD_START_TRIES:-3}"
    _hnap="${HOSTAPD_START_SLEEP:-1}"
    _h=1
    while [ "$_h" -le "$_htries" ]; do
      hostapd -B -P /run/hostapd.pid /etc/hostapd.conf >/dev/null 2>&1 || true
      sleep "$_hnap"
      if pgrep -f "hostapd -B" >/dev/null 2>&1; then
        echo "droplet-openwrt-attach: hostapd up on ${AP_IFACE}"
        return 0
      fi
      _h=$((_h + 1))
    done
    echo "droplet-openwrt-attach: ERROR: hostapd failed to start after ${_htries} tries — default Wi-Fi AP is DOWN (hostapd installed? iface ${AP_IFACE} present? /etc/hostapd.conf valid?)" >&2
    return 1
  }
  # <<< start_hostapd (WARP-826b)
  if [ "$HOSTAPD_CHANGED" = 1 ]; then
    pgrep -f "hostapd -B" | xargs -r kill 2>/dev/null
    sleep 1
  fi
  start_hostapd || true

  if [ "$DNSMASQ_CHANGED" = 1 ]; then
    pgrep -f "dnsmasq -C /etc/dnsmasq-ap.conf" | xargs -r kill 2>/dev/null
    sleep 1
  fi
  pgrep -f "dnsmasq -C /etc/dnsmasq-ap.conf" >/dev/null || dnsmasq -C /etc/dnsmasq-ap.conf

  # Final pass — re-run bootstrap_net AFTER everything else in this docker
  # exec block has run. Procd / hostapd / dnsmasq init can race against
  # the early unbridge_eth0 + bootstrap_net calls at the top of this
  # block — netifd in particular brings eth0 DOWN again on a clean
  # container restart because eth0 has no UCI interface (we removed it
  # from br-lan + left it un-managed by design, so docker-proxy keeps L3
  # ownership). With no UCI to bring it back up, netifd happily leaves
  # eth0 down, host:8081 cannot reach uhttpd, routing service times out,
  # orchestrator reports router:false. Idempotent re-run here is the
  # simplest fix: procd and netifd are quiesced by this point and we get
  # the last word.
  #
  # NB: NO APOSTROPHES allowed in this comment block — the whole docker
  # exec body is wrapped in single quotes by the outer script, so a stray
  # `cant` or `dont` would close the heredoc early and the trailing
  # function calls would run in the OUTER bash where they are undefined.
  # (Found the hard way: a `cannot` rendered as cant prematurely closed
  # the heredoc, two systemctl restarts ago.)
  unbridge_eth0
  bootstrap_net
'

echo "droplet-openwrt-attach: done (gateway=$GATEWAY_IP, ssid=$AP_SSID, domain=$AP_DOMAIN)"

# Fresh-provision fix: install the droplet rpcd ACL so the routing service
# session (root) is granted `umdns: [browse, update]` plus dhcp/iwinfo
# reads. Without it ubus returns "Access denied" on umdns browse and
# /aps/discovered 500s — AP auto-discovery cannot work. /usr/share is not a
# persisted volume (lost on container recreate), so (re)copy it every attach.
DROPLET_RPCD_ACL="${DROPLET_RPCD_ACL:-/home/droplet/edge-platform/openwrt/files/usr/share/rpcd/acl.d/droplet-ai.json}"
if [ -r "$DROPLET_RPCD_ACL" ]; then
  if docker cp "$DROPLET_RPCD_ACL" droplet-openwrt:/usr/share/rpcd/acl.d/droplet-ai.json >/dev/null 2>&1; then
    docker exec droplet-openwrt /etc/init.d/rpcd restart >/dev/null 2>&1
    echo "droplet-openwrt-attach: installed rpcd ACL (umdns browse/update)"
  fi
fi

# Routing service caches its OpenWrt session at startup and does not
# reconnect on RPC failure (the python-uci SDK holds the session token
# across calls). After ANY docker restart of droplet-openwrt — whether
# triggered by this attach run, a manual `docker restart`, or a host
# reboot — the routing service is left holding a stale session and the
# dashboard's next call lands on {"connected":false,"error":"Access
# denied"}.
#
# Earlier this block tried to probe routing's /health and conditionally
# restart, but the probe ran ~1s after openwrt came up — routing was
# still answering with its in-memory cache before its next outbound
# call failed, so the condition never fired. Since this script is a
# oneshot systemd unit (not a per-second poll), the unconditional
# restart is cheap (~15s on the POC box) and removes the race entirely.
# `docker restart` against an absent container is a hard error, so
# guard on `docker ps`.
if command -v docker >/dev/null 2>&1; then
  if docker ps --format '{{.Names}}' | grep -qx droplet-routing-1; then
    echo "droplet-openwrt-attach: restarting routing to drop any stale OpenWrt session"
    docker restart droplet-routing-1 >/dev/null 2>&1 || true
  fi
fi
