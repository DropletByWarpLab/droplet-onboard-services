#cloud-config
# =============================================================================
# Droplet single-box appliance — Ubuntu 24.04 autoinstall seed (WARP-663)
# =============================================================================
#
# subiquity `nocloud` autoinstall. Embedded on the repacked live-server ISO at
# /server/user-data (GRUB passes `autoinstall ds=nocloud;s=/cdrom/server/`).
# On first boot Ubuntu installs unattended, then late-commands clone this repo
# and run scripts/setup.sh --single-box --systemd — replicating the documented
# docs/SINGLE_BOX.md quick-start with zero human keystrokes.
#
# SECURITY (ADR-020 §D6): NO per-device secret is baked. The `droplet` identity
# below uses a LOCKED initial password (the `!` hash = no valid password) that
# MUST be set on first console/SSH access. Every real secret (JWT_SECRET,
# DEVICE_SECRET, DB/MQTT/Nextcloud passwords, TLS) is generated at first boot by
# scripts/lib/secrets.sh, exactly as on a `setup.sh` install today — so every
# built ISO is byte-identical and safe to distribute.
autoinstall:
  version: 1

  # Keyboard / locale — generic, no host-specific assumptions.
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Network: DHCP on any wired link. The appliance needs network on first boot
  # to clone the repo + pull container images (ISO is Phase 1; offline golden
  # raw .img is Phase 2). No host-specific addressing (ADR-011).
  network:
    version: 2
    ethernets:
      any-eth:
        match:
          name: "en*"
        dhcp4: true

  # Identity. Hostname names the deployment shape, not a lifecycle stage.
  # The password hash is the LOCKED sentinel `!` (no valid password). The
  # operator sets a real password on first login; SSH key auth is the intended
  # path (see ssh: below). NOTE: this is NOT a secret — it grants no access.
  identity:
    hostname: droplet
    username: droplet
    # `!` = locked account password (crypt sentinel). NOT a real credential.
    password: "!"

  # SSH: install the server, do NOT bake any authorized key (no secret). The
  # operator adds their key on first local-console access, or via the setup
  # wizard. Password auth stays off by default (locked password anyway).
  ssh:
    install-server: true
    allow-pw: false

  # Storage (WARP-232): explicit curtin config instead of the implicit `lvm`
  # layout. The root LV is BOUNDED (64G) so the VG keeps free extents for the
  # LUKS2 data LV that scripts/host/droplet-luks-provision.sh creates on first
  # boot (setup.sh Phase 1.5) and seals to the TPM. An ext4 root can't shrink
  # online — this split is why the partition layout is a build-time change.
  # The data LV is deliberately NOT declared here: setup.sh owns it (ADR-020
  # §D1 — setup.sh is the single source of provisioning truth).
  storage:
    config:
      - { type: disk, id: disk0, ptable: gpt, wipe: superblock-recursive,
          match: { size: largest }, grub_device: false }
      - { type: partition, id: part-esp,  device: disk0, size: 1G, flag: boot,
          grub_device: true }
      - { type: partition, id: part-boot, device: disk0, size: 2G }
      - { type: partition, id: part-pv,   device: disk0, size: -1 }
      - { type: format, id: fmt-esp,  volume: part-esp,  fstype: fat32 }
      - { type: format, id: fmt-boot, volume: part-boot, fstype: ext4 }
      - { type: lvm_volgroup, id: vg0, name: ubuntu-vg, devices: [ part-pv ] }
      - { type: lvm_partition, id: lv-root, volgroup: vg0, name: ubuntu-lv, size: 64G }
      - { type: format, id: fmt-root, volume: lv-root, fstype: ext4 }
      - { type: mount, id: mount-root, device: fmt-root, path: / }
      - { type: mount, id: mount-boot, device: fmt-boot, path: /boot }
      - { type: mount, id: mount-esp,  device: fmt-esp,  path: /boot/efi }

  # Base packages the first-boot clone + setup.sh need before Docker is
  # installed by setup.sh itself. Kept minimal — setup.sh owns the rest.
  packages:
    - git
    - curl
    - ca-certificates
    - openssl
    # WARP-2143: guaranteed present for the boot-order late-command below.
    # grub-efi-amd64 already depends on it on a UEFI install, but the skip
    # logic must key off EFI-vars presence, never off a missing binary. Tiny.
    - efibootmgr
    # TPM2 userspace (WARP-2101): systemd-cryptenroll dlopens all three tss2
    # libraries at runtime. Without them it reports "TPM2 support is not
    # installed" on HEALTHY TPM hardware, and the first-boot LUKS provisioning
    # (scripts/host/droplet-luks-provision.sh, setup.sh Phase 1.5) cannot seal
    # the data LV — worst case aborting mid-provision with a container that
    # has zero usable keyslots. Ubuntu 24.04 (noble) package names.
    - libtss2-esys-3.0.2-0t64
    - libtss2-mu-4.0.1-0t64
    - libtss2-rc0t64

  # Keep the installed system current at install time.
  updates: security

  # ---------------------------------------------------------------------------
  # First-boot provisioning. Runs in the installer environment with the target
  # mounted at /target; we clone into the target's /home/droplet and run setup
  # via systemd on first real boot (NOT here — setup.sh needs the booted system,
  # Docker, and the real network stack, not the installer's).
  # ---------------------------------------------------------------------------
  late-commands:
    # Clone the platform into the operator's home on the TARGET filesystem.
    # Retry up to 3x (autoinstall networking is racy just after the NIC comes
    # up), then FAIL THE INSTALL loudly if the clone never lands. The old
    # `|| true` swallowed a network failure: the install exited 0, the next
    # chown no-op'd on a missing dir, and droplet-firstboot.service then crash-
    # looped forever on a non-existent WorkingDirectory — a booted box with no
    # Droplet stack and no error shown at install time. (review #501)
    - |
      curtin in-target --target=/target -- bash -c '
        for attempt in 1 2 3; do
          rm -rf /home/droplet/edge-platform
          git clone --depth 1 https://github.com/DropletByWarpLab/droplet-onboard-services.git /home/droplet/edge-platform && break
          echo "droplet: clone attempt $attempt failed; retrying in 5s" >&2
          sleep 5
        done
        test -d /home/droplet/edge-platform/.git || { echo "FATAL: droplet platform clone failed during autoinstall; aborting so this surfaces now, not as a crash-looping first boot." >&2; exit 1; }
      '
    # WARP-2666: carry the client installers off the ISO into the checkout.
    #
    # This is the step that makes a SHIPPED box's /downloads page non-blank.
    # The clone above cannot bring them: data/app-downloads is git-ignored
    # (the binaries are built in droplet-windows / droplet-android, not here),
    # so every box that has ever shipped booted with an empty "Get the app"
    # page. build-iso.sh bakes the staged directory onto the ISO at
    # /droplet/app-downloads; this copies it into the freshly cloned tree.
    #
    # DELIBERATELY NOT `curtin in-target`. Every other late-command here is
    # chrooted into /target, where /cdrom does not exist — the ISO is mounted
    # in the INSTALLER environment, not in the target. So this one runs bare
    # and writes through to /target/... . Converting it to in-target for
    # consistency would silently copy nothing.
    #
    # `catalog.json` is baked by the builder, never generated here: the
    # package list above is git/curl/ca-certificates/openssl/efibootmgr plus
    # three libtss2 — there is no node and no python3 on this system, and the
    # orchestrator image that stage.sh borrows node from does not exist yet.
    #
    # GUARDED, unlike its neighbours. The clone is deliberately fatal because
    # a box without the platform is useless; a box without client installers
    # is a box with an honest empty page, which the audit reports and an
    # operator can fix with one command. Aborting an otherwise good install
    # over it would be the wrong trade, so every failure path here is
    # swallowed and left to `scripts/app-downloads/audit.sh` to report.
    - |
      set +e
      _src=/cdrom/droplet/app-downloads
      _dst=/target/home/droplet/edge-platform/data/app-downloads
      if [ -d "$_src" ] && [ -d "$_dst" ]; then
        cp -a "$_src"/. "$_dst"/ 2>/dev/null \
          && echo "droplet: staged client apps copied from the install media" \
          || echo "droplet: WARNING client-app payload copy failed; /downloads will be empty until an operator runs scripts/app-downloads/stage.sh" >&2
      else
        echo "droplet: no client-app payload on this media; /downloads will be empty until an operator stages one" >&2
      fi
      true
    # Runs AFTER the payload copy so the chown covers the copied files too —
    # cp -a off the ISO preserves root ownership, and the orchestrator's bind
    # mount would otherwise hand the operator a tree they cannot re-stage.
    - curtin in-target --target=/target -- chown -R droplet:droplet /home/droplet/edge-platform
    # Install a oneshot systemd unit that runs setup.sh --single-box --systemd
    # on the FIRST real boot, then disables itself. setup.sh is the single
    # source of provisioning truth (ADR-020 §D1) — no second copy of the
    # install logic here.
    # WARP-2100: TimeoutStartSec is GENEROUS but FINITE (first boot
    # legitimately pulls images for many minutes) — never 0/infinity, which
    # let a queued cryptsetup ask-password prompt wedge first boot forever;
    # StandardInput=null so no child inherits a promptable console stdin.
    - |
      curtin in-target --target=/target -- bash -c 'cat > /etc/systemd/system/droplet-firstboot.service <<UNIT
      [Unit]
      Description=Droplet single-box first-boot provisioning (runs setup.sh once)
      Wants=network-online.target
      After=network-online.target
      ConditionPathExists=!/var/lib/droplet/.firstboot-done

      [Service]
      Type=oneshot
      User=droplet
      WorkingDirectory=/home/droplet/edge-platform
      ExecStart=/bin/bash -lc "./scripts/setup.sh --single-box --systemd"
      ExecStartPost=/bin/bash -lc "sudo mkdir -p /var/lib/droplet && sudo touch /var/lib/droplet/.firstboot-done && sudo rm -f /etc/sudoers.d/droplet-firstboot"
      RemainAfterExit=yes
      TimeoutStartSec=45min
      StandardInput=null

      [Install]
      WantedBy=multi-user.target
      UNIT'
    - curtin in-target --target=/target -- systemctl enable droplet-firstboot.service
    # WARP-2142 — install-mode SSH window. Fail-open for commissioning,
    # fail-closed for production. The marker is a single epoch-seconds line in
    # the ROOT-owned half of the WARP-1984 state dir (never intent.d/ — the
    # orchestrator container must not be able to mint or extend a window).
    # While it is fresh (<48h) droplet-ssh-access-boot-reset stamps the SSH
    # intent ON at every boot instead of off, so a box that hangs or fails
    # mid-provision stays reachable over the LAN for rescue (the WARP-2100
    # dead-end: a wedged first boot with no console and no way in). setup.sh
    # removes the marker the moment a provision SUCCEEDS; the 48h backstop
    # expires it on an abandoned box. Key-only (allow-pw: false above) and
    # LAN-side only — nothing here touches the firewall or the WAN edge.
    # The path literal must match droplet-ssh-access-boot-reset and
    # setup.sh's completion hook: tests/image-pipeline.test.sh and the vitest
    # guard (ssh-access.host-script.guard.test.ts) pin the agreement.
    - |
      curtin in-target --target=/target -- bash -c '
        mkdir -p /var/lib/droplet-ssh-access
        date +%s > /var/lib/droplet-ssh-access/install-mode
        chmod 0644 /var/lib/droplet-ssh-access/install-mode
      '
    # ...and make sure sshd actually comes up on the very first boot: none of
    # the WARP-1984 machinery (path unit + applier + boot reset) exists until
    # setup.sh installs it mid-provision, so standing systemd enablement in
    # the target is the only thing that can open the window on boot 1. Kept
    # conditional so a base image that already enables ssh (service or
    # socket activation) is left on its own mechanism rather than
    # double-enabled. setup.sh's completion hook disables both again on a
    # successful provision — steady state returns to WARP-1984's
    # start-not-enable, owner-toggle-only regime.
    - |
      curtin in-target --target=/target -- bash -c '
        systemctl is-enabled ssh.service ssh.socket 2>/dev/null | grep -qx enabled \
          || systemctl enable ssh.service
      '
    # Passwordless sudo for the firstboot unit's setup.sh (setup.sh installs
    # Docker + systemd units). PROVISIONING-WINDOW ONLY: the firstboot unit's
    # ExecStartPost deletes this drop-in right after it stamps .firstboot-done
    # (marker first — the rm kills the unit's own sudo), so the grant never
    # outlives provisioning. Steady state on a shipped box is `sudo`-group
    # membership gated by the operator's password; unattended privileged paths
    # go through the device-bridge's polkit-routed root units, never sudo. A
    # NOPASSWD: ALL that persisted past first boot would turn the SSH password
    # into a remote root credential (ADR-020 §D6).
    - |
      curtin in-target --target=/target -- bash -c 'echo "droplet ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/droplet-firstboot && chmod 440 /etc/sudoers.d/droplet-firstboot'
    # WARP-2143: install media boots once — no manual stick-pull. Firmware
    # defaults (bench: ASRock B650I) put UEFI USB ahead of the internal disk,
    # so the customer runbook needed a "pull the stick when it reboots" step —
    # the ONE manual act in an otherwise unattended install. By the time
    # late-commands run, curtin has installed the bootloader, so the target's
    # "ubuntu" UEFI entry (grub-install's default label) exists: rebuild
    # BootOrder as <ubuntu>,<remaining entries in their existing relative
    # order> and apply it with efibootmgr -o. The post-install reboot — and
    # every later boot — then lands on the internal disk even with the stick
    # still inserted.
    #
    # DELIBERATELY NON-FATAL (unlike the clone step above): a boot-order nit
    # must never abort an otherwise good install. But non-fatal is not silent
    # (review #501) — every skip path logs:
    #   - no /sys/firmware/efi           -> BIOS/CSM boot; BootOrder does not apply
    #   - efivarfs unmountable in chroot -> cannot touch EFI vars; firmware keeps its order
    #   - no "ubuntu" entry / no BootOrder variable -> log and leave firmware alone
    #   - ubuntu already first           -> idempotent no-op (safe on re-install)
    # Duplicate "ubuntu" labels: first match wins; later duplicates drop out of
    # the rebuilt order (harmless de-dupe, the entries themselves are untouched).
    - |
      curtin in-target --target=/target -- bash -c '
        set -u
        log() { echo "droplet-boot-order: $1"; }
        if [ ! -d /sys/firmware/efi ]; then
          log "SKIP: no EFI firmware interface (BIOS/CSM boot) - BootOrder does not apply"
          exit 0
        fi
        if ! mountpoint -q /sys/firmware/efi/efivars 2>/dev/null; then
          mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null \
            || { log "SKIP: EFI variables not reachable from the install chroot - leaving BootOrder to the firmware"; exit 0; }
        fi
        if ! command -v efibootmgr >/dev/null 2>&1; then
          log "SKIP: efibootmgr not installed on the target - cannot assert BootOrder"
          exit 0
        fi
        vars="$(efibootmgr 2>&1)" \
          || { log "SKIP: efibootmgr could not read EFI variables: $vars"; exit 0; }
        entry="$(printf "%s\n" "$vars" | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)[* ] ubuntu\([[:space:]].*\)\{0,1\}\$/\1/p" | head -n1)"
        if [ -z "$entry" ]; then
          log "SKIP: no ubuntu boot entry found - leaving BootOrder untouched"
          exit 0
        fi
        order="$(printf "%s\n" "$vars" | sed -n "s/^BootOrder: //p" | head -n1)"
        if [ -z "$order" ]; then
          log "SKIP: firmware reports no BootOrder variable - not inventing one"
          exit 0
        fi
        if [ "${order%%,*}" = "$entry" ]; then
          log "OK: ubuntu entry Boot$entry is already first in BootOrder ($order)"
          exit 0
        fi
        rest="$(printf "%s\n" "$order" | tr "," "\n" | grep -ivx "$entry" | paste -sd, -)"
        new_order="$entry${rest:+,$rest}"
        if efibootmgr -o "$new_order" >/dev/null; then
          log "OK: BootOrder set to $new_order (ubuntu first; was $order) - install media can stay inserted"
        else
          log "WARNING: could not apply BootOrder $new_order - install continues; the stick may still boot first"
        fi
        exit 0
      ' || echo "droplet-boot-order: WARNING: boot-order assertion errored unexpectedly; install continues (WARP-2143 is deliberately non-fatal)" >&2
