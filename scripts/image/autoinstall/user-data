#cloud-config
# =============================================================================
# Droplet single-box appliance — Ubuntu 24.04 autoinstall seed (WARP-663)
# =============================================================================
#
# subiquity `nocloud` autoinstall. Embedded on the repacked live-server ISO at
# /server/user-data (GRUB passes `autoinstall ds=nocloud;s=/cdrom/server/`).
# On first boot Ubuntu installs unattended, then late-commands clone this repo
# and run scripts/setup.sh --single-box --systemd — replicating the documented
# docs/SINGLE_BOX.md quick-start with zero human keystrokes.
#
# SECURITY (ADR-020 §D6): NO per-device secret is baked. The `droplet` identity
# below uses a LOCKED initial password (the `!` hash = no valid password) that
# MUST be set on first console/SSH access. Every real secret (JWT_SECRET,
# DEVICE_SECRET, DB/MQTT/Nextcloud passwords, TLS) is generated at first boot by
# scripts/lib/secrets.sh, exactly as on a `setup.sh` install today — so every
# built ISO is byte-identical and safe to distribute.
autoinstall:
  version: 1

  # Keyboard / locale — generic, no host-specific assumptions.
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Network: DHCP on any wired link. The appliance needs network on first boot
  # to clone the repo + pull container images (ISO is Phase 1; offline golden
  # raw .img is Phase 2). No host-specific addressing (ADR-011).
  network:
    version: 2
    ethernets:
      any-eth:
        match:
          name: "en*"
        dhcp4: true

  # Identity. Hostname names the deployment shape, not a lifecycle stage.
  # The password hash is the LOCKED sentinel `!` (no valid password). The
  # operator sets a real password on first login; SSH key auth is the intended
  # path (see ssh: below). NOTE: this is NOT a secret — it grants no access.
  identity:
    hostname: droplet
    username: droplet
    # `!` = locked account password (crypt sentinel). NOT a real credential.
    password: "!"

  # SSH: install the server, do NOT bake any authorized key (no secret). The
  # operator adds their key on first local-console access, or via the setup
  # wizard. Password auth stays off by default (locked password anyway).
  ssh:
    install-server: true
    allow-pw: false

  # Storage (WARP-232): explicit curtin config instead of the implicit `lvm`
  # layout. The root LV is BOUNDED (64G) so the VG keeps free extents for the
  # LUKS2 data LV that scripts/host/droplet-luks-provision.sh creates on first
  # boot (setup.sh Phase 1.5) and seals to the TPM. An ext4 root can't shrink
  # online — this split is why the partition layout is a build-time change.
  # The data LV is deliberately NOT declared here: setup.sh owns it (ADR-020
  # §D1 — setup.sh is the single source of provisioning truth).
  storage:
    config:
      - { type: disk, id: disk0, ptable: gpt, wipe: superblock-recursive,
          match: { size: largest }, grub_device: false }
      - { type: partition, id: part-esp,  device: disk0, size: 1G, flag: boot,
          grub_device: true }
      - { type: partition, id: part-boot, device: disk0, size: 2G }
      - { type: partition, id: part-pv,   device: disk0, size: -1 }
      - { type: format, id: fmt-esp,  volume: part-esp,  fstype: fat32 }
      - { type: format, id: fmt-boot, volume: part-boot, fstype: ext4 }
      - { type: lvm_volgroup, id: vg0, name: ubuntu-vg, devices: [ part-pv ] }
      - { type: lvm_partition, id: lv-root, volgroup: vg0, name: ubuntu-lv, size: 64G }
      - { type: format, id: fmt-root, volume: lv-root, fstype: ext4 }
      - { type: mount, id: mount-root, device: fmt-root, path: / }
      - { type: mount, id: mount-boot, device: fmt-boot, path: /boot }
      - { type: mount, id: mount-esp,  device: fmt-esp,  path: /boot/efi }

  # Base packages the first-boot clone + setup.sh need before Docker is
  # installed by setup.sh itself. Kept minimal — setup.sh owns the rest.
  packages:
    - git
    - curl
    - ca-certificates
    - openssl
    # TPM2 userspace (WARP-2101): systemd-cryptenroll dlopens all three tss2
    # libraries at runtime. Without them it reports "TPM2 support is not
    # installed" on HEALTHY TPM hardware, and the first-boot LUKS provisioning
    # (scripts/host/droplet-luks-provision.sh, setup.sh Phase 1.5) cannot seal
    # the data LV — worst case aborting mid-provision with a container that
    # has zero usable keyslots. Ubuntu 24.04 (noble) package names.
    - libtss2-esys-3.0.2-0t64
    - libtss2-mu-4.0.1-0t64
    - libtss2-rc0t64

  # Keep the installed system current at install time.
  updates: security

  # ---------------------------------------------------------------------------
  # First-boot provisioning. Runs in the installer environment with the target
  # mounted at /target; we clone into the target's /home/droplet and run setup
  # via systemd on first real boot (NOT here — setup.sh needs the booted system,
  # Docker, and the real network stack, not the installer's).
  # ---------------------------------------------------------------------------
  late-commands:
    # Clone the platform into the operator's home on the TARGET filesystem.
    # Retry up to 3x (autoinstall networking is racy just after the NIC comes
    # up), then FAIL THE INSTALL loudly if the clone never lands. The old
    # `|| true` swallowed a network failure: the install exited 0, the next
    # chown no-op'd on a missing dir, and droplet-firstboot.service then crash-
    # looped forever on a non-existent WorkingDirectory — a booted box with no
    # Droplet stack and no error shown at install time. (review #501)
    - |
      curtin in-target --target=/target -- bash -c '
        for attempt in 1 2 3; do
          rm -rf /home/droplet/edge-platform
          git clone --depth 1 https://github.com/DropletByWarpLab/droplet-onboard-services.git /home/droplet/edge-platform && break
          echo "droplet: clone attempt $attempt failed; retrying in 5s" >&2
          sleep 5
        done
        test -d /home/droplet/edge-platform/.git || { echo "FATAL: droplet platform clone failed during autoinstall; aborting so this surfaces now, not as a crash-looping first boot." >&2; exit 1; }
      '
    - curtin in-target --target=/target -- chown -R droplet:droplet /home/droplet/edge-platform
    # Install a oneshot systemd unit that runs setup.sh --single-box --systemd
    # on the FIRST real boot, then disables itself. setup.sh is the single
    # source of provisioning truth (ADR-020 §D1) — no second copy of the
    # install logic here.
    - |
      curtin in-target --target=/target -- bash -c 'cat > /etc/systemd/system/droplet-firstboot.service <<UNIT
      [Unit]
      Description=Droplet single-box first-boot provisioning (runs setup.sh once)
      Wants=network-online.target
      After=network-online.target
      ConditionPathExists=!/var/lib/droplet/.firstboot-done

      [Service]
      Type=oneshot
      User=droplet
      WorkingDirectory=/home/droplet/edge-platform
      ExecStart=/bin/bash -lc "./scripts/setup.sh --single-box --systemd"
      ExecStartPost=/bin/bash -lc "sudo mkdir -p /var/lib/droplet && sudo touch /var/lib/droplet/.firstboot-done && sudo rm -f /etc/sudoers.d/droplet-firstboot"
      RemainAfterExit=yes
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
      UNIT'
    - curtin in-target --target=/target -- systemctl enable droplet-firstboot.service
    # Passwordless sudo for the firstboot unit's setup.sh (setup.sh installs
    # Docker + systemd units). PROVISIONING-WINDOW ONLY: the firstboot unit's
    # ExecStartPost deletes this drop-in right after it stamps .firstboot-done
    # (marker first — the rm kills the unit's own sudo), so the grant never
    # outlives provisioning. Steady state on a shipped box is `sudo`-group
    # membership gated by the operator's password; unattended privileged paths
    # go through the device-bridge's polkit-routed root units, never sudo. A
    # NOPASSWD: ALL that persisted past first boot would turn the SSH password
    # into a remote root credential (ADR-020 §D6).
    - |
      curtin in-target --target=/target -- bash -c 'echo "droplet ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/droplet-firstboot && chmod 440 /etc/sudoers.d/droplet-firstboot'
