[Unit]
Description=Droplet USB auto-mount for %I
# Wants=, NOT Requires=docker.service (P6): Docker is only needed for the opt-in
# (NEXTCLOUD_AUTO_REGISTER=0 default) occ registration, which already tolerates
# failure. A hard Requires= makes any docker.service stop/restart cascade a stop to
# every droplet-automount@ instance, whose ExecStop lazily unmounts every user drive
# and closes their LUKS mappers — and udev add events don't re-fire, so the drives
# stay gone until replug/reboot. After= still orders us after Docker; Wants= won't cascade.
Wants=docker.service
After=docker.service local-fs.target
# We depend on udisks staying out of our way — but don't hard-require it
# off, since many user-space apps want it running for other purposes.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/droplet-automount.sh add   /dev/%I
ExecStop=/usr/local/bin/droplet-automount.sh remove /dev/%I
TimeoutStartSec=30
TimeoutStopSec=30
# Pass known-good PATH so docker/blkid/mount are found when run from udev.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
