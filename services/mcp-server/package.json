{
  "name": "@droplet/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "require": "./dist/lib.js",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "droplet-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "postinstall": "node -e \"try { require('@prisma/client').PrismaClient; } catch (e) { console.warn('[@droplet/mcp-server] Prisma client not generated yet. Run: npm run -w @droplet/orchestrator db:generate'); }\""
  },
  "dependencies": {
    "@droplet/fips-selftest": "0.1.0",
    "@droplet/tools-core": "0.1.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.14.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "undici": "^6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  }
}
