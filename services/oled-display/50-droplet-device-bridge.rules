// WARP-808 follow-up — polkit rule for the Droplet device-bridge.
//
// The bridge (droplet-device-bridge.service) runs as the unprivileged
// `droplet` user inside a ProtectSystem=strict / NoNewPrivileges sandbox, so
// it cannot sudo and cannot touch root-owned paths. The single-box Wi-Fi
// write (scripts/host/droplet-set-hostapd.sh) needs exactly ONE privileged
// action: `systemctl restart droplet-openwrt-attach.service` (which
// regenerates /etc/hostapd.conf from the env files and respawns hostapd).
// systemctl performs that via a D-Bus call to PID 1 — no process privilege
// escalation — and polkit is the authorization gate. Allow `droplet` to
// restart THAT ONE unit and nothing else.
//
// The storage-pool write path (ADR-019 follow-up) needs one more, equally
// narrow grant: `systemctl start droplet-storage-pool-apply.service` — the
// root oneshot that consumes the bridge's spooled pool request
// (/var/lib/droplet-bridge/pool-spool/request.json) and runs the repo-tracked
// droplet-storage-pool.sh as root. mdadm/mkfs are direct binaries with no
// unit of their own to restart, so unlike the Wi-Fi fix the privileged work
// lives in that dedicated oneshot; the bridge still only talks to PID 1 over
// D-Bus. Start verb ONLY — the bridge never stops or restarts it.
//
// Installed to /etc/polkit-1/rules.d/ by scripts/install-device-bridge.sh.
// Requires polkit >= 106 (JS rules) — the shipping box runs Ubuntu 24.04
// (polkit 124).
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "droplet-openwrt-attach.service" &&
    (action.lookup("verb") === "restart" ||
      action.lookup("verb") === "start") &&
    subject.user === "droplet"
  ) {
    return polkit.Result.YES;
  }
});

polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "droplet-storage-pool-apply.service" &&
    action.lookup("verb") === "start" &&
    subject.user === "droplet"
  ) {
    return polkit.Result.YES;
  }
});
