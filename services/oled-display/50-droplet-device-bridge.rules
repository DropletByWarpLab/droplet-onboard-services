// Polkit rule for the Droplet device-bridge.
//
// The bridge (droplet-device-bridge.service) runs as the unprivileged
// `droplet` user inside a ProtectSystem=strict / NoNewPrivileges sandbox, so
// it cannot sudo and cannot touch root-owned paths.
//
// The storage-pool write path (ADR-019 follow-up) needs exactly ONE narrow
// grant: `systemctl start droplet-storage-pool-apply.service` — the root
// oneshot that consumes the bridge's spooled pool request
// (/var/lib/droplet-bridge/pool-spool/request.json) and runs the repo-tracked
// droplet-storage-pool.sh as root. mdadm/mkfs are direct binaries with no
// unit of their own, so the privileged work lives in that dedicated oneshot;
// the bridge only talks to PID 1 over D-Bus. Start verb ONLY — the bridge
// never stops or restarts it.
//
// HISTORY (WARP-843): the former second grant — restart on
// droplet-openwrt-attach.service for the single-box Wi-Fi write (WARP-808 /
// PR #551) — is REMOVED. The Wi-Fi write scripts skip systemctl entirely when
// unprivileged; the root-owned droplet-openwrt-attach.path unit watches the
// env file and re-applies the change, so the bridge needs no restart
// privilege at all (and the fix no longer depends on polkitd JS-rule support
// being present and healthy).
//
// Installed to /etc/polkit-1/rules.d/ by scripts/install-device-bridge.sh.
// Requires polkit >= 106 (JS rules) — the shipping box runs Ubuntu 24.04
// (polkit 124).
// WARP-1639 adds a SECOND narrow grant: `systemctl start
// droplet-panel-console.service` — the root oneshot that hands the rack
// panel's framebuffer back to the kernel console. This is the recovery path
// behind the panel's on-screen debug button: claiming the panel takes the
// physical console away, so there must be a way to get it back without
// already having a shell. The bridge cannot do the work itself (writing
// /sys/class/vtconsole/*/bind and calling chvt both need root, and this
// sandbox has NoNewPrivileges), so the privileged half lives in that unit and
// the bridge only asks PID 1 to start it. Start verb ONLY — the bridge never
// stops or restarts it, and it has no grant over droplet-panel-claim.service
// (taking the console AWAY from an operator must not be remotely triggerable
// by the container).
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    (action.lookup("unit") === "droplet-storage-pool-apply.service" ||
      action.lookup("unit") === "droplet-panel-console.service") &&
    action.lookup("verb") === "start" &&
    subject.user === "droplet"
  ) {
    return polkit.Result.YES;
  }
});
