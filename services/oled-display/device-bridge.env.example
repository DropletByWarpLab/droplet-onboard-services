# Droplet device-bridge runtime config.
#
# Install as /etc/droplet/device-bridge.env (root:root 0600) on the Jetson
# host. The systemd unit at droplet-device-bridge.service loads this file
# via EnvironmentFile=-/etc/droplet/device-bridge.env.
#
# Do NOT commit the populated version to git — this file is in .gitignore
# when named device-bridge.env. Only the .example template is tracked.

# OpenWrt router SSH credentials — used by the bridge for `iwinfo scan`
# and reading wifi SSID/PSK for the on-device QR code. Leave empty to
# make the bridge skip the OpenWrt path entirely (the display falls back
# to the Jetson's own wifi adapter via nmcli, without write-back).
OPENWRT_PASS=

# Pairing-QR credentials source — which deployment shape broadcasts the AP:
#   uci      (default) multi-box: a Pi-5 OpenWrt router holds the AP in
#            UCI; the bridge reads SSID+PSK over SSH (OPENWRT_* above).
#   hostapd  single-box: the host runs a raw hostapd AP via the
#            droplet-openwrt-attach script (no UCI). The bridge reads the
#            creds from DROPLET_AP_SSID/DROPLET_AP_PSK below, falling back
#            to parsing /etc/hostapd.conf inside the droplet-openwrt
#            container. Rotation is always disabled in this mode.
#   auto     pick hostapd when DROPLET_AP_SSID is set OR UCI wireless is
#            empty/unreachable; otherwise uci.
# Single-box installs: scripts/install-device-bridge.sh auto-writes
# DROPLET_AP_MODE=hostapd here, mirrored from the repo .env knob that
# `setup.sh --single-box` sets. Multi-box leaves it unset (defaults to uci).
# DROPLET_AP_MODE=uci

# hostapd-mode AP credentials (only used when DROPLET_AP_MODE=hostapd, or
# auto resolves to hostapd). Cleanest source — the droplet-openwrt-attach
# script already exports these. If left empty the bridge parses
# /etc/hostapd.conf out of the droplet-openwrt container instead.
# DROPLET_AP_SSID=Droplet
# DROPLET_AP_PSK=Droplet123!

# Override the container / path used for the hostapd.conf fallback. Defaults
# are correct for the single-box image; only set these if the AP container is
# named or mounts its config differently.
# DROPLET_AP_CONTAINER=droplet-openwrt
# DROPLET_AP_HOSTAPD_CONF=/etc/hostapd.conf

# Optional: override the default host-side bind. The bridge is meant to
# be consumed only by the local display container, so 127.0.0.1 is the
# safe default. Setting 0.0.0.0 without an auth layer exposes a
# no-auth POST /wifi/connect endpoint to every host on the LAN.
# BRIDGE_BIND=127.0.0.1

# Shared-secret auth for the two mutating endpoints (POST /openwrt/wifi/rotate
# and POST /wifi/connect). Required in production — without it, any process
# on the Jetson can rotate the Wi-Fi key or force-join arbitrary SSIDs.
# scripts/install-device-bridge.sh copies SERVICE_TOKEN_DISPLAY from the
# repo's .env into here (WARP-165 — previously DEVICE_SECRET_KEY, the
# FIPS-sealed AES-256 master key was reused here, which put it on the
# wire on every display call). Generate with:
#   openssl rand -hex 32
BRIDGE_AUTH_TOKEN=

# Wi-Fi key rotation. OFF by default in production because rotating the
# PSK kicks every joined station — a phone set to "auto-connect when I
# get home" will stop working until the user re-scans the fresh QR.
# Flip to true only in shared-office / visitor-kiosk scenarios where the
# churn is desirable. The PyPortal's "Rotate now" button, the 24h timer,
# and the rotation TTL chip all key off this flag.
# WIFI_KEY_ROTATION_ENABLED=false

# Rotation cadence + min interval only relevant when the above is true.
# WIFI_KEY_ROTATION_INTERVAL_SECONDS=86400
# WIFI_KEY_ROTATION_MIN_INTERVAL_SECONDS=30
