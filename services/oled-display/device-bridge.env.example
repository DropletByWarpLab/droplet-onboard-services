# Droplet device-bridge runtime config.
#
# Install as /etc/droplet/device-bridge.env (root:root 0600) on the Jetson
# host. The systemd unit at droplet-device-bridge.service loads this file
# via EnvironmentFile=-/etc/droplet/device-bridge.env.
#
# Do NOT commit the populated version to git — this file is in .gitignore
# when named device-bridge.env. Only the .example template is tracked.

# OpenWrt router SSH credentials — used by the bridge for `iwinfo scan`
# and reading wifi SSID/PSK for the on-device QR code. Leave empty to
# make the bridge skip the OpenWrt path entirely (the display falls back
# to the Jetson's own wifi adapter via nmcli, without write-back).
OPENWRT_PASS=

# Optional: override the default host-side bind. The bridge is meant to
# be consumed only by the local display container, so 127.0.0.1 is the
# safe default. Setting 0.0.0.0 without an auth layer exposes a
# no-auth POST /wifi/connect endpoint to every host on the LAN.
# BRIDGE_BIND=127.0.0.1
