[Unit]
Description=Droplet device-bridge (wifi scan + drives + QR for on-device screen)
# The bridge shells out to docker for Nextcloud/Frigate queries and to
# nmcli/ssh for wifi. It's useless before docker + network are up.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=droplet
Group=droplet
# Sensible defaults for endpoints that are always the same on a Droplet
# deployment. The operator env file is loaded AFTER these (see below) so it
# can OVERRIDE any of them — including BRIDGE_BIND (WARP-659): systemd applies
# Environment/EnvironmentFile in source order, last wins, so the file must come
# last or an operator's setting is silently ignored.
#
# WARP-815 (K2): OPENWRT_HOST/USER/IFACE below feed the SSH/UCI path in
# device-bridge.py — the `iwinfo <OPENWRT_IFACE> scan` and credential lookups
# that target an OpenWrt router at OPENWRT_HOST. 192.168.50.1 is the single
# documented OPENWRT_HOST default (matches docker/docker-compose.yml +
# services/routing/main.py).
#
# These are DEFAULTS, not a claim that they fit every shape:
#   - The SINGLE-BOX shape has no router at 192.168.50.1. It relies on
#     DROPLET_AP_MODE=hostapd (set via the EnvironmentFile below) so that AP
#     credential resolution (hostapd_wifi_credentials / _use_hostapd_mode in
#     device-bridge.py) reads from the host hostapd / the droplet-openwrt
#     container's hostapd.conf instead of these UCI/SSH defaults. If that env
#     is unset or hasn't been mirrored into the bridge before it starts, the
#     UCI/SSH `scan_via_openwrt` path is used and the bridge tries to reach
#     192.168.50.1 — which does not exist on single-box. So these are safe on
#     single-box only when DROPLET_AP_MODE=hostapd is in effect, not
#     unconditionally.
#   - OPENWRT_IFACE is just the SSH-path default here; this unit is NOT the
#     authority on radio/NIC naming. The interface name that is actually
#     correct for a given shape is resolved by the routing SDK — see
#     services/routing/droplet_openwrt_sdk.py (_default_wifi_scan_device and
#     the surrounding NET-02 note), which documents why a single literal does
#     not fit every shape.
# Either shape can re-pin all three via the operator env file (loaded last).
Environment=OPENWRT_HOST=192.168.50.1
Environment=OPENWRT_USER=root
Environment=OPENWRT_IFACE=wlan0
# Reach docker-hosted services on loopback so we don't bind to Docker
# bridge IPs that drift every time Docker reshuffles its subnet. Frigate
# publishes port 5000 on 127.0.0.1 via docker-compose. The orchestrator
# goes through the nginx gateway on port 80 (path-based proxy to
# orchestrator:3000) — its port 3000 is not host-published.
Environment=FRIGATE_URL=http://127.0.0.1:5000
Environment=ORCHESTRATOR_URL=http://127.0.0.1
Environment=BRIDGE_PORT=9090
# Bind all interfaces, NOT loopback. The orchestrator container is on the
# `droplet_default` bridge network and reaches the bridge via
# `host.docker.internal` (its `extra_hosts: host-gateway` mapping → the
# host's docker-gateway IP, e.g. 172.18.0.1). A 127.0.0.1 bind refuses that
# gateway connection, so GET /drives and GET /openwrt/qr from the
# orchestrator silently fail and the dashboard's Drives panel + setup
# storage step show nothing. This mirrors the oled-display service, which
# binds 0.0.0.0:8082 for the same cross-container reachability. Safe because
# every mutating endpoint (/wifi/connect, /openwrt/wifi/rotate,
# /drives/<uuid>/eject) AND every credential-bearing read (/openwrt/qr — the
# Wi-Fi PSK — plus /drives) is gated on BRIDGE_AUTH_TOKEN (WARP-659), and the
# bridge refuses to start without that token (see device-bridge.py
# _boot_banner). The remaining open reads (/wifi scan, /files, /cameras,
# /health) carry no credential material. The in-code default stays 127.0.0.1;
# an operator can re-pin the bind via the env file below (loaded last).
Environment=BRIDGE_BIND=0.0.0.0
Environment=BRIDGE_STATE_FILE=/var/lib/droplet-bridge/state.json
# WARP-808 follow-up: the hostapd Wi-Fi write (droplet-set-hostapd.sh, shelled
# by POST /openwrt/wifi/hostapd) runs INSIDE this unit's sandbox — User=droplet
# + ProtectSystem=strict make its default target /etc/default/droplet-openwrt-
# attach unwritable (mktemp EROFS — the setup wizard's Home Wi-Fi save failed
# with exactly that on the shipping box). Point the write at the bridge's own
# StateDirectory instead; the attach script's customer_ap_creds block parses
# ONLY DROPLET_AP_SSID/DROPLET_AP_PSK out of that file with hard validation
# (NOT an EnvironmentFile — drop-in ordering would clobber it, and a
# droplet-writable file must never inject arbitrary env into a root unit), so
# a customer Wi-Fi write overrides provisioning defaults without root. A
# factory reset wipes the StateDirectory AND /etc/droplet/ap-psk, so the AP
# returns to the /etc/default SSID with a freshly generated per-box PSK.
# The restart half of the write goes through polkit (50-droplet-device-
# bridge.rules), not privilege escalation: NoNewPrivileges stays true.
Environment=DROPLET_HOSTAPD_ENV_FILE=/var/lib/droplet-bridge/openwrt-attach.env
# Operator-managed runtime config, loaded LAST so it overrides the inline
# defaults above (BRIDGE_BIND, OPENWRT_*, etc.). Created by `setup.sh` with
# 0600 perms; holds the OpenWrt SSH password, BRIDGE_AUTH_TOKEN, Frigate URL.
# Kept out of the committed unit so git history never carries live credentials.
EnvironmentFile=-/etc/droplet/device-bridge.env
# @REPO_ROOT@ is filled in with the real repo path by
# scripts/install-device-bridge.sh at install time, so the unit is not pinned
# to one clone location. The old hardcoded
# /home/droplet/Documents/droplet-onboard-services path does not exist on the
# shipping box (repo lives at /home/droplet/edge-platform), so the service
# exited 2/INVALIDARGUMENT and crash-looped.
ExecStart=/usr/bin/python3 @REPO_ROOT@/services/oled-display/device-bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/droplet-device-bridge.log
StandardError=append:/var/log/droplet-device-bridge.log

# --- Hardening ---
# StateDirectory creates /var/lib/droplet-bridge owned by droplet:droplet
# with 0700 perms on every start, even after a factory-reset wipes it.
# The bridge writes rotation timestamps + a key digest there; cleartext
# keys never hit disk.
StateDirectory=droplet-bridge
StateDirectoryMode=0700
# Lock down the filesystem view: readonly rootfs, private /tmp, mask
# /proc so other users' details aren't visible.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true
# The bridge only needs IPv4/IPv6 + Unix sockets (SSH, curl, HTTP server).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Writable paths the bridge actually touches. Log file is per-unit so
# append:/var/log/... needs that path writable; StateDirectory above is
# handled automatically.
ReadWritePaths=/var/log/droplet-device-bridge.log
# WARP-985: the FQDN + box-name write-backs must upsert <repo>/.env — POST
# /host/public-fqdn execs droplet-set-public-fqdn.sh, which mktemp's a sibling
# next to .env before the atomic mv, so the repo DIRECTORY (not just the file)
# needs a carve-out from ProtectSystem=strict + ProtectHome=read-only. Without
# it the write-back dies with EROFS and the orchestrator's tls-issuance logs
# "device-bridge public-fqdn write-back failed" even though the cert issued.
# Same @REPO_ROOT@ install-time substitution as ExecStart above; `-` = ignore
# if missing so the unit still starts on a host where the checkout moved.
ReadWritePaths=-@REPO_ROOT@
# Allow reading by-label/by-uuid for drive enumeration, and /proc/mounts.
# Those are under /dev and /proc respectively — both readable by default.

[Install]
WantedBy=multi-user.target
