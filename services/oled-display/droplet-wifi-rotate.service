[Unit]
Description=Droplet — rotate Wi-Fi WPA key on the OpenWrt router
# Needs the bridge to be up so the rotate endpoint exists. If the bridge
# is down we'd rather no-op than error — next timer fire will pick it up.
After=droplet-device-bridge.service network-online.target
Requires=droplet-device-bridge.service

[Service]
Type=oneshot
# Pull BRIDGE_AUTH_TOKEN from the same env file the bridge uses, so the
# token never has to be duplicated. `=-` = tolerate missing file during
# initial provisioning; the curl will 401 and exit clean.
EnvironmentFile=-/etc/droplet/device-bridge.env
Environment=BRIDGE_URL=http://127.0.0.1:9090
# curl args:
#   -sS   quiet but still print errors
#   -f    exit non-zero on 4xx/5xx (so systemd marks the run as failed)
#   --max-time 40  belt against a hung SSH/UCI path on the router
#   -H    carry the auth token the bridge requires in production
# Output goes to the journal (`journalctl -u droplet-wifi-rotate`), not a flat
# file. It used to redirect into /var/log/droplet-wifi-rotate.log, carved out
# with `ReadWritePaths=` — but nothing ever created that file, and
# `ReadWritePaths=` is only a whitelist: systemd never creates the path and
# fails namespace setup with 226/NAMESPACE when it is absent. factory-reset.sh
# deleted the file too, so a reset armed the failure. The unit survived only
# because its timer ships disabled; the first `systemctl start` would have
# exited 226. Nothing read the file — journald is the correct home.
ExecStart=/bin/sh -c 'curl -sS -f --max-time 40 -X POST \
    -H "X-Droplet-Auth: ${BRIDGE_AUTH_TOKEN:-}" \
    "$BRIDGE_URL/openwrt/wifi/rotate"'

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
