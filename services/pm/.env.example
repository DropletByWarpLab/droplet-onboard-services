# services/pm/ — Plane PM stack environment variables
#
# Architecture-guard rule 11: never use a `MATTER_*` prefix (collides with
# matter.js VariableService). Use `DROPLET_PM_*`.
#
# Architecture-guard rule 14: no host-specific defaults. Defaults below
# either work on a brand-new install or fail loud at startup.
#
# Secrets (SECRET_KEY, DB_PASSWORD, ADMIN_TOKEN, WEBHOOK_SECRET) are
# generated by setup.sh on first run and written to the root .env file
# (mode 0600). Never commit real values.

# --- Plane Django SECRET_KEY (required) ---
DROPLET_PM_SECRET_KEY=

# --- Postgres for Plane (dedicated container per OQ1) ---
DROPLET_PM_DB_NAME=plane
DROPLET_PM_DB_USER=plane
DROPLET_PM_DB_PASSWORD=
DROPLET_PM_DB_HOST=postgres-pm
DROPLET_PM_DB_PORT=5432

# --- Redis for Plane (dedicated container per OQ1) ---
DROPLET_PM_REDIS_HOST=redis-pm
DROPLET_PM_REDIS_PORT=6379

# --- Plane internal URLs (compose-network DNS, not host IPs — rule 14) ---
DROPLET_PM_API_URL=http://pm-api:8000
DROPLET_PM_WEB_URL=https://gateway.local/pm

# --- Orchestrator-only: admin token for user provisioning ---
# Used by orchestrator to create/manage Plane users via API.
# NEVER exposed to the dashboard or LLM agent.
DROPLET_PM_ADMIN_TOKEN=

# --- Webhook signing key (HMAC) ---
# Plane signs outgoing webhook payloads with this; orchestrator validates.
# Fail-CLOSED on signature mismatch per security-rules.md.
DROPLET_PM_WEBHOOK_SECRET=

# --- Default workspace seeded by setup wizard (WARP-507) ---
# Customer's business name; falls back to "My Workspace" if empty.
DROPLET_PM_DEFAULT_WORKSPACE=

# --- Health sidecar config ---
# Polling interval (seconds) for the sidecar to check Plane's internal API.
DROPLET_PM_HEALTH_POLL_INTERVAL=30

# Maximum age (seconds) before a cached health result is considered stale.
DROPLET_PM_HEALTH_STALE_AFTER=90
