{
  "name": "@droplet/integration-tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:mcp": "vitest run mcp.integration.test.ts",
    "test:rag-extractors": "RUN_RAG_INTEGRATION=1 vitest run rag-extractors.integration.test.ts",
    "test:rag-brain-upload": "RUN_RAG_INTEGRATION=1 vitest run rag-brain-upload.integration.test.ts",
    "test:rag-brain-export": "RUN_RAG_INTEGRATION=1 vitest run rag-brain-export.integration.test.ts",
    "test:rag-end-to-end": "RUN_RAG_INTEGRATION=1 vitest run rag-end-to-end.integration.test.ts",
    "test:retrieval-eval": "RUN_RAG_INTEGRATION=1 vitest run retrieval-eval/run.integration.test.ts --reporter=verbose",
    "test:rag": "RUN_RAG_INTEGRATION=1 vitest run --no-file-parallelism rag-extractors.integration.test.ts rag-search.integration.test.ts rag-brain-upload.integration.test.ts rag-knowledge.integration.test.ts rag-brain-export.integration.test.ts rag-end-to-end.integration.test.ts",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from integration-tests"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/yauzl": "^3.4.0",
    "jsonwebtoken": "^9.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  }
}
